---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
import OverpricedStickersSection from "../components/OverpricedStickersSection.astro";
import InvestorChatbot from "../components/InvestorChatbot.astro";

const overpricedMetaItems = [
  { field: "sentiment", label: "SENTIMENT", value: "MYTHIC", width: 6 },
  { field: "ask_price", label: "ASK_PRICE", value: "TOO MUCH", width: 8 },
  { field: "liquidity", label: "LIQUIDITY", value: "COSMIC", width: 6 },
  { field: "rarity", label: "RARITY", value: "STUBBORN", width: 8 },
];
---

<Layout
  title="Overpriced Stickers — Conceptual Art Editions by Q888"
  description="Overpriced Stickers is a Q888 conceptual art collection where price, belief, provenance, sentiment, and absurdity become part of each limited-edition artifact."
  image="/images/overpriced_stickers.webp"
  canonicalPath="/overpriced/"
  pageType="collection"
  keywords={["conceptual art stickers", "limited edition art", "speculative value", "Q888", "Overpriced Stickers"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" customItems={overpricedMetaItems} />

  <main class="relative min-h-screen pt-10 md:pt-11">
    <div class="overpriced-layout-with-nav">
      <OverpricedStickersSection />
      <InvestorChatbot />
    </div>
  </main>

  <div class="hidden md:block">
    <SystemMeta position="bottom" customItems={overpricedMetaItems} />
  </div>
</Layout>

<style>
  .overpriced-layout-with-nav {
    --overpriced-nav-offset: 2.5rem;
    padding-top: var(--overpriced-nav-offset);
  }

  @media (min-width: 768px) {
    .overpriced-layout-with-nav {
      --overpriced-nav-offset: 2.75rem;
    }
  }
</style>
