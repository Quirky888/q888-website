---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
import ConstitutionDraft from "../components/ConstitutionDraft.astro";
import { getEntry } from "astro:content";
import DOMPurify from "isomorphic-dompurify";
import { Image } from "astro:assets";

const [presidentEntry, constitutionEntry] = await Promise.all([
  getEntry("campaigns", "president-of-the-galaxy"),
  getEntry("constitutions", "intergalactic-constitution"),
]);
if (!presidentEntry || !constitutionEntry) {
  throw new Error("Required President or constitution content entry is missing.");
}
const president = presidentEntry.data;
const constitution = constitutionEntry.data;
const v2Entry = await getEntry("stickers", "22-pog-2026");
if (!v2Entry) throw new Error("Required President V2 sticker entry is missing.");
const v2 = v2Entry.data;
if (!v2.imageUrl) throw new Error("Required President V2 artwork is missing.");
const v1Entry = await getEntry("stickers", "07-pog-2025");
if (!v1Entry) throw new Error("Required President V1 sticker entry is missing.");
const v1 = v1Entry.data;

// DNA: "Preparation before power", measured. The count comes from the sticker registry,
// so selling a sticker there moves the campaign forward here.
const v1Total = Number(v1.editionTotal);
const v1Left = Number(v1.availableCount);
const v1Handled = Number.isFinite(v1Total) && Number.isFinite(v1Left) ? v1Total - v1Left : 0;
// Seal ring text: runs once round the emblem.
const sealText = `${president.heroTitleLines.join(" ")} ✦ ${president.statusLines[0]} ✦ ${president.tagline} ✦ `.toUpperCase();
const sealTicks = Array.from({ length: 72 }, (_, i) => i);
// Split a headline line into per-letter spans so each letter can react to the pointer.
const splitChars = (text: string) => Array.from(text);
const v1Progress = v1Total > 0 ? Math.round((v1Handled / v1Total) * 100) : 0;
---

<Layout
  title="President of the Galaxy — Speculative Campaign Artwork by Q888"
  description="President of the Galaxy is an ongoing conceptual art campaign by Q888, built from limited artifacts, AI collaboration, mushroom civilizations, fictional economics, and preparation before power."
  image={president.heroImage}
  canonicalPath="/president/"
  displayFonts
  mainEntityType="CreativeWork"
  mainEntityName="President of the Galaxy"
  keywords={["President of the Galaxy", "speculative campaign", "political art", "human AI collaborative art", "Q888"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />

  <main class="relative min-h-[100dvh] pt-10 md:pt-11">
    <div class="president-eden-wrap">

      <!-- ══════════════════════════════════ HERO ══════════════════════════════════ -->
      <section class="president-hero" data-president-hero>
        <div class="president-hero-bg" aria-hidden="true">
          <span class="hero-aurora hero-aurora--teal"></span>
          <canvas class="hero-stars"></canvas>
          <span class="hero-spot"></span>
        </div>

        <!-- Presidential seal + orrery: rings, a ringed planet, orbiting moons, text running round the edge. -->
        <div class="hero-emblem" aria-hidden="true" data-emblem>
          <svg viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <path id="seal-path" d="M300,300 m-262,0 a262,262 0 1,1 524,0 a262,262 0 1,1 -524,0" />
              <linearGradient id="square-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff9de2" />
                <stop offset="100%" stop-color="#9b4f9e" />
              </linearGradient>
              <radialGradient id="planet-grad" cx="35%" cy="32%" r="75%">
                <stop offset="0%" stop-color="#fff1bf" />
                <stop offset="45%" stop-color="#ffcc33" />
                <stop offset="100%" stop-color="#7a5a00" />
              </radialGradient>
            </defs>
            <g class="emblem-ticks">
              {sealTicks.map((i) => <line x1="300" y1="6" x2="300" y2={i % 6 === 0 ? 24 : 15} transform={`rotate(${i * 5} 300 300)`} />)}
            </g>
            <g class="emblem-text">
              <text><textPath href="#seal-path" textLength="1646" lengthAdjust="spacing">{sealText}</textPath></text>
            </g>
            <circle class="emblem-ring emblem-ring--a" cx="300" cy="300" r="226" />
            <g class="emblem-orbit emblem-orbit--a"><circle class="moon moon--teal" cx="526" cy="300" r="7" /></g>
            <circle class="emblem-ring emblem-ring--b" cx="300" cy="300" r="170" />
            <g class="emblem-orbit emblem-orbit--b"><circle class="moon moon--gold" cx="130" cy="300" r="5" /></g>
            <circle class="emblem-ring emblem-ring--c" cx="300" cy="300" r="112" />
            <g class="emblem-orbit emblem-orbit--c"><circle class="moon moon--white" cx="412" cy="300" r="4" /></g>
            <!-- Square planet: the only one that is not round, on a tilted, off-centre orbit. -->
            <g class="emblem-square-orbit" transform="rotate(-32 300 300)">
              <ellipse class="square-orbit-track" cx="330" cy="300" rx="262" ry="78" />
              <g class="square-body">
                <animateMotion dur="44s" repeatCount="indefinite" path="M592,300 A262,78 0 1,1 68,300 A262,78 0 1,1 592,300" />
                <g class="square-spin" transform="rotate(32)">
                  <rect x="-17" y="-17" width="34" height="34" rx="8" fill="url(#square-grad)" />
                  <circle cx="-5" cy="-6" r="3.2" fill="#fff1e0" opacity="0.85" />
                  <circle cx="7" cy="3" r="2.2" fill="#fff1e0" opacity="0.7" />
                  <circle cx="-6" cy="8" r="1.6" fill="#fff1e0" opacity="0.6" />
                </g>
              </g>
            </g>
            <g class="emblem-planet">
              <ellipse class="planet-ring planet-ring--back" cx="300" cy="300" rx="78" ry="20" transform="rotate(-18 300 300)" />
              <circle cx="300" cy="300" r="42" fill="url(#planet-grad)" />
              <path class="planet-ring planet-ring--front" d="M222,300 A78,20 0 0 0 378,300" transform="rotate(-18 300 300)" />
            </g>
          </svg>
        </div>

        <div class="president-hero-inner px-6 sm:px-10 lg:px-16">
          <div class="president-hero-text">
            <p class="president-eyebrow">{president.tagline}</p>
            <h1 class="president-headline" aria-label={president.heroTitleLines.join(" ")} data-hl>
              {president.heroTitleLines.map((line: string, li: number) => (
                <span class="hl-line" aria-hidden="true">
                  {splitChars(line).map((ch, ci) => ch === " "
                    ? <span class="hl-space"></span>
                    : <span class="hl-char" style={`--i:${li * 12 + ci}`}>{ch}</span>)}
                </span>
              ))}
            </h1>
            <div class="president-status-block narmail-mono">
              {president.statusLines.map((line: string) => <div>{line}</div>)}
              <div>Year: <span class="president-censored" data-reveal="??" tabindex="0" role="button" aria-label="Reveal year digits">██</span>88<span class="hud-cursor" aria-hidden="true"></span></div>
            </div>
            <p class="president-provenance-line narmail-mono">
              <span>Artwork provenance</span>
              {president.authorship.imageStatus.join(" · ")}
            </p>
            <a class="president-witness-btn" href="#campaign-test">Become an early witness <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="president-ticker" aria-hidden="true">
          <div class="president-ticker-track">
            {[0, 1].map(() => (
              <div class="president-ticker-group">
                <span>{president.tagline}</span>
                {president.statusLines.map((line: string) => <span>{line}</span>)}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════ MAIN CONTENT ══════════════════════════════════ -->
      <div class="president-main-content px-6 sm:px-10 lg:px-16 pb-16">

        <!-- Lead section -->
        <section class="president-section" data-pg-reveal>
          <p class="president-lead">
            {president.lead}
          </p>
        </section>

        </section>


        <!-- DNA: the campaign's one practical claim, shown before anything else. -->
        <section class="president-section president-test" data-pg-reveal id="campaign-test" aria-labelledby="campaign-test-heading">
          <h2 class="president-h2" id="campaign-test-heading">{president.dealHeading}</h2>
          <p>{president.dealParagraph}</p>

          <div class="test-progress">
            <p class="test-progress-label">Preparation before power · V1, the original edition</p>
            <p class="test-progress-count"><strong>{v1Handled} of {v1Total}</strong> V1 stickers collected</p>
            <div
              class="test-progress-bar"
              role="progressbar"
              aria-label="V1 original edition stickers collected"
              aria-valuemin="0"
              aria-valuemax={v1Total}
              aria-valuenow={v1Handled}
            >
              {Array.from({ length: v1Total }, (_, i) => (
                <i class:list={{ "is-on": i < v1Handled }} style={`--n:${i}`}></i>
              ))}
            </div>
            <p class="test-progress-note">{v1Left} V1 stickers left. V2 has only just been released. The galaxy is watching, mildly.</p>
          </div>

          <div class="test-editions">
            <a class="test-edition" href={`/overpriced/${v1.slug}/`}>
              <div class="v2-artwork"><Image src={v1.imageUrl ?? "/images/president.webp"} alt="President of the Galaxy V1 sticker, the original edition" width={600} height={760} loading="lazy" /></div>
              <p class="test-edition-label">V1 · The original</p>
              <p class="test-edition-meta">Edition of {v1Total} · {v1Left} left · {v1.ask}</p>
              <span class="test-edition-link">Collect V1 <span aria-hidden="true">→</span></span>
            </a>
            <a class="test-edition" href={`/overpriced/${v2.slug}/`}>
              <div class="v2-artwork v2-artwork--sticker">
                <span class="sticker-holo-rim sticker-holo-rim--quiet" aria-hidden="true"></span>
                <img src="/images/president_v2_cutout.webp" alt={v2.imageAlt || v2.title} width="719" height="850" loading="lazy" decoding="async" />
              </div>
              <p class="test-edition-label">V2 · The update</p>
              <p class="test-edition-meta">Edition of {v2.editionTotal} · more human drawing, more fingers · price on request</p>
              <span class="test-edition-link">View V2 <span aria-hidden="true">→</span></span>
            </a>
          </div>

          <h3 class="president-h3">{president.dealIncludesHeading}</h3>
          <ul class="president-list">
            {president.dealIncludes.map((item: string) => <li>{item}</li>)}
          </ul>
          <p set:html={DOMPurify.sanitize(president.dealReturns)}></p>
          <p class="president-note">{president.dealFinePrint}</p>

          <details class="v2-details">
            <summary>Read what changed in V2</summary>
            <div class="v2-updates">
              <article>
                <p class="v2-feature-label">THE SURFACE</p>
                <h4>More human.</h4>
                <p>The original AI-generated figure remains underneath, but significantly more of it has now been covered, interrupted and reorganised by human drawing. White lines reclaim the surface. Gold survives where appropriate. Orange has been authorised for official presidential typography.</p>
              </article>
              <article>
                <p class="v2-feature-label">THE DIPLOMACY</p>
                <h4>One additional middle finger.</h4>
                <p>After extensive diplomatic research, the President can now perform the <strong>Peace On</strong> gesture with both hands, providing approximately twice the intergalactic peace experience.</p>
              </article>
              <article>
                <p class="v2-feature-label">THE TYPOGRAPHY</p>
                <h4>Now unscrewed.</h4>
                <p>Words that previously behaved like a conventional slogan have been separated and repositioned: <strong>GALAXY, TOGETHER, SCREW, PRESIDENT, STARS.</strong> Their relationship is no longer completely supervised. You may read them correctly. You may also read them differently. Both readings have presidential approval.</p>
              </article>
            </div>
          </details>

          <blockquote class="president-blockquote test-verdict">
            {president.campaignMethodLines[1]}<br />
            {president.campaignMethodLines[2]}<br />
            {president.campaignMethodLines[3]}
          </blockquote>
          <p class="test-verdict-closing">{president.campaignMethodClosing}</p>
        </section>

        <!-- Rules — campaign cards -->
        <section class="president-section" data-pg-reveal>
          <p class="ballot-kicker">The platform · tick what you would vote for</p>
          <h2 class="president-h2">{president.rulesHeading}</h2>
          <div class="president-rules-grid">
            {president.rules.map((rule: string, i: number) => (
              <div class="president-rule-card">
                <span class="ballot-box" aria-hidden="true"></span>
                <span class="rule-number"><span class="rule-article">Article</span>0{i + 1}</span>
                <p set:html={DOMPurify.sanitize(rule)}></p>
              </div>
            ))}
          </div>
        </section>

        <!-- What is this -->
        <section class="president-section" data-pg-reveal>
          <h2 class="president-h2">{president.whatHeading}</h2>
          <div class="president-two-col">
            <div class="president-two-col-text">
              <p>{president.whatParagraphs[0]}</p>
              <p>{president.whatParagraphs[1]}</p>
            </div>
            <div class="president-what-image-wrapper">
              <a href={president.whatLinkHref} class="president-what-image-link" aria-label="Go to Overpriced Stickers">
                <div class="president-mini-portal">
                  <img src={president.whatImage} alt="" loading="lazy" decoding="async" width="400" height="400" />
                </div>
              </a>
            </div>
          </div>

        <!-- Artwork card -->
        <section class="president-artwork-card-section" data-pg-reveal>
          <div
            class="artwork-info-card president-glass"
            id="president-gallery-trigger"
            role="button"
            tabindex="0"
            aria-label="Open President campaign gallery"
          >
            <!-- Secure Certificate Border Details -->
            <div class="certificate-secure-border"></div>
            <div class="certificate-corner-brackets"></div>

            <div class="artwork-card-content">
              <!-- Left: Postage Stamp Artwork Frame -->
              <div class="artwork-stamp-frame">
                <div class="postage-stamp">
                  <img
                    src="/images/president_galaxy.webp"
                    alt="President of the Galaxy Campaign Preview"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="300"
                  />
                  <div class="stamp-hologram-glare"></div>
                  <div class="stamp-inner-gold"></div>
                </div>
              </div>

              <!-- Right: Content & Action -->
              <div class="artwork-card-text-wrap">
                <div class="artwork-card-tag font-mono">Human × machine working archive</div>
                <h3 class="artwork-card-title">{president.artworkCardTitle}</h3>
                <p class="artwork-card-description">{president.artworkCardDescription}</p>
                
                <button class="artwork-card-button president-btn" type="button" aria-label="Open full campaign poster gallery viewer" tabindex="-1">
                  <span>{president.artworkCardButtonLabel}</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>


        <!--
          DNA: The campaign and its artifact appear before the authorship debate.
          Provenance deepens the work without becoming its first subject.
        -->
        <section class="president-authorship-section" data-pg-reveal aria-labelledby="president-authorship-heading">
          <p class="authorship-eyebrow">{president.authorship.eyebrow}</p>
          <h2 class="president-h2 authorship-heading" id="president-authorship-heading">
            {president.authorship.heading}
          </h2>
          <p class="authorship-introduction">{president.authorship.introduction}</p>

          <div class="authorship-voices">
            {president.authorship.voices.map((voice, index: number) => (
              <article class:list={["authorship-voice", index === 0 ? "is-human" : "is-machine"]}>
                <header class="authorship-voice-header">
                  {voice.collectiveAliases && voice.collectiveNote ? (
                    <span
                      class="ai-collective-reveal"
                      tabindex="0"
                      aria-label={`${voice.speaker}, also known as AI. ${voice.collectiveNote}`}
                    >
                      <span class="authorship-speaker ai-collective-name" aria-hidden="true">
                        <span class="ai-name-sizer">PERPLEXITY</span>
                        <span class="ai-name-base">{voice.speaker}</span>
                        <span class="ai-name-chorus">
                          {voice.collectiveAliases.map((alias, aliasIndex: number) => (
                            <span
                              class="ai-name-alias"
                              style={`--alias-index: ${aliasIndex}`}
                            >
                              {alias}
                            </span>
                          ))}
                        </span>
                      </span>
                      <span class="ai-collective-hint" aria-hidden="true">AKA AI</span>
                      <span class="ai-collective-note" aria-hidden="true">
                        {voice.collectiveNote}
                      </span>
                    </span>
                  ) : (
                    <span class="authorship-speaker">{voice.speaker}</span>
                  )}
                  <span class="authorship-role">{voice.role}</span>
                </header>
                <p>{voice.statement}</p>
              </article>
            ))}
          </div>


          <!-- A third, quiet voice below the surface. Mycelium links the two voices above it. -->
          <div class="authorship-ground">
            <div class="ground-surface qb-mono-label" aria-hidden="true"><span>SURFACE</span><span>SUBSOIL</span></div>
            <svg class="mycelium" viewBox="0 0 1000 150" preserveAspectRatio="none" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke">
                <path pathLength="1" d="M250,0 C250,50 330,70 400,95 S480,130 500,150" />
                <path pathLength="1" d="M750,0 C750,50 670,70 600,95 S520,130 500,150" />
                <path pathLength="1" d="M330,66 C300,90 280,110 240,128" />
                <path pathLength="1" d="M670,66 C700,92 722,108 766,126" />
                <path pathLength="1" d="M400,95 C420,118 410,134 380,148" />
                <path pathLength="1" d="M600,95 C585,116 600,136 628,148" />
                <path pathLength="1" d="M500,150 C490,150 470,150 440,150" />
              </g>
              <g class="mycelium-nodes">
                <circle cx="400" cy="95" r="3" /><circle cx="600" cy="95" r="3" /><circle cx="330" cy="66" r="2.4" />
                <circle cx="670" cy="66" r="2.4" /><circle cx="500" cy="150" r="3.6" /><circle cx="240" cy="128" r="2" />
                <circle cx="766" cy="126" r="2" />
              </g>
            </svg>
            <article class="authorship-voice is-fungi" aria-label="Third voice: fungi">
              <header class="authorship-voice-header">
                <span class="authorship-speaker">FUNGI</span>
                <span class="authorship-role">NETWORK / NOT YET CONSULTED</span>
              </header>
              <p class="fungi-line" style="--k:0">…</p>
              <p class="fungi-line" style="--k:1">11°C. damp. fine.</p>
              <p class="fungi-line" style="--k:2">we were here before the argument.</p>
              <p class="fungi-line" style="--k:3">nothing to add. everything is already connected.</p>
              <p class="fungi-note">Mycelium does not answer in sentences. Q888 translates, with uncertainty. <span>TRANSLATION: UNVERIFIED</span></p>
            </article>
          </div>

          <p class="authorship-provenance-line" aria-label="Working provenance">
            {president.authorship.provenance.map((entry) => (
              <span><strong>{entry.label}:</strong> {entry.status.toLowerCase()}</span>
            ))}
          </p>

          <p class="authorship-closing">{president.authorship.closing}</p>
        </section>

        <!-- The full ten principles live on /constitution/; the campaign keeps the tests. -->
        <ConstitutionDraft constitution={constitution} variant="brief" />

        <!-- sticker divider 2: mushroom + spiral (like square_bubble / love_mushroom art) -->
        <hr class="president-hairline" aria-hidden="true" />





        <!-- Inline sticker motif strip (between campaign principles and method) -->
        


        <!-- Contact -->
        <section class="president-section" data-pg-reveal>
          <h2 class="president-h2">{president.contactTitle}</h2>
          <p class="president-portal-reach">{president.contactReachLine}</p>
          <ul class="president-list">
            <li>{president.contactBullets[0]}</li>
            <li>{president.contactBullets[1]}</li>
            <li>{president.contactBullets[2]}</li>
            <li>{president.contactBullets[3]}</li>
          </ul>
          <div class="president-portal-meta">
            <p set:html={DOMPurify.sanitize(president.contactFor)}></p>
            <p set:html={DOMPurify.sanitize(president.contactOpenTo)}></p>
          </div>
          <p class="president-portal-links">
            <a href={`mailto:${president.contactEmail}`}>{president.contactEmail}</a>
            <span class="president-portal-sep">|</span>
            <a href={president.contactInstagramUrl} target="_blank" rel="noopener noreferrer">{president.contactInstagramHandle}</a>
          </p>
          <p class="president-portal-closing">
            {president.contactClosing}
          </p>
        </section>

        <!-- CTA -->
        <section class="president-cta">
          <a href="#campaign-test" class="president-witness-btn">Become an early witness</a>
          <a href="/#infocigan" class="president-retreat-btn">{president.ctaLabel}</a>
        </section>

      </div>
    </div>

    <!-- ══════════════════════════════════ GALLERY DIALOG ══════════════════════════════════ -->
    <dialog
      class="president-gallery-dialog"
      id="president-gallery-dialog"
      aria-label="President of the Galaxy campaign gallery"
    >
      <!-- Controls bar -->
      <div class="gallery-controls" id="president-gallery-controls">
        <!-- Left: nav -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-prev" id="president-prev-btn" aria-label="Previous image" title="Previous (←)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-counter" id="president-gallery-counter" aria-live="polite">1 / 1</span>
          <button class="gallery-btn gallery-next" id="president-next-btn" aria-label="Next image" title="Next (→)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-label" id="president-gallery-label" aria-live="polite"></span>
        </div>

        <!-- Right: actions -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-zoom-in" id="president-zoom-in" aria-label="Zoom in" title="Zoom in (+)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-zoom-out" id="president-zoom-out" aria-label="Zoom out" title="Zoom out (-)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-reset" id="president-reset-zoom" aria-label="Reset zoom" title="Reset view (0)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <a class="gallery-btn gallery-download" id="president-download-btn" aria-label="Download image" title="Download image" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3V16M12 16L7 11M12 16L17 11M5 20H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <button class="gallery-btn gallery-fullscreen" id="president-fullscreen-btn" aria-label="Toggle fullscreen" title="Fullscreen (F)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="president-fs-icon-expand">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="president-fs-icon-shrink" class="hidden">
              <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-close" id="president-close-btn" aria-label="Close gallery" title="Close (Esc)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Image viewport -->
      <div class="gallery-viewport" id="president-gallery-viewport">
        <div class="gallery-img-container" id="president-img-container">
          <img
            class="gallery-img"
            id="president-gallery-img"
            src=""
            alt=""
            draggable="false"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="gallery-zoom-pill" id="president-zoom-pill" aria-live="polite" aria-atomic="true">100%</div>
      </div>
    </dialog>
  </main>

  <div class="hidden md:block">
    <SystemMeta position="bottom" />
  </div>
</Layout>

<script>
  import { lockBodyScroll } from "../lib/bodyScrollLock";
  /* ─────────────────────────────────────────────────────────────────
     PRESIDENT CAMPAIGN GALLERY — Native <dialog> + Fullscreen API
     ───────────────────────────────────────────────────────────────── */
  type GalleryImage = { src: string; alt: string; label: string };

  const IMAGES: GalleryImage[] = [
    { src: "/images/president_galaxy.webp", alt: "President of the Galaxy — full campaign poster", label: "Campaign Poster" },
    { src: "/images/president_v2.png", alt: "President of the Galaxy V2 — Q888 drawing over the original AI-generated body", label: "President V2 · Edition of 10" },
    { src: "/images/president.webp", alt: "Original President of the Galaxy V1 sticker", label: "President V1 · Original edition" },
  ];

  function initGallery() {
    // Force cleanup on page load / page swap to avoid carrying over viewer state
    document.documentElement.classList.remove("is-viewer-open");

    const trigger   = document.getElementById("president-gallery-trigger");
    const dialog    = document.getElementById("president-gallery-dialog") as HTMLDialogElement | null;
    if (!trigger || !dialog) return;
    if (dialog.dataset.galleryInit) return;
    dialog.dataset.galleryInit = "1";
    let releaseScroll: (() => void) | null = null;

    const img        = document.getElementById("president-gallery-img") as HTMLImageElement;
    const counter    = document.getElementById("president-gallery-counter")!;
    const label      = document.getElementById("president-gallery-label")!;
    const container  = document.getElementById("president-img-container")!;
    const viewport   = document.getElementById("president-gallery-viewport")!;
    const pill       = document.getElementById("president-zoom-pill")!;
    const prevBtn    = document.getElementById("president-prev-btn")!;
    const nextBtn    = document.getElementById("president-next-btn")!;
    const zoomInBtn  = document.getElementById("president-zoom-in")!;
    const zoomOutBtn = document.getElementById("president-zoom-out")!;
    const resetBtn   = document.getElementById("president-reset-zoom")!;
    const dlBtn      = document.getElementById("president-download-btn") as HTMLAnchorElement;
    const fsBtn      = document.getElementById("president-fullscreen-btn")!;
    const closeBtn   = document.getElementById("president-close-btn")!;
    const fsExpand   = document.getElementById("president-fs-icon-expand")!;
    const fsShrink   = document.getElementById("president-fs-icon-shrink")!;

    if (IMAGES.length <= 1) {
      prevBtn.style.display = "none";
      nextBtn.style.display = "none";
      counter.style.display = "none";
    }

    let currentIdx = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    const MIN_SCALE = 1;
    const MAX_SCALE = 5;
    const ZOOM_STEP = 0.35;
    let pillTimer: ReturnType<typeof setTimeout>;
    let initialDist = 0;
    let initialScale = 1;

    // ── Image loading ──
    function loadImage(idx: number) {
      const entry = IMAGES[idx];
      img.src = entry.src;
      img.alt = entry.alt;
      dlBtn.href = entry.src;
      dlBtn.download = entry.src.split("/").pop() ?? "president-artwork";
      counter.textContent = `${idx + 1} / ${IMAGES.length}`;
      label.textContent = entry.label;
      prevBtn.toggleAttribute("disabled", idx === 0);
      nextBtn.toggleAttribute("disabled", idx === IMAGES.length - 1);
    }

    // ── Transform ──
    function applyTransform() {
      container.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      const pct = `${Math.round(scale * 100)}%`;
      pill.textContent = pct;
      pill.classList.add("show");
      clearTimeout(pillTimer);
      pillTimer = setTimeout(() => pill.classList.remove("show"), 1200);
    }

    function resetTransform() {
      scale = 1; tx = 0; ty = 0;
      container.style.transform = "";
    }

    function zoomIn() {
      scale = Math.min(scale + ZOOM_STEP, MAX_SCALE);
      applyTransform();
    }

    // Explicit function ZoomOut
    function zoomOut() {
      scale = Math.max(scale - ZOOM_STEP, MIN_SCALE);
      if (scale <= MIN_SCALE) { tx = 0; ty = 0; }
      applyTransform();
    }

    // ── Open / close ──
    function openGallery(idx = 0) {
      currentIdx = idx;
      loadImage(currentIdx);
      resetTransform();
      document.documentElement.classList.add("is-viewer-open");
      if (!releaseScroll) releaseScroll = lockBodyScroll();
      dialog!.showModal();
    }

    function closeGallery() {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
      dialog!.close();
      document.documentElement.classList.remove("is-viewer-open");
      releaseScroll?.();
      releaseScroll = null;
      resetTransform();
    }

    // ── Fullscreen ──
    function updateFsIcon() {
      const isFs = !!document.fullscreenElement;
      fsExpand.classList.toggle("hidden", isFs);
      fsShrink.classList.toggle("hidden", !isFs);
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        dialog!.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    document.addEventListener("fullscreenchange", updateFsIcon);

    // ── Drag / pan ──
    function onPointerDown(e: PointerEvent) {
      if (scale <= 1) return;
      isDragging = true;
      viewport.setPointerCapture(e.pointerId);
      viewport.style.cursor = "grabbing";
      startX = e.clientX - tx;
      startY = e.clientY - ty;
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      tx = e.clientX - startX;
      ty = e.clientY - startY;
      applyTransform();
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      viewport.releasePointerCapture(e.pointerId);
      viewport.style.cursor = "";
    }

    // ── Wheel zoom ──
    function onWheel(e: WheelEvent) {
      e.preventDefault();
      if (e.deltaY < 0) zoomIn(); else zoomOut();
    }

    // ── Touch pinch ──
    function getTouchDist(e: TouchEvent) {
      return Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY,
      );
    }

    function onTouchStart(e: TouchEvent) {
      if (e.touches.length === 2) {
        initialDist  = getTouchDist(e);
        initialScale = scale;
      }
    }

    function onTouchMove(e: TouchEvent) {
      if (e.touches.length === 2) {
        e.preventDefault();
        const ratio = getTouchDist(e) / initialDist;
        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, initialScale * ratio));
        applyTransform();
      }
    }

    // ── Keyboard ──
    function onKeyDown(e: KeyboardEvent) {
      if (!dialog?.open) return;
      switch (e.key) {
        case "ArrowLeft":  if (currentIdx > 0)                    { currentIdx--; loadImage(currentIdx); resetTransform(); } break;
        case "ArrowRight": if (currentIdx < IMAGES.length - 1)    { currentIdx++; loadImage(currentIdx); resetTransform(); } break;
        case "+": case "=": zoomIn();   break;
        case "-":           zoomOut();  break;
        case "0":           resetTransform(); pill.textContent = "100%"; break;
        case "f": case "F": toggleFullscreen(); break;
      }
    }

    // ── Nav buttons ──
    prevBtn.addEventListener("click", () => {
      if (currentIdx > 0) { currentIdx--; loadImage(currentIdx); resetTransform(); }
    });
    nextBtn.addEventListener("click", () => {
      if (currentIdx < IMAGES.length - 1) { currentIdx++; loadImage(currentIdx); resetTransform(); }
    });

    // ── Event wiring ──
    trigger.addEventListener("click",   () => openGallery(0));
    trigger.addEventListener("keydown", (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "Enter" || ke.key === " ") { ke.preventDefault(); openGallery(0); }
    });

    closeBtn.addEventListener("click",    closeGallery);
    zoomInBtn.addEventListener("click",   zoomIn);
    zoomOutBtn.addEventListener("click",  zoomOut);
    resetBtn.addEventListener("click",    () => { resetTransform(); });
    fsBtn.addEventListener("click",       toggleFullscreen);

    // Light dismiss: close when clicking the backdrop
    dialog!.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (target === dialog) closeGallery();
    });

    // Native cancel event (ESC key)
    dialog!.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeGallery();
    });

    viewport.addEventListener("pointerdown", onPointerDown as EventListener);
    viewport.addEventListener("pointermove", onPointerMove as EventListener);
    viewport.addEventListener("pointerup",   onPointerUp   as EventListener);
    viewport.addEventListener("wheel",       onWheel as EventListener, { passive: false });
    viewport.addEventListener("touchstart",  onTouchStart as EventListener, { passive: true });
    viewport.addEventListener("touchmove",   onTouchMove  as EventListener, { passive: false });

    document.addEventListener("keydown", onKeyDown);

    // Cleanup on Astro page transitions
    const cleanup = () => {
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("fullscreenchange", updateFsIcon);
      document.documentElement.classList.remove("is-viewer-open");
      releaseScroll?.();
      releaseScroll = null;
      document.removeEventListener("astro:before-swap", cleanup);
    };
    document.addEventListener("astro:before-swap", cleanup);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }
  document.addEventListener("astro:page-load", initGallery);
</script>

<script>
  /* Hero: starfield with constellation lines around the pointer (idle drift on touch), a seal that tilts
     toward the pointer, scroll parallax, ticker speeding with scroll, magnetic button. Reduced motion: static stars. */
  const hero = document.querySelector<HTMLElement>("[data-president-hero]");
  const bg = hero?.querySelector<HTMLElement>(".president-hero-bg");
  const canvas = hero?.querySelector<HTMLCanvasElement>(".hero-stars");
  const emblem = hero?.querySelector<HTMLElement>("[data-emblem]");
  const heroText = hero?.querySelector<HTMLElement>(".president-hero-text");
  const track = hero?.querySelector<HTMLElement>(".president-ticker-track");
  const btn = hero?.querySelector<HTMLElement>(".president-witness-btn");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  // Year chip: tap/click toggles (touch devices do not focus a span).
  document.querySelectorAll<HTMLElement>(".president-censored").forEach((el) => {
    el.addEventListener("click", () => el.classList.toggle("is-open"));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); el.classList.toggle("is-open"); }
    });
  });

  if (finePointer) {
    document.querySelectorAll<HTMLElement>(".president-rule-card").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--cx", (e.clientX - r.left) + "px");
        card.style.setProperty("--cy", (e.clientY - r.top) + "px");
      }, { passive: true });
    });
  }

  if (finePointer && !reduce) {
    document.querySelectorAll<HTMLElement>(".test-edition").forEach((card) => {
      const art = card.querySelector<HTMLElement>(".v2-artwork");
      if (!art) return;
      card.addEventListener("pointermove", (e) => {
        const r = art.getBoundingClientRect();
        art.style.setProperty("--ty", (((e.clientX - r.left) / r.width - 0.5) * 14).toFixed(1) + "deg");
        art.style.setProperty("--tx", ((0.5 - (e.clientY - r.top) / r.height) * 12).toFixed(1) + "deg");
      }, { passive: true });
      card.addEventListener("pointerleave", () => { art.style.setProperty("--tx", "0deg"); art.style.setProperty("--ty", "0deg"); });
    });
  }

  type Star = { x: number; y: number; z: number; r: number; ph: number };
  if (reduce) emblem?.querySelector("svg")?.pauseAnimations();
  if (hero && bg && canvas) {
    const ctx = canvas.getContext("2d");
    let w = 0, h = 0, dpr = 1;
    let stars: Star[] = [];
    let focusX = 0.68, focusY = 0.38, targetX = 0.68, targetY = 0.38;
    let hasPointer = false, last = -9999, t = 0;
    let streak: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextStreak = 3;
    let lastY = window.scrollY, rate = 1, ex = 0, ey = 0;
    const trackAnim = track?.getAnimations()[0];

    const resize = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = hero.clientWidth; h = hero.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(260, Math.round((w * h) / 7000));
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        z: 0.25 + Math.random() * 0.75, r: 0.4 + Math.random() * 1.3, ph: Math.random() * 6.28,
      }));
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      const fx = focusX * w, fy = focusY * h;
      const ox = (focusX - 0.5) * -36, oy = (focusY - 0.5) * -24;
      const pts: { x: number; y: number; z: number }[] = [];
      for (const st of stars) {
        const x = (((st.x + ox * st.z + t * 4 * st.z) % w) + w) % w;
        const y = st.y + oy * st.z;
        const tw = reduce ? 0.8 : 0.55 + 0.45 * Math.sin(t * 1.6 + st.ph);
        ctx.globalAlpha = tw * (0.35 + st.z * 0.65);
        ctx.fillStyle = st.z > 0.85 ? "#ffe9a8" : "#dfeff1";
        ctx.beginPath(); ctx.arc(x, y, st.r * st.z + 0.2, 0, 6.283); ctx.fill();
        if (Math.hypot(x - fx, y - fy) < 190) pts.push({ x, y, z: st.z });
      }
      // Constellation: lines join the stars near the focus point.
      ctx.lineWidth = 0.8;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        const df = Math.hypot(a.x - fx, a.y - fy);
        ctx.strokeStyle = "#ffcc33";
        ctx.globalAlpha = Math.max(0, 1 - df / 190) * 0.55;
        ctx.beginPath(); ctx.moveTo(fx, fy); ctx.lineTo(a.x, a.y); ctx.stroke();
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < 95) {
            ctx.strokeStyle = "#7fe3e4";
            ctx.globalAlpha = (1 - d / 95) * Math.max(0, 1 - df / 190) * 0.6;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      if (streak) {
        const g = ctx.createLinearGradient(streak.x, streak.y, streak.x - streak.vx * 14, streak.y - streak.vy * 14);
        g.addColorStop(0, "rgba(255,240,190,0.95)"); g.addColorStop(1, "rgba(255,240,190,0)");
        ctx.globalAlpha = Math.min(1, streak.life);
        ctx.strokeStyle = g; ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.moveTo(streak.x, streak.y); ctx.lineTo(streak.x - streak.vx * 14, streak.y - streak.vy * 14); ctx.stroke();
      }
      ctx.globalAlpha = 1;
    };

    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      targetX = (e.clientX - r.left) / r.width;
      targetY = (e.clientY - r.top) / r.height;
      hasPointer = true; last = performance.now();
    }, { passive: true });
    hero.addEventListener("pointerleave", () => { hasPointer = false; });
    window.addEventListener("resize", () => { resize(); if (reduce) draw(); });
    resize();

    if (reduce) {
      draw();
    } else {
      // Magnetic button
      if (btn && finePointer) {
        btn.addEventListener("pointermove", (e) => {
          const r = btn.getBoundingClientRect();
          btn.style.transform = `translate(${((e.clientX - (r.left + r.width / 2)) / r.width) * 14}px, ${((e.clientY - (r.top + r.height / 2)) / r.height) * 10}px)`;
        });
        btn.addEventListener("pointerleave", () => { btn.style.transform = ""; });
      }
      let prev = performance.now();
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - prev) / 1000); prev = now; t += dt;
        const sy = window.scrollY;
        const vel = sy - lastY; lastY = sy;
        const visible = sy < hero.offsetHeight && !document.hidden;
        if (visible) {
          if (!hasPointer || now - last > 2500) { targetX = 0.62 + Math.sin(t * 0.5) * 0.2; targetY = 0.4 + Math.cos(t * 0.42) * 0.22; }
          focusX += (targetX - focusX) * 0.06; focusY += (targetY - focusY) * 0.06;
          bg.style.setProperty("--mx", (focusX * 100).toFixed(2) + "%");
          bg.style.setProperty("--my", (focusY * 100).toFixed(2) + "%");
          if (emblem) {
            ey += (((focusX - 0.5) * 24) - ey) * 0.06; ex += (((0.5 - focusY) * 18) - ex) * 0.06;
            emblem.style.setProperty("--ey", ey.toFixed(2) + "deg");
            emblem.style.setProperty("--ex", ex.toFixed(2) + "deg");
          }
          nextStreak -= dt;
          if (!streak && nextStreak <= 0) {
            streak = { x: Math.random() * w * 0.7, y: Math.random() * h * 0.4, vx: 9 + Math.random() * 5, vy: 4 + Math.random() * 3, life: 1 };
            nextStreak = 5 + Math.random() * 6;
          }
          if (streak) {
            streak.x += streak.vx; streak.y += streak.vy; streak.life -= dt * 1.1;
            if (streak.life <= 0 || streak.x > w + 40) streak = null;
          }
          draw();
          if (heroText) {
            const k = Math.min(1, sy / (hero.offsetHeight * 0.8));
            heroText.style.transform = `translate3d(0, ${sy * 0.22}px, 0)`;
            heroText.style.opacity = String(1 - k * 0.9);
          }
        }
        if (trackAnim) {
          const target = 1 + Math.min(8, Math.abs(vel) * 0.5) * (vel < 0 ? -1 : 1);
          rate += (target - rate) * 0.08;
          trackAnim.playbackRate = rate;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }

  if (!reduce && "IntersectionObserver" in window) {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-pg-reveal]"));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting || en.boundingClientRect.top < 0) {
          en.target.classList.add("is-in");
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.06 });
    items.forEach((el) => { el.classList.add("pg-reveal"); io.observe(el); });
  }
</script>

<style>
  /* ─── Hero: provenance line ─── */
  .president-provenance-line {
    max-width: 34rem;
    margin: 1.25rem 0 1.75rem;
    font-size: 0.7rem;
    line-height: 1.7;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--eden-text-muted);
  }
  .president-provenance-line span {
    display: block;
    color: var(--eden-gold);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  /* LEARN: the rim is the sticker's own silhouette used as a mask, filled with the
     holographic gradient and scaled up slightly, so it reads as a foil edge. */
  .sticker-holo-rim {
    /* Black-and-gold foil: dark lacquer bands with a travelling gold highlight. */
    background: linear-gradient(
      115deg,
      #0b0803 0%, #6e5410 14%, #d4af37 26%, #fff1bf 33%, #d4af37 40%,
      #2a1f08 52%, #0b0803 60%, #a67c00 72%, #ffe08a 80%, #6e5410 90%, #0b0803 100%
    );
    background-size: 260% 260%;
    -webkit-mask: url("/images/president_v2_cutout.webp") center / contain no-repeat;
    mask: url("/images/president_v2_cutout.webp") center / contain no-repeat;
    transform: scale(1.075);
    filter: drop-shadow(0 0 1px rgba(255, 225, 140, 0.95)) drop-shadow(0 0 10px rgba(212, 175, 55, 0.45));
    animation: sticker-holo-shift 6s ease-in-out infinite alternate;
  }
  @keyframes sticker-holo-shift {
    from { background-position: 0% 30%; }
    to { background-position: 100% 70%; }
  }
  /* The same foil, quieter, for the V2 card beside V1. */
  .v2-artwork--sticker {
    position: relative;
    display: grid;
    place-items: center;
    padding: 8% 8%;
    background:
      radial-gradient(circle at 50% 45%, rgba(166, 124, 0, 0.16), transparent 70%),
      #05080b;
  }
  .v2-artwork.v2-artwork--sticker > img,
  .v2-artwork--sticker .sticker-holo-rim {
