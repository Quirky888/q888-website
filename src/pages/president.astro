    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--eden-gold) !important;
  }
  .test-progress-count { margin-top: 0.4rem !important; font-size: clamp(1.1rem, 2vw, 1.5rem) !important; color: var(--eden-text) !important; }
  .test-progress-count strong { font-family: 'Bungee', 'Space Grotesk', sans-serif; font-weight: 800; font-size: 1.4em; }
  .test-progress-bar {
    height: 14px;
