    .president-witness-btn:hover, .test-edition:hover .v2-artwork { transform: none; }
  }

  /* Keep the edition subordinate to the campaign and its first practical test. */
  .president-v2 { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(170, 225, 232, 0.15); scroll-margin-top: 6rem; }
  .v2-overview { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .v2-context { min-width: 0; }
  .president-v2 h3 { font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.2; color: var(--eden-text); margin: 0 0 1rem; }
  .president-v2 p:not(.v2-feature-label) { font-size: 1rem; line-height: 1.7; color: var(--eden-text-muted); margin-bottom: 1rem; }
  .v2-editions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 22rem; }
  .v2-editions figure { margin: 0; min-width: 0; }
  .v2-artwork { background: #000; aspect-ratio: 4 / 5; display: grid; place-items: center; border-radius: 0.5rem; overflow: hidden; }
  .v2-artwork img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .v2-editions figcaption { padding-block: 0.75rem; font-size: 1rem; line-height: 1.5; color: var(--eden-text-muted); }
  .v2-editions figcaption strong, .v2-editions figcaption span { display: block; }
  .v2-editions figcaption strong { color: var(--eden-text); }
  .president-v2 .v2-feature-label { font-family: ui-monospace, monospace; font-size: 0.875rem; letter-spacing: 0.08em; color: var(--eden-gold); margin-bottom: 0.75rem; }
  .v2-edition-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--eden-primary); font-size: 1rem; text-underline-offset: 0.2em; }
  .v2-details { margin-top: 1rem; }
  .v2-details summary { width: fit-content; min-height: 44px; padding-block: 0.65rem; cursor: pointer; color: var(--eden-primary); font-size: 1rem; }
  .v2-edition-link:focus-visible, .v2-details summary:focus-visible { outline: 2px solid var(--eden-primary); outline-offset: 4px; }
  .v2-updates { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; margin-top: 1rem; }
  .v2-updates article { border-top: 1px solid rgba(170, 225, 232, 0.15); padding-top: 1rem; min-width: 0; }
  .v2-updates h4 { font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size: 1.125rem; line-height: 1.3; color: var(--eden-text); margin-bottom: 0.75rem; }
  @media (min-width: 900px) { .v2-overview { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); gap: 2rem; } }
  @media (min-width: 900px) { .v2-updates { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* ─── Hide nav when viewer is open ─── */
  :global(.is-viewer-open [data-slim-nav]),
  :global(.is-viewer-open [data-system-meta]),
  :global(.is-viewer-open [data-subpage-nav]),
  :global(.is-viewer-open .mobile-escape-nav) {
    display: none !important;
  }

  /* ═══════════════════════════════════════
     NATIVE <dialog> GALLERY
     ═══════════════════════════════════════ */
  .president-gallery-dialog {
    /* Reset browser defaults */
    border: none;
    padding: 0;
    margin: 0;
    outline: none;
    /* Full-screen modal */
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    /* flex column to stack controls + viewport */
    display: none; /* overridden by [open] below */
    flex-direction: column;
  }

  .president-gallery-dialog[open] {
    display: flex;
  }

  .president-gallery-dialog::backdrop {
    background: rgba(4, 7, 10, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* ─── Controls bar ─── */
  .gallery-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(170, 225, 232, 0.15);
    flex-shrink: 0;
    background: var(--eden-bg, #fcf8f9);
  }

  .gallery-ctrl-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-counter {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--eden-text-muted, #627078);
    letter-spacing: 0.1em;
    padding: 0 0.5rem;
  }

  .gallery-label {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--eden-gold, #a67c00);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0 0.5rem;
  }

  .gallery-btn {
    background: rgba(170, 225, 232, 0.05);
    border: 1px solid rgba(170, 225, 232, 0.15);
    color: var(--eden-text, #134252);
    width: 44px;
    height: 44px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    flex-shrink: 0;
  }

  .gallery-btn:hover {
    background: rgba(170, 225, 232, 0.1);
    border-color: rgba(170, 225, 232, 0.3);
    color: var(--eden-primary, #208c8d);
    transform: translateY(-1px);
  }

  .gallery-btn[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }

  .gallery-close {
    background: rgba(220, 60, 60, 0.08);
    border-color: rgba(220, 60, 60, 0.2);
    color: #dc3c3c;
  }

  .gallery-close:hover {
    background: #dc3c3c;
    border-color: #dc3c3c;
    color: #fff;
  }

  /* ─── Image viewport ─── */
  .gallery-viewport {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    border-top: none;
    background: rgba(170, 225, 232, 0.03);
  }

  .gallery-img-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
    transform-origin: center;
    transition: transform 0.1s ease-out;
  }

  .gallery-img {
    max-width: 96%;
    max-height: 96%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
    border-radius: 4px;
  }

  /* ─── Zoom pill ─── */
  .gallery-zoom-pill {
    position: absolute;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    background: rgba(170, 225, 232, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 30px;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10;
  }

  .gallery-zoom-pill.show { opacity: 1; }

  /* ─── Base theme variables ─── */
  .president-eden-wrap {
    --eden-bg: #06090c;
    --eden-text: #e9f1f2;
    --eden-text-muted: #94a6ab;
    --eden-primary: #3fd3d4;
    --eden-gold: #e2b93b;
    --eden-gold-bright: #ffcc33;
    --eden-surface: #0d1318;
    --eden-line: rgba(170, 225, 232, 0.14);
    position: relative;
    min-height: 100dvh;
    background: var(--eden-bg);
  }

  /* ─── HERO ─── */
  .president-hero {
    overflow-x: clip;
    padding: 3rem 0 0;
  }

  .president-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: 58dvh;
    padding-block: 2rem;
  }

  /* ─── Hero: dark, alive ─── */
  .president-hero {
    position: relative;
    isolation: isolate;
    padding: 3rem 0 0;
    background: #04070a;
  }
  .president-hero-inner { min-height: 76dvh; padding-block: 2.5rem 3.5rem; }
  .president-hero-text { position: relative; z-index: 1; }
  .president-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    --mx: 68%;
    --my: 38%;
  }
  .hero-aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
  }
  .hero-aurora--teal {
    width: 46rem; height: 34rem; left: -12rem; top: -10rem;
    background: radial-gradient(closest-side, rgba(63, 211, 212, 0.55), transparent);
    animation: aurora-a 22s ease-in-out infinite alternate;
  }
  @keyframes aurora-a { to { transform: translate3d(14rem, 9rem, 0) scale(1.15); } }
  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(26rem circle at var(--mx) var(--my), rgba(63, 211, 212, 0.1), transparent 70%);
  }
  .president-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.6rem;
    background: none;
    -webkit-text-fill-color: currentColor;
    color: var(--eden-gold-bright);
    animation: none;
    font-size: clamp(0.7rem, 1.1vw, 0.9rem);
  }
  .president-eyebrow::before {
    content: "";
    width: 2.6rem;
    height: 1px;
    background: currentColor;
  }
  .president-status-block {
    display: grid;
    gap: 0.1rem;
    width: fit-content;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--eden-line);
    border-left: 2px solid var(--eden-primary);
    border-radius: 0 10px 10px 0;
    background: rgba(255, 255, 255, 0.03);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .president-status-block > div::before { content: "› "; color: var(--eden-primary); }
  .hud-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.12em;
    background: var(--eden-primary);
    animation: hud-blink 1.1s steps(1) infinite;
  }
  @keyframes hud-blink { 50% { opacity: 0; } }
  .president-ticker {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-block: 1px solid var(--eden-line);
    background: rgba(4, 7, 10, 0.7);
  }
  .president-ticker-track { display: flex; width: max-content; animation: ticker-run 38s linear infinite; }
  .president-ticker-group { display: flex; flex: none; }
  .president-ticker-group span {
    padding: 0.85rem 1.6rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--eden-text-muted);
    white-space: nowrap;
  }
  .president-ticker-group span::after { content: "✦"; margin-left: 1.6rem; color: var(--eden-gold); }
  @keyframes ticker-run { to { transform: translateX(-50%); } }
  .president-hairline {
    height: 1px;
    margin: 0;
    border: 0;
    background: linear-gradient(90deg, transparent, var(--eden-line), var(--eden-primary), var(--eden-line), transparent);
    opacity: 0.6;
  }
  /* Scroll reveal: hidden only after the script has run, so no-JS and anchor jumps stay visible. */
  :global(.pg-reveal) { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 0.84, 0.24, 1); }
  :global(.pg-reveal.is-in) { opacity: 1; transform: none; }
  :global(.pg-reveal .president-h2) { clip-path: inset(0 100% 0 0); transition: clip-path 1s cubic-bezier(0.7, 0, 0.2, 1) 0.15s; }
  :global(.pg-reveal.is-in .president-h2) { clip-path: inset(0 0 0 0); }
  :global(.pg-reveal .president-rule-card),
  :global(.pg-reveal .test-edition) { opacity: 0; transform: translateY(34px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 0.84, 0.24, 1); }
  :global(.pg-reveal.is-in .president-rule-card),
  :global(.pg-reveal.is-in .test-edition) { opacity: 1; transform: none; }
  :global(.pg-reveal.is-in .president-rule-card:nth-child(2)),
  :global(.pg-reveal.is-in .test-edition:nth-child(2)) { transition-delay: 0.12s; }
  :global(.pg-reveal.is-in .president-rule-card:nth-child(3)) { transition-delay: 0.24s; }
  :global(.pg-reveal.is-in .president-rule-card:nth-child(4)) { transition-delay: 0.36s; }
  @media (prefers-reduced-motion: reduce) {
    .hl-char { animation: none; transform: none; }
    .hero-aurora, .president-ticker-track, .hud-cursor { animation: none; }
    :global(.pg-reveal), :global(.pg-reveal .president-h2), :global(.pg-reveal .president-rule-card), :global(.pg-reveal .test-edition) { opacity: 1; transform: none; clip-path: none; transition: none; }
  }

  /* ─── Cosmic hero: stars + seal ─── */
  .hero-stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-emblem {
    position: absolute;
    z-index: 0;
    right: max(-4rem, calc(50% - 40rem));
    top: 50%;
    width: clamp(19rem, 50vw, 42rem);
    aspect-ratio: 1;
    margin-top: calc(clamp(19rem, 50vw, 42rem) / -2);
    pointer-events: none;
    transform: perspective(1000px) rotateX(var(--ex, 0deg)) rotateY(var(--ey, 0deg));
    will-change: transform;
  }
  .hero-emblem svg { width: 100%; height: 100%; overflow: visible; }
  .hero-emblem svg > * { transform-origin: 300px 300px; transform-box: view-box; }
  .emblem-ticks line { stroke: rgba(255, 204, 51, 0.55); stroke-width: 1.2; }
  .emblem-text text { font-family: 'Space Mono', ui-monospace, monospace; font-size: 17px; font-weight: 700; fill: rgba(255, 204, 51, 0.6); }
  .emblem-text { animation: emblem-spin 140s linear infinite; }
  .emblem-ring { stroke: rgba(63, 211, 212, 0.35); stroke-width: 1; }
  .emblem-ring--a { stroke-dasharray: 2 9; stroke: rgba(255, 204, 51, 0.5); }
  .emblem-ring--c { stroke-dasharray: 1 6; }
  .emblem-orbit--a { animation: emblem-spin 46s linear infinite; }
  .emblem-orbit--b { animation: emblem-spin 30s linear infinite reverse; }
  .emblem-orbit--c { animation: emblem-spin 18s linear infinite; }
  .moon--teal { fill: #3fd3d4; }
  .moon--gold { fill: #ffcc33; }
  .moon--white { fill: #e9f1f2; }
  .planet-ring { stroke: rgba(255, 224, 138, 0.9); stroke-width: 3; fill: none; }
  .planet-ring--back { opacity: 0.45; }
  .hero-emblem svg > .emblem-square-orbit { transform-origin: 300px 300px; }
  .square-orbit-track { fill: none; stroke: rgba(255, 157, 226, 0.28); stroke-width: 1; stroke-dasharray: 3 7; }
  .square-spin { animation: square-turn 12s linear infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes square-turn { to { transform: rotate(392deg); } }
  .emblem-planet { animation: planet-bob 9s ease-in-out infinite alternate; }
  @keyframes emblem-spin { to { transform: rotate(360deg); } }
  @keyframes planet-bob { to { transform: translateY(-8px); } }
  @media (max-width: 900px) {
    .hero-emblem { right: -32%; width: 28rem; margin-top: -14rem; opacity: 0.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .emblem-text, .emblem-orbit--a, .emblem-orbit--b, .emblem-orbit--c, .emblem-planet, .square-spin { animation: none; }
  }

  /* ─── Hero text ─── */
  .president-eyebrow {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(0.75rem, 1.2vw, 1rem);
    font-weight: 700;
    color: var(--eden-gold);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    margin: 0 0 1.25rem 0;
    background: linear-gradient(to right, #a67c00 20%, #ffcc33 50%, #a67c00 80%);
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: president-gold-shine 5s linear infinite;
  }

  .president-headline {
    margin: 0 0 2.25rem;
    font-family: 'Bricolage Grotesque', 'Arial Narrow', Arial, sans-serif;
    font-variation-settings: "wdth" 78;
    font-size: clamp(3rem, min(14.5vw, 25dvh), 10.5rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
  .hl-line {
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
    padding: 0.04em 0 0.1em;
    white-space: pre;
  }
  .hl-space { display: inline-block; width: 0.24em; flex: none; }
  .hl-char {
    display: inline-block;
    color: #e9f1f2;
    transform: translateY(112%);
    animation: hl-rise 0.9s cubic-bezier(0.16, 0.84, 0.24, 1) calc(0.1s + var(--i) * 32ms) forwards;
  }
  @keyframes hl-rise { to { transform: translateY(0); } }

  @keyframes president-gold-shine {
    to { background-position: 0% center; }
  }

  .president-status-block {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(0.7rem, 1.1vw, 0.9rem);
    line-height: 1.8;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--eden-text-muted);
    border-left: 2px solid var(--eden-primary);
    padding-left: 1rem;
  }

  .narmail-mono {
    font-family: 'Space Mono', ui-monospace, monospace;
  }

  /* ─── Cosmic dividers ─── */


  /* ─── Main content layout ─── */
  .president-main-content {
    max-width: 72rem;
    margin: 0 auto;
  }

  .president-section {
    padding: 4rem 0;
    border-bottom: 1px solid rgba(170, 225, 232, 0.1);
  }

  .president-section:last-of-type {
    border-bottom: none;
  }

  /* ─── Section headings ─── */
  .president-h2 {
    font-family: 'Bricolage Grotesque', 'Arial Narrow', Arial, sans-serif;
    font-variation-settings: "wdth" 84;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 800;
    color: var(--eden-text);
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  /* Section index, counted by CSS: 01 /, 02 / ... */
  .president-main-content { counter-reset: pg-sec; }
  .president-section > .president-h2::before {
    counter-increment: pg-sec;
    content: "0" counter(pg-sec) " /";
    display: block;
    margin-bottom: 0.9rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-variation-settings: normal;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--eden-gold);
  }

  .president-h3 {
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    font-weight: 700;
    color: var(--eden-text);
    margin: 2.5rem 0 1rem 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ─── Lead / body text ─── */
  .president-lead {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.6rem, 3.2vw, 2.8rem);
    font-weight: 400;
    line-height: 1.22;
    max-width: 52rem;
    color: var(--eden-text);
    margin: 0;
  }

  .president-section .president-lead {
    font-size: clamp(1.6rem, 3.2vw, 2.8rem);
    line-height: 1.22;
  }
  .president-section p {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    line-height: 1.65;
    color: var(--eden-text);
    margin: 0 0 1.5rem 0;
  }

  /* ─── Human × AI authorship declaration ─── */
  .president-authorship-section {
    position: relative;
    margin: 1rem 0 4rem;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(32, 140, 141, 0.09) 1px, transparent 1px),
      linear-gradient(rgba(32, 140, 141, 0.09) 1px, transparent 1px),
      var(--eden-surface);
    background-size: 24px 24px;
    border: 1px solid rgba(170, 225, 232, 0.2);
    border-top: 5px solid var(--eden-text);
    box-shadow: 12px 12px 0 rgba(32, 140, 141, 0.12);
  }

  .president-authorship-section::after {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 5rem;
    aspect-ratio: 1;
    opacity: 0.65;
    background:
      linear-gradient(45deg, transparent 44%, var(--eden-gold) 45% 55%, transparent 56%),
      linear-gradient(-45deg, transparent 44%, var(--eden-primary) 45% 55%, transparent 56%);
    content: '';
    pointer-events: none;
    transform: rotate(8deg);
  }

  .authorship-eyebrow {
    position: relative;
    z-index: 1;
    max-width: calc(100% - 6rem);
    margin: 0 0 1rem;
    color: var(--eden-gold);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(0.66rem, 1vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .authorship-heading {
    position: relative;
    z-index: 1;
    max-width: 48rem;
    margin-bottom: 1.25rem;
  }

  .authorship-introduction {
    position: relative;
    z-index: 1;
    max-width: 58rem;
    margin: 0 0 2.25rem;
    color: var(--eden-text);
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.05rem, 1.7vw, 1.42rem);
    line-height: 1.65;
  }

  .authorship-voices {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .authorship-voice {
    min-width: 0;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    background: rgba(255, 255, 255, 0.045);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(170, 225, 232, 0.2);
  }

  .authorship-voice.is-human {
    border-left: 5px solid var(--eden-gold);
    transform: rotate(-0.35deg);
  }

  .authorship-voice.is-machine {
    border-left: 5px solid var(--eden-primary);
    transform: translateY(0.8rem) rotate(0.35deg);
  }

  .authorship-voice-header {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .authorship-speaker {
    color: var(--eden-text);
    font-family: 'Bricolage Grotesque', 'Arial Narrow', Arial, sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.45rem);
    line-height: 1;
  }

  /*
   * DNA: “CHATGPT” is the familiar conversational name, while the changing
   * faces reveal the wider AI chorus without adding another explanatory block.
   * The sizer keeps the card still as names of different lengths pass through.
   */
  .ai-collective-reveal {
    position: relative;
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--eden-text);
    cursor: help;
    outline: none;
  }

  .ai-collective-name {
    position: relative;
    display: inline-grid;
    border-bottom: 1px dashed rgba(32, 140, 141, 0.65);
  }

  .ai-name-sizer {
    visibility: hidden;
    grid-area: 1 / 1;
  }

  .ai-name-base,
  .ai-name-chorus,
  .ai-name-alias {
    position: absolute;
    inset: 0;
  }

  .ai-name-base {
    transition:
      opacity 180ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-name-alias {
    display: flex;
    align-items: center;
    opacity: 0;
    color: var(--eden-primary);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.82em;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .ai-name-alias:nth-child(2) {
    color: var(--eden-gold);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    letter-spacing: 0;
  }

  .ai-name-alias:nth-child(3) {
    color: var(--eden-text);
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -0.06em;
  }

  .ai-name-alias:nth-child(4) {
    color: var(--eden-primary);
    font-family: 'Bricolage Grotesque', 'Arial Narrow', Arial, sans-serif;
    font-size: 0.66em;
    letter-spacing: 0;
  }

  .ai-collective-hint {
    color: var(--eden-primary);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.9;
  }

  .ai-collective-note {
    position: absolute;
    z-index: 4;
    top: calc(100% + 0.65rem);
    left: 0;
    width: min(26rem, calc(100vw - 7rem));
    padding: 0.72rem 0.85rem;
    opacity: 0;
    color: var(--eden-text);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.5;
    background: var(--eden-surface);
    border: 1px solid var(--eden-primary);
    box-shadow: 5px 5px 0 rgba(32, 140, 141, 0.15);
    pointer-events: none;
    transform: translateY(-0.25rem);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-collective-reveal:hover .ai-name-base,
  .ai-collective-reveal:focus .ai-name-base {
    opacity: 0;
    transform: translateY(-0.18em);
  }

  .ai-collective-reveal:hover .ai-name-alias,
  .ai-collective-reveal:focus .ai-name-alias {
    animation: ai-collective-cycle 4.8s steps(1, end) infinite;
    animation-delay: calc(var(--alias-index) * 1.2s);
  }

  .ai-collective-reveal:hover .ai-collective-note,
  .ai-collective-reveal:focus .ai-collective-note {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-collective-reveal:focus-visible {
    border-radius: 0.1rem;
    outline: 2px solid var(--eden-primary);
    outline-offset: 0.25rem;
  }

  @keyframes ai-collective-cycle {
    0%,
    24.99% {
      opacity: 1;
    }

    25%,
    100% {
      opacity: 0;
    }
  }

  .authorship-role {
    color: var(--eden-text-muted);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.5;
  }

  .authorship-voice p {
    margin: 0;
    color: var(--eden-text);
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.7;
  }

  .authorship-provenance {
    position: relative;
    z-index: 1;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed rgba(170, 225, 232, 0.35);
  }

  .authorship-provenance > h3 {
    margin: 0 0 1rem;
    color: var(--eden-text);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .provenance-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .provenance-entry {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(170, 225, 232, 0.14);
  }

  .provenance-entry-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }

  .provenance-entry h4 {
    margin: 0;
    color: var(--eden-text);
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
  }

  .provenance-entry-heading span {
    padding: 0.2rem 0.45rem;
    color: var(--eden-primary);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(32, 140, 141, 0.08);
    border: 1px solid rgba(32, 140, 141, 0.22);
  }

  .provenance-entry p {
    margin: 0;
    color: var(--eden-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .authorship-closing {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    margin: 2.25rem 0 0;
    padding-left: 1rem;
    color: var(--eden-text);
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.55;
    border-left: 4px solid var(--eden-gold-bright);
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-name-base {
      transition: none;
    }

    .ai-collective-reveal:hover .ai-name-alias,
    .ai-collective-reveal:focus .ai-name-alias {
      animation: none;
    }

    .ai-collective-reveal:hover .ai-name-alias:last-child,
    .ai-collective-reveal:focus .ai-name-alias:last-child {
      opacity: 1;
    }
  }

  .president-note {
    font-style: italic;
    font-size: clamp(0.85rem, 1.1vw, 1rem) !important;
    color: var(--eden-text-muted) !important;
  }

  /* ─── Two-column layout for "What is this" ─── */
  .president-two-col {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  .president-two-col-text {
    min-width: 0;
  }

  /* ─── Mini portal (inline image) ─── */
  .president-mini-portal {
    width: 200px;
    aspect-ratio: 1 / 1;
    border-radius: 45% 55% 52% 48% / 48% 44% 56% 52%;
    overflow: hidden;
    box-shadow:
      0 0 0 2px rgba(32, 140, 141, 0.2),
      0 0 20px rgba(32, 140, 141, 0.2),
      0 8px 32px rgba(0, 0, 0, 0.38);
    transition: all 0.4s ease;
    flex-shrink: 0;
  }

  .president-mini-portal:hover {
    border-radius: 38% 62% 46% 54% / 56% 44% 60% 40%;
    box-shadow:
      0 0 0 2px rgba(32, 140, 141, 0.4),
      0 0 35px rgba(32, 140, 141, 0.35),
      0 8px 40px rgba(0, 0, 0, 0.62);
  }

  .president-mini-portal img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── List ─── */
  .president-list {
    list-style: none;
    margin: 0 0 1.5rem 0;
    padding: 0;
  }

  .president-list li {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    line-height: 1.5;
    color: var(--eden-text);
    margin-bottom: 0.75rem;
    padding-left: 2.25rem;
    position: relative;
  }

  .president-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    background: linear-gradient(
      to right,
      #a67c00 20%,
      #ce9e00 40%,
      #ffcc33 50%,
      #ce9e00 60%,
      #a67c00 80%
    );
    background-size: 200% auto;
    background-position: 0% center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: president-gold-shine 8s linear infinite;
  }

  /* ─── Blockquote ─── */
  .president-blockquote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--eden-text);
    margin: 1.5rem 0;
    padding: 1.25rem 0 1.25rem 2rem;
    border-left: 3px solid var(--eden-primary);
  }

  /* ─── Sticker strip ─── */





  @keyframes chip-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-6px); }
  }

  /* ─── Rules: campaign platform cards ─── */
  .president-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2.5rem 2.75rem;
    margin-top: 1.5rem;
  }

  .president-rule-card {
    position: relative;
    padding: 1.4rem 0 0.4rem;
    background: none;
    border: 0;
    border-top: 1px solid var(--eden-line);
    border-radius: 0;
    isolation: isolate;
    transition: transform 0.45s cubic-bezier(0.16, 0.84, 0.24, 1);
  }
  /* Top rule that draws itself in teal on hover. */
  .president-rule-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--eden-primary), var(--eden-gold-bright));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.7, 0, 0.2, 1);
  }
  /* Soft light that follows the pointer inside the card. */
  .president-rule-card::after {
    content: '';
    position: absolute;
    inset: -1px -1.2rem 0;
    z-index: -1;
    background: radial-gradient(18rem circle at var(--cx, 50%) var(--cy, 0%), rgba(63, 211, 212, 0.09), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .president-rule-card:hover { transform: translateY(-4px); }
  .president-rule-card:hover::before { transform: scaleX(1); }
  .president-rule-card:hover::after { opacity: 1; }

  .rule-number {
    display: block;
    margin-bottom: 1rem;
    font-family: 'Bricolage Grotesque', 'Arial Narrow', Arial, sans-serif;
    font-variation-settings: "wdth" 80;
    font-size: clamp(3.4rem, 6vw, 5.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 204, 51, 0.7);
    transition: color 0.5s ease, -webkit-text-stroke-color 0.5s ease;
  }
  .president-rule-card:hover .rule-number { color: rgba(255, 204, 51, 0.92); -webkit-text-stroke-color: transparent; }
  .rule-article {
    display: block;
    margin-bottom: 0.6rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-variation-settings: normal;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    -webkit-text-stroke: 0;
    color: var(--eden-primary);
  }

  .president-rule-card p {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem) !important;
    margin: 0 !important;
    line-height: 1.65 !important;
  }

  /* ─── Artwork card ─── */
  .president-artwork-card-section {
    padding: 2rem 0 4rem;
  }

  .artwork-info-card.president-glass {
    position: relative;
    background: var(--eden-surface);
    border: 1px solid rgba(170, 225, 232, 0.12);
    border-radius: 24px;
    max-width: 960px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: 
      0 4px 24px rgba(0, 0, 0, 0.1),
      0 20px 48px rgba(0, 0, 0, 0.15);
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .artwork-info-card.president-glass:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.2),
      0 28px 64px rgba(0, 0, 0, 0.3);
    border-color: rgba(32, 140, 141, 0.3);
  }

  /* Secure Double Gold Border on Certificate Card */
  .certificate-secure-border {
    position: absolute;
    inset: 6px;
    border: 3px double rgba(206, 158, 0, 0.4);
    border-radius: 18px;
    pointer-events: none;
    z-index: 4;
  }

  /* Safe-Deposit corner brackets */
  .certificate-corner-brackets {
    position: absolute;
    inset: 14px;
    border: 1px dashed rgba(32, 140, 141, 0.15);
    border-radius: 12px;
    pointer-events: none;
    z-index: 4;
  }

  /* Star ornaments at corners! */
  .certificate-corner-brackets::before {
    content: '✦';
    position: absolute;
    top: -6px;
    left: -4px;
    font-size: 0.8rem;
    color: #ce9e00;
  }

  .certificate-corner-brackets::after {
    content: '✦';
    position: absolute;
    bottom: -6px;
    right: -4px;
    font-size: 0.8rem;
    color: #ce9e00;
  }

  .artwork-card-content {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding: 4rem 3.5rem;
  }

  /* Left Side: Gilded Certificate Frame */
  .artwork-stamp-frame {
    flex-shrink: 0;
    width: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .postage-stamp {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fdfcfb;
    padding: 12px;
    border: 1px solid rgba(170, 225, 232, 0.12);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.15),
      0 2px 6px rgba(0, 0, 0, 0.03);
    border-radius: 2px;
