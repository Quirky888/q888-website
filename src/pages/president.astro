    transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .president-witness-btn:hover::before { transform: translateX(0); }
  .president-witness-btn > span { display: inline-block; transition: transform 0.35s cubic-bezier(0.16, 0.84, 0.24, 1); }
  .president-witness-btn:hover > span { transform: translateY(3px); }
  .president-witness-btn:focus-visible { outline: 2px solid var(--eden-gold); outline-offset: 4px; }

  .president-test { scroll-margin-top: 5rem; }
  .test-progress {
    margin: 2rem 0;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgba(170, 225, 232, 0.15);
    border-left: 4px solid var(--eden-gold);
    border-radius: 0 12px 12px 0;
    background: rgba(255, 204, 51, 0.06);
