  .test-edition { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .test-edition .v2-artwork { transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .test-edition:hover .v2-artwork { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5); }
  .test-edition:focus-visible { outline: 2px solid var(--eden-primary); outline-offset: 4px; border-radius: 0.5rem; }
  .test-edition p { margin: 0 !important; }
  .test-edition-label { margin-top: 0.75rem !important; font-weight: 700; color: var(--eden-text) !important; }
  .test-edition-meta { font-size: 0.9rem !important; line-height: 1.5 !important; color: var(--eden-text-muted) !important; }
  .test-edition-link { display: inline-flex; min-height: 44px; align-items: center; color: var(--eden-primary); font-weight: 700; }

  .test-verdict { margin-top: 2.5rem; }
  .test-verdict-closing { font-size: clamp(1.05rem, 1.6vw, 1.3rem) !important; color: var(--eden-text) !important; }

  /* ─── Rules as a ballot paper ─── */
  .ballot-kicker {
    margin: 0 0 0.75rem !important;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.8rem !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--eden-gold) !important;
