        </div>
      </div>

      <!-- Large hero carton image -->
      <div class="dyno-hero-carton-wrap">
        <img
          src="/images/IMG_6177Dyno.webp"
          alt="DYNO MILK flagship carton"
          class="zero-g-float dyno-hero-carton"
