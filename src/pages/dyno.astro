<script>
  /* ══════════════════════════════════════════════════════════════
     DYNO MILK — Zero-Gravity Physics + Interactions
     All logic runs after DOM ready; cleaned up on Astro page swap.
  ══════════════════════════════════════════════════════════════ */

  // ── LocalStorage Key ──
  const SLOT_KEY = "dyno-milk-claimed";
  const MAX_SLOTS = 10;

  // ── Utility ──
  function clamp(val: number, min: number, max: number) {
    return Math.min(Math.max(val, min), max);
  }

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  // ── Zero-Gravity Float Engine ──
  // Pure rAF-based, no GSAP needed — lightweight and efficient.
  interface FloatEl {
    el: HTMLElement;
    driftX: number;
    driftY: number;
    driftRot: number;
    idlePhasX: number;
    idlePhasY: number;
    idlePhasR: number;
    idleSpeedX: number;
    idleSpeedY: number;
    idleSpeedR: number;
    idleAmpX: number;
    idleAmpY: number;
    idleAmpR: number;
    scrollDx: number;
    scrollDy: number;
    scrollDr: number;
  }

  let floatEls: FloatEl[] = [];
  let rafId: number | null = null;
  let scrollY = 0;
  let targetScrollY = 0;
  let reducedMotion = false;

  function initZeroGravity() {
    reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reducedMotion) return;

    const isMobile = window.innerWidth <= 768;
    const driftScale = isMobile ? 0.3 : 1;

    const els = document.querySelectorAll<HTMLElement>(".zero-g-float");
    floatEls = Array.from(els).map((el, i) => {
      const seed = i * 137.508; // golden angle spread
      return {
        el,
        driftX: parseFloat(el.dataset.driftX || "20") * driftScale,
        driftY: parseFloat(el.dataset.driftY || "15") * driftScale,
        driftRot: parseFloat(el.dataset.driftRot || "5") * driftScale,
        idlePhasX: seed,
        idlePhasY: seed * 1.3,
        idlePhasR: seed * 0.7,
        idleSpeedX: 0.0004 + (i % 5) * 0.00008,
        idleSpeedY: 0.0003 + (i % 4) * 0.00009,
        idleSpeedR: 0.00025 + (i % 3) * 0.0001,
        idleAmpX: 12 + (i % 4) * 5,
        idleAmpY: 8 + (i % 5) * 4,
        idleAmpR: 2 + (i % 3) * 1.5,
        scrollDx: 0,
        scrollDy: 0,
        scrollDr: 0,
      };
    });

    window.addEventListener("scroll", onScroll, { passive: true });
    rafId = requestAnimationFrame(tick);
  }

  function onScroll() {
    targetScrollY = window.scrollY;
  }

  function tick(now: number) {
    // Smooth scroll lerp
    scrollY = lerp(scrollY, targetScrollY, 0.06);
    const scrollFrac =
      scrollY / (document.body.scrollHeight - window.innerHeight || 1);

    floatEls.forEach((f) => {
      // Idle sine wave float
      const idleX = Math.sin(now * f.idleSpeedX + f.idlePhasX) * f.idleAmpX;
      const idleY = Math.cos(now * f.idleSpeedY + f.idlePhasY) * f.idleAmpY;
      const idleR = Math.sin(now * f.idleSpeedR + f.idlePhasR) * f.idleAmpR;

      // Scroll-driven drift (parallax-like)
      const scrollX = scrollFrac * f.driftX;
      const scrollY2 = scrollFrac * f.driftY;
      const scrollR = scrollFrac * f.driftRot;

      const tx = idleX + scrollX;
      const ty = idleY + scrollY2;
      const tr = idleR + scrollR;

      f.el.style.transform = `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px) rotate(${tr.toFixed(2)}deg)`;
    });

    rafId = requestAnimationFrame(tick);
  }

  function destroyZeroGravity() {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
    window.removeEventListener("scroll", onScroll);
    floatEls.forEach((f) => {
      f.el.style.transform = "";
    });
    floatEls = [];
  }

  // ── Diagonal Split Hover Glitch ──
  function initSplitGlitch() {
    if (window.innerWidth <= 768) return; // Disable hover glitch dependency on mobile

    const arenaEl = document.getElementById("dyno-split-arena");
    const anarchyPanel = document.getElementById("dyno-panel-anarchy");
    const sexypunkPanel = document.getElementById("dyno-panel-sexypunk");
    const glitchAnarchy = document.getElementById("dyno-glitch-anarchy");
    const glitchSexypunk = document.getElementById("dyno-glitch-sexypunk");
    if (!arenaEl || !anarchyPanel || !sexypunkPanel) return;

    anarchyPanel.addEventListener("mouseenter", () => {
      glitchSexypunk?.classList.add("is-glitching");
    });
    anarchyPanel.addEventListener("mouseleave", () => {
      glitchSexypunk?.classList.remove("is-glitching");
    });

    sexypunkPanel.addEventListener("mouseenter", () => {
      glitchAnarchy?.classList.add("is-glitching");
    });
    sexypunkPanel.addEventListener("mouseleave", () => {
      glitchAnarchy?.classList.remove("is-glitching");
    });
  }

  // ── Mandatory Checkbox + Application Logic ──
  function initCheckout() {
    const checkbox = document.getElementById(
      "dyno-confirm-checkbox",
    ) as HTMLInputElement | null;
    const warning = document.getElementById("dyno-checkbox-warning");
    const applyBtn = document.getElementById(
      "dyno-apply-btn",
    ) as HTMLAnchorElement | null;
    const buyT2 = document.getElementById(
      "dyno-buy-tier2",
    ) as HTMLButtonElement | null;
    const btnText = document.getElementById("dyno-btn-t1-text");

    if (!checkbox) return;

    function updateButtonState() {
      const isChecked = checkbox!.checked;

      // Tier 2 unlocks on checkbox
      if (buyT2) buyT2.disabled = !isChecked;

      if (!isChecked) {
        // Apply button: locked state
        if (applyBtn) {
          applyBtn.setAttribute("aria-disabled", "true");
          applyBtn.setAttribute("tabindex", "-1");
          applyBtn.classList.remove("is-unlocked");
        }
        if (btnText) btnText.textContent = "CONFIRM NET WORTH TO APPLY";
        warning?.classList.remove("hidden");
      } else {
        // Apply button: unlocked — real mailto link is already in href
        if (applyBtn) {
          applyBtn.removeAttribute("aria-disabled");
          applyBtn.setAttribute("tabindex", "0");
          applyBtn.classList.add("is-unlocked");
        }
        if (btnText) btnText.textContent = "APPLY FOR VISIONARY ALLOCATION →";
        warning?.classList.add("hidden");
      }
    }

    // Intercept clicks when locked
    applyBtn?.addEventListener("click", (e) => {
      if (!checkbox.checked) {
        e.preventDefault();
        // Shake the checkbox section to guide user
        document
          .getElementById("dyno-checkbox-section")
          ?.classList.add("is-shaking");
        setTimeout(() => {
          document
            .getElementById("dyno-checkbox-section")
            ?.classList.remove("is-shaking");
        }, 600);
      }
    });

    buyT2?.addEventListener("click", () => {
      if (!checkbox.checked) return;
      window.location.href =
        "mailto:hello@q888.space?subject=DYNO%20MILK%20OPEN%20EDITION";
    });

    checkbox.addEventListener("change", updateButtonState);
    updateButtonState();
  }

  // ── Entry Banner Animation ──
  function initEntryBanner() {
    const banner = document.getElementById("dyno-entry-banner");
    if (!banner) return;
    // Already animated via CSS, just add the visible class after short delay
    setTimeout(() => banner.classList.add("is-visible"), 100);
  }

  // ── Master init ──
  function init() {
    initZeroGravity();
    initSplitGlitch();
    initCheckout();
    initEntryBanner();
  }

  function cleanup() {
    destroyZeroGravity();
    document.removeEventListener("astro:before-swap", cleanup);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", cleanup);
</script>

