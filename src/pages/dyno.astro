  }

  .dyno-punk-headline {
    color: var(--dyno-green);
    text-shadow: 0 0 30px rgba(57, 255, 20, 0.4);
  }

  .dyno-punk-headline em {
    color: var(--dyno-cyan);
    font-style: normal;
    text-shadow: 0 0 20px rgba(0, 200, 255, 0.5);
    font-size: 0.7em;
  }

  /* Shape-outside text wrap */
  .dyno-shape-wrap-container {
    overflow: hidden; /* BFC for float */
  }

  .dyno-shape-img {
    height: auto;
    margin-bottom: 3rem;
    border-radius: 4px;
  }

  .dyno-wrap-left .dyno-shape-img {
    float: left;
    margin-right: 1.5rem;
    shape-outside: polygon(5% 0%, 95% 0%, 100% 92%, 85% 100%, 15% 100%, 0% 92%);
    shape-margin: 1rem;
    width: clamp(120px, 45vw, 220px);
  }

  .dyno-wrap-right .dyno-shape-img {
    float: right;
    margin-left: 1.5rem;
    shape-outside: polygon(3% 5%, 97% 0%, 100% 90%, 80% 100%, 20% 100%, 0% 88%);
    shape-margin: 1rem;
    width: clamp(120px, 45vw, 220px);
  }

  @media (max-width: 768px) {
    .dyno-wrap-left .dyno-shape-img {
      margin-right: 1rem;
      shape-margin: 0.5rem;
    }
    .dyno-wrap-right .dyno-shape-img {
      margin-left: 1rem;
      shape-margin: 0.5rem;
    }
  }

  .dyno-flex-container {
    clear: both;
    border-top: 1px dashed rgba(255, 255, 255, 0.2);
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .dyno-vibe-label,
  .dyno-flex-label {
    font-family: "Syne Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--dyno-muted);
    margin: 1.5rem 0 0.5rem;
  }

  .dyno-body-text {
    font-size: clamp(1.2rem, 2.5vw, 2.5rem);
    line-height: 1.15;
    font-weight: 700;
    color: var(--dyno-white);
    margin: 0 0 0.75rem;
  }

  .dyno-gold-text {
    background: linear-gradient(
      to right,
      #d4af37 10%,
      #ffdf73 40%,
      #fffae6 50%,
      #ffdf73 60%,
      #d4af37 90%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: dyno-gold-shine 6s linear infinite;
    filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.3));
  }

  @keyframes dyno-gold-shine {
    to {
      background-position: 200% center;
    }
  }

  .dyno-body-text em {
    font-style: italic;
    color: var(--dyno-yellow);
  }

  .dyno-quote-text {
    border-left: 2px solid var(--dyno-pink);
    padding-left: 1rem;
    color: rgba(240, 232, 255, 0.8);
  }

  .dyno-pulp-text {
    font-style: italic;
    color: var(--dyno-muted);
    font-size: 0.95em;
  }

  .dyno-edition-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .dyno-spec {
    font-family: "VT323", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--dyno-pink);
    border: 1px solid rgba(255, 45, 120, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: rgba(255, 45, 120, 0.05);
  }

  .dyno-spec-alt {
    color: var(--dyno-green);
    border-color: rgba(57, 255, 20, 0.3);
    background: rgba(57, 255, 20, 0.05);
  }

  /* ══════════════════════════════════════════════════════
     WEALTH TRAP
  ══════════════════════════════════════════════════════ */
  .dyno-wealth {
    position: relative;
    padding: 6rem 1.5rem;
    background: var(--dyno-bg);
    overflow: hidden;
  }

  .dyno-wealth::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 50% at 50% 30%,
      rgba(255, 230, 0, 0.06) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .dyno-wealth-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    text-align: center;
  }

  .dyno-wealth-headline {
    color: var(--dyno-yellow);
    text-shadow: 0 0 30px rgba(255, 230, 0, 0.35);
  }

  .dyno-wealth-collage {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Floating image overlaps — absolute positioning for collage effect */
  .dyno-wealth-float {
    position: absolute;
    pointer-events: none;
    height: auto;
    z-index: 1;
    border-radius: 4px;
  }

  .dyno-wealth-float-1 {
    top: -3rem;
    right: -2rem;
    width: clamp(120px, 18vw, 250px);
    opacity: 0.9;
    filter: drop-shadow(0 0 20px rgba(255, 230, 0, 0.4));
    z-index: 3;
  }

  .dyno-wealth-float-2 {
    bottom: 30%;
    left: -2rem;
    width: clamp(100px, 14vw, 200px);
    opacity: 0.7;
    z-index: 2;
  }

  .dyno-wealth-float-3 {
    bottom: -2rem;
    right: 5%;
    width: clamp(90px, 12vw, 180px);
    opacity: 0.6;
    z-index: 1;
  }

  .dyno-wealth-text {
    position: relative;
    z-index: 5;
    padding: 0 0 0 0;
  }

  .dyno-futures-block,
  .dyno-roi-block {
    background: var(--dyno-card-bg);
    border: 1px solid rgba(255, 230, 0, 0.15);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
    overflow: hidden;
    backdrop-filter: blur(8px);
  }

  .dyno-roi-block {
    border-color: rgba(255, 45, 120, 0.15);
  }

  .dyno-wealth-subhead {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--dyno-yellow);
    letter-spacing: 0.1em;
    margin: 0 0 1.5rem;
  }

  .dyno-roi-head {
    color: var(--dyno-pink);
  }

  /* Inline floats for shape-outside inside text blocks */
  .dyno-futures-text-wrap,
  .dyno-roi-text-wrap {
    overflow: hidden;
  }

  .dyno-inline-float {
    height: auto;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .dyno-inline-float-right {
    float: right;
    margin-left: 1.5rem;
    width: clamp(100px, 25%, 180px);
    shape-outside: circle(48%);
    shape-margin: 1rem;
    filter: drop-shadow(0 0 15px rgba(255, 230, 0, 0.35));
  }

  .dyno-inline-float-left {
    float: left;
    margin-right: 1.5rem;
    width: clamp(90px, 22%, 160px);
    shape-outside: polygon(8% 0%, 92% 0%, 95% 95%, 50% 100%, 5% 95%);
    shape-margin: 1rem;
  }

  .dyno-wealth-body {
    font-size: clamp(1.2rem, 2.5vw, 2.5rem);
    line-height: 1.15;
    font-weight: 700;
    color: var(--dyno-white);
    margin: 0 0 1rem;
  }

  .dyno-wealth-body strong {
    color: var(--dyno-yellow);
  }

  .dyno-wealth-body em {
    font-style: italic;
    color: var(--dyno-pink);
  }

  .dyno-disclosure {
    font-family: "VT323", monospace;
    font-size: 0.95rem;
    color: var(--dyno-muted);
    border-left: 2px solid rgba(255, 230, 0, 0.3);
    padding-left: 1rem;
    line-height: 1.5;
  }

  .dyno-highlight {
    color: var(--dyno-yellow);
    font-style: normal;
  }

  /* ══════════════════════════════════════════════════════
     CHECKOUT
  ══════════════════════════════════════════════════════ */
  .dyno-checkout {
    position: relative;
    background: var(--dyno-bg-2);
    border-top: 1px solid rgba(255, 45, 120, 0.2);
    overflow: hidden;
    padding: 5rem 0;
  }

  .dyno-checkout::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 40px,
      rgba(255, 45, 120, 0.02) 40px,
      rgba(255, 45, 120, 0.02) 41px
    );
    pointer-events: none;
  }

  .dyno-checkout-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  .dyno-checkout-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .dyno-checkout-headline {
    color: var(--dyno-pink);
    text-shadow: var(--dyno-glow-pink);
  }

  .dyno-checkout-subtitle {
    font-family: "VT323", monospace;
    font-size: 1.2rem;
    color: var(--dyno-muted);
    letter-spacing: 0.2em;
    text-align: center;
    margin: 0 0 3rem;
  }

  .dyno-sight-unseen {
    background: rgba(255, 45, 120, 0.05);
    border: 1px solid rgba(255, 45, 120, 0.2);
    border-left: 4px solid var(--dyno-pink);
    padding: 2rem;
    margin-bottom: 3rem;
    border-radius: 4px;
  }

  .dyno-sight-title {
    font-family: "Black Han Sans", sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--dyno-white);
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .dyno-sight-body {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    color: rgba(240, 232, 255, 0.8);
    margin: 0;
  }

  /* ── Mandatory Checkbox ── */
  .dyno-checkbox-section {
    background: rgba(255, 45, 120, 0.06);
    border: 1px solid rgba(255, 45, 120, 0.3);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  .dyno-checkbox-label {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    cursor: pointer;
    position: relative;
  }

  .dyno-checkbox-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .dyno-checkbox-custom {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border: 2px solid var(--dyno-pink);
    border-radius: 3px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
    transition:
      background 0.2s,
      border-color 0.2s;
    position: relative;
  }

  .dyno-checkbox-input:checked + .dyno-checkbox-custom {
    background: var(--dyno-pink);
  }

  .dyno-checkbox-input:checked + .dyno-checkbox-custom::after {
    content: "✓";
    color: #000;
    font-size: 0.85rem;
    font-weight: 900;
    position: absolute;
  }

  .dyno-checkbox-input:focus-visible + .dyno-checkbox-custom {
    outline: 2px solid var(--dyno-pink);
    outline-offset: 2px;
  }

  .dyno-checkbox-text {
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    line-height: 1.65;
    color: var(--dyno-white);
    font-family: "Syne", sans-serif;
  }

  .dyno-cbtxt-prefix,
  .dyno-cbtxt-suffix {
    font-family: "Syne Mono", monospace;
    color: var(--dyno-pink);
    font-weight: 700;
  }

  .dyno-checkbox-text strong {
    color: var(--dyno-yellow);
  }

  .dyno-checkbox-warning {
    font-family: "VT323", monospace;
    font-size: 0.9rem;
    color: var(--dyno-pink);
    letter-spacing: 0.1em;
    margin: 1rem 0 0 3rem;
    transition: opacity 0.3s;
  }

  .dyno-checkbox-warning.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Tiers ── */
  .dyno-tiers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .dyno-tiers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dyno-tier {
    border: 1px solid rgba(255, 45, 120, 0.3);
    border-radius: 12px;
    overflow: hidden;
    background: var(--dyno-card-bg);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .dyno-tier-1 {
    border-color: rgba(255, 45, 120, 0.5);
  }

  .dyno-tier-1:hover {
    border-color: var(--dyno-pink);
    box-shadow: 0 0 30px rgba(255, 45, 120, 0.2);
  }

  .dyno-tier-2 {
    border-color: rgba(154, 138, 170, 0.3);
    opacity: 0.85;
  }

  .dyno-tier-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 45, 120, 0.2);
    background: rgba(255, 45, 120, 0.08);
  }

  .dyno-tier-2 .dyno-tier-header {
    background: rgba(154, 138, 170, 0.06);
    border-color: rgba(154, 138, 170, 0.2);
  }

  .dyno-tier-number {
    font-family: "VT323", monospace;
    font-size: 2rem;
    color: var(--dyno-pink);
    line-height: 1;
  }

  .dyno-tier-2 .dyno-tier-number {
    color: var(--dyno-muted);
  }

  .dyno-tier-name {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    color: var(--dyno-white);
  }

  .dyno-tier-body {
    padding: 1.5rem;
  }

  .dyno-tier-price {
    font-family: "Black Han Sans", sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--dyno-yellow);
    margin: 0 0 0.75rem;
    text-shadow: 0 0 20px rgba(255, 230, 0, 0.4);
  }

  .dyno-tier-price-tbd {
    color: var(--dyno-muted);
    text-shadow: none;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .dyno-tier-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(240, 232, 255, 0.7);
    margin: 0 0 1.25rem;
  }

  .dyno-tier-slots {
    font-family: "Syne Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--dyno-green);
    margin-bottom: 0.5rem;
  }

  .dyno-slots-remaining {
    font-family: "Black Han Sans", sans-serif;
    font-size: 1.4rem;
    color: var(--dyno-green);
    text-shadow: var(--dyno-glow-green);
  }

  .dyno-slot-bar {
    height: 4px;
    background: rgba(57, 255, 20, 0.15);
    border-radius: 2px;
    margin-bottom: 1.25rem;
    overflow: hidden;
  }

  .dyno-slot-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--dyno-green), var(--dyno-cyan));
    border-radius: 2px;
    transition: width 0.6s ease;
    box-shadow: 0 0 8px var(--dyno-green);
  }

  /* ── Buy Buttons ── */
  .dyno-buy-btn {
    width: 100%;
    padding: 0.9rem 1.5rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.25s ease;
    background: var(--dyno-pink);
    color: #000;
    box-shadow: 0 0 20px rgba(255, 45, 120, 0.3);
  }

  .dyno-buy-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(255, 45, 120, 0.5);
    background: #ff4d8e;
  }

  .dyno-buy-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .dyno-buy-btn:disabled {
    background: rgba(255, 45, 120, 0.2);
    color: var(--dyno-muted);
    cursor: not-allowed;
    box-shadow: none;
    border: 1px solid rgba(255, 45, 120, 0.2);
  }

  .dyno-buy-tier2:disabled {
    background: rgba(154, 138, 170, 0.1);
    border-color: rgba(154, 138, 170, 0.2);
    color: var(--dyno-muted);
  }

  .dyno-buy-tier2:not(:disabled) {
    background: transparent;
    border: 1px solid var(--dyno-muted);
    color: var(--dyno-muted);
    box-shadow: none;
  }

  .dyno-buy-tier2:not(:disabled):hover {
    border-color: var(--dyno-white);
    color: var(--dyno-white);
    transform: none;
    box-shadow: none;
  }

  .dyno-btn-soldout {
    background: rgba(57, 255, 20, 0.1) !important;
    border: 1px solid rgba(57, 255, 20, 0.3) !important;
    color: var(--dyno-green) !important;
    cursor: not-allowed !important;
  }

  /* ── Success Message ── */
  .dyno-purchase-success {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: rgba(57, 255, 20, 0.08);
    border: 1px solid rgba(57, 255, 20, 0.4);
    border-radius: 8px;
    padding: 2rem;
  }

  .dyno-purchase-success.hidden {
    display: none;
  }

  .dyno-success-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .dyno-success-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.5rem;
    color: var(--dyno-green);
    letter-spacing: 0.1em;
    margin: 0 0 0.5rem;
  }

  .dyno-success-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(240, 232, 255, 0.8);
    margin: 0;
  }

  .dyno-success-body a {
    color: var(--dyno-cyan);
    text-decoration: underline;
  }

  .dyno-success-body strong {
    color: var(--dyno-yellow);
  }

  /* ══════════════════════════════════════════════════════
     MYSTERY REDACTED IMAGE OVERLAY
  ══════════════════════════════════════════════════════ */
  .dyno-redacted-wrap {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
  }

  .dyno-redacted-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    filter: blur(14px) brightness(0.6) saturate(0.4);
    transform: scale(1.08); /* prevents blur edge bleed */
    transition: filter 0.4s ease;
  }

  .dyno-redacted-overlay {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      rgba(8, 0, 15, 0.55) 0%,
      rgba(200, 57, 255, 0.15) 50%,
      rgba(8, 0, 15, 0.55) 100%
    );
    backdrop-filter: blur(2px);
    border: 1px solid rgba(200, 57, 255, 0.35);
    box-shadow:
      inset 0 0 30px rgba(200, 57, 255, 0.1),
      0 0 20px rgba(200, 57, 255, 0.2);
    overflow: hidden;
  }

  /* Scan-line sweep animation */
  .dyno-redacted-scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(200, 57, 255, 0.05) 3px,
      rgba(200, 57, 255, 0.05) 4px
    );
    animation: scan-drift 4s linear infinite;
  }

  @keyframes scan-drift {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 0 100px;
    }
  }

  .dyno-redacted-label {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    padding: 1rem;
  }

  .dyno-redacted-icon {
    font-size: 1.6rem;
    color: var(--dyno-purple);
    animation: redact-pulse 2s ease-in-out infinite alternate;
    display: block;
  }

  @keyframes redact-pulse {
    from {
      opacity: 0.6;
      text-shadow: 0 0 10px var(--dyno-purple);
    }
    to {
      opacity: 1;
      text-shadow:
        0 0 25px var(--dyno-purple),
        0 0 50px rgba(200, 57, 255, 0.4);
    }
  }

  .dyno-redacted-text {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(0.9rem, 2.5vw, 1.3rem);
    letter-spacing: 0.2em;
    color: var(--dyno-white);
    line-height: 1.1;
    text-shadow: 0 0 10px rgba(200, 57, 255, 0.6);
  }

  .dyno-redacted-sub {
    font-family: "VT323", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--dyno-purple);
    opacity: 0.8;
  }

  /* Hover: lift the blur slightly as a tease */
  .dyno-redacted-wrap:hover .dyno-redacted-img {
    filter: blur(10px) brightness(0.7) saturate(0.5);
  }

  /* ══════════════════════════════════════════════════════
     ALLOCATION GATE (APPLY BUTTON)
  ══════════════════════════════════════════════════════ */
  .dyno-allocation-gate {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dyno-allocation-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Syne Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--dyno-muted);
  }

  .dyno-alloc-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dyno-muted);
    flex-shrink: 0;
    animation: alloc-blink 2s step-start infinite;
  }

  @keyframes alloc-blink {
    0%,
