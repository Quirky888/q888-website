let tunnelMouseX = -9999;
let tunnelMouseY = -9999;

function initWindTunnel() {
  const canvas = document.getElementById("aero-tunnel-canvas") as HTMLCanvasElement | null;
  if (!canvas || prefersReduced) return;

  const ctx = canvas.getContext("2d");
  if (!ctx) return;

  const LINE_COUNT = 28;
  const WARP_RADIUS = 200;
  const WARP_STRENGTH = 60;

  function resize() {
    canvas!.width  = canvas!.offsetWidth;
    canvas!.height = canvas!.offsetHeight;
  }
  resize();
  const ro = new ResizeObserver(resize);
  ro.observe(canvas);

  // Build evenly-spaced horizontal lines
  type Line = { baseY: number; points: { x: number; y: number }[] };
  let lines: Line[] = [];

  function buildLines() {
    lines = [];
    const w = canvas!.width;
    const h = canvas!.height;
    for (let i = 0; i < LINE_COUNT; i++) {
      const baseY = (h / (LINE_COUNT + 1)) * (i + 1);
      const pts: { x: number; y: number }[] = [];
      const segments = 120;
      for (let j = 0; j <= segments; j++) {
        pts.push({ x: (w / segments) * j, y: baseY });
      }
      lines.push({ baseY, points: pts });
    }
  }
  buildLines();

  function draw(ts: number) {
    if (!canvas || !ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const mx = tunnelMouseX;
    const my = tunnelMouseY;
    const time = ts * 0.0003;

    for (let li = 0; li < lines.length; li++) {
      const line = lines[li];
      ctx.beginPath();

      for (let pi = 0; pi < line.points.length; pi++) {
        const bx = line.points[pi].x;
        const by = line.baseY;

        // Idle sine drift
        const idleWave = Math.sin(bx * 0.015 + time + li * 0.4) * 2.5;

        // Cursor warp
        const dx = bx - mx;
        const dy = by - my;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const warpFactor = dist < WARP_RADIUS
          ? (1 - dist / WARP_RADIUS) * WARP_STRENGTH
          : 0;
        const warpY = dist < 1 ? 0 : (dy / dist) * warpFactor;

        const fy = by + idleWave + warpY;

        if (pi === 0) ctx.moveTo(bx, fy);
        else ctx.lineTo(bx, fy);
      }

      // Fade lines near centre — more drama
      const normY = line.baseY / canvas.height;
      const alpha = 0.06 + Math.sin(normY * Math.PI) * 0.08;
      ctx.strokeStyle = `rgba(0, 245, 255, ${alpha})`;
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }

    tunnelRaf = requestAnimationFrame(draw);
  }

  tunnelRaf = requestAnimationFrame(draw);

  const hero = document.getElementById("aero-hero");
  if (hero) {
    hero.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      tunnelMouseX = e.clientX - rect.left;
      tunnelMouseY = e.clientY - rect.top;

      // Live-update Ω_sticker value based on cursor proximity to centre
      updateOmegaFromMouse(e.clientX, e.clientY);
    }, { passive: true });

    hero.addEventListener("mouseleave", () => {
      tunnelMouseX = -9999;
      tunnelMouseY = -9999;
    }, { passive: true });
  }

  return () => {
    if (tunnelRaf) cancelAnimationFrame(tunnelRaf);
    ro.disconnect();
  };
}

/* ────────────────────────────────────────────────────────────────
   OMEGA COUNTER
   Animates 0.000 → 0.888 on telemetry section enter;
   also nudges from cursor position in hero.
───────────────────────────────────────────────────────────────── */
let omegaCurrent = 0;
let omegaTarget  = 0;
let omegaRaf: number | null = null;

function updateOmegaFromMouse(cx: number, cy: number) {
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  const dx = (cx / vw - 0.5) * 2;
  const dy = (cy / vh - 0.5) * 2;
  const dist = Math.sqrt(dx * dx + dy * dy);
  // Closer to centre → higher Ω_sticker (max 0.5 from cursor)
  omegaTarget = Math.max(omegaTarget, clamp((1 - dist) * 0.5, 0, 0.5));
  runOmegaRaf();
}

function runOmegaRaf() {
  if (omegaRaf) return;
  function tick() {
    omegaCurrent = lerp(omegaCurrent, omegaTarget, 0.04);
    const el = document.getElementById("aero-omega-value");
    if (el) el.textContent = omegaCurrent.toFixed(3);
    if (Math.abs(omegaCurrent - omegaTarget) > 0.0001) {
      omegaRaf = requestAnimationFrame(tick);
    } else {
      omegaRaf = null;
    }
  }
  omegaRaf = requestAnimationFrame(tick);
}

/* ────────────────────────────────────────────────────────────────
   INTERSECTION OBSERVER — generic reveal + telemetry Ω trigger
───────────────────────────────────────────────────────────────── */
function initRevealObserver() {
  // Generic card reveals
  const revealEls = document.querySelectorAll<HTMLElement>("[data-aero-reveal]");
  if (revealEls.length) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-revealed");
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    revealEls.forEach(el => obs.observe(el));
  }

  // Telemetry section → animate Ω to full 0.888
  const telemSection = document.getElementById("aero-telemetry");
  if (telemSection) {
    const telemObs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        omegaTarget = 0.888;
        runOmegaRaf();
        telemObs.disconnect();
      }
    }, { threshold: 0.2 });
    telemObs.observe(telemSection);
  }
}

/* ────────────────────────────────────────────────────────────────
   LAYER REVEAL — manual tier buttons
───────────────────────────────────────────────────────────────── */
function initLayerReveal() {
  let activeTier = 0;

  function setTier(n: number) {
    if (n === activeTier) return;

    // Layers
    [0, 1, 2].forEach(i => {
      const layer = document.getElementById(`aero-layer-${i}`);
      const panel = document.getElementById(`aero-tier-${i}`);
      const btn   = document.getElementById(`aero-tn-${i}`);
      if (!layer || !panel || !btn) return;

      const active = i === n;
      layer.classList.toggle("is-active", active);
      // stagger layers beneath to remain slightly visible
      layer.style.opacity = active ? "1" : i < n ? "0.12" : "0";
      panel.classList.toggle("is-active", active);
      btn.classList.toggle("is-active", active);
      btn.setAttribute("aria-pressed", active ? "true" : "false");
    });

    // Glow colour shifts per tier
    const glow = document.getElementById("aero-stack-glow");
    if (glow) {
      const colours = ["rgba(0,245,255,0.18)", "rgba(255,255,255,0.12)", "rgba(0,245,255,0.28)"];
      glow.style.background = colours[n] ?? colours[0];
    }

    activeTier = n;
  }

  // Button listeners
  [0, 1, 2].forEach(i => {
    const btn = document.getElementById(`aero-tn-${i}`);
    btn?.addEventListener("click", () => setTier(i));
  });

  // Auto-advance on scroll past reveal section
  if (!prefersReduced) {
    const revealSection = document.getElementById("aero-reveal");
    if (revealSection) {
      let autoTier = 0;
      const scrollObs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          // advance every 800ms while in view
          const id = setInterval(() => {
            autoTier = (autoTier + 1) % 3;
            setTier(autoTier);
            if (autoTier === 2) clearInterval(id); // stop at final state
          }, 900);
        }
      }, { threshold: 0.4 });
      scrollObs.observe(revealSection);
    }
  }
}

/* ────────────────────────────────────────────────────────────────
   ACCORDION — disclaimer firewall
───────────────────────────────────────────────────────────────── */
function initAccordion() {
  const trigger = document.getElementById("aero-accordion-trigger");
  const body    = document.getElementById("aero-accordion-body");
  if (!trigger || !body) return;

  trigger.addEventListener("click", () => {
    const expanded = trigger.getAttribute("aria-expanded") === "true";
    trigger.setAttribute("aria-expanded", expanded ? "false" : "true");
    trigger.classList.toggle("is-open", !expanded);
    if (expanded) {
      body.hidden = true;
    } else {
      body.hidden = false;
    }
  });
}

/* ────────────────────────────────────────────────────────────────
   HERO STICKER PARALLAX (subtle)
───────────────────────────────────────────────────────────────── */
function initHeroParallax() {
  if (prefersReduced) return;
  const sticker = document.getElementById("aero-hero-sticker") as HTMLElement | null;
  if (!sticker) return;

  let tx = 0, ty = 0, tr = 0;
  let cx = 0, cy = 0, cr = 0;

  document.addEventListener("mousemove", (e: MouseEvent) => {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    tx = (e.clientX / vw - 0.5) * 22;
    ty = (e.clientY / vh - 0.5) * 14;
    tr = (e.clientX / vw - 0.5) * -8;
  }, { passive: true });

  function tick() {
    cx = lerp(cx, tx, 0.06);
    cy = lerp(cy, ty, 0.06);
    cr = lerp(cr, tr, 0.04);
    if (sticker) sticker.style.transform = `translate(${cx}px, ${cy}px) rotate(${cr}deg)`;
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

/* ────────────────────────────────────────────────────────────────
   ED'S WIND TUNNEL — Auto-advancing phase player
   No scroll pinning. Triggered when section enters viewport.
   Each phase holds ~5s then auto-advances. Dots are clickable.
───────────────────────────────────────────────────────────────── */
function initEdGraph() {
  const chamber = document.getElementById("wt-chamber");
  if (!chamber) return;

  const PHASE_COUNT = 6;
  const PHASE_DURATION = 5200; // ms each phase holds before auto-advance
  let currentPhase = 0;
  let autoTimer: ReturnType<typeof setTimeout> | null = null;
  let hasStarted = false;

  const phaseIds = ["wt-p0","wt-p1","wt-p2","wt-p3","wt-p4","wt-p5"];
  const edThoughtIndex = [0, 1, 2, 3, 3, 3]; // which thought per phase

  // ── Helpers ──────────────────────────────────────────────────
  function setEdThought(index: number) {
    document.querySelectorAll<HTMLElement>(".ed-thought").forEach((el, i) => {
      el.classList.toggle("is-active", i === index);
    });
  }

  function setCaption(phase: number) {
    document.querySelectorAll<HTMLElement>(".wt-cap").forEach((el) => {
      gsap.to(el, { opacity: 0, duration: 0.2 });
    });
    const cap = document.querySelector<HTMLElement>(`.wt-cap-p${phase}`);
    if (cap) gsap.to(cap, { opacity: 1, duration: 0.4, delay: 0.25 });
  }

  function setDot(phase: number) {
    document.querySelectorAll<HTMLElement>(".wt-dot").forEach((el, i) => {
      el.classList.toggle("wt-dot--active", i === phase);
      // restart sweep animation on active dot
      if (i === phase) {
        el.style.setProperty("--sweep", "0");
        // Force reflow then add class to restart animation
        el.classList.remove("wt-dot--running");
        void el.offsetWidth;
        el.classList.add("wt-dot--running");
      } else {
        el.classList.remove("wt-dot--running");
      }
    });
  }

  // ── Phase transition ─────────────────────────────────────────
  function goToPhase(phase: number, animate = true) {
    if (phase < 0 || phase >= PHASE_COUNT) return;

    const fromId = phaseIds[currentPhase];
    const toId   = phaseIds[phase];
    currentPhase = phase;

    setCaption(phase);
    setEdThought(edThoughtIndex[phase]);
    setDot(phase);

    // Reset bar heights when re-entering phase 2
    if (phase === 2) {
      gsap.set("#wt-bar-cost", { height: 0 });
      gsap.set("#wt-bar-gain", { height: 0 });
    }

    if (animate) {
      // Fade out current
      const fromEl = document.getElementById(fromId);
      if (fromEl) gsap.to(fromEl, { opacity: 0, y: -14, duration: 0.4, ease: "power2.in" });

      // Fade / slide in next
      const toEl = document.getElementById(toId);
      if (toEl) {
        gsap.fromTo(toEl,
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.55, ease: "power2.out", delay: 0.25 }
        );
      }

      // Extra animations for specific phases
      if (phase === 2) {
        // Bar chart — comedy timing
        gsap.to("#wt-bar-cost", { height: 85, duration: 1.2, ease: "power2.out", delay: 0.7 });
        gsap.to("#wt-bar-gain", { height: 4,   duration: 0.6, ease: "power2.out", delay: 1.4 });
      }
      if (phase === 4) {
        gsap.from(".wt-cert-stamp", { rotation: -10, scale: 0.5, opacity: 0, duration: 0.55, ease: "back.out(2)", delay: 0.55 });
      }
      if (phase === 5) {
        gsap.from(".wt-final-stamp span", { opacity: 0, y: 10, duration: 0.35, stagger: 0.15, ease: "power2.out", delay: 0.6 });
      }
    } else {
      // Instant: show target, hide all others
      phaseIds.forEach((id, i) => {
        const el = document.getElementById(id);
        if (el) gsap.set(el, { opacity: i === phase ? 1 : 0, y: 0 });
      });
    }

    scheduleNext();
  }

  // ── Auto-advance timer ────────────────────────────────────────
  function scheduleNext() {
    if (autoTimer) clearTimeout(autoTimer);
    autoTimer = setTimeout(() => {
      // Loop back to phase 0 after the last phase
      const next = (currentPhase + 1) % PHASE_COUNT;
      goToPhase(next, true);
    }, PHASE_DURATION);
  }

  // ── Init: hide all phases, show p0 ───────────────────────────
  phaseIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) gsap.set(el, { opacity: 0, y: 0 });
  });
  gsap.set("#wt-p0", { opacity: 1 });

  // Boot lines stagger in
  gsap.set(".wt-boot-line", { opacity: 0, x: -10 });

  // ── Dot click handlers ────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".wt-dot").forEach((dot) => {
    dot.addEventListener("click", () => {
      const phase = parseInt(dot.dataset.phase ?? "0", 10);
      goToPhase(phase, true);
    });
  });

  // ── IntersectionObserver — start when chamber is visible ─────
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && !hasStarted) {
        hasStarted = true;
        observer.disconnect();

        // Boot lines animate in, then start auto-advance
        gsap.to(".wt-boot-line", {
          opacity: 1, x: 0,
          duration: 0.45,
          stagger: 0.22,
          ease: "power2.out",
          onComplete: () => {
            setDot(0);
            scheduleNext();
          },
        });
      }
    },
    { threshold: 0.4 }
  );
  observer.observe(chamber);

  // ── Pause auto-advance when tab is hidden ────────────────────
  document.addEventListener("visibilitychange", () => {
    if (document.hidden && autoTimer) {
      clearTimeout(autoTimer);
      autoTimer = null;
    } else if (!document.hidden && hasStarted && !autoTimer) {
      scheduleNext();
    }
  });
}


/* ────────────────────────────────────────────────────────────────
   BOOT
───────────────────────────────────────────────────────────────── */
function boot() {
  initWindTunnel();
  initRevealObserver();
  initLayerReveal();
  initAccordion();
  initHeroParallax();
  initEdGraph();
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", boot);
} else {
  boot();
}
document.addEventListener("astro:page-load", boot);
</script>

