/* ════════════════════════════════════════════════════════════════
   AERO V1 — Wind Tunnel Interactions & Scroll Systems
   All logic initialises after DOM ready; cleaned up on Astro swap.
════════════════════════════════════════════════════════════════ */

// ── Reduced motion guard ──
const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// ── Utility ──
function lerp(a: number, b: number, t: number): number { return a + (b - a) * t; }
function clamp(v: number, lo: number, hi: number): number { return Math.min(Math.max(v, lo), hi); }

/* ────────────────────────────────────────────────────────────────
   WIND-TUNNEL CANVAS
   Draws velocity lines across the hero; cursor warps them.
───────────────────────────────────────────────────────────────── */
