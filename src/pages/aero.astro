  --aero-bg:       #000000;
  --aero-cyan:     #00f5ff;
  --aero-cyan-dim: rgba(0, 245, 255, 0.35);
  --aero-white:    #ffffff;
  --aero-dim:      rgba(255, 255, 255, 0.55);
  --aero-grid:     rgba(0, 245, 255, 0.06);
  --aero-border:   rgba(0, 245, 255, 0.18);
  --aero-mono:     'Space Mono', 'Syne Mono', ui-monospace, monospace;
  --aero-sans:     'Space Grotesk', ui-sans-serif, sans-serif;
}

/* ── Base ── */
.aero-wrap {
  background: var(--aero-bg);
  color: var(--aero-white);
  font-family: var(--aero-sans);
  overflow-x: hidden;
  min-height: 100vh;
}

/* Carbon-weave grid on entire page */
.aero-wrap::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(var(--aero-grid) 1px, transparent 1px),
