  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
  color: var(--aero-white);
  margin: 0 0 2rem;
}

.aero-cyan       { color: var(--aero-cyan); }
.aero-dim        { color: var(--aero-dim); }
.aero-white      { color: var(--aero-white); }

/* ══════════════════════════════════════════════════════════
   01 — HERO
══════════════════════════════════════════════════════════ */
.aero-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: clamp(5rem, 10vw, 7rem) clamp(1.5rem, 5vw, 5rem) clamp(4rem, 8vw, 6rem);
