  display: none;
}
@media (min-width: 900px) {
  .aero-hero-sticker-wrap { display: block; }
}
.aero-hero-sticker {
  width: clamp(260px, 30vw, 420px);
  height: auto;
  display: block;
  position: relative;
  z-index: 2;
  will-change: transform;
  filter: drop-shadow(0 0 40px rgba(0,245,255,0.35));
}
.aero-sticker-glow {
  position: absolute;
  inset: -20%;
  background: radial-gradient(ellipse at center, rgba(0,245,255,0.2) 0%, transparent 70%);
  z-index: 1;
  pointer-events: none;
  animation: aero-glow-pulse 3s ease-in-out infinite;
}
@keyframes aero-glow-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.5; }
}
.aero-sticker-ring {
  position: absolute;
  inset: -8%;
  border: 1px solid var(--aero-border);
  border-radius: 50%;
  pointer-events: none;
  animation: aero-ring-spin 12s linear infinite;
}
.aero-ring-2 {
  inset: -20%;
  border-color: rgba(0,245,255,0.08);
  animation-duration: 20s;
  animation-direction: reverse;
}
@keyframes aero-ring-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Scroll cue */
.aero-scroll-cue {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 1rem;
  font-family: var(--aero-mono);
  font-size: 0.5rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--aero-dim);
}
.aero-scroll-line {
  width: 40px;
  height: 1px;
  background: var(--aero-border);
}

/* ══════════════════════════════════════════════════════════
   02 — SPECS
══════════════════════════════════════════════════════════ */
.aero-specs {
  position: relative;
  z-index: 1;
  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  border-top: 1px solid var(--aero-border);
}
.aero-specs-inner { max-width: 1100px; margin: 0 auto; }

.aero-specs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1px;
  background: var(--aero-border);
  border: 1px solid var(--aero-border);
}

.aero-spec-card {
  --hover-color: var(--aero-cyan);
  background: var(--aero-bg);
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.5s ease, transform 0.5s ease, background 0.3s ease, box-shadow 0.3s ease;
}
.aero-spec-card:nth-child(1) { --hover-color: #00f5ff; } /* Cyan */
.aero-spec-card:nth-child(2) { --hover-color: #ff00ff; } /* Magenta */
.aero-spec-card:nth-child(3) { --hover-color: #ffcc33; } /* Gold */
.aero-spec-card:nth-child(4) { --hover-color: #39ff14; } /* Neon Green */
.aero-spec-card:nth-child(5) { --hover-color: #ff69b4; } /* Hot Pink */
.aero-spec-card:nth-child(6) { --hover-color: #9d00ff; } /* Purple */
.aero-spec-card:nth-child(7) { --hover-color: #ff4500; } /* Orange Red */
.aero-spec-card:nth-child(8) { --hover-color: #00ffaa; } /* Mint */

.aero-spec-card.is-revealed {
  opacity: 1;
  transform: translateY(0);
}
.aero-spec-card:hover {
  background: color-mix(in srgb, var(--hover-color) 8%, transparent);
  box-shadow: inset 0 0 30px color-mix(in srgb, var(--hover-color) 15%, transparent);
}
.aero-spec-label {
  font-family: var(--aero-mono);
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--aero-cyan);
  transition: color 0.3s ease, text-shadow 0.3s ease;
}
.aero-spec-card:hover .aero-spec-label {
  color: var(--hover-color);
  text-shadow: 0 0 8px color-mix(in srgb, var(--hover-color) 60%, transparent);
}
.aero-spec-value {
  font-family: var(--aero-sans);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 700;
  color: var(--aero-white);
  line-height: 1;
}
.aero-spec-unit {
  font-size: 0.7em;
  color: var(--aero-dim);
  font-weight: 400;
}
.aero-spec-sub {
  font-family: var(--aero-mono);
  font-size: 0.55rem;
  color: var(--aero-dim);
  letter-spacing: 0.05em;
}

/* ══════════════════════════════════════════════════════════
   03 — ED'S WIND TUNNEL CALCULATION CHAMBER
══════════════════════════════════════════════════════════ */
.aero-paradox {
  position: relative;
  z-index: 1;
  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  border-top: 1px solid var(--aero-border);
}
.aero-paradox-inner { max-width: 1200px; margin: 0 auto; }

.aero-paradox-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: start;
}
@media (min-width: 768px) {
  .aero-paradox-split { grid-template-columns: 1fr 1.3fr; gap: 5rem; align-items: start; }
}

/* Left Column */
.aero-paradox-headline {
  font-family: var(--aero-sans);
  font-size: clamp(2.5rem, 7vw, 5rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
  margin: 0 0 2rem;
}
.aero-paradox-intro {
  font-size: clamp(0.95rem, 1.4vw, 1.1rem);
  line-height: 1.75;
  color: var(--aero-dim);
  margin: 0 0 1rem;
}
.aero-paradox-intro--accent { color: var(--aero-white); font-style: italic; }
.aero-paradox-intro strong { color: var(--aero-white); }

/* Ed Thought rotating box */
.ed-thought-container {
  margin-top: 2rem;
  padding: 1.25rem 1.5rem;
  border: 1px solid rgba(0, 245, 255, 0.15);
  background: rgba(0, 245, 255, 0.03);
  position: relative;
  overflow: hidden;
  min-height: 90px;
}
.ed-thought-label {
  font-family: var(--aero-mono);
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--aero-cyan);
  display: block;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}
.ed-thought-track { position: relative; }
.ed-thought {
  font-family: var(--aero-sans);
  font-size: clamp(0.95rem, 1.5vw, 1.1rem);
  color: var(--aero-white);
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  opacity: 0;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  transition: opacity 0.6s ease;
}
.ed-thought.is-active { opacity: 1; position: relative; }

/* Wind Tunnel Chamber — Right Column */
.wt-chamber {
  position: relative;
  background: #050505;
  border: 1px solid rgba(0, 245, 255, 0.12);
  min-height: 500px;
  overflow: hidden;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Carbon grid texture via CSS */
.wt-chamber::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 245, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 245, 255, 0.03) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}

/* Airflow lines SVG overlay */
.wt-airflow {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
@keyframes wt-flow {
  0%   { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: -120px; }
}
.wt-airflow path {
  stroke-dasharray: 12px 8px;
  animation: wt-flow 3s linear infinite;
}
.af2 { animation-delay: -0.5s; }
.af3 { animation-delay: -1s; }
.af4 { animation-delay: -1.5s; }
.af5 { animation-delay: -2s; }
.af6 { animation-delay: -2.5s; }

/* Phase panels — all hidden by default, shown via GSAP */
.wt-phase {
  position: absolute;
  inset: 0;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.85rem;
  opacity: 0;
  pointer-events: none;
  /* leave room for the dot nav (28px) + caption bar (38px) + a little breathing room */
  padding-bottom: 80px;
}
.wt-phase.is-current { pointer-events: auto; }

/* Boot lines (Phase 0) */
.wt-boot-lines { display: flex; flex-direction: column; gap: 0.6rem; }
.wt-boot-line {
  font-family: var(--aero-mono);
  font-size: clamp(0.7rem, 1.2vw, 0.9rem);
  color: var(--aero-cyan);
  letter-spacing: 0.08em;
  opacity: 0;
  transform: translateX(-12px);
}

/* Formula (Phases 1 & 3) */
.wt-formula {
  font-family: var(--aero-mono);
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  color: var(--aero-white);
  letter-spacing: 0.04em;
  line-height: 1.4;
}
.wt-formula sub, .wt-formula sup { font-size: 0.6em; }
.wt-formula--new { color: var(--aero-cyan); }
.wt-formula-new { color: var(--aero-dim); font-size: 0.75em; }

/* Readout rows */
.wt-readouts { display: flex; flex-direction: column; gap: 0.5rem; }
.wt-readout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  font-family: var(--aero-mono);
  font-size: clamp(0.65rem, 1vw, 0.78rem);
}
.wt-key {
  color: var(--aero-dim);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.wt-val { color: var(--aero-white); text-align: right; }
.wt-val--hi { color: var(--aero-cyan); }
.wt-val--warn { color: #ff6b35; }

/* Bar chart (Phase 2) */
.wt-bars {
  display: flex;
  align-items: flex-end;
  gap: 2rem;
  height: 100px;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(255,255,255,0.15);
}
.wt-bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
.wt-bar {
  width: 48px;
  background: var(--aero-border);
  border-top: 2px solid transparent;
  transition: height 0.8s ease;
}
.wt-bar--cost {
  height: 0;
  background: linear-gradient(to top, rgba(255,255,255,0.06), rgba(255,255,255,0.18));
  border-color: rgba(255,255,255,0.5);
}
.wt-bar--gain {
  height: 0;
  background: linear-gradient(to top, rgba(255,107,53,0.1), rgba(255,107,53,0.3));
  border-color: #ff6b35;
}
.wt-bar-label {
  font-family: var(--aero-mono);
  font-size: 0.6rem;
  color: var(--aero-dim);
  text-align: center;
  line-height: 1.3;
}
.wt-warning {
  font-family: var(--aero-mono);
  font-size: 0.65rem;
  color: #ff6b35;
  letter-spacing: 0.12em;
  padding: 0.6rem 0.75rem;
  border: 1px solid rgba(255, 107, 53, 0.3);
  background: rgba(255, 107, 53, 0.05);
}

/* Drift particles (Phase 3) */
.wt-particles {
  width: 100%;
  height: 60px;
  overflow: visible;
}
@keyframes wt-drift {
  0%   { transform: translateX(0) translateY(0); opacity: 0.6; }
  100% { transform: translateX(240px) translateY(-10px); opacity: 0; }
}
.wt-particle { animation: wt-drift 4s linear infinite; }
.wt-particle:nth-child(1) { animation-delay: 0s; }
.wt-particle:nth-child(2) { animation-delay: -0.8s; }
.wt-particle:nth-child(3) { animation-delay: -1.6s; }
.wt-particle:nth-child(4) { animation-delay: -2.4s; }
.wt-particle:nth-child(5) { animation-delay: -3.2s; }

/* Certification stamp (Phase 4) */
.wt-cert-stamp {
  font-family: var(--aero-mono);
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  color: var(--aero-cyan);
  border: 1px solid var(--aero-cyan);
  padding: 0.4rem 0.8rem;
  display: inline-block;
  width: fit-content;
  transform: rotate(-1deg);
  box-shadow: 0 0 12px rgba(0, 245, 255, 0.2);
}
.wt-value-density {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.wt-vd-label {
  font-family: var(--aero-mono);
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  color: var(--aero-dim);
  text-transform: uppercase;
}
.wt-vd-number {
  font-family: var(--aero-sans);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: var(--aero-white);
  letter-spacing: -0.04em;
  line-height: 1;
}
.wt-vd-unit {
  font-size: 0.45em;
  color: var(--aero-cyan);
  font-weight: 400;
  letter-spacing: 0.05em;
}

/* Final lockup (Phase 5) */
.wt-final-headline {
  font-family: var(--aero-sans);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  color: var(--aero-white);
  letter-spacing: -0.05em;
  line-height: 1;
}
.wt-final-sub {
  font-family: var(--aero-mono);
  font-size: clamp(0.75rem, 1.2vw, 0.9rem);
  color: var(--aero-dim);
  line-height: 1.8;
}
.wt-final-sub em { color: var(--aero-white); font-style: normal; }
.wt-final-stamp {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  font-family: var(--aero-mono);
  font-size: 0.6rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--aero-dim);
  border-top: 1px solid var(--aero-border);
  padding-top: 1rem;
}
.wt-stamp-gold { color: #d4a855; }
.wt-stamp-dim  { color: var(--aero-dim); }
.wt-stamp-cyan { color: var(--aero-cyan); }

/* Terminal caption bar */
.wt-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 38px;
  background: rgba(0, 0, 0, 0.75);
  border-top: 1px solid rgba(0, 245, 255, 0.12);
  border-left: 3px solid var(--aero-cyan);
  display: flex;
  align-items: center;
  padding: 0 1rem;
  backdrop-filter: blur(4px);
}
.wt-cap {
  font-family: var(--aero-mono);
  font-size: 0.65rem;
  color: var(--aero-cyan);
  letter-spacing: 0.06em;
  position: absolute;
  opacity: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: calc(100% - 2rem);
}

/* Phase dot timeline nav */
.wt-timeline {
  position: absolute;
  bottom: 42px;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0.6rem 1rem;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  border-top: 1px solid rgba(0, 245, 255, 0.08);
}
.wt-dot {
  position: relative;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  cursor: pointer;
  overflow: hidden;
  transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease, width 0.3s ease;
  padding: 0;
  flex-shrink: 0;
}
.wt-dot:hover {
  background: rgba(0, 245, 255, 0.25);
  border-color: var(--aero-cyan);
  transform: scale(1.25);
}
.wt-dot--active {
  background: rgba(0, 245, 255, 0.15);
  border-color: var(--aero-cyan);
  width: 38px;
  border-radius: 7px;
  box-shadow: 0 0 8px rgba(0, 245, 255, 0.3);
}
/* Sweep progress fill inside active dot */
@keyframes wt-dot-sweep {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}
.wt-dot--active::after {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--aero-cyan);
  border-radius: 7px;
  transform-origin: left center;
  transform: scaleX(0);
}
.wt-dot--running::after {
  animation: wt-dot-sweep 5.2s linear forwards;
}


/* ══════════════════════════════════════════════════════════
   04 — LAYER REVEAL
══════════════════════════════════════════════════════════ */
.aero-reveal-section {
  position: relative;
  z-index: 1;
  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  border-top: 1px solid var(--aero-border);
}
.aero-reveal-inner { max-width: 1100px; margin: 0 auto; }

.aero-reveal-stage {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: start;
}
@media (min-width: 768px) {
  .aero-reveal-stage { grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
}

.aero-image-stack {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  max-width: 480px;
  margin: 0 auto;
}
.aero-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  transform: translateY(8px) scale(0.97);
  transition: opacity 0.55s ease, transform 0.55s ease;
  will-change: opacity, transform;
}
.aero-layer.is-active {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.aero-stack-glow {
  position: absolute;
  inset: -15%;
  border-radius: 50%;
  background: rgba(0,245,255,0.18);
  filter: blur(40px);
  z-index: -1;
  pointer-events: none;
  transition: background 0.6s ease;
}

.aero-tier-panels {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.aero-tier-panel {
  display: none;
  flex-direction: column;
  gap: 0.75rem;
  animation: aero-panel-in 0.4s ease;
}
.aero-tier-panel.is-active { display: flex; }

@keyframes aero-panel-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.aero-tier-number {
  font-family: var(--aero-mono);
  font-size: 0.55rem;
  letter-spacing: 0.22em;
  color: var(--aero-cyan);
  text-transform: uppercase;
}
.aero-tier-name {
  font-family: var(--aero-sans);
  font-size: clamp(1.4rem, 3.5vw, 2rem);
  font-weight: 700;
  color: var(--aero-white);
}
.aero-tier-desc {
  font-size: clamp(0.88rem, 1.4vw, 1rem);
  line-height: 1.7;
  color: var(--aero-dim);
  margin: 0;
}
.aero-tier-spec {
  font-family: var(--aero-mono);
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--aero-cyan-dim);
  padding-top: 0.75rem;
  border-top: 1px solid var(--aero-border);
}

.aero-tier-nav {
  display: flex;
  gap: 0.5rem;
  margin-top: 2rem;
}
.aero-tier-btn {
  width: 44px;
  height: 44px;
  border: 1px solid var(--aero-border);
  background: transparent;
  color: var(--aero-dim);
  font-family: var(--aero-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
}
.aero-tier-btn:hover {
  border-color: var(--aero-cyan);
  color: var(--aero-cyan);
}
.aero-tier-btn.is-active {
  background: var(--aero-cyan);
  color: #000;
  border-color: var(--aero-cyan);
}

/* ══════════════════════════════════════════════════════════
   05 — TELEMETRY
══════════════════════════════════════════════════════════ */
.aero-telemetry {
  position: relative;
  z-index: 1;
  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  border-top: 1px solid var(--aero-border);
}

.aero-telem-header {
  max-width: 1100px;
  margin: 0 auto 3rem;
}

.aero-omega-display {
  display: inline-flex;
  align-items: baseline;
  gap: 0.75rem;
  background: rgba(0,245,255,0.06);
  border: 1px solid var(--aero-border);
  padding: 0.75rem 1.5rem;
  margin-top: 1rem;
}
.aero-omega-label {
  font-family: var(--aero-mono);
  font-size: 0.85rem;
  color: var(--aero-dim);
}
.aero-omega-equals {
  font-family: var(--aero-mono);
  font-size: 0.85rem;
  color: var(--aero-dim);
}
.aero-omega-value {
  font-family: var(--aero-mono);
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--aero-cyan);
  min-width: 5ch;
  text-shadow: 0 0 20px rgba(0,245,255,0.6);
  transition: color 0.1s ease;
}

.aero-formula-grid {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1px;
  background: var(--aero-border);
  border: 1px solid var(--aero-border);
}

.aero-formula-card {
  background: var(--aero-bg);
  padding: 2rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
