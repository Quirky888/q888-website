---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";

const aeroMetaItems = [
  { field: "drag_coeff",    label: "DRAG_COEFF",    value: "Cd: 0.000",  width: 10 },
  { field: "vibe_freq",     label: "VIBE_FREQ",     value: "888 Hz",     width: 7  },
  { field: "sticker_status",label: "STICKER_STATUS",value: "DEPLOYED",   width: 9  },
  { field: "belief_index",  label: "BELIEF_INDEX",  value: "MAXIMUM",    width: 7  },
];
---

<Layout title="AERO V1 — INFOCIGAN × Q888">
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" customItems={aeroMetaItems} />

  <main class="aero-wrap" id="aero-main">

    <!-- ══════════════════════════════════════════════════════
         01. HERO BLOCK
    ══════════════════════════════════════════════════════ -->
    <section class="aero-hero" id="aero-hero" aria-label="Aero V1 hero">

      <!-- Wind-tunnel SVG canvas — warped by cursor -->
      <canvas class="aero-tunnel-canvas" id="aero-tunnel-canvas" aria-hidden="true"></canvas>

      <!-- Cinematic video background -->
      <div class="aero-video-wrap" aria-hidden="true">
        <video
          class="aero-video"
          id="aero-hero-video"
          src="/images/Prompt_Cinematic_slow_motio.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
        ></video>
        <div class="aero-video-overlay"></div>
      </div>

      <!-- Scanline overlay -->
      <div class="aero-scanlines" aria-hidden="true"></div>

      <!-- Hero copy -->
      <div class="aero-hero-content">
        <div class="aero-hero-eyebrow">
          <span class="aero-badge">INFOCIGAN AERO DIVISION</span>
          <span class="aero-badge aero-badge-mono">V1 // WIND TUNNEL VALIDATED</span>
        </div>

        <h1 class="aero-headline">
          <span class="aero-hl-1">WE MAKE YOU</span>
          <span class="aero-hl-2">MORE AERO</span>
          <span class="aero-hl-3">V1</span>
        </h1>

        <div class="aero-price-index" id="aero-price-index">
          <span class="aero-price-label">ACQUISITION METRIC</span>
          <span class="aero-price-value">£230 <span class="aero-price-slash">·</span> V1</span>
          <span class="aero-price-sub">// £100 PER GRAM · DENSITY-SCALED VALUATION PROTOCOL</span>
        </div>

        <div class="aero-hero-status">
          <span class="aero-status-dot" aria-hidden="true"></span>
          <span class="aero-status-text">UNITS: <span class="aero-cyan">50 / 50</span> AVAILABLE</span>
          <span class="aero-status-sep">//</span>
          <span class="aero-status-text">RARITY: <span class="aero-cyan">SCALES WITH BELIEF</span></span>
        </div>

        <a
          href="mailto:hello@q888.space?subject=AERO%20V1%20ACQUISITION%20INTENT"
          class="aero-acquire-btn"
          id="aero-acquire-btn"
          aria-label="Submit acquisition intent for Aero V1"
        >
          <span class="aero-btn-icon" aria-hidden="true">◈</span>
          <span>SUBMIT ACQUISITION INTENT</span>
          <span class="aero-btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Floating sticker preview -->
      <div class="aero-hero-sticker-wrap">
        <img
          src="/images/aero_sticker.webp"
          alt="Aero Sticker V1 — the fully realised consumer skin"
          class="aero-hero-sticker"
          id="aero-hero-sticker"
          width="420"
          height="420"
          loading="eager"
          decoding="async"
        />
        <div class="aero-sticker-glow" aria-hidden="true"></div>
        <div class="aero-sticker-ring aero-ring-1" aria-hidden="true"></div>
        <div class="aero-sticker-ring aero-ring-2" aria-hidden="true"></div>
      </div>

      <!-- Scroll cue -->
      <div class="aero-scroll-cue" aria-hidden="true">
        <span class="aero-scroll-line"></span>
        <span class="aero-scroll-label">SCROLL TO ENTER WIND TUNNEL</span>
        <span class="aero-scroll-line"></span>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         02. PHYSICAL COLLECTIBLE INTERFACE
    ══════════════════════════════════════════════════════ -->
    <section class="aero-specs" id="aero-specs" aria-label="Technical specifications">
      <div class="aero-specs-inner">
        <div class="aero-section-tag">HARDWARE SPECIFICATION MATRIX</div>
        <h2 class="aero-section-headline">UNIT PROFILE</h2>

        <div class="aero-specs-grid">
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">FOOTPRINT</span>
            <span class="aero-spec-value">76 × 71 <span class="aero-spec-unit">mm</span></span>
            <span class="aero-spec-sub">μ-Matrix boundary layer</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">VERTICAL PROFILE</span>
            <span class="aero-spec-value">&lt; 1.5 <span class="aero-spec-unit">mm</span></span>
            <span class="aero-spec-sub">Zero-drag laminar stack</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">PRODUCTION RUN</span>
            <span class="aero-spec-value">50 <span class="aero-spec-unit">units</span></span>
            <span class="aero-spec-sub">Hard-ceiling scarcity protocol</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">DENSITY METRIC</span>
            <span class="aero-spec-value">£100 <span class="aero-spec-unit">/ g</span></span>
            <span class="aero-spec-sub">Belief-scaled valuation</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">SERIAL TAG</span>
            <span class="aero-spec-value">SqB<span class="aero-spec-unit">001</span></span>
            <span class="aero-spec-sub">Laser-engraved μ-matrix ID</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">Ω COEFFICIENT</span>
            <span class="aero-spec-value">0<span class="aero-spec-unit">.888</span></span>
            <span class="aero-spec-sub">Sticker drag-nullification constant</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">WIND TUNNEL</span>
            <span class="aero-spec-value">0 <span class="aero-spec-unit">hrs</span></span>
            <span class="aero-spec-sub">Validated exclusively by vibes.</span>
          </div>
          <div class="aero-spec-card" data-aero-reveal>
            <span class="aero-spec-label">PEER REVIEWS</span>
            <span class="aero-spec-value">N/A</span>
            <span class="aero-spec-sub">Science is subjective anyway.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         03. ED'S WIND TUNNEL CALCULATION CHAMBER
    ══════════════════════════════════════════════════════ -->
    <section class="aero-paradox" id="aero-paradox" aria-label="Wind tunnel calculation chamber">
      <div class="aero-paradox-inner">
        <div class="aero-section-tag">ORIGIN STORY // THE 100KG FALLACY CALCULATION CHAMBER</div>

        <div class="aero-paradox-split">
          <!-- LEFT COLUMN: Ed's identity + rotating thought -->
          <div class="aero-paradox-left">
            <h2 class="aero-paradox-headline">
              ED'S WIND<br />
              <span class="aero-cyan">TUNNEL</span><br />
              REVELATION
            </h2>

            <p class="aero-paradox-intro">
              The Aero Sticker was not born in a sterile corporate wind tunnel. It was forged in the heat of a specialty coffee shop, fueled by intense irritation, and mapped out by our co-creator, Ed—a brilliant young engineer with a fresh diploma, an obsessive passion for flawless coffee extraction, and a deep understanding of dimensional aerodynamics.
            </p>
            <p class="aero-paradox-intro">
              Ed set out with a noble, highly targeted mission: to help ultra-rich cyclists save some precious, overpriced watts and drastically reduce their drag in this universe. But when he examined the sacred mathematical promise of high-end cycling performance, the numbers shattered his reality. A £10,000 aero frame. A 100kg rider. Approximately 2 miserable watts saved at 30 km/h.
            </p>
            <p class="aero-paradox-intro aero-paradox-intro--accent">
              This wasn't innovation; it was a massive financial headwind wearing carbon fibre.
            </p>
            <p class="aero-paradox-intro">
              So Ed chose to bypass Newtonian physics altogether. Instead of wasting months trying to make a metal bicycle frame more aerodynamic, the <strong>Aero V-0888 streamlines the bicycle's underlying logic.</strong> The result is a £100-per-gram Infocigan performance artefact engineered to reduce atmospheric drag, maximize human belief, and politely inform the wind exactly who is in charge.
            </p>

          </div>

          <!-- RIGHT COLUMN: Wind tunnel visual -->
          <div class="aero-paradox-right">
            <div class="wt-chamber" id="wt-chamber">

              <!-- Airflow lines background (always present) -->
              <svg class="wt-airflow" viewBox="0 0 600 400" preserveAspectRatio="none" aria-hidden="true">
                <path d="M-20 60  Q200 55  620 62"  fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.15" class="af af1"/>
                <path d="M-20 120 Q180 112 620 125" fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.12" class="af af2"/>
                <path d="M-20 180 Q220 175 620 183" fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.10" class="af af3"/>
                <path d="M-20 240 Q200 238 620 244" fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.12" class="af af4"/>
                <path d="M-20 300 Q190 295 620 303" fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.10" class="af af5"/>
                <path d="M-20 360 Q210 355 620 362" fill="none" stroke="var(--aero-cyan)" stroke-width="0.8" opacity="0.08" class="af af6"/>
              </svg>

              <!-- Phase 0: Boot screen -->
              <div class="wt-phase wt-p0" id="wt-p0">
                <div class="wt-boot-lines">
                  <div class="wt-boot-line bl0">WIND_TUNNEL: SEALED</div>
                  <div class="wt-boot-line bl1">SUBJECT: ED</div>
                  <div class="wt-boot-line bl2">COFFEE_LEVEL: STRUCTURALLY ADEQUATE</div>
                  <div class="wt-boot-line bl3">CALCULATION_TYPE: DANGEROUSLY RATIONAL</div>
                </div>
              </div>

              <!-- Phase 1: Real drag formula -->
              <div class="wt-phase wt-p1" id="wt-p1">
                <div class="wt-formula">F<sub>D</sub> = &frac12;&rho;v&sup2;C<sub>D</sub>A</div>
                <div class="wt-readouts">
                  <div class="wt-readout"><span class="wt-key">RIDER_MASS</span><span class="wt-val">100 kg</span></div>
                  <div class="wt-readout"><span class="wt-key">FRAME_COST</span><span class="wt-val wt-val--hi">£10,000</span></div>
                  <div class="wt-readout"><span class="wt-key">EXPECTED_FEELING</span><span class="wt-val">FAST</span></div>
                </div>
              </div>

              <!-- Phase 2: The tragedy bar chart -->
              <div class="wt-phase wt-p2" id="wt-p2">
                <div class="wt-bars">
                  <div class="wt-bar-wrap">
                    <div class="wt-bar wt-bar--cost" id="wt-bar-cost"></div>
                    <span class="wt-bar-label">£10,000<br/>COST</span>
                  </div>
                  <div class="wt-bar-wrap">
                    <div class="wt-bar wt-bar--gain" id="wt-bar-gain"></div>
                    <span class="wt-bar-label">2W<br/>GAIN</span>
                  </div>
                </div>
                <div class="wt-readouts">
                  <div class="wt-readout"><span class="wt-key">OUTPUT_GAIN</span><span class="wt-val">2W</span></div>
                  <div class="wt-readout"><span class="wt-key">COST_PER_WATT</span><span class="wt-val wt-val--hi">£5,000</span></div>
                  <div class="wt-readout"><span class="wt-key">EMOTIONAL_DAMAGE</span><span class="wt-val wt-val--warn">SIGNIFICANT</span></div>
                </div>
                <div class="wt-warning">&#x26A0; MARGINAL GAIN HAS BECOME MARGINAL PAIN</div>
              </div>

              <!-- Phase 3: Rational collapse / new formula -->
              <div class="wt-phase wt-p3" id="wt-p3">
                <div class="wt-formula wt-formula--new">
                  F<sub>D</sub><span class="wt-formula-new">(new)</span> = F<sub>D</sub> &times; e<sup>-(&Omega;<sub>sticker</sub> &times; Vibe)</sup>
                </div>
                <div class="wt-readouts">
                  <div class="wt-readout"><span class="wt-key">NEWTONIAN_PHYSICS</span><span class="wt-val wt-val--warn">MOVED TO OPTIONAL</span></div>
                  <div class="wt-readout"><span class="wt-key">QUANTUM_DEFLECTION</span><span class="wt-val">RECALCULATING</span></div>
                  <div class="wt-readout"><span class="wt-key">VIBE</span><span class="wt-val wt-val--hi">SIGNIFICANT</span></div>
                </div>
                <svg class="wt-particles" viewBox="0 0 400 100" aria-hidden="true">
                  <text x="20"  y="60"  class="wt-particle" font-family="var(--aero-mono)" font-size="14" fill="var(--aero-cyan)" opacity="0.6">&#x03C1;</text>
                  <text x="80"  y="35"  class="wt-particle" font-family="var(--aero-mono)" font-size="14" fill="var(--aero-cyan)" opacity="0.5">v&sup2;</text>
                  <text x="155" y="75"  class="wt-particle" font-family="var(--aero-mono)" font-size="14" fill="var(--aero-cyan)" opacity="0.7">C&#x1D05;A</text>
                  <text x="235" y="45"  class="wt-particle" font-family="var(--aero-mono)" font-size="14" fill="var(--aero-cyan)" opacity="0.4">&frac12;</text>
                  <text x="315" y="65"  class="wt-particle" font-family="var(--aero-mono)" font-size="14" fill="var(--aero-cyan)" opacity="0.6">F&#x1D05;</text>
                </svg>
              </div>

              <!-- Phase 4: Value density certification -->
              <div class="wt-phase wt-p4" id="wt-p4">
                <div class="wt-cert-stamp">&#x03BC;-MATRIX ACTIVE</div>
                <div class="wt-value-density">
                  <span class="wt-vd-label">AERO VALUE DENSITY</span>
                  <span class="wt-vd-number">£100<span class="wt-vd-unit">/gram</span></span>
                </div>
                <div class="wt-readouts">
                  <div class="wt-readout"><span class="wt-key">MASS</span><span class="wt-val">NEGLIGIBLE</span></div>
                  <div class="wt-readout"><span class="wt-key">CONFIDENCE</span><span class="wt-val wt-val--hi">HEAVY</span></div>
                  <div class="wt-readout"><span class="wt-key">VALUE</span><span class="wt-val">WIND-TUNNEL VERIFIED IN 1 DIMENSION</span></div>
                </div>
              </div>

              <!-- Phase 5: Final lockup -->
              <div class="wt-phase wt-p5" id="wt-p5">
                <div class="wt-final-headline">BELIEF &gt; DRAG</div>
                <div class="wt-final-sub">
                  NOT FASTER.<br/>
                  MORE AERO.<br/>
                  <em>IMPORTANT DIFFERENCE.</em>
                </div>
                <div class="wt-final-stamp">
                  <span>AERO V-0888</span>
                  <span class="wt-stamp-gold">£100/g PERFORMANCE ARTEFACT</span>
                  <span class="wt-stamp-dim">WIND-TUNNEL REJECTED</span>
                  <span class="wt-stamp-cyan">INFOCIGAN APPROVED</span>
                </div>
              </div>

              <!-- Phase dot timeline nav -->
              <div class="wt-timeline" id="wt-timeline" role="tablist" aria-label="Phases">
                <button class="wt-dot wt-dot--active" data-phase="0" role="tab" aria-label="Phase 0: Boot" title="BOOT"></button>
                <button class="wt-dot" data-phase="1" role="tab" aria-label="Phase 1: Formula" title="01"></button>
                <button class="wt-dot" data-phase="2" role="tab" aria-label="Phase 2: Tragedy" title="02"></button>
                <button class="wt-dot" data-phase="3" role="tab" aria-label="Phase 3: Collapse" title="03"></button>
                <button class="wt-dot" data-phase="4" role="tab" aria-label="Phase 4: Value Density" title="04"></button>
                <button class="wt-dot" data-phase="5" role="tab" aria-label="Phase 5: Belief > Drag" title="05"></button>
              </div>

              <!-- Terminal caption bar -->
              <div class="wt-caption" id="wt-caption">
                <span class="wt-cap wt-cap-p0">WIND_TUNNEL: SEALED — SUBJECT: ED — CALCULATION_TYPE: DANGEROUSLY RATIONAL</span>
                <span class="wt-cap wt-cap-p1">PHASE 01 — Newtonian physics enters the room with confidence.</span>
                <span class="wt-cap wt-cap-p2">PHASE 02 — £10,000 detected. 2 watts recovered. Dignity unstable.</span>
                <span class="wt-cap wt-cap-p3">PHASE 03 — Newtonian physics has been moved to the optional folder.</span>
                <span class="wt-cap wt-cap-p4">PHASE 04 — &#x03BC;-Matrix active. Air molecules awaiting instruction.</span>
                <span class="wt-cap wt-cap-p5">PHASE 05 — Belief exceeds drag. Sticker classified as £100/g velocity matter.</span>
              </div>
            </div>

            <!-- Ed Thought — synced to chamber phases -->
            <div class="ed-thought-container">
              <span class="ed-thought-label">ED THOUGHT</span>
              <div class="ed-thought-track">
                <p class="ed-thought et-0">What if the problem is not the rider?</p>
                <p class="ed-thought et-1">What if the problem is the financial density of hope?</p>
                <p class="ed-thought et-2">What if a sticker has better emotional aerodynamics than a frame?</p>
                <p class="ed-thought et-3">What if the wind simply needs better instructions?</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         04. INTERACTIVE LAYER REVEAL
    ══════════════════════════════════════════════════════ -->
    <section class="aero-reveal-section" id="aero-reveal" aria-label="Product layer reveal">
      <div class="aero-reveal-inner">
        <div class="aero-section-tag">MATERIAL STACK // SCROLL TO DEPLOY</div>
        <h2 class="aero-section-headline">THREE-TIER CONSTRUCTION</h2>

        <div class="aero-reveal-stage">
          <!-- Image stack -->
          <div class="aero-image-stack" id="aero-image-stack" aria-live="polite">
            <img
              src="/images/aero_base.webp"
              alt="Tier 1: μ-Matrix Chassis — dark stealth-carbon substrate reinforced with an iridescent titanium lattice and laser-etched SqB001 registry"
              class="aero-layer aero-layer-base is-active"
              id="aero-layer-0"
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <img
              src="/images/aero_midlayer.webp"
              alt="Tier 2: Field Prototype — raw vector layout superimposing an aerodynamic tuck onto a front-basket commuter bicycle"
              class="aero-layer aero-layer-mid"
              id="aero-layer-1"
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <img
              src="/images/aero_sticker.webp"
              alt="Tier 3: Consumer V1 Skin (Digital Ink Core) — micro-encapsulated Smart Pixels locking in the cyan velocity banner"
              class="aero-layer aero-layer-top"
              id="aero-layer-2"
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <!-- Glow halo behind stack -->
            <div class="aero-stack-glow" aria-hidden="true" id="aero-stack-glow"></div>
          </div>

          <!-- Tier info panels -->
          <div class="aero-tier-panels">
            <div class="aero-tier-panel is-active" id="aero-tier-0" data-tier="0">
              <div class="aero-tier-number">TIER 01</div>
              <div class="aero-tier-name">μ-MATRIX CHASSIS</div>
              <p class="aero-tier-desc">
                A microscopic, dark stealth-carbon substrate reinforced with an iridescent titanium lattice. Engineered to remain entirely beneath the visible surface—shielded from casual inspection, accessible only to the true owner.
              </p>
              <p class="aero-tier-desc" style="margin-top:0.5rem">
                <strong class="aero-cyan">Telemetry Data:</strong> Laser-etched directly into the nano-carbide weave is the product classification matrix and the unique registration marker: <strong class="aero-cyan">SqB001</strong>. A hidden certificate of hyper-elite authenticity confirming structural priority.
              </p>
              <div class="aero-tier-spec">MATERIAL: NANO-CARBIDE // WEAVE: 8K // REGISTRY: SqB001</div>
            </div>

            <div class="aero-tier-panel" id="aero-tier-1" data-tier="1">
              <div class="aero-tier-number">TIER 02</div>
              <div class="aero-tier-name">FIELD PROTOTYPE</div>
              <p class="aero-tier-desc">
                The raw deployment layer. Features a high-contrast, dotted-line vector layout tracking an aggressive, aerodynamic sprint tuck—superimposed directly onto a traditional, front-basket commuter bicycle infrastructure.
              </p>
              <p class="aero-tier-desc" style="margin-top:0.5rem">
                <strong class="aero-cyan">Velocity Metrics:</strong> The unpigmented blue swoosh banner serves as an abstract wind-channel vector line. By deliberately minimizing localized ink mass, we ensure peak molecular acceleration across the sticker surface.
              </p>
              <div class="aero-tier-spec">DEPLOYMENT: FIELD VALIDATED // STATUS: SEVERE OVER-SPEC // INK MASS: ~0.00g</div>
            </div>

            <div class="aero-tier-panel" id="aero-tier-2" data-tier="2">
              <div class="aero-tier-number">TIER 03</div>
              <div class="aero-tier-name">CONSUMER V1 SKIN (DIGITAL INK CORE)</div>
              <p class="aero-tier-desc">
                The ultimate interface layer. Woven with a surface skin of active Smart Pixels from the <a href="/dink">Digital Ink Architecture</a>. This micro-encapsulated pixel matrix dynamically shifts state under raw kinetic force, locking in the ultra-high contrast cyan velocity banner declaring: "WE MAKE YOU MORE AERO V1".
              </p>
              <p class="aero-tier-desc" style="margin-top:0.5rem">
                <strong class="aero-cyan">Deployment Protocol:</strong> Powered entirely by friction. As aerodynamic headwind velocity increases, the Smart Pixels magnetically align to smooth out incoming molecular friction, altering their visual density to bypass Newtonian drag entirely through sheer aesthetic superiority.
              </p>
              <div class="aero-tier-spec">INTERFACE: DIGITAL INK V1 // ACTIVE PIXELS: 8,888,000 // HUBRIS INDEX: MAXIMUM</div>
            </div>

            <!-- Manual tier nav -->
            <div class="aero-tier-nav" aria-label="Layer navigation">
              <button class="aero-tier-btn is-active" id="aero-tn-0" data-target="0" aria-label="View Tier 1 — μ-Matrix Chassis" aria-pressed="true">01</button>
              <button class="aero-tier-btn" id="aero-tn-1" data-target="1" aria-label="View Tier 2 — Field Prototype" aria-pressed="false">02</button>
              <button class="aero-tier-btn" id="aero-tn-2" data-target="2" aria-label="View Tier 3 — Consumer V1 Skin (Digital Ink Core)" aria-pressed="false">03</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         05. TELEMETRY SCIENCE ENGINE
    ══════════════════════════════════════════════════════ -->
    <section class="aero-telemetry" id="aero-telemetry" aria-label="Aerodynamic telemetry formulas">

      <div class="aero-telem-header">
        <div class="aero-section-tag">TELEMETRY ENGINE // LIVE READOUT</div>
