---
import Layout from "../layouts/Layout.astro";
import ProjectDrawer from "../components/ProjectDrawer.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
---

<Layout
  title="Digital Ink — Finite-Pixel iPad Art App by Q888"
  description="Digital Ink is a finite-pixel iPad art app by Aleksandrs Sestakovs / Q888, turning each imported image into one scarce, traceable Smart Ink Drop."
  image="/images/DigitalInk_Ipad_kn.webp"
  canonicalPath="/dink/"
  mainEntityType="SoftwareApplication"
  mainEntityName="Digital Ink"
  mainEntityData={{
    applicationCategory: "GraphicsApplication",
    operatingSystem: "iPadOS 18 or later",
    downloadUrl: "https://apps.apple.com/us/app/digital-ink/id6757157376",
  }}
  keywords={["Digital Ink", "finite pixel art app", "iPad drawing app", "digital scarcity art", "Smart Ink Drop", "Q888"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />
  <ProjectDrawer standaloneProject="digital-ink" />
</Layout>
