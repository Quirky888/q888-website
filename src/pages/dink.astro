---
import Layout from "../layouts/Layout.astro";
import DigitalInkPage from "../components/DigitalInkPage.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
---

<Layout
  title="Digital Ink — Every pixel has a past | Q888"
  description="Digital Ink is a free iPad app and artwork by Alexander Sestakovs / Q888: every photo becomes one finite Smart Ink, a single square of colour with its own memory, connections and provenance."
  image="/images/DigitalInk_Ipad_kn.webp"
  canonicalPath="/dink/"
  regularTextFont
  displayFonts
  mainEntityType="SoftwareApplication"
  mainEntityName="Digital Ink"
  mainEntityData={{
    applicationCategory: "GraphicsApplication",
    operatingSystem: "iPadOS 26 or later",
    softwareVersion: "3.2",
    downloadUrl: "https://apps.apple.com/us/app/digital-ink/id6757157376",
  }}
  keywords={["Digital Ink", "finite pixel art app", "Smart Ink", "Ink Home", "Artist Identity", "cryptographic provenance", "Heritage Ink", "116-Pixel Archive", "Q888"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />
  <DigitalInkPage />
</Layout>
