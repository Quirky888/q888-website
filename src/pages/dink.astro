---
import Layout from "../layouts/Layout.astro";
import DigitalInkPage from "../components/DigitalInkPage.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
---

<Layout
  title="Digital Ink — Images Become Materials with a Past | Q888"
  description="An experimental art world inside an iPad drawing app. Turn images into finite Smart Inks with colour, memory and histories of their own, then make artworks together."
  image="/images/DigitalInk_Ipad_kn.webp"
  canonicalPath="/dink/"
  regularTextFont
  mainEntityType="SoftwareApplication"
  mainEntityName="Digital Ink"
  mainEntityData={{
    applicationCategory: "GraphicsApplication",
    operatingSystem: "iPadOS 18 or later",
    downloadUrl: "https://apps.apple.com/us/app/digital-ink/id6757157376",
  }}
  keywords={["Digital Ink", "finite pixel art app", "Smart Ink", "Inkhome", "Artist Identity", "cryptographic provenance", "Heritage Ink", "116-Pixel Archive", "Q888"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />
  <DigitalInkPage />
</Layout>
