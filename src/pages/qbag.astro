    <!-- ══════════════════════════════════ GALLERY DIALOG ══════════════════════════════════ -->
    <dialog
      class="qbag-gallery-dialog"
      id="qbag-gallery-dialog"
      aria-label="Q-Bag artwork gallery"
    >
      <!-- Controls bar -->
