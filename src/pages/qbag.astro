---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
import { getEntry } from "astro:content";

const qBagEntry = await getEntry("products", "q-bag");
if (!qBagEntry || qBagEntry.data.slug !== "q-bag") {
  throw new Error("Required Q-Bag content entry is missing.");
}
const qBag = qBagEntry.data;
---

<Layout title="Q-Bag — Q888">
  <SlimNav />
  <SystemMeta position="top" />

  <main class="relative min-h-screen pt-10 md:pt-11">
    <div class="qbag-new-layout">
      <section class="qbag-hero">
        <img
          src={qBag.heroImage}
          alt={qBag.heroAlt}
          loading="eager"
          decoding="async"
          width="1200"
          height="800"
        />
        <div class="qbag-hero-overlay">
          <h1 class="qbag-title gold-shine">{qBag.heroTitle}</h1>
        </div>
      </section>
      
      <div class="qbag-main-content">
        <section class="qbag-intro-section">
          <div class="glass-card intro-card">
            <p class="qbag-tagline gold-shine">{qBag.introTagline}</p>
            <p class="qbag-lead">
              {qBag.introLead}
            </p>
          </div>
        </section>
      </div>

      <!-- Artwork Gallery Info Card (replaces full artwork section) -->
      <section class="qbag-artwork-card-section">
        <div class="artwork-info-card glass-card" id="artwork-gallery-trigger">
          <div class="artwork-card-content">
            <div class="artwork-card-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 16L8.586 11.414C9.367 10.633 10.633 10.633 11.414 11.414L16 16M14 14L15.586 12.414C16.367 11.633 17.633 11.633 18.414 12.414L20 14M14 8H14.01M6 20H18C19.105 20 20 19.105 20 18V6C20 4.895 19.105 4 18 4H6C4.895 4 4 4.895 4 6V18C4 19.105 4.895 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="artwork-card-text">
              <h3 class="artwork-card-title">{qBag.artworkCardTitle}</h3>
              <p class="artwork-card-description">{qBag.artworkCardDescription}</p>
            </div>
            <button class="artwork-card-button" type="button">
              <span>{qBag.artworkCardButtonLabel}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <div class="qbag-main-content">
        <section class="qbag-content-grid-section" data-motion-reveal>
          <div class="qbag-glass-grid" data-motion-stagger data-motion-children="[data-motion-item]">
            <div class="glass-card" data-motion-item>
              <h3>{qBag.conceptCards[0].title}</h3>
              <p>{qBag.conceptCards[0].paragraphs[0]}</p>
              <p>{qBag.conceptCards[0].paragraphs[1]}</p>
            </div>
            <div class="glass-card" data-motion-item>
              <h3>{qBag.conceptCards[1].title}</h3>
              <p>{qBag.conceptCards[1].paragraphs[0]}</p>
              <p>{qBag.conceptCards[1].paragraphs[1]}</p>
              <p>{qBag.conceptCards[1].paragraphs[2]}</p>
            </div>
            <div class="glass-card" data-motion-item>
              <h3>{qBag.conceptCards[2].title}</h3>
              <p>{qBag.conceptCards[2].paragraphs[0]}</p>
              <p>{qBag.conceptCards[2].paragraphs[1]}</p>
            </div>
            <div class="glass-card" data-motion-item>
              <h3>{qBag.conceptCards[3].title}</h3>
              <p>{qBag.conceptCards[3].paragraphs[0]}</p>
              <p>{qBag.conceptCards[3].paragraphs[1]}</p>
            </div>
          </div>
        </section>

        <section class="qbag-partners-section">
          <div class="glass-card partners-card">
            <h2>{qBag.partnersTitle}</h2>
            <p>{qBag.partnersParagraphs[0]}</p>
            <p>{qBag.partnersParagraphs[1]}</p>
          </div>
        </section>

        <section class="qbag-closing-section">
          <div class="closing-content">
            <p class="big-statement">
              {qBag.closingLines[0]}<br />
              {qBag.closingLines[1]}<br />
              {qBag.closingLines[2]}
            </p>
          </div>
        </section>

        <section class="qbag-contact-section">
          <div class="glass-card contact-card">
            <p>{qBag.contactIntro}</p>
            <p class="contact-info">
              <a href={`mailto:${qBag.contactEmail}`}>{qBag.contactEmail}</a> or Instagram: <a href={qBag.contactInstagramUrl} target="_blank" rel="noopener">{qBag.contactInstagramHandle}</a>
            </p>
          </div>
        </section>
      </div>

      <section class="qbag-cta">
        <a href="/#infocigan" class="retreat-button no-underline inline-block">
          {qBag.ctaLabel}
        </a>
      </section>

      <div class="artwork-viewer" id="artwork-viewer" aria-hidden="true">
        <div class="viewer-overlay"></div>
        <div class="viewer-container">
          <div class="viewer-controls">
            <button class="viewer-btn viewer-close" aria-label="Close viewer" title="Close (ESC)">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="viewer-btn viewer-zoom-in" aria-label="Zoom in" title="Zoom In">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="viewer-btn viewer-zoom-out" aria-label="Zoom out" title="Zoom Out">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="viewer-btn viewer-reset" aria-label="Reset view" title="Reset View">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div class="viewer-image-wrapper">
            <div class="viewer-image-container" id="viewer-image-container">
              <img
                src={qBag.viewerImage}
                alt={qBag.viewerAlt}
                class="viewer-image"
                id="viewer-image"
                draggable="false"
                loading="lazy"
                decoding="async"
                width="1200"
                height="900"
              />
            </div>
          </div>
          <div class="viewer-zoom-indicator" id="zoom-indicator">100%</div>
        </div>
      </div>
    </div>
  </main>

  <div class="hidden md:block">
    <SystemMeta position="bottom" />
  </div>
</Layout>

<script>
  function initArtworkViewer() {
    const trigger = document.getElementById("artwork-gallery-trigger");
    const viewer = document.getElementById("artwork-viewer");
    const closeBtn = viewer?.querySelector(".viewer-close");
    const zoomInBtn = viewer?.querySelector(".viewer-zoom-in");
    const zoomOutBtn = viewer?.querySelector(".viewer-zoom-out");
    const resetBtn = viewer?.querySelector(".viewer-reset");
    const imageContainer = document.getElementById("viewer-image-container");
    const imageWrapper = viewer?.querySelector(".viewer-image-wrapper");
    const zoomIndicator = document.getElementById("zoom-indicator");

    if (!trigger || !viewer || !imageContainer) return;
    if (viewer.hasAttribute("data-viewer-initialized")) return;
    viewer.setAttribute("data-viewer-initialized", "true");

    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const MIN_SCALE = 1;
    const MAX_SCALE = 4;
    const ZOOM_STEP = 0.3;

    function updateTransform() {
      if (!imageContainer) return;
      imageContainer.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
      if (zoomIndicator) {
        zoomIndicator.textContent = `${Math.round(scale * 100)}%`;
        showZoomIndicator();
      }
    }

    function showZoomIndicator() {
      if (!zoomIndicator) return;
      zoomIndicator.classList.add("show");
      clearTimeout((window as unknown as { zoomIndicatorTimeout?: number }).zoomIndicatorTimeout);
      (window as unknown as { zoomIndicatorTimeout?: number }).zoomIndicatorTimeout = window.setTimeout(() => {
        zoomIndicator.classList.remove("show");
      }, 1000);
    }

    function openViewer() {
      if (!viewer) return;
      document.documentElement.classList.add("is-viewer-open");
      viewer.classList.add("is-open");
      viewer.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      resetView();
    }

    function closeViewer() {
      if (!viewer) return;
      document.documentElement.classList.remove("is-viewer-open");
      viewer.classList.remove("is-open");
      viewer.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      resetView();
    }

    function resetView() {
      scale = 1;
      translateX = 0;
      translateY = 0;
      updateTransform();
    }

    function zoomIn() {
      if (scale < MAX_SCALE) {
        scale = Math.min(scale + ZOOM_STEP, MAX_SCALE);
        updateTransform();
      }
    }

    function zoomOut() {
      if (scale > MIN_SCALE) {
        scale = Math.max(scale - ZOOM_STEP, MIN_SCALE);
        if (scale === MIN_SCALE) {
          translateX = 0;
          translateY = 0;
        }
        updateTransform();
      }
    }

    function handleWheel(e: WheelEvent) {
      e.preventDefault();
      if (e.deltaY < 0) zoomIn();
      else zoomOut();
    }

    function handleDragStart(e: MouseEvent | TouchEvent) {
      if (scale === 1) return;
      isDragging = true;
      imageWrapper?.classList.add("is-grabbing");
      const clientX = e.type === "mousedown" ? (e as MouseEvent).clientX : (e as TouchEvent).touches[0].clientX;
      const clientY = e.type === "mousedown" ? (e as MouseEvent).clientY : (e as TouchEvent).touches[0].clientY;
      startX = clientX - translateX;
      startY = clientY - translateY;
      if (e.type === "mousedown") {
        document.addEventListener("mousemove", handleDragMove as EventListener);
        document.addEventListener("mouseup", handleDragEnd);
      }
    }

    function handleDragMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      e.preventDefault();
      const clientX = e.type === "mousemove" ? (e as MouseEvent).clientX : (e as TouchEvent).touches[0].clientX;
      const clientY = e.type === "mousemove" ? (e as MouseEvent).clientY : (e as TouchEvent).touches[0].clientY;
      translateX = clientX - startX;
      translateY = clientY - startY;
      updateTransform();
    }

    function handleDragEnd() {
      isDragging = false;
      imageWrapper?.classList.remove("is-grabbing");
      document.removeEventListener("mousemove", handleDragMove as EventListener);
      document.removeEventListener("mouseup", handleDragEnd);
    }

    let initialDistance = 0;
    let initialScale = 1;

    function getTouchDistance(e: TouchEvent) {
      const touch1 = e.touches[0];
      const touch2 = e.touches[1];
      return Math.hypot(touch2.clientX - touch1.clientX, touch2.clientY - touch1.clientY);
    }

    function handleTouchStart(e: TouchEvent) {
      if (e.touches.length === 2) {
        initialDistance = getTouchDistance(e);
        initialScale = scale;
      } else if (e.touches.length === 1) {
        handleDragStart(e);
      }
    }

    function handleTouchMove(e: TouchEvent) {
      if (e.touches.length === 2) {
        e.preventDefault();
        const currentDistance = getTouchDistance(e);
        const newScale = initialScale * (currentDistance / initialDistance);
        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, newScale));
        updateTransform();
      } else if (e.touches.length === 1 && isDragging) {
        handleDragMove(e);
      }
    }

    trigger.addEventListener("click", openViewer);
    closeBtn?.addEventListener("click", closeViewer);
    closeBtn?.addEventListener("touchend", (e) => { e.preventDefault(); closeViewer(); }, { passive: false });
    zoomInBtn?.addEventListener("click", zoomIn);
    zoomOutBtn?.addEventListener("click", zoomOut);
    resetBtn?.addEventListener("click", resetView);

    viewer.querySelector(".viewer-overlay")?.addEventListener("click", closeViewer);

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && viewer.classList.contains("is-open")) closeViewer();
    };
    document.addEventListener("keydown", handleKeyDown);

    imageWrapper?.addEventListener("mousedown", handleDragStart as EventListener);
    imageWrapper?.addEventListener("touchstart", handleTouchStart as EventListener, { passive: false });
    imageWrapper?.addEventListener("touchmove", handleTouchMove as EventListener, { passive: false });
    imageWrapper?.addEventListener("touchend", handleDragEnd);
    imageWrapper?.addEventListener("wheel", handleWheel as EventListener, { passive: false });

    const handleBeforeSwap = () => {
      document.removeEventListener("keydown", handleKeyDown);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    };
    document.addEventListener("astro:before-swap", handleBeforeSwap);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArtworkViewer);
  } else {
    initArtworkViewer();
  }
  document.addEventListener("astro:page-load", initArtworkViewer);
</script>

<style>
  :global(.is-viewer-open [data-slim-nav]),
  :global(.is-viewer-open [data-system-meta]),
  :global(.is-viewer-open .mobile-escape-nav) {
    display: none !important;
  }

  /* Q-Bag layout - clean & modern */
  .qbag-new-layout {
    width: 100%;
    background: #0a0a0a;
    color: var(--text-primary, #e0e0e0);
    font-family: inherit;
    overflow-y: auto;
  }

  .qbag-hero {
    width: 100%;
    height: 80dvh;
    position: relative;
    overflow: hidden;
  }

  .qbag-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .qbag-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 4vw;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  }

  .qbag-title {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(5rem, 14vw, 14rem);
    font-weight: 900;
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--accent-primary, #ffd700);
    margin: 0;
    letter-spacing: -0.04em;
    text-shadow: 0 4px 20px rgba(255, 215, 0, 0.3);
  }

  .qbag-main-content {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4vw;
  }

  .qbag-intro-section {
    padding: 8rem 0 6rem;
  }

  .intro-card {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 4rem;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .qbag-tagline {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 600;
    color: var(--accent-primary, #ffd700);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    line-height: 1;
    opacity: 0.95;
  }

  .qbag-lead {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    line-height: 1.4;
    font-weight: 300;
    opacity: 0.95;
    margin: 0;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .qbag-artwork-card-section {
    padding: 6rem 0;
  }

  .qbag-artwork-card-section .artwork-info-card {
    background-image: linear-gradient(rgba(10, 10, 10, 0.78), rgba(10, 10, 10, 0.78)), url("/images/qbag_concept.webp");
    background-size: cover;
    background-position: center;
  }

  .artwork-info-card {
    max-width: 1000px;
    margin: 0 auto;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .artwork-info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.1), transparent);
    transition: left 0.5s ease;
  }

  .artwork-info-card:hover::before {
    left: 100%;
  }

  .artwork-info-card:hover {
    border-color: rgba(255, 215, 0, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(255, 215, 0, 0.2);
  }

  .artwork-card-content {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 3rem;
  }

  .artwork-card-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary, #ffd700);
    background: rgba(255, 215, 0, 0.1);
    border-radius: 12px;
  }

  .artwork-card-text {
    flex: 1;
  }

  .artwork-card-title {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--accent-primary, #ffd700);
    margin: 0 0 1rem 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .artwork-card-title::before {
    content: '// GALLERY';
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: rgba(255, 215, 0, 0.5);
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .artwork-card-description {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
    font-weight: 300;
    letter-spacing: -0.005em;
  }

  .artwork-card-button {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: var(--accent-primary, #ffd700);
    color: #000;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .artwork-card-button:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(255, 215, 0, 0.4);
  }

  .artwork-card-button svg {
    transition: transform 0.2s ease;
  }

  .artwork-card-button:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .artwork-card-content {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
      gap: 1.5rem;
    }
    .artwork-card-button {
      width: 100%;
      justify-content: center;
    }
  }

  .artwork-viewer {
    position: fixed;
    inset: 0;
    z-index: 2000000;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .artwork-viewer.is-open {
    display: block;
    opacity: 1;
  }

  .viewer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(10px);
  }

  .viewer-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .viewer-controls {
    position: absolute;
    top: calc(1.5rem + env(safe-area-inset-top, 0px));
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    display: flex;
    gap: 0.5rem;
    z-index: 10002;
  }

  .viewer-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }

  .viewer-btn:hover {
    background: rgba(255, 215, 0, 0.2);
    border-color: var(--accent-primary, #ffd700);
    transform: scale(1.05);
  }

  .viewer-close {
    background: rgba(255, 50, 50, 0.15);
    border-color: rgba(255, 50, 50, 0.3);
  }

  .viewer-close:hover {
    background: rgba(255, 50, 50, 0.3);
    border-color: rgba(255, 50, 50, 0.6);
  }

  .viewer-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    cursor: grab;
  }

  .viewer-image-wrapper.is-grabbing {
    cursor: grabbing;
  }

  .viewer-image-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    transition: transform 0.2s ease;
    will-change: transform;
  }

  .viewer-image {
    max-width: 90vw;
    max-height: 90dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

