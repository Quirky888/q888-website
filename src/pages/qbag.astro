  .qbag-pilot-metric {
    max-width: 48rem;
    margin: 0 0 1.8rem;
    color: #fffaf0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.35rem, 2.4vw, 2.5rem);
    font-style: italic;
    line-height: 1.18;
  }

  .qbag-pilot-action {
    background: var(--qb-gold-bright);
    color: #17100b;
  }

  .qbag-participant-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .qbag-participant-grid article {
    min-height: 13rem;
    padding: 1.5rem;
    border: 1px solid var(--qb-border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.4);
  }

  .qbag-participant-grid article:nth-child(2) {
    background: rgba(255, 204, 51, 0.1);
  }

  .qbag-participant-grid article:nth-child(3) {
    background: rgba(32, 140, 141, 0.08);
  }

  .qbag-value-circuit {
    position: relative;
    margin: clamp(4rem, 8vw, 8rem) 0;
    padding: clamp(4.5rem, 8vw, 7rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    border: 2px solid var(--qb-text);
    border-radius: 4px;
    background: var(--qb-gold-bright);
    color: #17100b;
    box-shadow: 14px 14px 0 rgba(26, 16, 8, 0.12);
  }

  .qbag-value-circuit::before {
    content: 'VALUE MAY ESCAPE · TRUST MAY COMPOUND · MONEY MAY BECOME ANOTHER ARTWORK · ';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    padding: 0.75rem 1rem;
    overflow: hidden;
    background: #17100b;
    color: var(--qb-gold-bright);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .qbag-value-circuit .qbag-section-index {
    color: #17100b;
    opacity: 0.68;
  }

  .qbag-value-circuit-header {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(18rem, 1.1fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .qbag-value-circuit-header .qbag-section-index {
    grid-column: 1 / -1;
  }

  .qbag-value-circuit-header h2 {
    min-width: 0;
    margin: 0;
    font-family: 'Bungee', 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.6vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.88;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .qbag-value-circuit-header > p:last-child {
    min-width: 0;
    margin: 0;
    font-size: clamp(1rem, 1.45vw, 1.25rem);
    line-height: 1.6;
  }

  .qbag-value-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 3.5rem 0 0;
    padding: 0;
    border-top: 2px solid #17100b;
    border-left: 2px solid #17100b;
    list-style: none;
  }

  .qbag-value-stages li {
    min-height: 16rem;
    padding: 1.4rem;
    border-right: 2px solid #17100b;
    border-bottom: 2px solid #17100b;
    background: rgba(255, 255, 255, 0.12);
  }

  .qbag-value-stages li:nth-child(even) {
    background: rgba(23, 16, 11, 0.06);
  }

  .qbag-value-stage-number {
    display: block;
    margin-bottom: 2.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .qbag-value-stages h3 {
    margin: 0 0 0.75rem;
    font-family: 'Syne', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    line-height: 1.1;
  }

  .qbag-value-stages p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .qbag-collector-bonus {
    max-width: 60rem;
    margin: 0;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border: 0;
    color: #17100b;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.55rem, 3vw, 3.1rem);
    font-style: italic;
    line-height: 1.16;
    text-wrap: balance;
  }

  .qbag-value-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: end;
    padding-top: 1.5rem;
    border-top: 2px solid #17100b;
  }

  .qbag-value-clarity {
    max-width: 48rem;
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .qbag-value-footer nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    align-items: flex-end;
  }

  .qbag-value-footer a {
    color: #17100b;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-underline-offset: 0.25em;
    text-transform: uppercase;
  }

  .qbag-speculative-zone {
    position: relative;
    margin: 4rem 0;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px dashed rgba(193, 122, 46, 0.7);
    border-radius: 24px;
    background:
      repeating-linear-gradient(-45deg, rgba(193, 122, 46, 0.04) 0 10px, transparent 10px 20px),
      rgba(255, 255, 255, 0.38);
  }

  .qbag-speculative-zone::before {
    content: 'ARTWORK BOUNDARY';
    position: absolute;
    top: -0.68rem;
    right: 2rem;
    padding: 0.3rem 0.75rem;
    background: var(--qb-bg);
    color: var(--qb-amber);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .qbag-speculative-zone h2 {
    max-width: 50rem;
    margin: 0 0 1.4rem;
    font-family: 'Bungee', 'Space Grotesk', sans-serif;
    font-size: clamp(1.7rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1;
    text-wrap: balance;
  }

  .qbag-speculative-zone > p,
  .qbag-speculative-zone blockquote {
    max-width: 50rem;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  .qbag-speculative-zone blockquote {
    margin: 1.5rem 0;
    color: var(--qb-amber);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
  }

  .qbag-speculative-disclaimer {
    max-width: 50rem;
    margin-top: 2rem;
    padding: 1rem;
    border-left: 3px solid var(--qb-primary);
    background: rgba(32, 140, 141, 0.08);
    color: var(--qb-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .qbag-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--qb-border);
  }

  .qbag-section:last-of-type {
    border-bottom: none;
  }

  /* ─── Lead ─── */
  .qbag-lead {
    font-family: 'Syne', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--qb-text);
    margin: 0;
  }

  /* ─── Headings ─── */
  .qbag-h2 {
    font-family: 'Bungee', 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.6rem, 3vw, 3.2rem);
    font-weight: 400;
    color: var(--qb-text);
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* ─── Body text ─── */
  .qbag-section p {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    line-height: 1.65;
    color: var(--qb-text);
    margin: 0 0 1.5rem 0;
  }

  /* ─── Blockquote ─── */
  .qbag-blockquote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--qb-text);
    margin: 1.5rem 0;
    padding: 1.25rem 0 1.25rem 2rem;
    border-left: 3px solid var(--qb-amber);
  }

  /* ─── Two-col layout ─── */
  .qbag-two-col {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  .qbag-two-col-text {
    min-width: 0;
  }

  /* ─── Mini portal visual ─── */
  .qbag-mini-portal-wrap {
    flex-shrink: 0;
  }

  .qbag-mini-portal {
    width: 200px;
    aspect-ratio: 1 / 1;
    border-radius: 45% 55% 52% 48% / 48% 44% 56% 52%;
    overflow: hidden;
    box-shadow:
      0 0 0 2px rgba(193, 122, 46, 0.15),
      0 0 20px rgba(193, 122, 46, 0.15),
      0 8px 32px rgba(26, 16, 8, 0.1);
    transition: all 0.4s ease;
    animation: qb-mini-morph 14s ease-in-out infinite;
  }

  .qbag-mini-portal:hover {
    border-radius: 38% 62% 46% 54% / 56% 44% 60% 40%;
    box-shadow:
      0 0 0 2px rgba(193, 122, 46, 0.35),
      0 0 30px rgba(193, 122, 46, 0.25),
      0 8px 40px rgba(26, 16, 8, 0.15);
  }

  @keyframes qb-mini-morph {
    0%   { border-radius: 45% 55% 52% 48% / 48% 44% 56% 52%; }
    50%  { border-radius: 55% 45% 44% 56% / 56% 52% 44% 48%; }
    100% { border-radius: 45% 55% 52% 48% / 48% 44% 56% 52%; }
  }

  .qbag-mini-portal svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ─── Sticker strip ─── */
  .qb-sticker-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 0;
    flex-wrap: wrap;
  }

  .qb-sticker-chip {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(193, 122, 46, 0.15));
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
    cursor: default;
    animation: qb-chip-float 4s ease-in-out infinite;
  }

  .qb-sticker-chip:nth-child(1) { animation-delay: 0s; }
  .qb-sticker-chip:nth-child(2) { animation-delay: 0.9s; }
  .qb-sticker-chip:nth-child(3) { animation-delay: 1.8s; }
  .qb-sticker-chip:nth-child(4) { animation-delay: 2.7s; }

  .qb-sticker-chip:hover {
    transform: scale(1.2) rotate(-5deg);
    filter: drop-shadow(0 8px 20px rgba(193, 122, 46, 0.3));
  }

  .qb-sticker-chip svg {
    width: 100%;
    height: 100%;
  }

  @keyframes qb-chip-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-7px); }
  }

  /* ─── Gallery card ─── */
  .qbag-artwork-card-section {
    padding: 2rem 0 4rem;
  }

  .qbag-artwork-card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(19, 66, 82, 0.12);
    border-radius: 24px;
    max-width: 960px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: 
      0 4px 24px rgba(19, 66, 82, 0.04),
      0 20px 48px rgba(19, 66, 82, 0.06);
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .qbag-artwork-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 8px 32px rgba(19, 66, 82, 0.08),
      0 28px 64px rgba(19, 66, 82, 0.12);
    border-color: rgba(193, 122, 46, 0.35);
  }

  /* Secure Double Gold/Amber Border on Certificate Card */
  .certificate-secure-border {
    position: absolute;
    inset: 6px;
    border: 3px double rgba(193, 122, 46, 0.4);
    border-radius: 18px;
    pointer-events: none;
    z-index: 4;
  }

  /* Safe-Deposit corner brackets */
  .certificate-corner-brackets {
    position: absolute;
    inset: 14px;
    border: 1px dashed rgba(32, 140, 141, 0.15);
    border-radius: 12px;
    pointer-events: none;
    z-index: 4;
  }

  /* Coffee bean ornaments at corners! */
  .certificate-corner-brackets::before {
    content: '✦';
    position: absolute;
    top: -6px;
    left: -4px;
    font-size: 0.8rem;
    color: #ce9e00;
  }

  .certificate-corner-brackets::after {
    content: '✦';
    position: absolute;
    bottom: -6px;
    right: -4px;
    font-size: 0.8rem;
    color: #ce9e00;
  }

  .artwork-card-content {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding: 4rem 3.5rem;
  }

  /* Left Side: Gilded Certificate Frame */
  .artwork-stamp-frame {
    flex-shrink: 0;
    width: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .postage-stamp {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fdfcfb;
    padding: 12px;
    border: 1px solid rgba(19, 66, 82, 0.12);
    box-shadow: 
      0 8px 24px rgba(19, 66, 82, 0.06),
      0 2px 6px rgba(0, 0, 0, 0.03);
    border-radius: 2px;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
    transform-origin: center;
  }

  /* Stamp perforation notches around the edges */
  .postage-stamp::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: 6px dotted #ffffff;
    border-radius: 4px;
    pointer-events: none;
    z-index: 3;
  }

  .postage-stamp img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid rgba(19, 66, 82, 0.08);
    border-radius: 1px;
  }

  /* Holographic moving glare */
  .stamp-hologram-glare {
    position: absolute;
    inset: 12px;
    background: linear-gradient(
      135deg,
      transparent 30%,
      rgba(255, 255, 255, 0.45) 45%,
      rgba(206, 158, 0, 0.2) 50%,
      rgba(32, 140, 141, 0.2) 55%,
      transparent 70%
    );
    background-size: 200% 200%;
    background-position: -100% -100%;
    transition: background-position 0.6s ease;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: color-dodge;
  }

  /* Thin gold border layer on top of image */
  .stamp-inner-gold {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(206, 158, 0, 0.4);
    pointer-events: none;
    z-index: 3;
  }

  /* Postmark detail on the stamp */
  .postage-stamp::after {
    content: '★ COFFEE REUSE';
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.6rem;
    font-weight: bold;
    color: var(--qb-amber);
    border: 1px solid var(--qb-amber);
    padding: 1px 4px;
    border-radius: 1px;
    z-index: 4;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.85);
  }

  .qbag-artwork-card:hover .postage-stamp {
    transform: translateY(-8px) rotate(1.5deg) scale(1.02);
    box-shadow: 
      0 18px 36px rgba(19, 66, 82, 0.12),
      0 4px 12px rgba(0, 0, 0, 0.04);
  }

  .qbag-artwork-card:hover .stamp-hologram-glare {
    background-position: 200% 200%;
  }

  /* Right Side: Content & Action */
  .artwork-card-text-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .artwork-card-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--qb-primary);
    letter-spacing: 0.25em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .qbag-artwork-card .artwork-card-title {
    background: linear-gradient(to right, #c17a2e 10%, #208c8d 50%, #c17a2e 90%);
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: qbag-gold-shine-title 10s linear infinite;
    color: transparent;
    font-family: 'Syne', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  @keyframes qbag-gold-shine-title {
    to { background-position: 200% center; }
  }

  .qbag-artwork-card .artwork-card-description {
    color: var(--qb-text-muted);
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.6;
    font-weight: 400;
    margin: 0 0 2rem 0;
    text-align: left;
  }

  .artwork-card-button.qb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #ffcc33 0%, #c17a2e 100%);
    color: #ffffff;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 80px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 
      0 4px 14px rgba(193, 122, 46, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
  }

  .artwork-card-button.qb-btn svg {
    transition: transform 0.35s ease;
  }

  .artwork-card-button.qb-btn:hover {
    background: linear-gradient(135deg, #208c8d 0%, #176d6e 100%);
    color: #ffffff;
    box-shadow: 
      0 6px 20px rgba(32, 140, 141, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .artwork-card-button.qb-btn:hover svg {
    transform: translateX(4px);
  }

  /* ─── Closing ─── */
  .qbag-closing-section {
    padding: 6rem 0;
    text-align: center;
  }

  .qbag-closing-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 5rem 2rem;
    border-top: 1px solid var(--qb-border);
    border-bottom: 1px solid var(--qb-border);
  }

  .qbag-big-statement {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.35;
    color: var(--qb-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* ─── Contact links ─── */
  .qbag-portal-links {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 2rem 0;
  }

  .qbag-portal-links a {
    /* #208c8d on #faf7f2 = contrast ~4.8:1  ✓ WCAG AA */
    color: var(--qb-primary);
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .qbag-portal-links a:hover { opacity: 0.75; }

  .qbag-portal-sep {
    margin: 0 0.75rem;
    opacity: 0.4;
  }

  /* ─── CTA ─── */
  .qbag-cta {
    padding: 5rem 0 7rem;
    text-align: center;
  }

  .qbag-retreat-btn {
    display: inline-block;
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--qb-amber);
    color: var(--qb-amber);
    padding: 1.25rem 3rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 4px;
  }

  .qbag-retreat-btn:hover {
    background: rgba(193, 122, 46, 0.08);
    color: var(--qb-amber);
    box-shadow: 0 4px 16px rgba(193, 122, 46, 0.15);
  }

  /* ═══════════════════════════════════════
     NATIVE <dialog> GALLERY
     ═══════════════════════════════════════ */
  .qbag-gallery-dialog {
    /* Reset browser defaults */
    border: none;
    padding: 0;
    margin: 0;
    outline: none;
    /* Full-screen modal */
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    /* flex column to stack controls + viewport */
    display: none; /* overridden by [open] below */
    flex-direction: column;
  }

  .qbag-gallery-dialog[open] {
    display: flex;
  }

  .qbag-gallery-dialog::backdrop {
    background: rgba(250, 247, 242, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* ─── Controls bar ─── */
  .gallery-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(193, 122, 46, 0.12);
    flex-shrink: 0;
    background: var(--qb-bg, #faf7f2);
  }

