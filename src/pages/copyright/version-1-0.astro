---
import Layout from "../../layouts/Layout.astro";
import SubPageNav from "../../components/SubPageNav.astro";
import SlimNav from "../../components/SlimNav.astro";

const scheduleFields = ["Artwork title", "Client", "Commission date", "Permitted use", "Approved products", "Maximum production quantity", "Media and platforms", "Territory", "Licence duration", "Exclusive or non-exclusive", "Permitted alterations", "Required credit", "Licence fee", "Files supplied", "Embargo or confidentiality", "Additional conditions"];
