</Layout>

<style>
  .archive-page { min-height: 100vh; background: #f6f4ef; color: #171714; padding: max(6rem, calc(env(safe-area-inset-top) + 5rem)) 1.5rem 4rem; }
  .archive-shell { max-width: 52rem; margin: auto; font-family: Georgia, serif; }
  header, section { border-bottom: 1px solid #c8c5bd; padding: 2rem 0; }
  header > p:first-child, dt, footer { font: 700 .65rem/1.5 "Space Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 1rem 0 2rem; font: 700 clamp(2.4rem, 7vw, 5rem)/.93 "Space Grotesk", sans-serif; letter-spacing: -.06em; text-transform: uppercase; }
  h2 { margin: 0 0 1rem; font: 700 1.35rem/1.2 "Space Grotesk", sans-serif; }
  p { font-size: 1.05rem; line-height: 1.7; }
  a { color: #a23c2c; }
  header dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 2rem 0 0; border: 1px solid #171714; }
  header dl div { padding: .8rem; border-right: 1px solid #171714; } header dl div:last-child { border: 0; }
  dd { margin: .35rem 0 0; font: .8rem "Space Mono", monospace; }
  .archive-notice { padding: 1rem; background: #e4ff75; font-family: "Space Mono", monospace; font-size: .75rem; }
  .emphasis { padding: .8rem 1rem; border-left: 4px solid #d94832; background: #fff; font-family: "Space Mono", monospace; font-weight: 700; }
  .covenant { margin: 2rem -1.25rem; padding: 2rem 1.25rem; background: #171714; color: #f6f4ef; border: 0; } .covenant .emphasis { color: #e4ff75; background: transparent; border-color: #e4ff75; }
  .schedule { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid #c8c5bd; } .schedule div { padding: .7rem; border-bottom: 1px solid #c8c5bd; } .schedule div:nth-child(odd) { border-right: 1px solid #c8c5bd; } .schedule dd { color: #6a665f; }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 2rem 0; color: #5d5952; }
  @media (max-width: 560px) { header dl, .schedule { grid-template-columns: 1fr; } header dl div, .schedule div:nth-child(odd) { border-right: 0; border-bottom: 1px solid #c8c5bd; } header dl div:last-child { border-bottom: 0; } .covenant { margin-inline: 0; } }
  @media print { :global([data-subpage-nav]), :global(.slim-nav) { display: none !important; } .archive-page { padding: 0; } }
</style>
