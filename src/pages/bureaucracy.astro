<script>
  // ── Scroll reveal observer ──────────────────────────────────────────
  // LEARN: IntersectionObserver fires when elements enter the viewport.
  // We add 'is-revealed' to trigger CSS transitions defined below.
  function initBurReveal() {
    const html = document.documentElement;
    if (!html.dataset.motionReady) html.dataset.motionReady = "1";

    const staggerParents = document.querySelectorAll("[data-motion-stagger]");
    const singles = document.querySelectorAll(
      ".bur-wrap .q888-reveal:not([data-motion-stagger])"
    );

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-revealed");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.08 }
    );

    staggerParents.forEach((el) => io.observe(el));
    singles.forEach((el) => io.observe(el));
  }

  initBurReveal();
  document.addEventListener("astro:page-load", initBurReveal);

  // ── Compost accordion ──────────────────────────────────────────────
  function initCompostAccordion() {
    document.querySelectorAll("[data-bur-case]").forEach((card) => {
      const trigger = card.querySelector(".bur-compost-header") as HTMLButtonElement | null;
      const body = card.querySelector(".bur-compost-body") as HTMLElement | null;
      const icon = card.querySelector(".bur-compost-toggle") as HTMLElement | null;
      if (!trigger || !body) return;
      if (trigger.dataset.burCaseInit) return;
      trigger.dataset.burCaseInit = "1";

      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
        if (isOpen) {
          body.hidden = true;
          if (icon) icon.textContent = "+";
          card.classList.remove("is-open");
        } else {
          body.hidden = false;
          if (icon) icon.textContent = "−";
          card.classList.add("is-open");
        }
      });
    });
  }

  initCompostAccordion();
  document.addEventListener("astro:page-load", initCompostAccordion);
</script>

