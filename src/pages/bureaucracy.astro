    font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    line-height: 0.92;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
  }

  .bur-hl-pre {
    font-size: clamp(1.2rem, 4vw, 2rem);
    color: rgba(255, 255, 255, 0.55);
    font-weight: 700;
    letter-spacing: 0.25em;
    font-family: ui-monospace, monospace;
  }

  .bur-hl-main {
    font-size: clamp(3.5rem, 12vw, 9rem);
    color: rgba(255, 255, 255, 0.92);
    font-weight: 700;
    line-height: 0.88;
  }

  .bur-hl-sub {
    font-size: clamp(2rem, 7vw, 5.5rem);
    color: rgba(255, 255, 255, 0.60);
    font-weight: 700;
    line-height: 1;
  }

  .bur-hero-subtitle {
    font-family: ui-monospace, monospace;
    font-size: clamp(0.65rem, 1.5vw, 0.8rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.60);
    max-width: 42rem;
    line-height: 1.6;
  }

  /* Intro copy */
  .bur-hero-intro {
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bur-hero-intro p {
    font-size: clamp(0.8rem, 1.8vw, 0.95rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.75);
    font-family: ui-monospace, monospace;
    letter-spacing: 0.02em;
  }

  .bur-hero-caveat {
    font-size: 0.85rem !important;
    color: rgba(255, 255, 255, 0.50) !important;
    letter-spacing: 0.08em;
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    padding-left: 0.75rem;
  }

  /* Scroll pulse */
  .bur-scroll-pulse {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.40);
    animation: bur-pulse 3s ease-in-out infinite;
  }

  @keyframes bur-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }


  /* ═══════════════════════════════════════════════
     SHARED SECTION STYLES
  ═══════════════════════════════════════════════ */
  .bur-section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 5rem 0;
  }

  .bur-section-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 768px) {
    .bur-section-inner {
      padding: 0 3rem;
    }
  }

  .bur-section-label {
    font-size: 0.9rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.40);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding-bottom: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .bur-section-subtitle {
    font-size: clamp(0.75rem, 1.5vw, 0.9rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.60);
    max-width: 44rem;
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
  }

  /* Inline status chips */
  .bur-method-status,
  .bur-timeline-meta,
  .bur-curator-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .bur-inline-status {
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.3rem 0.65rem;
    white-space: nowrap;
  }

  .bur-inline-status-note {
    color: rgba(240, 200, 180, 0.4);
    border-color: rgba(240, 200, 180, 0.15);
  }

  /* Metadata block rows */
  .bur-meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
  }

  .bur-meta-row {
    display: grid;
    grid-template-columns: 9rem auto 1fr;
    gap: 0 0.5rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .bur-meta-row:last-child {
    border-bottom: none;
  }

  .bur-meta-key {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.50);
    white-space: nowrap;
  }

  .bur-meta-sep {
    color: rgba(255, 255, 255, 0.40);
    font-size: 0.95rem;
  }

  .bur-meta-val {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .bur-materials {
    letter-spacing: 0.05em;
    word-break: break-word;
  }


  /* ═══════════════════════════════════════════════
     02. IDENTITY_RECORD
  ═══════════════════════════════════════════════ */
  .bur-identity-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 860px) {
    .bur-identity-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .bur-identity-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-identity-heading {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(1.1rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.15;
    margin: 0 0 0.5rem;
  }

  .bur-identity-copy p {
    font-size: clamp(0.8rem, 1.6vw, 0.95rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.72);
  }

  .bur-identity-note {
    font-size: 0.85rem !important;
    color: rgba(255, 255, 255, 0.48) !important;
    border-left: 2px solid rgba(255, 255, 255, 0.08);
    padding-left: 0.75rem;
    letter-spacing: 0.04em;
  }


  /* ═══════════════════════════════════════════════
     03. METHOD_ENGINE
  ═══════════════════════════════════════════════ */
  .bur-method-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 860px) {
    .bur-method-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .bur-method-distinction {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bur-distinction-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
  }

  .bur-distinction-row-alt {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
  }

  .bur-distinction-label {
    font-size: 0.88rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
  }

  .bur-distinction-text {
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
  }

  .bur-distinction-text-highlight {
    color: rgba(255, 255, 255, 0.9);
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-weight: 700;
  }

  .bur-distinction-divider {
    text-align: center;
    color: rgba(255, 255, 255, 0.12);
    font-size: 1.2rem;
    letter-spacing: 0.4em;
  }

  .bur-method-desc {
    font-size: clamp(0.75rem, 1.5vw, 0.875rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.60);
    margin-top: 0.25rem;
  }

  .bur-method-formulas {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bur-formula-block {
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
  }

  .bur-formula-label {
    font-size: 0.88rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 1.25rem;
  }

  .bur-formula-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .bur-formula-node {
    font-size: clamp(0.7rem, 1.5vw, 0.875rem);
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.80);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.3rem 0.7rem;
  }

  .bur-formula-node-final {
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.05);
  }

  .bur-formula-arrow {
    color: rgba(255, 255, 255, 0.40);
    font-size: 0.9rem;
  }

  .bur-code-formula {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-code-line {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-size: clamp(0.65rem, 1.3vw, 0.8rem);
    line-height: 1.7;
    flex-wrap: wrap;
  }

  .bur-code-agent {
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.06em;
  }

  .bur-code-sep {
    color: rgba(255, 255, 255, 0.45);
  }

  .bur-code-action {
    color: rgba(255, 255, 255, 0.62);
  }

  .bur-code-line-final .bur-code-agent,
  .bur-code-line-final .bur-code-action {
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
  }


  /* ═══════════════════════════════════════════════
     04. EVIDENCE GRID
  ═══════════════════════════════════════════════ */
  .bur-evidence-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  @media (min-width: 540px) {
    .bur-evidence-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .bur-evidence-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bur-evidence-card {
    background: #121212;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: background 160ms ease;
    cursor: pointer;
  }

  .bur-evidence-card:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .bur-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bur-card-code {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .bur-card-status {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.15rem 0.4rem;
  }

  .bur-card-name {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(0.85rem, 1.8vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.2;
  }

  .bur-card-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.58);
    flex: 1;
  }

  .bur-card-footer {
    margin-top: auto;
  }

  .bur-card-access {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.40);
    transition: color 160ms ease;
  }

  .bur-evidence-card:hover .bur-card-access {
    color: rgba(255, 255, 255, 0.75);
  }


  /* ═══════════════════════════════════════════════
     05. TIMELINE
  ═══════════════════════════════════════════════ */
  .bur-timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 2rem;
  }

  .bur-timeline-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.3rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .bur-timeline-entry::before {
    content: "";
    position: absolute;
    left: -2.4rem;
    top: 1.5rem;
    width: 6px;
    height: 6px;
    border: 1px solid rgba(255, 255, 255, 0.40);
    background: #121212;
    border-radius: 50%;
  }

  @media (min-width: 640px) {
    .bur-timeline-entry {
      grid-template-columns: 14rem 1fr;
      gap: 0 2rem;
    }
  }

  .bur-timeline-marker {
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
    padding-top: 0.1rem;
    word-break: break-all;
  }

  .bur-timeline-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bur-timeline-event {
    font-size: clamp(0.8rem, 1.6vw, 0.95rem);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .bur-timeline-note {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.48);
    line-height: 1.5;
  }

  .bur-timeline-footnote {
    margin-top: 2rem;
    padding-top: 1.5rem;
  }

  .bur-redacted-inline {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.04em;
    user-select: none;
  }

  .bur-timeline-fn-text {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.40);
    text-transform: uppercase;
  }


  /* ═══════════════════════════════════════════════
     06. HUMAN CODE FRAGMENTS
  ═══════════════════════════════════════════════ */
  .bur-fragment-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .bur-fragment-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bur-fragment-block {
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .bur-fragment-label {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    padding: 0.65rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .bur-code-block {
    margin: 0;
    padding: 1.25rem 1rem;
    background: transparent;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
    white-space: pre;
    overflow-x: auto;
  }


  /* ═══════════════════════════════════════════════
     07. EARTH_RECORD
  ═══════════════════════════════════════════════ */
  .bur-earth {
    background: rgba(255, 255, 255, 0.015);
  }

  .bur-earth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 860px) {
    .bur-earth-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .bur-earth-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-earth-preface {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    font-weight: 700;
    border-left: 2px solid rgba(255, 255, 255, 0.35);
    padding-left: 1rem;
    line-height: 1.5;
  }

  .bur-earth-copy p {
    font-size: clamp(0.75rem, 1.5vw, 0.88rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.62);
  }

  .bur-earth-footnote {
    font-size: 0.95rem !important;
    color: rgba(255, 255, 255, 0.42) !important;
    letter-spacing: 0.06em;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }


  /* ═══════════════════════════════════════════════
     08. CURATOR_SAFE_MODE
  ═══════════════════════════════════════════════ */
  .bur-curator-intro {
    font-size: clamp(0.78rem, 1.5vw, 0.9rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.58);
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .bur-curator-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    max-width: 44rem;
  }

  @media (min-width: 560px) {
    .bur-curator-actions {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 860px) {
    .bur-curator-actions {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bur-action-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 160ms ease, background 160ms ease;
    cursor: pointer;
  }

  .bur-action-btn:hover {
    border-color: rgba(255, 255, 255, 0.48);
    background: rgba(255, 255, 255, 0.06);
  }

  .bur-action-btn-primary {
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.04);
  }

  .bur-action-btn-primary:hover {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
  }

  .bur-btn-icon {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.50);
    flex-shrink: 0;
    transition: color 160ms ease;
  }

  .bur-action-btn:hover .bur-btn-icon {
    color: rgba(255, 255, 255, 0.7);
  }

  .bur-btn-label {
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    flex: 1;
  }

  .bur-btn-status {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .bur-action-btn:hover .bur-btn-status {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Footer stamp */
  .bur-footer-stamp {
    margin-top: 4rem;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-stamp-line {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.1);
    letter-spacing: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .bur-stamp-text {
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.40);
    line-height: 1.8;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .bur-stamp-sep {
    color: rgba(255, 255, 255, 0.1);
  }

  /* ── Media query: mobile tweaks ── */
  @media (max-width: 540px) {
    .bur-status-grid {
      grid-template-columns: 1fr 1fr;
    }

    .bur-status-item {
      border-right: none;
      margin-right: 0;
      padding-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .bur-curator-actions {
      grid-template-columns: 1fr;
    }

    .bur-formula-chain {
      gap: 0.35rem;
    }

    .bur-timeline-entry {
      grid-template-columns: 1fr;
    }
  }

  /* ── Hover: pointer media (non-touch) ── */
  @media (hover: none) {
    .bur-evidence-card:hover {
      background: #121212;
    }
    .bur-action-btn:hover {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.025);
    }
  }


  /* ═══════════════════════════════════════════════
     REJECTION_ARCHIVE
  ═══════════════════════════════════════════════ */
  .bur-rejection {
    background: rgba(255, 255, 255, 0.01);
  }

  .bur-rejection-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .bur-rejection-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 860px) {
    .bur-rejection-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  /* Left col: intro copy */
  .bur-rejection-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .bur-rejection-heading {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(1.1rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.15;
    margin: 0 0 0.25rem;
  }

  .bur-rejection-copy p {
    font-size: clamp(0.78rem, 1.5vw, 0.9rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Mutual freedom rule box */
  .bur-mutual-rule {
    margin-top: 0.75rem;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bur-mutual-rule-label {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .bur-mutual-rule-lines {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bur-mutual-rule-lines p {
    font-size: clamp(0.82rem, 1.6vw, 0.95rem) !important;
    color: rgba(255, 255, 255, 0.75) !important;
    line-height: 1.5 !important;
    font-style: italic;
    margin: 0;
  }

  /* Right col: protocol block */
  .bur-protocol-block {
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bur-protocol-label {
    font-size: 0.88rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.65rem;
  }

  .bur-protocol-intro {
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
  }

  .bur-protocol-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-protocol-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding-bottom: 0.35rem;
  }

  .bur-proto-num {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.42);
    flex-shrink: 0;
    min-width: 1.5rem;
  }

  /* Failure block */
  .bur-protocol-failure {
    padding: 1rem;
    border: 1px solid rgba(255, 80, 80, 0.12);
    background: rgba(255, 80, 80, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .bur-pf-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 150, 150, 0.4);
    margin-bottom: 0.4rem;
  }

  .bur-pf-row {
    display: grid;
    grid-template-columns: 12rem auto 1fr;
    gap: 0 0.4rem;
    align-items: baseline;
  }

  .bur-pf-key {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
    white-space: nowrap;
  }

  .bur-pf-sep {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.9rem;
  }

  .bur-pf-val {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.70);
  }

  .bur-pf-restricted {
    color: rgba(255, 140, 120, 0.75);
  }

  /* ── Case list & cards ── */
  .bur-case-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .bur-case-card {
    background: #0c0c0c;
    overflow: hidden;
  }

  .bur-case-card.is-open {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  /* Collapsed trigger row */
  .bur-case-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 140ms ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    flex-wrap: wrap;
  }

  .bur-case-header:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .bur-case-card.is-open .bur-case-header {
    background: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bur-case-header-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .bur-case-number {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    flex-shrink: 0;
  }

  .bur-case-institution {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(0.85rem, 1.8vw, 1.05rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.02em;
  }

  .bur-case-event {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.50);
  }

  .bur-case-header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .bur-case-badge {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border: 1px solid;
    white-space: nowrap;
  }

  .bur-badge-restricted {
    color: rgba(255, 140, 120, 0.7);
    border-color: rgba(255, 140, 120, 0.2);
    background: rgba(255, 80, 60, 0.04);
  }

  .bur-badge-generic {
    color: rgba(255, 255, 200, 0.45);
    border-color: rgba(255, 255, 200, 0.12);
    background: rgba(255, 255, 150, 0.02);
  }

  .bur-case-toggle-icon {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.50);
    line-height: 1;
    width: 1.5rem;
    text-align: center;
    flex-shrink: 0;
    transition: color 140ms ease;
    font-family: ui-monospace, monospace;
    font-weight: 300;
  }

  .bur-case-card.is-open .bur-case-toggle-icon {
    color: rgba(255, 255, 255, 0.80);
  }

  /* Expanded body */
  .bur-case-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    animation: bur-case-open 200ms ease;
  }

  @keyframes bur-case-open {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Case fields grid */
  .bur-case-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.015);
  }

  @media (min-width: 640px) {
    .bur-case-fields {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bur-case-field {
    display: grid;
    grid-template-columns: 9rem auto 1fr;
    gap: 0 0.4rem;
    padding: 0.38rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    align-items: baseline;
  }

  .bur-case-field:last-child {
    border-bottom: none;
  }

  .bur-cf-key {
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.46);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bur-cf-sep {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.9rem;
  }

  .bur-cf-val {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.80);
    word-break: break-word;
  }

  .bur-cf-warning {
    color: rgba(255, 200, 120, 0.75);
  }

  /* Response block row */
  .bur-case-response {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  @media (min-width: 640px) {
    .bur-case-response {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bur-case-response-block {
    padding: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.015);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-crb-restricted {
    border-color: rgba(255, 100, 80, 0.18);
    background: rgba(255, 60, 40, 0.04);
  }

  .bur-crb-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .bur-crb-val {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }

  .bur-crb-val-restricted {
    color: rgba(255, 140, 120, 0.85);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Smallprint */
  .bur-case-smallprint {
    font-size: 0.58rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.42);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1rem;
    letter-spacing: 0.04em;
    font-style: italic;
  }

  /* Wide fields that span both grid columns */
  .bur-case-field-wide {
    grid-column: 1 / -1;
  }

  .bur-cf-quote {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .bur-cf-translation {
    color: rgba(255, 200, 140, 0.65);
    text-transform: none;
    letter-spacing: 0.02em;
    font-style: italic;
    line-height: 1.6;
  }

  /* WHY_ACCESS_IS_RESTRICTED block */
  .bur-why-block {
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.018);
    overflow: hidden;
  }

  .bur-why-label {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .bur-why-core {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bur-why-lead {
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.3;
  }

  .bur-why-core p {
    font-size: clamp(0.75rem, 1.4vw, 0.875rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.68);
    margin: 0;
  }

  .bur-why-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .bur-why-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
  }

  .bur-why-num {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.40);
    flex-shrink: 0;
    min-width: 1.25rem;
  }

  .bur-why-note {
    color: rgba(255, 255, 255, 0.55) !important;
    font-style: italic;
    border-left: 2px solid rgba(255, 255, 255, 0.08);
    padding-left: 0.75rem;
  }

  /* PUBLIC_NOTE panel — the sharp clear rule at bottom of WHY block */
  .bur-public-note {
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bur-public-note-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.40);
    margin-bottom: 0.1rem;
  }

  .bur-public-note p {
    font-size: clamp(0.75rem, 1.4vw, 0.875rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .bur-public-note-rule {
    color: rgba(255, 255, 255, 0.75) !important;
    font-style: italic;
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-weight: 700;
    font-size: clamp(0.82rem, 1.5vw, 0.95rem) !important;
  }

  /* ── Mobile overrides ── */
  @media (max-width: 540px) {
    .bur-case-fields {
      grid-template-columns: 1fr;
    }
    .bur-case-response {
      grid-template-columns: 1fr;
    }
    .bur-case-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .bur-case-header-right {
      width: 100%;
      justify-content: space-between;
    }
    .bur-pf-row {
      grid-template-columns: 10rem auto 1fr;
    }
    .bur-mutual-rule-lines p {
      font-size: 0.95rem !important;
    }
  }

  @media (hover: none) {
    .bur-case-header:hover {
      background: transparent;
    }
  }

  /* ═══════════════════════════════════════════════════════════
     ANIMATIONS & VISUAL UPGRADE
  ═══════════════════════════════════════════════════════════ */

  /* Ghost background word in hero */
  .bur-ghost-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Space Grotesk", ui-sans-serif, sans-serif;
    font-weight: 700;
    font-size: clamp(6rem, 22vw, 18rem);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.07);
    text-shadow: 0 0 60px rgba(255,255,255,0.06);
    user-select: none;
    pointer-events: none;
    z-index: 0;
    animation: bur-ghost-drift 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes bur-ghost-drift {
    0%   { transform: translateX(-2%) translateY(0);   opacity: 0.5; }
    50%  { transform: translateX(2%)  translateY(-1%); opacity: 1;   }
    100% { transform: translateX(-1%) translateY(1%);  opacity: 0.6; }
  }

  /* Data stream canvas */
  .bur-datastream {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  /* Ensure hero inner is above canvas */
  .bur-hero-inner {
    position: relative;
    z-index: 1;
  }

  /* Scanline now has a slow sweep animation */
  @keyframes bur-scan-sweep {
    0%   { background-position: 0 0; }
    100% { background-position: 0 200px; }
  }

  .bur-scanlines {
    animation: bur-scan-sweep 8s linear infinite;
  }

  /* Enhanced blinking dot (already existed, now with color shift) */
  @keyframes bur-blink {
    0%, 100% { opacity: 1;   box-shadow: 0 0 4px rgba(180,220,180,0.6); }
    50%       { opacity: 0.1; box-shadow: none; }
  }

  /* Status val glowing accent */
  .bur-val-active {
    text-shadow: 0 0 12px rgba(180,255,180,0.15);
  }

  /* Headline gradient on the main title word */
  .bur-hl-main {
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(200,200,190,0.7) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Section label: animated accent underline */
  .bur-section-label {
    position: relative;
    overflow: hidden;
  }

  .bur-section-label::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 0;
    background: rgba(255, 255, 255, 0.45);
    transition: width 600ms cubic-bezier(0.22,1,0.36,1) 100ms;
  }

  .bur-section.is-revealed .bur-section-label::after,
  .bur-section-label.is-revealed::after {
    width: 100%;
  }

  /* Timeline dot: glow on scroll-in */
  .bur-timeline-entry.is-revealed::before {
    background: rgba(255, 255, 255, 0.70);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.50);
    animation: bur-dot-ping 1.6s ease-out;
  }

  @keyframes bur-dot-ping {
    0%   { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.60); }
    70%  { box-shadow: 0 0 0 8px rgba(255,255,255,0);  }
    100% { box-shadow: 0 0 0 0 rgba(255,255,255,0);    }
  }

  /* Evidence card: glow hover */
  .bur-evidence-card {
    transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    position: relative;
  }

  .bur-evidence-card:hover {
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1), 0 0 24px rgba(255,255,255,0.03);
  }

  /* Restricted badge: slow red pulse */
  .bur-badge-restricted {
    animation: bur-restricted-pulse 3.5s ease-in-out infinite;
  }

  @keyframes bur-restricted-pulse {
    0%, 100% { box-shadow: none;                               }
    50%       { box-shadow: 0 0 10px rgba(255,100,80,0.18);    }
  }

  /* Glitch flash on RESTRICTED text */
  .bur-crb-val-restricted.bur-glitch-active {
    animation: bur-glitch-flash 140ms steps(1) forwards;
  }

  @keyframes bur-glitch-flash {
    0%  { opacity: 1;   transform: translateX(0);   filter: none; }
    25% { opacity: 0.4; transform: translateX(2px); filter: hue-rotate(90deg); }
    50% { opacity: 1;   transform: translateX(-1px);filter: none; }
    75% { opacity: 0.6; transform: translateX(1px); filter: hue-rotate(-45deg); }
    100%{ opacity: 1;   transform: translateX(0);   filter: none; }
  }

  /* Case file: subtle scan on open */
  .bur-case-card.is-open .bur-case-fields {
    animation: bur-case-scan 0.5s ease;
  }

  @keyframes bur-case-scan {
    0%   { border-color: rgba(255, 255, 255, 0.38); }
    60%  { border-color: rgba(255,255,255,0.06); }
    100% { border-color: rgba(255,255,255,0.06); }
  }

  /* WHY block lead: glow on reveal */
  .bur-why-lead {
    text-shadow: 0 0 20px rgba(255,255,255,0.08);
    transition: text-shadow 400ms ease;
  }

  /* Mutual-rule italic lines: warmer tint */
  .bur-mutual-rule-lines p {
    background: linear-gradient(90deg, rgba(255,255,240,0.8) 0%, rgba(255, 255, 255, 0.85) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Protocol failure block: subtle red breathing border */
  .bur-protocol-failure {
    animation: bur-red-breath 5s ease-in-out infinite;
  }

  @keyframes bur-red-breath {
    0%, 100% { border-color: rgba(255,80,80,0.12); }
    50%       { border-color: rgba(255,80,80,0.22); }
  }

  /* ── DECREE STYLES ── */
  .bur-decree {
    border: 1px solid rgba(255,80,60,0.2);
    background: rgba(255,40,30,0.04);
    overflow: hidden;
    position: relative;
    animation: bur-decree-appear 400ms ease;
  }

  @keyframes bur-decree-appear {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0);   }
  }

  /* Animated top accent line on decree */
  .bur-decree::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,100,80,0.5), transparent);
    animation: bur-decree-line 3s ease-in-out infinite;
  }

  @keyframes bur-decree-line {
    0%   { opacity: 0.4; transform: scaleX(0.8); }
    50%  { opacity: 1;   transform: scaleX(1);   }
    100% { opacity: 0.4; transform: scaleX(0.8); }
  }

  .bur-decree-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(255,80,60,0.12);
    background: rgba(255,40,30,0.04);
  }

  .bur-decree-icon {
    font-size: 0.85rem;
    color: rgba(255,130,110,0.55);
    animation: bur-blink 2.8s ease-in-out infinite;
  }

  .bur-decree-title {
    font-size: 0.88rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,130,110,0.65);
    flex: 1;
  }

  .bur-decree-body {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-decree-preamble {
    font-size: clamp(0.78rem,1.4vw,0.9rem);
    line-height: 1.8;
    color: rgba(255,220,210,0.65);
  }

  .bur-decree-sub {
    font-size: 0.85rem;
