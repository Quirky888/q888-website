---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";

const bureaucracyMetaItems = [
  { field: "document_status", label: "DOCUMENT_STATUS", value: "SUBMITTED",        width: 9  },
  { field: "myth_index",      label: "MYTH_INDEX",      value: "ACTIVE",           width: 7  },
  { field: "bureau_level",    label: "BUREAUCRACY_LVL", value: "GALLERY",          width: 7  },
  { field: "reality_anchor",  label: "REALITY_ANCHOR",  value: "VESSEL CONFIRMED", width: 16 },
];

const selectedSystems = [
  {
    code: "SYS-001",
    name: "DIGITAL INK",
    desc: "A system for memory, scarcity and traceable digital creation.",
    status: "OPERATIONAL",
    href: "/#projects",
  },
  {
    code: "SYS-002",
    name: "INFOCIGAN",
    desc: "A speculative marketplace for objects, belief and optional nonsense.",
    status: "ACTIVE",
    href: "/#infocigan",
  },
  {
    code: "SYS-003",
    name: "AERO V1",
    desc: "A performance artefact for reducing drag through belief, style-watts and atmospheric fiction.",
    status: "DEPLOYED",
    href: "/aero/",
  },
  {
    code: "SYS-004",
    name: "DYNO MILK",
    desc: "A bio-dairy future product for status, satire and interdimensional wealth signalling.",
    status: "PHASE 4",
    href: "/dyno/",
  },
  {
    code: "SYS-005",
    name: "EDINBURGH MAGICAL MAP",
    desc: "A mythic cartography of place, memory and hidden infrastructure.",
    status: "ARCHIVAL",
    href: "/#projects",
  },
  {
    code: "SYS-006",
    name: "CiQU BRAND IDENTITY",
    desc: "Controlled visual communication for Earth-based chocolate bureaucracy.",
    status: "DELIVERED",
    href: "/#projects",
  },
  {
    code: "SYS-007",
    name: "HUMAN CODE",
    desc: "Readable rules for AI, art, memory, ethics and impossible worlds.",
    status: "ENABLED",
    href: "/#projects",
  },
  {
    code: "SYS-008",
    name: "ARTIFICIAL ENTELECHY",
    desc: "A meaning engine for allowing fragments to become worlds.",
    status: "IN PROGRESS",
    href: "/#projects",
  },
];

const timeline = [
  {
    marker: "1982BBB",
    event: "Born before Big Bang.",
    note: "Administrative date error still unresolved.",
  },
  {
    marker: "GARAVASTAR_OPENING",
    event: "First known access point into Q888 internal architecture.",
    note: "Location: classified.",
  },
  {
    marker: "SQUARE_BUBBLE_PERIOD",
    event: "Soft systems discovered inside hard borders.",
    note: "Physics complaints filed. Dismissed.",
  },
  {
    marker: "SMART_PIXEL_ERA",
    event: "Digital matter begins remembering its source.",
    note: "Memory becomes material.",
  },
  {
    marker: "HUMAN_CODE_ACTIVATION",
    event: "Readable rules for AI, art, memory and ethical absurdity.",
    note: "System: online.",
  },
  {
    marker: "GALLERY_BUREAUCRACY_PHASE",
    event: "Q888 becomes partially compatible with open-call paperwork.",
    note: "CURATOR_SAFE_MODE: partially enabled.",
  },
];

const codeFragments = [
  {
    label: "FRAGMENT_001 // MEMORY_AS_PIXEL",
    code: `if memory_becomes_pixel:
    do_not_duplicate
    keep_origin_alive
    treat_image_as_sentimental_matter`,
  },
  {
    label: "FRAGMENT_002 // WORLD_SEED_CHECK",
    code: `if idea_makes_me_laugh_and_think:
    do_not_throw_away
    let_it_grow_rules
    check_if_it_is_world_seed`,
  },
  {
    label: "FRAGMENT_003 // SOFT_BORDER_PROTOCOL",
    code: `if world_is_too_square:
    make_bubble_soft
    allow_error_to_become_art
    confirm_that_myth_is_valid_infrastructure`,
  },
];
---

<Layout title="For Gallery Bureaucracy — Q888">
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" customItems={bureaucracyMetaItems} />

  <main class="bur-wrap" id="bur-main">

    <!-- ══════════════════════════════════════════════════════
         01. HERO / ENTRY TERMINAL
    ══════════════════════════════════════════════════════ -->
    <section class="bur-hero" id="bur-hero" aria-label="Entry terminal">
      <div class="bur-scanlines" aria-hidden="true"></div>

      <!-- Ghost background word -->
      <div class="bur-ghost-bg" aria-hidden="true">BUREAUCRACY</div>

      <!-- Data-stream canvas -->
      <canvas class="bur-datastream" id="bur-datastream" aria-hidden="true"></canvas>

      <div class="bur-hero-inner">
        <!-- Terminal entry banner -->
        <div class="bur-entry-banner q888-reveal" data-motion-stagger>
          <span class="bur-entry-tag q888-reveal-item" style="--reveal-index:0">[ INSTITUTIONAL PORTAL // GALLERY-GRADE ACCESS ]</span>
          <span class="bur-entry-tag bur-entry-tag-mono q888-reveal-item" style="--reveal-index:1">
            RECORD_TYPE: ARTIST_SYSTEM &nbsp;//&nbsp; OPEN_CALL_COMPATIBILITY: EXPERIMENTAL
          </span>
        </div>

        <!-- Status grid -->
        <div class="bur-status-grid q888-reveal" data-motion-stagger>
          <div class="bur-status-item q888-reveal-item" style="--reveal-index:0">
            <span class="bur-status-label">DOCUMENT_STATUS</span>
            <span class="bur-status-val">SUBMITTED</span>
          </div>
          <div class="bur-status-item q888-reveal-item" style="--reveal-index:1">
            <span class="bur-status-label">MYTH_INDEX</span>
            <span class="bur-status-val bur-val-active">
              <span class="bur-dot" aria-hidden="true"></span>ACTIVE
            </span>
          </div>
          <div class="bur-status-item q888-reveal-item" style="--reveal-index:2">
            <span class="bur-status-label">CURATOR_SAFE_MODE</span>
            <span class="bur-status-val">PARTIALLY ENABLED</span>
          </div>
          <div class="bur-status-item q888-reveal-item" style="--reveal-index:3">
            <span class="bur-status-label">OPEN_CALL_COMPAT</span>
            <span class="bur-status-val">EXPERIMENTAL</span>
          </div>
        </div>

        <!-- Main title -->
        <div class="bur-hero-title-wrap">
          <h1 class="bur-headline q888-reveal">
            <span class="bur-hl-pre">FOR</span>
            <span class="bur-hl-main">GALLERY</span>
            <span class="bur-hl-sub">BUREAUCRACY</span>
          </h1>
          <p class="bur-hero-subtitle q888-reveal">
            Artist record, mythic credentials, and administrative proof of Q888 existence.
          </p>
        </div>

        <!-- Intro -->
        <div class="bur-hero-intro q888-reveal">
          <p>
            This page exists for institutions, galleries, curators, open calls, grant forms,
            residencies, archives, and other Earth-based systems requiring evidence that
            Q888 can be processed by bureaucracy without fully dissolving into it.
          </p>
          <p class="bur-hero-caveat">
            // NOTE: Processing may take longer than expected. Q888 does not become normal for bureaucracy.
            Bureaucracy becomes one more material inside Q888.
          </p>
        </div>

        <!-- Scroll indicator -->
        <div class="bur-scroll-pulse" aria-hidden="true">
          <span>▼</span>
          <span>SCROLL TO PROCESS RECORD</span>
          <span>▼</span>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         02. IDENTITY_RECORD
    ══════════════════════════════════════════════════════ -->
    <section class="bur-section bur-identity" id="bur-identity" aria-label="Identity record">
      <div class="bur-section-inner">
        <div class="bur-section-label">IDENTITY_RECORD</div>

        <div class="bur-identity-grid">
          <!-- Metadata block -->
          <div class="bur-meta-block q888-reveal" data-motion-stagger>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:0">
              <span class="bur-meta-key">ENTITY_ID</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">Q888</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:1">
              <span class="bur-meta-key">EARTH_NAME</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">ALEKSANDRS SESTAKOVS</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:2">
              <span class="bur-meta-key">BIRTH_MARKER</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">1982BBB</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:3">
              <span class="bur-meta-key">ENTITY_TYPE</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">ARTIST-SYSTEM</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:4">
              <span class="bur-meta-key">LOCATION</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">EDINBURGH, EARTH // SECTOR 3W</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:5">
              <span class="bur-meta-key">PRIMARY_MATERIALS</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val bur-materials">
                MYTH · CODE · IMAGE · INTERFACE · MEMORY · ABSURDITY
              </span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:6">
              <span class="bur-meta-key">RECORD_INTEGRITY</span>
              <span class="bur-meta-sep">:</span>
              <span class="bur-meta-val">OFFICIALLY_UNSTABLE</span>
            </div>
          </div>

          <!-- Description copy -->
          <div class="bur-identity-copy q888-reveal">
            <h2 class="bur-identity-heading">Q888 IS AN ARTIST-SYSTEM.</h2>
            <p>
              Working with visual mythologies, symbolic infrastructure, AI-assisted world-building,
              fictional technologies, and Human Code.
            </p>
            <p>
              The practice treats artworks not only as images, but as rules, portals,
              certificates, memory units, speculative products, and small pieces of alternative
              reality trying to become operational.
            </p>
            <p class="bur-identity-note">
              // The work builds symbolic systems, narrative architectures and speculative tools.
              It treats myth, code and interface as equal materials.
              This site is not a portfolio. It is an entry point into living systems.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         03. METHOD_ENGINE
    ══════════════════════════════════════════════════════ -->
    <section class="bur-section bur-method" id="bur-method" aria-label="Method engine">
      <div class="bur-section-inner">
        <div class="bur-section-label">METHOD_ENGINE</div>

        <div class="bur-method-status q888-reveal" data-motion-stagger>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:0">METHOD_ENGINE: ARTIFICIAL ENTELECHY</span>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:1">HUMAN_CODE: ENABLED</span>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:2">MEANING_EXTRACTION: IN PROGRESS</span>
        </div>

        <div class="bur-method-grid">
          <!-- Left: distinction block -->
          <div class="bur-method-distinction q888-reveal">
            <div class="bur-distinction-row">
              <span class="bur-distinction-label">ARTIFICIAL INTELLIGENCE ASKS:</span>
              <span class="bur-distinction-text">What is the answer?</span>
            </div>
            <div class="bur-distinction-divider" aria-hidden="true">—</div>
            <div class="bur-distinction-row bur-distinction-row-alt">
              <span class="bur-distinction-label">ARTIFICIAL ENTELECHY ASKS:</span>
              <span class="bur-distinction-text bur-distinction-text-highlight">
                What is this trying to become?
              </span>
            </div>
            <p class="bur-method-desc">
              Q888 uses AI not only as a tool, but as a meaning engine — a mirror that helps
              unfinished ideas, jokes, mistakes, memories and symbols unfold into systems.
            </p>
          </div>

          <!-- Right: formula blocks -->
          <div class="bur-method-formulas">
            <div class="bur-formula-block q888-reveal">
              <div class="bur-formula-label">PIXEL_TO_ENTITY FORMULA</div>
              <div class="bur-formula-chain" aria-label="Pixels to Pattern to Form to Story to Entity">
                <span class="bur-formula-node">Pixels</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Pattern</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Form</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Story</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node bur-formula-node-final">Entity</span>
              </div>
            </div>

            <div class="bur-formula-block q888-reveal">
              <div class="bur-formula-label">HUMAN_CODE FORMULA</div>
              <div class="bur-code-formula">
                <div class="bur-code-line">
                  <span class="bur-code-agent">AI</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">builds structure.</span>
                </div>
                <div class="bur-code-line">
                  <span class="bur-code-agent">Artificial Entelechy</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">unfolds direction.</span>
                </div>
                <div class="bur-code-line">
                  <span class="bur-code-agent">Human Code</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">protects meaning.</span>
                </div>
                <div class="bur-code-line bur-code-line-final">
                  <span class="bur-code-agent">Q888</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">gives it a world.</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         04. SELECTED SYSTEMS / EVIDENCE GRID
    ══════════════════════════════════════════════════════ -->
    <section class="bur-section bur-evidence" id="bur-evidence" aria-label="Selected systems evidence grid">
      <div class="bur-section-inner">
        <div class="bur-section-label">SELECTED_SYSTEMS // EVIDENCE_GRID</div>
        <p class="bur-section-subtitle q888-reveal">
          The following systems have been produced, tested, or deployed within the Q888 operational field.
          Each constitutes a form of evidence. Evidence of what, exactly, remains under review.
        </p>

        <div class="bur-evidence-grid" data-motion-stagger>
          {selectedSystems.map((sys, i) => (
            <a
              href={sys.href}
              class="bur-evidence-card q888-reveal-item"
              style={`--reveal-index:${i}`}
              aria-label={`${sys.name} — ${sys.desc}`}
            >
              <div class="bur-card-header">
                <span class="bur-card-code">{sys.code}</span>
                <span class="bur-card-status">{sys.status}</span>
              </div>
              <div class="bur-card-name">{sys.name}</div>
              <p class="bur-card-desc">{sys.desc}</p>
              <div class="bur-card-footer">
                <span class="bur-card-access">ACCESS RECORD →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         05. REJECTION_ARCHIVE / GALLERY ACCESS RESTRICTIONS
    ══════════════════════════════════════════════════════ -->
    <section class="bur-section bur-rejection" id="bur-rejection" aria-label="Rejection archive — gallery access restrictions">
      <div class="bur-section-inner">
        <div class="bur-section-label">REJECTION_ARCHIVE // GALLERY ACCESS RESTRICTIONS</div>

        <!-- Status row -->
        <div class="bur-rejection-status q888-reveal" data-motion-stagger>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:0">REJECTION_ARCHIVE: ACTIVE</span>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:1">FEEDBACK_RECEIVED: GENERIC</span>
          <span class="bur-inline-status q888-reveal-item" style="--reveal-index:2">TEMPLATE_DEMON: SUSPECTED</span>
          <span class="bur-inline-status bur-inline-status-note q888-reveal-item" style="--reveal-index:3">Q888_MOOD: NO HARD FEELINGS / NO FUTURE DEALINGS</span>
        </div>

        <div class="bur-rejection-grid">
          <!-- Left col: intro copy -->
          <div class="bur-rejection-copy q888-reveal">
            <h2 class="bur-rejection-heading">NOT EVERY PORTAL OPENS.</h2>
            <p>
              Some galleries receive artist labour, images, statements, application forms,
              submission fees, emotional energy and time — then return a perfectly polished
              generic rejection unit.
            </p>
            <p>
              Q888 accepts rejection as part of artistic life.
            </p>
            <p>
              However, when a paid or labour-intensive application receives no meaningful
              feedback, no useful explanation, and no visible sign that the artist was seen
              as more than an entry in a spreadsheet, the rejection becomes material.
            </p>
            <p>
              In the Q888 system, generic rejection letters are archived as bureaucratic fossils:
              small institutional objects proving that an artist was processed, but not really met.
            </p>

            <!-- Mutual freedom rule -->
            <div class="bur-mutual-rule q888-reveal">
              <div class="bur-mutual-rule-label">// CORE_PRINCIPLE</div>
              <div class="bur-mutual-rule-lines">
                <p>Galleries can reject Q888.</p>
                <p>Q888 can reject galleries back.</p>
                <p>Everybody remains free. The portal closes politely.</p>
              </div>
            </div>
          </div>

          <!-- Right col: minimum feedback protocol -->
          <div class="bur-protocol-block q888-reveal">
            <div class="bur-protocol-label">Q888 MINIMUM FEEDBACK PROTOCOL</div>
            <p class="bur-protocol-intro">
              To avoid entering the Generic Reply Museum, an institution may provide:
            </p>
            <ol class="bur-protocol-list">
              <li><span class="bur-proto-num">01</span> One human sentence.</li>
              <li><span class="bur-proto-num">02</span> One useful clue.</li>
              <li><span class="bur-proto-num">03</span> One sign that somebody actually looked.</li>
              <li><span class="bur-proto-num">04</span> Optional mercy biscuit.</li>
            </ol>
            <div class="bur-protocol-failure">
              <div class="bur-pf-label">FAILURE TO COMPLY MAY RESULT IN:</div>
              <div class="bur-pf-row"><span class="bur-pf-key">REPRESENTATION_ACCESS</span><span class="bur-pf-sep">:</span><span class="bur-pf-val bur-pf-restricted">RESTRICTED</span></div>
              <div class="bur-pf-row"><span class="bur-pf-key">PORTAL_STATUS</span><span class="bur-pf-sep">:</span><span class="bur-pf-val">CLOSED FROM THIS SIDE</span></div>
              <div class="bur-pf-row"><span class="bur-pf-key">FUTURE_Q888_DEALINGS</span><span class="bur-pf-sep">:</span><span class="bur-pf-val">UNLIKELY BUT TECHNICALLY REVERSIBLE</span></div>
            </div>
          </div>
        </div>

        <!-- ── Case files ── -->
        <div class="bur-case-list q888-reveal" data-motion-stagger>

          <!-- CASE FILE 001 -->
          <div class="bur-case-card q888-reveal-item" style="--reveal-index:0" data-bur-case>
            <!-- Collapsed header (always visible) -->
            <button
              class="bur-case-header"
              aria-expanded="false"
              aria-controls="bur-case-001-body"
              id="bur-case-001-trigger"
              type="button"
            >
              <div class="bur-case-header-left">
                <span class="bur-case-number">CASE_FILE_001</span>
                <span class="bur-case-institution">&amp;Gallery</span>
                <span class="bur-case-event">Open Call 2026 // Edinburgh</span>
              </div>
              <div class="bur-case-header-right">
                <span class="bur-case-badge bur-badge-restricted">ACCESS_RESTRICTED</span>
                <span class="bur-case-badge bur-badge-generic">GENERIC_REPLY_DETECTED</span>
                <span class="bur-case-toggle-icon" aria-hidden="true">+</span>
              </div>
            </button>

            <!-- Expanded body -->
            <div
              class="bur-case-body"
              id="bur-case-001-body"
              role="region"
              aria-labelledby="bur-case-001-trigger"
              hidden
            >
              <!-- Metadata fields grid -->
              <div class="bur-case-fields">
                <div class="bur-case-field">
                  <span class="bur-cf-key">INSTITUTION</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">&amp;Gallery</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">LOCATION</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Edinburgh / Earth</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">EVENT</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Open Call 2026 — September Group Exhibition</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">PORTAL_TYPE</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Paid / labour-intensive open call</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">SUBMITTED_WORKS</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Dyno Milk · Edinburgh Magical Map</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">SUBMISSION_DEADLINE</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">30 June 2026</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">OUTCOME</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Not selected</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">REPLY_TYPE</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Generic polite fog</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">FEEDBACK_DEPTH</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Approximately 0.8mm</span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">ARTIST_LABOUR</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val">Confirmed</span>
                </div>
                <div class="bur-case-field bur-case-field-wide">
                  <span class="bur-cf-key">OFFICIAL_REPLY_FLAVOUR</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val bur-cf-quote">"Strong response / carefully considered / curatorial direction."</span>
                </div>
                <div class="bur-case-field bur-case-field-wide">
                  <span class="bur-cf-key">Q888_TRANSLATION</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val bur-cf-translation">
                    Thank you, artist-unit. Your labour has been absorbed.
                    No further meaning will be provided.
                  </span>
                </div>
                <div class="bur-case-field">
                  <span class="bur-cf-key">TEMPLATE_DEMON</span>
                  <span class="bur-cf-sep">:</span>
                  <span class="bur-cf-val bur-cf-warning">Strongly suspected</span>
                </div>
              </div>

              <!-- WHY ACCESS IS RESTRICTED — main explanation block -->
              <div class="bur-why-block">
