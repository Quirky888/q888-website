---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";

const selectedSystems = [
  {
    code: "01",
    name: "Digital Ink",
    desc: "A system for memory, scarcity and traceable digital creation.",
    status: "Operational",
    href: "/#projects",
  },
  {
    code: "02",
    name: "Overpriced",
    desc: "Collectibles where price is part of the narrative and the price tag becomes material.",
    status: "Active",
    href: "/overpriced/",
  },
  {
    code: "03",
    name: "Aero V1",
    desc: "A performance artefact for reducing drag through belief, style-watts and atmospheric fiction.",
    status: "Deployed",
    href: "/aero/",
  },
  {
    code: "04",
    name: "Dyno Milk",
    desc: "A bio-dairy future product for status, satire and interdimensional wealth signalling.",
    status: "Phase 4",
    href: "/dyno/",
  },
  {
    code: "05",
    name: "Edinburgh Magical Map",
    desc: "A mythic cartography of place, memory and hidden infrastructure.",
    status: "Archival",
    href: "/map/",
  },
  {
    code: "06",
    name: "Chromatic Sovereignty Treaty",
    desc: "An intergalactic legal accord governing the balance between The Void and The Singularity.",
    status: "Ratified",
    href: "/docs/black_and_white_contract.pdf",
  },
  {
    code: "07",
    name: "Human Code",
    desc: "Readable rules for AI, art, memory, ethics and impossible worlds.",
    status: "Enabled",
    href: "/#projects",
  },
  {
    code: "08",
    name: "Artificial Entelechy",
    desc: "An artistic research framework for allowing fragments to become worlds.",
    status: "In progress",
    href: "/docs/Q888_AE_Adaptive_Competence_Development_Draft_July_2026.pdf",
  },
];

const fieldRecords = [
  {
    place: "Touched",
    location: "Tbilisi, Georgia",
    format: "Collaborative exhibition",
    note: "A real-world contact point where Q888 entered shared exhibition space.",
    status: "Public record",
  },
  {
    place: "Chateau Chapiteau",
    location: "Georgia",
    format: "Forest / community field record",
    note: "Site-specific objects from the underground mycelium phase. White cube not required.",
    status: "Physical works",
  },
  {
    place: "Private Flat Exhibition",
    location: "Edinburgh, Scotland",
    format: "Invitation-only exhibition",
    note: "Protected by chosen vibes. Memory preserved; access remains selective.",
    status: "Archive on request",
  },
  {
    place: "Sticker Placements",
    location: "Global",
    format: "Distributed underground practice",
    note: "Works placed across travel routes and public surfaces. The city becomes a gallery wall.",
    status: "Ongoing",
  },
  {
    place: "Unpublished Archive",
    location: "Various",
    format: "Works, sketches, systems and stories",
    note: "A larger root system remains available for curatorial conversations and research visits.",
    status: "Private / on request",
  },
];

const mythicTimeline = [
  ["1982bbb", "Born before the Big Bang", "Administrative date error unresolved."],
  ["Garavastar", "First known portal", "Q888 internal architecture becomes accessible."],
  ["Square Bubble", "Soft systems inside hard borders", "Physics complaints dismissed."],
  ["Smart Pixel", "Digital matter remembers its source", "Memory becomes material."],
  ["Human Code", "Readable rules activated", "Meaning receives technical protection."],
  ["Now", "Mushroom phase visible", "The mycelium was always there."],
];
---

<Layout title="Artist CV & Bureaucratic Dossier — Q888">
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>

  <main class="dossier" id="bureaucracy-main">
    <header class="dossier-hero" id="record">
      <div class="hero-copy">
        <p class="eyebrow">For gallery bureaucracy · Form Q888/CV</p>
        <h1>
          Q888
          <span>Aleksandrs Sestakovs</span>
        </h1>
        <p class="hero-role">Multidisciplinary artist · Edinburgh, Scotland</p>
        <p class="hero-statement">
          I build visual mythologies, speculative products and functioning interfaces.
          The work treats code, image, humour, memory and invented institutions as equal materials.
        </p>
      </div>

      <aside class="hero-record" aria-label="Artist record summary">
        <div class="specimen-mark">
          <img src="/images/bur-icons/mushroom.png" alt="Watercolour mushroom, the visible part of the Q888 mycelium" width="1024" height="1024" />
          <span class="specimen-stamp">record alive</span>
        </div>
        <dl class="record-list">
          <div><dt>Entity</dt><dd>Q888</dd></div>
          <div><dt>Earth name</dt><dd>Aleksandrs Sestakovs</dd></div>
          <div><dt>Born</dt><dd>Latvia · 1982bbb</dd></div>
          <div><dt>Based</dt><dd>Edinburgh, Earth</dd></div>
          <div><dt>Materials</dt><dd>Myth · code · image · interface · memory</dd></div>
          <div><dt>Status</dt><dd><span class="status-dot" aria-hidden="true"></span>Available for portals</dd></div>
        </dl>
      </aside>
    </header>

    <nav class="dossier-index" aria-label="Artist dossier sections">
      <span class="index-label">Dossier</span>
      <a href="#practice">Practice</a>
      <a href="#works">Selected works</a>
      <a href="#field-record">Field record</a>
      <a href="#method">Method</a>
      <a href="#earth-record">Earth record</a>
    </nav>

    <section class="dossier-section practice" id="practice" aria-labelledby="practice-title">
      <div class="section-number">01</div>
      <div class="section-heading">
        <p class="section-kicker">Practice</p>
        <h2 id="practice-title">The joke becomes a system.</h2>
      </div>
      <div class="section-content practice-grid">
        <div class="prose lead-prose">
          <p>
            Q888 is an artist-system working across visual mythology, symbolic infrastructure,
            AI-assisted world-building, fictional technologies and Human Code.
          </p>
          <p>
            Artworks may arrive as images, portals, certificates, maps, memory units,
            speculative products or small pieces of alternative reality trying to become operational.
          </p>
        </div>
        <blockquote>
          “What is this idea trying to become—and what structure lets it enter reality
          without losing its soul?”
          <cite>Working question, Artificial Entelechy</cite>
        </blockquote>
        <dl class="practice-facts">
          <div><dt>Disciplines</dt><dd>Art, design, world-building, interface and speculative systems</dd></div>
          <div><dt>Research</dt><dd>Artificial Entelechy · Adaptive Competence · Human Code</dd></div>
          <div><dt>Current phase</dt><dd>The mushroom has appeared above ground</dd></div>
        </dl>
      </div>
    </section>

    <section class="dossier-section" id="works" aria-labelledby="works-title">
      <div class="section-number">02</div>
      <div class="section-heading section-heading-row">
        <div>
          <p class="section-kicker">Selected systems</p>
          <h2 id="works-title">Evidence of practice.</h2>
        </div>
        <p>Eight operational fragments. Evidence of what, exactly, remains under review.</p>
      </div>
      <div class="section-content work-list">
        {selectedSystems.map((system) => (
          <a
            class="work-row"
            href={system.href}
            target={system.href.endsWith(".pdf") ? "_blank" : undefined}
            rel={system.href.endsWith(".pdf") ? "noopener noreferrer" : undefined}
          >
            <span class="work-number">{system.code}</span>
            <span class="work-name">{system.name}</span>
            <span class="work-description">{system.desc}</span>
            <span class="work-status">{system.status}</span>
            <span class="work-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="dossier-section" id="field-record" aria-labelledby="field-title">
      <div class="section-number">03</div>
      <div class="section-heading section-heading-row">
        <div>
          <p class="section-kicker">Exhibitions & field record</p>
          <h2 id="field-title">Not every mushroom arrives with paperwork.</h2>
        </div>
        <p>The archive is real. Visibility is selective. Verification is available.</p>
      </div>
      <div class="section-content field-list">
        {fieldRecords.map((record) => (
          <article class="field-row">
            <div class="field-place">
              <h3>{record.place}</h3>
              <span>{record.location}</span>
            </div>
            <p>{record.format}</p>
            <p>{record.note}</p>
            <span class="field-status">{record.status}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="dossier-section" id="method" aria-labelledby="method-title">
      <div class="section-number">04</div>
      <div class="section-heading">
        <p class="section-kicker">Method mycelium</p>
        <h2 id="method-title">Three rules under the surface.</h2>
      </div>
      <div class="section-content method-grid">
        <article>
          <span>01 · Direction</span>
          <h3>Artificial Entelechy</h3>
          <p>AI can build structure. Entelechy asks what unfinished fragments are trying to become.</p>
        </article>
        <article>
          <span>02 · Protection</span>
          <h3>Human Code</h3>
          <p>Readable rules keep intention, ethics, memory and humour alive inside technical systems.</p>
        </article>
        <article>
          <span>03 · Contact</span>
          <h3>The Bridge</h3>
          <p>Humanisation is an interface—not an ontology. A bridge creates contact without claiming sameness.</p>
        </article>
      </div>

      <details class="myth-drawer">
        <summary>
          <span>Open the non-linear CV</span>
          <small>Optional mythology · chronology slightly damaged</small>
        </summary>
        <ol class="myth-timeline">
          {mythicTimeline.map(([marker, event, note]) => (
            <li>
              <span>{marker}</span>
              <strong>{event}</strong>
              <p>{note}</p>
            </li>
          ))}
        </ol>
      </details>

      <details class="myth-drawer compost-drawer">
        <summary>
          <span>Open the rejection compost</span>
          <small>Optional bureaucracy · bitterness level 1/5</small>
        </summary>
        <div class="compost-content">
          <div>
            <p class="compost-lead">Some portals open. Some send a polite fog machine and keep the submission fee.</p>
            <p>This drawer keeps those fog machines. Not with hatred. Mostly for compost.</p>
          </div>
          <div class="protocol">
            <p>Q888 minimum feedback protocol</p>
            <ol>
              <li>One human sentence.</li>
              <li>One useful clue.</li>
              <li>One sign that somebody actually looked.</li>
              <li>Optional mercy biscuit.</li>
            </ol>
          </div>

          <article class="compost-case" aria-labelledby="compost-case-gallery">
            <header class="compost-case-header">
              <div>
                <p class="compost-case-number">Compost note 001 · Edinburgh / Earth</p>
                <h3 id="compost-case-gallery">&amp;Gallery</h3>
              </div>
              <span class="compost-case-status">Portal closed · reversible</span>
            </header>

            <dl class="compost-case-facts">
              <div>
                <dt>Event</dt>
                <dd>Open Call 2026 · September Group Exhibition</dd>
              </div>
              <div>
                <dt>Portal type</dt>
                <dd>Paid / labour-intensive open call</dd>
              </div>
              <div>
                <dt>Submitted works</dt>
                <dd>Dyno Milk · Edinburgh Magical Map</dd>
              </div>
              <div>
                <dt>Outcome</dt>
                <dd>Not selected</dd>
              </div>
              <div>
                <dt>Reply type</dt>
                <dd>Generic polite fog</dd>
              </div>
              <div>
                <dt>Feedback depth</dt>
                <dd>Approximately 0.8mm</dd>
              </div>
            </dl>

            <div class="compost-reason">
              <p class="compost-reason-label">Why this record is in the compost</p>
              <div>
                <h4>The rejection was not the problem. The generic fog was.</h4>
                <p>
                  Q888 does not require selection. Q888 requires evidence of looking.
                  The reply said that the response was strong, applications were carefully considered,
                  and the final choice followed the curatorial direction. It explained that a decision
                  happened, but offered no specific response to either submitted work.
                </p>
                <p>
                  After an artist pays, prepares images and statements, completes the form, and gives
                  time, attention and emotional energy, a reusable rejection template provides no useful
                  return. The artist learns nothing about the work and feels processed rather than met.
                </p>
                <ol>
                  <li>The gallery had many applications.</li>
                  <li>The gallery made a decision.</li>
                  <li>The artist learned absolutely nothing.</li>
                </ol>
              </div>
            </div>

            <div class="compost-public-note">
              <p>
                <strong>&amp;Gallery is not here because Q888 was rejected.</strong><br />
                It is here because the rejection gave no meaningful feedback after a paid,
                labour-intensive submission.
              </p>
              <p>
                A gallery is free to choose its artists. An artist is free to choose which
                institutions deserve future attention. This is not conflict. This is mutual curation.
              </p>
            </div>

            <footer class="compost-case-verdict">
              <span><small>Future dealings</small> Unlikely, technically reversible</span>
              <span><small>No hard feelings</small> Active</span>
              <span><small>Future traffic</small> Redirected to other galaxies</span>
            </footer>
          </article>

          <p class="compost-note">
            Galleries can reject Q888. Q888 can reject galleries back.
            Everybody remains free. The portal closes politely.
          </p>
        </div>
      </details>
    </section>

    <section class="dossier-section earth" id="earth-record" aria-labelledby="earth-title">
      <div class="section-number">05</div>
      <div class="section-heading">
        <p class="section-kicker">Earth record</p>
        <h2 id="earth-title">For administrative purposes, the artist also exists on Earth.</h2>
      </div>
      <div class="section-content earth-grid">
        <div class="prose">
          <p class="earth-intro">
            The Earth version drinks coffee, pays rent, writes applications and occasionally
            pretends to understand gallery forms.
          </p>
          <p>
            Aleksandrs Sestakovs is a Latvian-born, Edinburgh-based multidisciplinary artist and designer.
            His background moves through specialty coffee, roasting, quality control, social care,
            volunteering, travel, farm work, identity design, web experiments and independent app development.
          </p>
        </div>
        <div class="contact-card">
          <p>Institutional bridge</p>
          <a href="mailto:hello@q888.space">hello@q888.space</a>
          <div class="contact-actions">
            <a href="mailto:hello@q888.space?subject=Q888%20artist%20CV%20request">Request artist CV</a>
            <a href="mailto:hello@q888.space?subject=Q888%20project%20list%20request">Request project list</a>
            <a href="/#projects">Enter full portfolio</a>
          </div>
          <small>Response time: human. Mythology remains present in all documents.</small>
        </div>
      </div>
    </section>

    <footer class="dossier-footer">
      <span>Q888 · Artist dossier · Edinburgh, Earth</span>
      <span>Document status: alive</span>
    </footer>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 7rem;
  }

  :global(body) {
    margin: 0;
  }

  .dossier {
    --paper: #f1eee6;
    --paper-light: #f8f6f0;
    --ink: #25251f;
    --muted: #6f6c60;
    --line: rgba(37, 37, 31, 0.18);
    --moss: #4f694d;
    --moss-soft: #dfe6d8;
    --clay: #a55e3e;
    min-height: 100vh;
    padding-top: 2.7rem;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(79, 105, 77, 0.07) 1px, transparent 1px) 4.5rem 0 / calc(100% - 9rem) 100%,
      var(--paper);
    font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  }

  .dossier ::selection {
    background: var(--moss);
    color: var(--paper-light);
  }

  .dossier a:focus-visible,
  .dossier summary:focus-visible {
    outline: 3px solid var(--clay);
    outline-offset: 4px;
  }

  .dossier-hero,
  .dossier-section,
  .dossier-footer {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }

  .dossier-hero {
    min-height: min(47rem, calc(100vh - 2.7rem));
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.8fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    padding: clamp(4.5rem, 9vw, 8rem) 0;
  }

  .eyebrow,
  .section-kicker,
  .section-number,
  .index-label {
    margin: 0;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 1.4rem 0 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(5rem, 12vw, 10.5rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.75;
  }

  .hero-copy h1 span {
    display: block;
    width: fit-content;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-left: 0.25rem;
    color: var(--clay);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(0.72rem, 1.35vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-role {
    margin: 3rem 0 1.25rem;
    font-size: clamp(0.78rem, 1.3vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-statement {
    max-width: 42rem;
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.35rem, 2.45vw, 2rem);
    line-height: 1.35;
  }

  .hero-record {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid var(--line);
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
  }

  .specimen-mark {
    position: relative;
    aspect-ratio: 1.1;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .specimen-mark img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    mix-blend-mode: multiply;
    transform: scale(1.08);
  }

  .specimen-stamp {
    position: absolute;
    right: 0.7rem;
    bottom: 0.8rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--clay);
    border-radius: 50%;
    color: var(--clay);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transform: rotate(-8deg);
  }

  .record-list {
    margin: 1.2rem 0 0;
  }

  .record-list div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }

  .record-list dt,
  .record-list dd {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .record-list dt {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    display: inline-block;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--moss);
  }

  .dossier-index {
    position: sticky;
    top: 2.65rem;
    z-index: 20;
    min-height: 3.8rem;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0 4.5rem;
    overflow-x: auto;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(241, 238, 230, 0.94);
    backdrop-filter: blur(14px);
    scrollbar-width: none;
  }

  .dossier-index::-webkit-scrollbar {
    display: none;
  }

  .dossier-index a {
    flex: 0 0 auto;
    padding: 1.2rem 0;
    color: var(--ink);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .dossier-index a:hover {
    color: var(--clay);
  }

  .dossier-section {
    scroll-margin-top: 7rem;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 3.5rem);
    padding: clamp(5rem, 9vw, 8.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .section-number {
    grid-row: 1 / span 2;
    padding-top: 0.3rem;
    color: var(--clay);
  }

  .section-heading {
    max-width: 48rem;
  }

  .section-heading-row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3rem;
  }

  .section-heading-row > p {
    max-width: 25rem;
    margin: 0 0 0.3rem;
    color: var(--muted);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1rem;
    line-height: 1.5;
  }

  .section-heading h2 {
    margin: 0.8rem 0 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.97;
  }

  .section-content {
    grid-column: 2;
    margin-top: clamp(2.75rem, 5vw, 5rem);
  }

  .practice-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .prose p {
    margin: 0 0 1.3rem;
    color: var(--muted);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.65;
  }

  .lead-prose p:first-child {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    line-height: 1.45;
  }

  blockquote {
    margin: 0;
    padding: 1.6rem 0 1.6rem 1.6rem;
    border-left: 3px solid var(--moss);
    color: var(--moss);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.25rem, 2.25vw, 1.75rem);
    font-style: italic;
    line-height: 1.45;
  }

  blockquote cite {
    display: block;
    margin-top: 1.25rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .practice-facts div {
    padding: 1.25rem 1.5rem 0 0;
  }

  .practice-facts div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .practice-facts dt {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
