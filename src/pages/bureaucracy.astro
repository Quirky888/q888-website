---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";

// DNA: selectedSystems data — internal codes kept maintainable; surface names stay human
const selectedSystems = [
  {
    code: "SYS-001",
    name: "Digital Ink",
    desc: "A system for memory, scarcity and traceable digital creation.",
    status: "Operational",
    href: "/#projects",
  },
  {
    code: "SYS-002",
    name: "Infocigan",
    desc: "A speculative marketplace for objects, belief and optional nonsense.",
    status: "Active",
    href: "/#infocigan",
  },
  {
    code: "SYS-003",
    name: "Aero V1",
    desc: "A performance artefact for reducing drag through belief, style-watts and atmospheric fiction.",
    status: "Deployed",
    href: "/aero/",
  },
  {
    code: "SYS-004",
    name: "Dyno Milk",
    desc: "A bio-dairy future product for status, satire and interdimensional wealth signalling.",
    status: "Phase 4",
    href: "/dyno/",
  },
  {
    code: "SYS-005",
    name: "Edinburgh Magical Map",
    desc: "A mythic cartography of place, memory and hidden infrastructure.",
    status: "Archival",
    href: "/#projects",
  },
  {
    code: "SYS-006",
    name: "CiQU Brand Identity",
    desc: "Controlled visual communication for Earth-based chocolate bureaucracy.",
    status: "Delivered",
    href: "/#projects",
  },
  {
    code: "SYS-007",
    name: "Human Code",
    desc: "Readable rules for AI, art, memory, ethics and impossible worlds.",
    status: "Enabled",
    href: "/#projects",
  },
  {
    code: "SYS-008",
    name: "Artificial Entelechy",
    desc: "A meaning engine for allowing fragments to become worlds.",
    status: "In progress",
    href: "/#projects",
  },
];

// DNA: fieldRecords — underground mycelium, not absence
const fieldRecords = [
  {
    place: "Chateau Chapiteau",
    location: "Georgia",
    type: "Forest & Community Installation",
    note: "Site-specific art objects in an alternative forest space. Outside white-cube logic. Mushroom-compatible by design.",
    tone: "site-specific",
    icon: "🌿",
  },
  {
    place: "Touched",
    location: "Tbilisi, Georgia",
    type: "Collaborative Exhibition",
    year: "2025",
    note: "Q888 entering visible shared space. First gallery-adjacent exposure in the current mushroom phase.",
    tone: "emerging",
    icon: "🍄",
  },
  {
    place: "Private Flat Exhibition",
    location: "Edinburgh",
    type: "Invitation-Only",
    note: "Protected by chosen vibes. Not all exhibitions need press releases. Memory preserved, access selective.",
    tone: "mysterious",
    icon: "🔑",
  },
  {
    place: "Sticker Placements",
    location: "Edinburgh · Georgia · India · Thailand · others",
    type: "Distributed Underground Exhibition",
    note: "Public but unregistered. Distributed across travel routes and surfaces. The city as gallery wall.",
    tone: "underground",
    icon: "⬡",
  },
  {
    place: "Unpublished Archive",
    location: "Various / Ongoing",
    type: "Hidden Mycelium",
    note: "Large body of works, sketches, systems, stories, stickers, maps, characters, digital ideas and private mythology. Not absence — underground storage.",
    tone: "dormant",
    icon: "○",
  },
];

const timeline = [
  {
    marker: "1982bbb",
    event: "Born before Big Bang.",
    note: "Administrative date error still unresolved.",
  },
  {
    marker: "Garavastar Opening",
    event: "First known access point into Q888 internal architecture.",
    note: "Location: classified.",
  },
  {
    marker: "Square Bubble Period",
    event: "Soft systems discovered inside hard borders.",
    note: "Physics complaints filed. Dismissed.",
  },
  {
    marker: "Smart Pixel Era",
    event: "Digital matter begins remembering its source.",
    note: "Memory becomes material.",
  },
  {
    marker: "Human Code Activation",
    event: "Readable rules for AI, art, memory and ethical absurdity.",
    note: "System: online.",
  },
  {
    marker: "Mushroom Phase",
    event: "Q888 becomes visible above ground.",
    note: "The mycelium was always there. The mushroom just appeared.",
  },
];

const codeFragments = [
  {
    label: "Fragment 001 // Memory as Pixel",
    code: `if memory_becomes_pixel:\n    do_not_duplicate\n    keep_origin_alive\n    treat_image_as_sentimental_matter`,
  },
  {
    label: "Fragment 002 // World Seed Check",
    code: `if idea_makes_me_laugh_and_think:\n    do_not_throw_away\n    let_it_grow_rules\n    check_if_it_is_world_seed`,
  },
  {
    label: "Fragment 003 // Soft Border Protocol",
    code: `if world_is_too_square:\n    make_bubble_soft\n    allow_error_to_become_art\n    confirm_that_myth_is_valid_infrastructure`,
  },
];
---

<Layout title="For Gallery Bureaucracy — Q888">
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>

  <main class="bur-wrap" id="bur-main">

    <!-- Ambient blobs — organic background atmosphere -->
    <div class="bur-ambient" aria-hidden="true">
      <div class="bur-blob bur-blob-1"></div>
      <div class="bur-blob bur-blob-2"></div>
      <div class="bur-blob bur-blob-3"></div>
      <div class="bur-blob bur-blob-4"></div>
    </div>

    <!-- Drifting spore particles -->
    <div class="bur-spores" aria-hidden="true">
      <span class="bur-spore" style="--sx:12%;--sd:0s;--ss:22s"></span>
      <span class="bur-spore" style="--sx:28%;--sd:4s;--ss:28s"></span>
      <span class="bur-spore" style="--sx:45%;--sd:8s;--ss:19s"></span>
      <span class="bur-spore" style="--sx:62%;--sd:2s;--ss:25s"></span>
      <span class="bur-spore" style="--sx:78%;--sd:12s;--ss:21s"></span>
      <span class="bur-spore" style="--sx:88%;--sd:6s;--ss:30s"></span>
      <span class="bur-spore" style="--sx:35%;--sd:16s;--ss:24s"></span>
      <span class="bur-spore" style="--sx:55%;--sd:20s;--ss:18s"></span>
    </div>


    <!-- ═══════════════════════════════════════════════
         01. HERO — The mushroom has appeared above ground
    ═══════════════════════════════════════════════ -->
    <section class="bur-hero" id="bur-hero" aria-label="For Gallery Bureaucracy — hero">

      <div class="bur-hero-inner">
        <!-- Pre-heading label -->
        <div class="bur-hero-preheading q888-reveal">
          <span class="bur-field-label">For Gallery Bureaucracy</span>
          <span class="bur-field-sep" aria-hidden="true">·</span>
          <span class="bur-field-note">document status: submitted</span>
        </div>

        <!-- Main title -->
        <h1 class="bur-headline q888-reveal">
          The artist CV
          <em class="bur-hl-em">that grew mushrooms</em>
          while waiting<br class="bur-hl-br"/> for institutional review.
        </h1>

        <p class="bur-hero-subtitle q888-reveal">
          Artist record, mythic credentials, and administrative proof of Q888 existence.
          Fields mostly completed. Some fields composted.
        </p>

        <!-- Status pills — soft, not terminal boxes -->
        <div class="bur-status-row q888-reveal" data-motion-stagger>
          <span class="bur-pill q888-reveal-item" style="--reveal-index:0">
            <span class="bur-pill-dot" aria-hidden="true"></span>myth index active
          </span>
          <span class="bur-pill q888-reveal-item" style="--reveal-index:1">curator safe mode: partial</span>
          <span class="bur-pill q888-reveal-item" style="--reveal-index:2">open call compat: experimental</span>
          <span class="bur-pill bur-pill-soft q888-reveal-item" style="--reveal-index:3">mushroom phase: visible</span>
        </div>

        <!-- Intro prose -->
        <div class="bur-hero-intro q888-reveal">
          <p>
            This page exists for institutions, galleries, curators, open calls, grant forms,
            residencies, archives, and other Earth-based systems requiring evidence that
            Q888 can be processed by bureaucracy without fully dissolving into it.
          </p>
          <p class="bur-hero-aside">
            Processing may take longer than expected.<br/>
            Q888 does not become normal for bureaucracy.<br/>
            Bureaucracy becomes one more material inside Q888.
          </p>
        </div>

        <!-- Scroll gesture -->
        <div class="bur-scroll-nudge" aria-hidden="true">
          <span class="bur-scroll-line"></span>
          <span class="bur-scroll-text">keep scrolling — the paperwork has not escaped yet</span>
          <span class="bur-scroll-line"></span>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         02. IDENTITY CLOUD
    ═══════════════════════════════════════════════ -->
    <section class="bur-section bur-identity" id="bur-identity" aria-label="Identity cloud">
      <div class="bur-section-inner">
        <div class="bur-section-tag">identity record</div>

        <div class="bur-identity-grid">
          <!-- Cloud card: identity metadata -->
          <div class="bur-cloud-card bur-identity-meta q888-reveal" data-motion-stagger>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:0">
              <span class="bur-meta-key">Entity</span>
              <span class="bur-meta-val bur-meta-val-strong">Q888</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:1">
              <span class="bur-meta-key">Earth name</span>
              <span class="bur-meta-val">Aleksandrs Sestakovs</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:2">
              <span class="bur-meta-key">Birth marker</span>
              <span class="bur-meta-val">1982bbb</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:3">
              <span class="bur-meta-key">Type</span>
              <span class="bur-meta-val">Artist-System</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:4">
              <span class="bur-meta-key">Location</span>
              <span class="bur-meta-val">Edinburgh, Earth // Sector 3W</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:5">
              <span class="bur-meta-key">Materials</span>
              <span class="bur-meta-val bur-materials">myth · code · image · interface · memory · absurdity</span>
            </div>
            <div class="bur-meta-row q888-reveal-item" style="--reveal-index:6">
              <span class="bur-meta-key">Record integrity</span>
              <span class="bur-meta-val bur-meta-val-note">officially unstable</span>
            </div>
          </div>

          <!-- Identity description -->
          <div class="bur-identity-copy q888-reveal">
            <h2 class="bur-identity-heading">Q888 is an artist-system.</h2>
            <p>
              Working with visual mythologies, symbolic infrastructure, AI-assisted world-building,
              fictional technologies, and Human Code.
            </p>
            <p>
              The practice treats artworks not only as images, but as rules, portals,
              certificates, memory units, speculative products, and small pieces of alternative
              reality trying to become operational.
            </p>
            <p class="bur-identity-aside">
              The work builds symbolic systems, narrative architectures and speculative tools.
              It treats myth, code and interface as equal materials.
              This site is not a portfolio. It is an entry point into living systems.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         03. METHOD MYCELIUM
    ═══════════════════════════════════════════════ -->
    <section class="bur-section bur-method" id="bur-method" aria-label="Method mycelium">
      <div class="bur-section-inner">
        <div class="bur-section-tag">method mycelium</div>

        <div class="bur-method-intro q888-reveal">
          <p>This is the part where the joke becomes a system.</p>
          <p>Artificial Entelechy asks what the idea is trying to become. Human Code checks that it enters reality without losing its soul.</p>
        </div>

        <div class="bur-method-grid">
          <!-- Left: distinction -->
          <div class="bur-cloud-card bur-method-distinction q888-reveal">
            <div class="bur-distinction-row">
              <span class="bur-distinction-label">Artificial Intelligence asks:</span>
              <span class="bur-distinction-text">What is the answer?</span>
            </div>
            <div class="bur-distinction-divider" aria-hidden="true">
              <span class="bur-root-line"></span>
            </div>
            <div class="bur-distinction-row bur-distinction-row-alt">
              <span class="bur-distinction-label">Artificial Entelechy asks:</span>
              <span class="bur-distinction-text bur-distinction-highlight">
                What is this trying to become?
              </span>
            </div>
            <p class="bur-method-desc">
              Q888 uses AI not only as a tool, but as a meaning engine — a mirror that helps
              unfinished ideas, jokes, mistakes, memories and symbols unfold into systems.
            </p>
          </div>

          <!-- Right: formula clouds -->
          <div class="bur-method-formulas">
            <div class="bur-cloud-card bur-formula-cloud q888-reveal">
              <div class="bur-formula-tag">pixel → entity formula</div>
              <div class="bur-formula-chain" aria-label="Pixels to Pattern to Form to Story to Entity">
                <span class="bur-formula-node">Pixels</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Pattern</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Form</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node">Story</span>
                <span class="bur-formula-arrow" aria-hidden="true">→</span>
                <span class="bur-formula-node bur-formula-node-final">Entity</span>
              </div>
            </div>

            <div class="bur-cloud-card bur-formula-cloud q888-reveal">
              <div class="bur-formula-tag">human code formula</div>
              <div class="bur-code-formula">
                <div class="bur-code-line">
                  <span class="bur-code-agent">AI</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">builds structure.</span>
                </div>
                <div class="bur-code-line">
                  <span class="bur-code-agent">Artificial Entelechy</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">unfolds direction.</span>
                </div>
                <div class="bur-code-line">
                  <span class="bur-code-agent">Human Code</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">protects meaning.</span>
                </div>
                <div class="bur-code-line bur-code-line-final">
                  <span class="bur-code-agent">Q888</span>
                  <span class="bur-code-sep">&nbsp;→&nbsp;</span>
                  <span class="bur-code-action">gives it a world.</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         04. SELECTED SYSTEMS — floating clouds
    ═══════════════════════════════════════════════ -->
    <section class="bur-section bur-evidence" id="bur-evidence" aria-label="Selected systems">
      <div class="bur-section-inner">
        <div class="bur-section-tag">selected systems</div>
        <p class="bur-section-subtitle q888-reveal">
          The following systems have been produced, tested, or deployed within the Q888 operational field.
          Each constitutes a form of evidence. Evidence of what, exactly, remains under review.
        </p>

        <div class="bur-systems-grid" data-motion-stagger>
          {selectedSystems.map((sys, i) => (
            <a
              href={sys.href}
              class="bur-system-cloud q888-reveal-item"
              style={`--reveal-index:${i}`}
              aria-label={`${sys.name} — ${sys.desc}`}
            >
              <div class="bur-sys-top">
                <span class="bur-sys-code">{sys.code}</span>
                <span class="bur-sys-status">{sys.status}</span>
              </div>
              <div class="bur-sys-name">{sys.name}</div>
              <p class="bur-sys-desc">{sys.desc}</p>
              <div class="bur-sys-access">explore →</div>
            </a>
          ))}
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         05. FIELD RECORD — Underground Mycelium [NEW]
    ═══════════════════════════════════════════════ -->
    <section class="bur-section bur-field-record" id="bur-field-record" aria-label="Field record — underground mycelium">
      <div class="bur-section-inner">
        <div class="bur-section-tag">field record // underground mycelium</div>

        <div class="bur-field-intro q888-reveal">
          <h2 class="bur-field-heading">The public record may look incomplete.<br/>The network is not.</h2>
          <p>
            Q888's gallery experience is not a clean institutional ladder.
            It is an underground mycelium: forest installations in Georgia,
            a collaborative exhibition in Tbilisi, a private Edinburgh flat exhibition
            protected by chosen vibes, stickers placed across travel routes,
            and a large unpublished archive still growing below the visible surface.
          </p>
          <p class="bur-field-note">
            Q888 is now entering the visible mushroom phase: independent, self-curated,
            harder to ignore, and no longer afraid to redirect gallery traffic elsewhere.
          </p>
        </div>

        <!-- Mycelium node connections -->
        <div class="bur-mycelium-map" aria-label="Underground mycelium field records">
          <div class="bur-mycelium-root" aria-hidden="true"></div>

          <div class="bur-field-nodes" data-motion-stagger>
            {fieldRecords.map((rec, i) => (
              <div
                class={`bur-field-node q888-reveal-item bur-node-tone-${rec.tone}`}
                style={`--reveal-index:${i}`}
              >
                <div class="bur-node-icon" aria-hidden="true">{rec.icon}</div>
                <div class="bur-node-place">{rec.place}</div>
                <div class="bur-node-meta">
                  <span class="bur-node-type">{rec.type}</span>
                  {rec.year && <span class="bur-node-year">{rec.year}</span>}
                  <span class="bur-node-location">{rec.location}</span>
                </div>
                <p class="bur-node-note">{rec.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         06. REJECTION COMPOST — gallery fog archive
    ═══════════════════════════════════════════════ -->
    <section class="bur-section bur-rejection" id="bur-rejection" aria-label="Rejection compost — gallery fog archive">
      <div class="bur-section-inner">
        <div class="bur-section-tag">rejection compost // gallery fog archive</div>

        <div class="bur-rejection-prose q888-reveal">
          <p>Some portals open.</p>
          <p>Some portals send a polite fog machine and keep the submission fee.</p>
          <p>This is where I keep those fog machines.</p>
          <p>Mostly for compost.</p>
        </div>

        <div class="bur-rejection-grid">
          <!-- Left: principle -->
          <div class="bur-cloud-card bur-rejection-copy q888-reveal">
            <h2 class="bur-rejection-heading">Not every portal opens.</h2>
            <p>
              Some galleries receive artist labour, images, statements, application forms,
              submission fees, emotional energy and time — then return a perfectly polished
              generic rejection unit.
            </p>
            <p>Q888 accepts rejection as part of artistic life.</p>
            <p>
              However, when a paid or labour-intensive application receives no meaningful
              feedback, no useful explanation, and no visible sign that the artist was seen
              as more than an entry in a spreadsheet, the rejection becomes material.
            </p>
            <p>
              In the Q888 system, generic rejection letters are archived as bureaucratic fossils:
              small institutional objects proving that an artist was processed, but not really met.
            </p>

            <div class="bur-mutual-cloud">
              <div class="bur-mutual-label">// core principle</div>
              <p>Galleries can reject Q888.</p>
              <p>Q888 can reject galleries back.</p>
              <p>Everybody remains free. The portal closes politely.</p>
            </div>
          </div>

          <!-- Right: minimum feedback protocol -->
          <div class="bur-cloud-card bur-protocol-cloud q888-reveal">
            <div class="bur-protocol-title">Q888 minimum feedback protocol</div>
            <p class="bur-protocol-intro">
              To avoid entering the Generic Reply Museum, an institution may provide:
            </p>
            <ol class="bur-protocol-list">
              <li><span class="bur-proto-num">01</span> One human sentence.</li>
              <li><span class="bur-proto-num">02</span> One useful clue.</li>
              <li><span class="bur-proto-num">03</span> One sign that somebody actually looked.</li>
              <li><span class="bur-proto-num">04</span> Optional mercy biscuit.</li>
            </ol>

            <!-- CHOICE: soft moss/mushroom colour, not aggressive red -->
            <div class="bur-compost-outcome">
              <div class="bur-compost-label">Non-compliance may result in:</div>
              <div class="bur-compost-row">
                <span class="bur-compost-key">Representation access</span>
                <span class="bur-compost-val bur-compost-restricted">Composted</span>
              </div>
              <div class="bur-compost-row">
                <span class="bur-compost-key">Portal status</span>
                <span class="bur-compost-val">Closed from this side</span>
              </div>
              <div class="bur-compost-row">
                <span class="bur-compost-key">Future Q888 dealings</span>
                <span class="bur-compost-val">Unlikely. Technically reversible.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Case files — compost notes -->
        <div class="bur-compost-list q888-reveal" data-motion-stagger>

          <!-- CASE NOTE 001 — &Gallery -->
          <div class="bur-compost-card q888-reveal-item" style="--reveal-index:0" data-bur-case>
            <button
              class="bur-compost-header"
              aria-expanded="false"
              aria-controls="bur-case-001-body"
              id="bur-case-001-trigger"
              type="button"
            >
              <div class="bur-compost-header-left">
                <span class="bur-compost-num">Compost note 001</span>
                <span class="bur-compost-institution">&amp;Gallery</span>
                <span class="bur-compost-event">Open Call 2026 · Edinburgh</span>
              </div>
              <div class="bur-compost-header-right">
                <span class="bur-compost-badge bur-badge-fog">Fog received</span>
                <span class="bur-compost-badge bur-badge-compost">Compost status: active</span>
                <span class="bur-compost-toggle" aria-hidden="true">+</span>
              </div>
            </button>

            <div
              class="bur-compost-body"
              id="bur-case-001-body"
              role="region"
              aria-labelledby="bur-case-001-trigger"
              hidden
            >
              <!-- Case note fields -->
              <div class="bur-note-fields">
                <div class="bur-note-field">
                  <span class="bur-nf-key">Institution</span>
                  <span class="bur-nf-val">&amp;Gallery</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Location</span>
                  <span class="bur-nf-val">Edinburgh / Earth</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Event</span>
                  <span class="bur-nf-val">Open Call 2026 — September Group Exhibition</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Portal type</span>
                  <span class="bur-nf-val">Paid / labour-intensive open call</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Submitted works</span>
                  <span class="bur-nf-val">Dyno Milk · Edinburgh Magical Map</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Outcome</span>
                  <span class="bur-nf-val">Not selected</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Reply type</span>
                  <span class="bur-nf-val">Generic polite fog</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Feedback depth</span>
                  <span class="bur-nf-val">Approximately 0.8mm</span>
                </div>
                <div class="bur-note-field">
                  <span class="bur-nf-key">Artist labour</span>
                  <span class="bur-nf-val">Confirmed</span>
                </div>
                <div class="bur-note-field bur-note-field-wide">
                  <span class="bur-nf-key">Official reply flavour</span>
