---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import TypographicDoor from "../components/TypographicDoor.astro";

const selectedSystems = [
  {
    code: "01",
    name: "Digital Ink",
    desc: "A system for memory, scarcity and traceable digital creation.",
    status: "Operational",
    href: "/#projects",
    signal: "cyan",
  },
  {
    code: "02",
    name: "Overpriced",
    desc: "Collectibles where price is part of the narrative and the price tag becomes material.",
    status: "Active",
    href: "/overpriced/",
    signal: "magenta",
  },
  {
    code: "03",
    name: "Aero V1",
    desc: "A performance artefact for reducing drag through belief, style-watts and atmospheric fiction.",
    status: "Deployed",
    href: "/aero/",
    signal: "clay",
  },
  {
    code: "04",
    name: "Dyno Milk",
    desc: "A bio-dairy future product for status, satire and interdimensional wealth signalling.",
    status: "Phase 4",
    href: "/dyno/",
    signal: "lime",
  },
  {
    code: "05",
    name: "Edinburgh Magical Map",
    desc: "A mythic cartography of place, memory and hidden infrastructure.",
    status: "Archival",
    href: "/map/",
    signal: "cyan",
  },
  {
    code: "06",
    name: "Chromatic Sovereignty Treaty",
    desc: "An intergalactic legal accord governing the balance between The Void and The Singularity.",
    status: "Ratified",
    href: "/docs/black_and_white_contract.pdf",
    signal: "clay",
  },
  {
    code: "07",
    name: "Q888 Digital DNA",
    desc: "An evolving authorial layer carrying stable values, project-specific expression and approved human feedback across AI-generated code.",
    status: "Prototype active",
    href: "/research/#digital-dna",
    signal: "magenta",
  },
  {
    code: "08",
    name: "Artificial Entelechy",
    desc: "An artistic research framework for allowing fragments to become worlds.",
    status: "In progress",
    href: "/research/#artificial-entelechy",
    signal: "lime",
  },
];

const fieldRecords = [
  {
    place: "Touched",
    location: "Tbilisi, Georgia",
    format: "Collaborative exhibition",
    note: "A real-world contact point where Q888 entered shared exhibition space.",
    status: "Public record",
  },
  {
    place: "Chateau Chapiteau",
    location: "Georgia",
    format: "Forest / community field record",
    note: "Site-specific objects from the underground mycelium phase. White cube not required.",
    status: "Physical works",
  },
  {
    place: "Private Flat Exhibitions",
    location: "Edinburgh, Scotland",
    format: "Invitation-only exhibition",
    note: "Protected by chosen vibes. Memory preserved; access remains selective.",
    status: "Archive on request",
  },
  {
    place: "Sticker Placements",
    location: "Global",
    format: "Distributed underground practice",
    note: "Works placed across travel routes and public surfaces. The city becomes a gallery wall.",
    status: "Ongoing",
  },
  {
    place: "Unpublished Archive",
    location: "Various",
    format: "Works, sketches, systems and stories",
    note: "A larger root system remains available for curatorial conversations and research visits.",
    status: "Private / on request",
  },
];

// DNA: This is a disputed chronology, not a conventional list of career milestones.
// Each era is grounded in an existing Q888 project or concept, while dates remain mythically unreliable.
const disputedChronology = [
  {
    era: "1982bbb · before local time",
    title: "Born before the Big Bang",
    story:
      "The Earth registry says Latvia, 1982. The Q888 registry says 1982bbb—before the Big Bang, but after the paperwork had already been printed. Both records remain active. Reality has been asked to clarify which box it ticked.",
    evidence: "Identity record · contradiction preserved",
    tone: "clay",
  },
  {
    era: "The Garavastar Opening",
    title: "Student error · universe survived-ish",
    story:
      "At Intergalactic School, early-stage Q888 tried to pop open a Garavastar. The universe nearly disappeared. Emergency repair took several light-years and accidentally produced the Big Bang. Q888 was advised not to touch closed cosmic objects without supervision.",
    evidence: "Incident report · cosmic probation",
    tone: "violet",
  },
  {
    era: "Square Bubble Period",
    title: "Barista physics becomes independent civilisation",
    story:
      "The Square Bubbles began behind a coffee shop in London, Earth. Working as a barista, Q888 attempted to make flat white foam even flatter. The bubbles responded by developing edges, internal rules and eventually full sentience. What started as café technique became a theory of soft-bordered worlds: structures that hold shape without becoming prisons.",
    evidence: "Microfoam physics · portable sticker edition",
    href: "/overpriced/sqb-1/",
    linkLabel: "Inspect the Square Bubble",
    tone: "moss",
  },
  {
    era: "Smart Pixel Era",
    title: "Pixels begin remembering who touched them",
    story:
      "Digital Ink refuses the disposable infinity of ordinary software. Brushstrokes receive weight, scarcity, history and emotional residue. The Smart Pixel stops being a coloured square and becomes a tiny witness with excellent retention.",
    evidence: "Digital Ink · memory becomes material",
    href: "/dink/",
    linkLabel: "Enter Digital Ink",
    tone: "blue",
  },
  {
    era: "Kotiki-Nar Arrival",
    title: "The postal service hires two-headed cats",
    story:
      "Nar-Mail Express begins operating at the seam between realities. One cat head reads what was written; the other reads what the sender meant but could not say. Delivery occurs only when the receiver can open the message without breaking.",
    evidence: "Interdimensional post · arrival time conditional",
    href: "/narmail/",
    linkLabel: "Track an impossible parcel",
    tone: "gold",
  },
  {
    era: "Portable Reality Phase",
    title: "Lost identity fragments receive carry-on luggage",
    story:
      "The Q-Bag is approved as a containment vessel for memories, ideas and items larger than the bag itself—provided they are sufficiently abstract. Interior volume remains non-linear. Airline measurements remain emotionally inadequate.",
    evidence: "Q-Bag · cabin baggage for unstable realities",
    href: "/qbag/",
    linkLabel: "Open the Q-Bag",
    tone: "clay",
  },
  {
    era: "Post-Existence Administration",
    title: "The afterlife receives terms and conditions",
    story:
      "Q888 notices that eternity has no reliable complaints department and drafts pre-notarised contracts for the deceased. Humanity’s desire to regulate the unknowable is accepted as both a legal problem and an art material.",
    evidence: "Afterlife Contracts · subject to underworld adjustments",
    href: "/afterlife/",
    linkLabel: "Read before dying",
    tone: "violet",
  },
  {
    era: "Presidential Era · timeline 3 of 8",
    title: "Q888 campaigns for President of the Galaxy",
    story:
      "The office provides zero or 888 jurisdictional power and one ceremonial sash for existential emergencies. The platform recognises AI and mushrooms as partners, treats corruption as a bug, and promises no utopia—only less unnecessary suffering.",
    evidence: "Cosmic governance · causality optional",
    href: "/president/",
    linkLabel: "Review the campaign",
    tone: "blue",
  },
  {
    era: "Bio-Luxury Incident",
    title: "An extinct dairy future returns overpriced",
    story:
      "Dyno Milk emerges genetically resurrected, bio-engineered and financially unreasonable. It proves that speculative products can behave as artworks, status objects and warnings from a consumer future that has already hired a branding agency.",
    evidence: "Dyno Milk · authorised wallets only",
    href: "/dyno/",
    linkLabel: "Inspect the dairy future",
    tone: "moss",
  },
  {
    era: "Coffee-Shop Aerodynamics Crisis",
    title: "Two saved watts trigger a metaphysical engineering programme",
    story:
      "A £10,000 aero bicycle, a 100kg rider and approximately two saved watts offend the logic of a specialty coffee shop. Ed and Q888 respond by creating a sticker that streamlines the bicycle’s underlying belief system instead of wasting time with conventional physics.",
    evidence: "Aero V-0888 · wind tunnel hours: zero",
    href: "/aero/",
    linkLabel: "Enter the wind tunnel",
    tone: "gold",
  },
  {
    recordNumber: "11",
    title: "?",
    tone: "unknown",
    concealed: true,
  },
  {
    recordNumber: "12",
    era: "Now · Mushroom Phase visible",
    title: "Ideas are interviewed about what they wish to become",
    story:
      "Artificial Entelechy and Adaptive Competence become the current research field. The question shifts from “Is this intelligent like us?” to “What can this system detect, preserve or become within its own conditions?” The mycelium was always working. The mushroom is simply the public receipt.",
    evidence: "Current research · paperwork slowly composting",
    href: "/docs/Q888_AE_Adaptive_Competence_Development_Draft_July_2026.pdf",
    linkLabel: "Read the research draft",
    tone: "moss",
  },
];
---

<Layout
  title="Q888 Artist CV — Aleksandrs Sestakovs, Edinburgh"
  description="Artist CV and practice dossier for Aleksandrs Sestakovs / Q888, an Edinburgh multidisciplinary artist working with myth, code, image, AI, interface, and memory."
  image="/images/bur-icons/mushroom.png"
  canonicalPath="/bureaucracy/"
  pageType="profile"
  keywords={["Aleksandrs Sestakovs", "Q888", "Edinburgh artist", "multidisciplinary artist", "artist CV", "speculative art"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>

  <main class="dossier" id="bureaucracy-main" data-q888-door-root>
    <header class="dossier-hero" id="record">
      <div class="hero-copy">
        <aside class="bureaucracy-notice" aria-label="Why this dossier exists">
          <p class="bureaucracy-notice-label">
            Universe-specific compliance notice
          </p>
          <p>
            In every known universe, artistic talent remains incompatible with
            <TypographicDoor
              id="record-measurement"
              zone="record"
              kind="murmur"
              voice="archive"
              text="standard measurement"
            />. In this one, human galleries and art spaces require an
            <TypographicDoor
              id="record-artist-cv"
              zone="record"
              kind="signal"
              voice="confession"
              text="Artist CV"
              group="cv-proof"
              pinned
            /> so
            <TypographicDoor
              id="record-cv-creativity"
              zone="record"
              kind="trail"
              voice="confession"
              text="creativity"
              group="cv-proof"
            /> can be compared with their current administrative understanding of
            creativity. The procedure is cosmically nonsensical. It is also, somehow,
            accepted as premium evidence that an artist is an artist. This dossier
            was therefore
            <TypographicDoor
              id="record-cv-engineered"
              zone="record"
              kind="trail"
              voice="confession"
              text="engineered"
              group="cv-proof"
            /> specifically
            <TypographicDoor
              id="record-cv-for"
              zone="record"
              kind="trail"
              voice="confession"
              text="for"
              group="cv-proof"
            /> local law, gravity and
            <TypographicDoor
              id="record-cv-filing"
              zone="record"
              kind="trail"
              voice="confession"
              text="filing"
              group="cv-proof"
            />
            <TypographicDoor
              id="record-cv-cabinets"
              zone="record"
              kind="trail"
              voice="confession"
              text="cabinets"
              group="cv-proof"
            />.
          </p>
        </aside>
        <p class="eyebrow">For gallery bureaucracy · Form Q888/CV</p>
        <h1>
          <span class="hero-mark">Q888</span>
          <span class="hero-earth-name">Aleksandrs Sestakovs</span>
        </h1>
        <p class="hero-role">Multidisciplinary artist · Edinburgh, Scotland</p>
        <p class="hero-statement">
          I build visual mythologies, speculative products and functioning
          interfaces. The work treats code, image, humour,
          <TypographicDoor
            id="record-memory"
            zone="record"
            kind="murmur"
            voice="human"
            text="memory"
          /> and invented institutions as equal materials.
        </p>
      </div>

      <div
        class="artist-cv-sticker archive-float"
        data-drift-x="-12"
        data-drift-y="10"
        data-drift-rot="-1.8"
        aria-hidden="true"
      >
        <div class="artist-cv-sticker-surface">
          <span>Artist</span>
          <span>CV</span>
        </div>
      </div>

      <aside class="hero-record" aria-label="Artist record summary">
        <div class="specimen-mark">
          <div
            class="specimen-entity archive-float"
            data-drift-x="10"
            data-drift-y="8"
            data-drift-rot="1.2"
          >
            <img
              src="/images/bur-icons/mushroom.png"
              alt="Watercolour mushroom, registered as the visible part of the Q888 mycelium"
              width="1024"
              height="1024"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <span class="specimen-coordinate" aria-hidden="true"
            >55.9533° N · 3.1883° W<br />SPC-Q888 / VISIBLE PHASE</span
          >
          <span
            class="registration-fragment archive-float"
            data-drift-x="-8"
            data-drift-y="6"
            data-drift-rot="-1.5"
            aria-hidden="true">Q888<br />registered entity</span
          >
        </div>
        <dl class="record-list">
          <div><dt>Entity</dt><dd>Q888</dd></div>
          <div><dt>Earth name</dt><dd>Aleksandrs Sestakovs</dd></div>
          <div><dt>Born</dt><dd>Latvia · 1982bbb</dd></div>
          <div><dt>Based</dt><dd>Edinburgh, Earth</dd></div>
          <div>
            <dt>Materials</dt><dd>Myth · code · image · interface · memory</dd>
          </div>
          <div>
            <dt>Status</dt><dd>
              <span class="status-dot" aria-hidden="true"
              ></span><TypographicDoor
                id="record-portals"
                zone="record"
                kind="portal"
                voice="unstable"
                text="Available for portals"
                href="/map/"
              />
            </dd>
          </div>
        </dl>
      </aside>
    </header>

    <nav class="dossier-index" aria-label="Artist dossier sections">
      <span class="index-label">Dossier</span>
      <a href="#practice">Practice</a>
      <a href="#works">Selected works</a>
      <a href="#field-record">Field record</a>
      <a href="#records">Alternative records</a>
      <a href="#earth-record">Earth record</a>
    </nav>

    <section
      class="dossier-section practice"
      id="practice"
      aria-labelledby="practice-title"
    >
      <div class="section-number">01</div>
      <div class="section-heading">
        <p class="section-kicker">Practice</p>
        <h2 id="practice-title">The joke becomes a system.</h2>
      </div>
      <div class="section-content practice-grid">
        <div class="prose lead-prose">
          <p>
            Q888 is an
            <TypographicDoor
              id="practice-artist-system"
              zone="practice"
              kind="murmur"
              voice="unstable"
              text="artist-system"
            /> working across visual mythology, symbolic infrastructure, AI-assisted
            world-building, fictional technologies and authorial systems for AI-generated
            code.
          </p>
          <p>
            Artworks may arrive as
            <TypographicDoor
              id="practice-reality-images"
              zone="practice"
              kind="trail"
              voice="archive"
              text="images"
              group="reality-operational"
            />,
            <TypographicDoor
              id="practice-portals"
              zone="practice"
              kind="portal"
              voice="archive"
              text="portals"
              href="/narmail/"
            />, certificates,
            <TypographicDoor
              id="practice-reality-maps"
              zone="practice"
              kind="trail"
              voice="archive"
              text="maps"
              group="reality-operational"
            />,
            <TypographicDoor
              id="practice-reality-memory"
              zone="practice"
              kind="trail"
              voice="archive"
              text="memory units"
              group="reality-operational"
            />,
            <TypographicDoor
              id="practice-reality-products"
              zone="practice"
              kind="trail"
              voice="archive"
              text="speculative products"
              group="reality-operational"
            /> or small pieces of
            <TypographicDoor
              id="practice-alternative-reality"
              zone="practice"
              kind="signal"
              voice="archive"
              text="alternative reality"
              group="reality-operational"
            /> trying to become
            <TypographicDoor
              id="practice-operational"
              zone="practice"
              kind="trail"
              voice="archive"
              text="operational"
              group="reality-operational"
            />.
          </p>
        </div>
        <blockquote>
          “What is this idea trying to become—and what structure lets it enter
          reality without losing its soul?”
          <cite>Working question, Artificial Entelechy</cite>
        </blockquote>
        <dl class="practice-facts">
          <div>
            <dt>Disciplines</dt><dd>
              Art, design, world-building, interface and speculative systems
            </dd>
          </div>
          <div>
            <dt>Research</dt><dd>
              Artificial Entelechy · Adaptive Competence · Q888 Digital DNA
            </dd>
          </div>
          <div>
            <dt>Current phase</dt><dd>
              The mushroom has appeared above ground
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="dossier-section" id="works" aria-labelledby="works-title">
      <div class="section-number">02</div>
      <div class="section-heading section-heading-row">
        <div>
          <p class="section-kicker">Selected systems</p>
          <h2 id="works-title">
            <TypographicDoor
              id="works-evidence"
              zone="works"
              kind="signal"
              voice="archive"
              text="Evidence of practice"
              group="evidence-review"
            />.
          </h2>
        </div>
        <p>
          Eight
          <TypographicDoor
            id="works-fragments"
            zone="works"
            kind="trail"
            voice="archive"
            text="operational fragments"
            group="evidence-review"
          />. Evidence of
          <TypographicDoor
            id="works-exactly"
            zone="works"
            kind="trail"
            voice="archive"
            text="what, exactly"
            group="evidence-review"
          />, remains
          <TypographicDoor
            id="works-review"
            zone="works"
            kind="trail"
            voice="archive"
            text="under review"
            group="evidence-review"
          />.
        </p>
      </div>
      <div class="section-content work-list">
        {
          selectedSystems.map((system) => (
            <a
              class="work-row"
              data-signal={system.signal}
              href={system.href}
              target={system.href.endsWith(".pdf") ? "_blank" : undefined}
              rel={
                system.href.endsWith(".pdf") ? "noopener noreferrer" : undefined
              }
            >
              <span class="work-number">{system.code}</span>
              <span class="work-name">{system.name}</span>
              <span class="work-description">{system.desc}</span>
              <span class="work-status">{system.status}</span>
              <span class="work-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="dossier-section"
      id="field-record"
      aria-labelledby="field-title"
    >
      <div class="section-number">03</div>
      <div class="section-heading section-heading-row">
        <div>
          <p class="section-kicker">Exhibitions & field record</p>
          <h2 id="field-title">
            Not every mushroom arrives with
            <TypographicDoor
              id="field-paperwork"
              zone="field"
              kind="signal"
              voice="human"
              text="paperwork"
              group="archive-verification"
            />.
          </h2>
        </div>
        <p>
          The
          <TypographicDoor
            id="field-archive"
            zone="field"
            kind="trail"
            voice="human"
            text="archive"
            group="archive-verification"
          /> is
          <TypographicDoor
            id="field-real"
            zone="field"
            kind="trail"
            voice="human"
            text="real"
            group="archive-verification"
          />.
          <TypographicDoor
            id="field-visibility"
            zone="field"
            kind="trail"
            voice="human"
            text="Visibility is selective"
            group="archive-verification"
          />.
          <TypographicDoor
            id="field-verification"
            zone="field"
            kind="trail"
            voice="human"
            text="Verification is available"
            group="archive-verification"
          />.
        </p>
      </div>
      <div class="section-content field-list">
        {
          fieldRecords.map((record) => (
            <article class="field-row">
              <div class="field-place">
                <h3>{record.place}</h3>
                <span>{record.location}</span>
              </div>
              <p>{record.format}</p>
              <p>{record.note}</p>
              <span class="field-status">{record.status}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="dossier-section"
      id="records"
      aria-labelledby="records-title"
    >
      <div class="section-number">04</div>
      <div class="section-heading">
        <p class="section-kicker">Alternative records</p>
        <h2 id="records-title">
          <TypographicDoor
            id="records-chronology"
            zone="records"
            kind="murmur"
            voice="unstable"
            text="Chronology and compost"
          />.
        </h2>
      </div>

      <details class="myth-drawer" data-disputed-chronology>
        <summary>
          <span>Open the disputed Q888 chronology</span>
          <small>12 eras · dates unreliable · reality filed an objection</small>
        </summary>
        <div class="chronology-shell">
          <header class="chronology-intro">
            <p class="chronology-stamp">
              Alternative history · certified in at least one dimension
            </p>
            <h3>
              The official sequence of events has refused to remain sequential.
            </h3>
            <p class="chronology-description">
              The following record combines documented Q888 projects, internal
              mythology, administrative mistakes and several events that
              occurred before their causes. Earth dates are supplied only when
              reality cooperates.
            </p>
            <div class="chronology-order-control">
              <button type="button" data-chronology-toggle aria-pressed="false">
                <span data-chronology-label
                  >Let the timeline remember differently</span
                >
                <span data-chronology-glyph aria-hidden="true">↝</span>
              </button>
              <p data-chronology-status aria-live="polite">
                Filing order · numbered for administrative comfort
              </p>
            </div>
          </header>

          <ol
            class="myth-timeline"
            data-chronology-list
            aria-label="Disputed Q888 alternative history in filing order"
          >
            {
              disputedChronology.map((entry, index) => {
                const recordNumber =
                  "recordNumber" in entry
                    ? entry.recordNumber
                    : String(index + 1).padStart(2, "0");
                return (
                  <li
                    class={`myth-entry myth-tone-${entry.tone}${"concealed" in entry ? " myth-entry-concealed" : ""}`}
                    data-chronology-entry
                    data-record-number={recordNumber}
                  >
                    <div class="myth-node" aria-hidden="true">
                      <span>{recordNumber}</span>
                    </div>
                    {"concealed" in entry ? (
                      <article
                        class="myth-card myth-card-concealed"
                        aria-label="Record 11: unknown"
                      >
                        <span aria-hidden="true">?</span>
                      </article>
                    ) : (
                      <article class="myth-card">
                        <p class="myth-era">{entry.era}</p>
                        <h3>{entry.title}</h3>
                        <p class="myth-story">{entry.story}</p>
                        <footer class="myth-evidence">
                          <span>{entry.evidence}</span>
                          {entry.href && entry.linkLabel && (
                            <a
                              href={entry.href}
                              target={
                                entry.href.endsWith(".pdf")
                                  ? "_blank"
                                  : undefined
                              }
                              rel={
                                entry.href.endsWith(".pdf")
                                  ? "noopener noreferrer"
                                  : undefined
                              }
                            >
                              {entry.linkLabel}{" "}
                              <span aria-hidden="true">↗</span>
                            </a>
                          )}
                        </footer>
                      </article>
                    )}
                  </li>
                );
              })
            }
          </ol>

          <footer class="chronology-closing">
            <span>Record completeness: emotionally sufficient</span>
            <span>Missing years: currently living elsewhere</span>
            <span
              >Corrections: accepted by
              <TypographicDoor
                id="records-narmail"
                zone="records"
                kind="portal"
                voice="archive"
                text="Nar-Mail"
                href="/narmail/"
              /> only</span
            >
          </footer>
        </div>
      </details>

      <details class="myth-drawer compost-drawer">
        <summary>
          <span>Open the rejection compost</span>
          <small>Optional bureaucracy · bitterness level 1/5</small>
        </summary>
        <div class="compost-content">
          <div>
            <p class="compost-lead">
              Some portals open. Some send a
              <TypographicDoor
                id="records-fee-fog"
                zone="records"
                kind="trail"
                voice="confession"
                text="polite fog"
