<script>
  import {
    cleanupTypographicDoors,
    initTypographicDoors,
  } from "../scripts/typographicDoors";
  import {
    cleanupDisputedChronology,
    initDisputedChronology,
  } from "../scripts/disputedChronology";

  // CHOICE: A tiny local drift engine borrows Dyno's object-energy without
  // bringing its louder motion system or another dependency into the dossier.
  interface ArchiveFloat {
    element: HTMLElement;
    driftX: number;
    driftY: number;
    driftRotation: number;
    phase: number;
  }

  let archiveFloats: ArchiveFloat[] = [];
  let archiveFrame: number | null = null;
  let archiveResizeTimer: number | null = null;
  let currentScroll = 0;
  let targetScroll = 0;
  const reducedMotionQuery = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  const compactViewportQuery = window.matchMedia("(max-width: 768px)");

  function updateArchiveScroll() {
    targetScroll = window.scrollY;
  }

  function animateArchive(now: number) {
    currentScroll += (targetScroll - currentScroll) * 0.055;
    const scrollRange = Math.max(
      document.documentElement.scrollHeight - window.innerHeight,
      1,
    );
    const scrollProgress = currentScroll / scrollRange;

    archiveFloats.forEach((item) => {
      const idleX = Math.sin(now * 0.00022 + item.phase) * 3.5;
      const idleY = Math.cos(now * 0.00018 + item.phase) * 2.75;
      const idleRotation = Math.sin(now * 0.00015 + item.phase) * 0.6;
      const x = idleX + scrollProgress * item.driftX;
      const y = idleY + scrollProgress * item.driftY;
      const rotation = idleRotation + scrollProgress * item.driftRotation;

      item.element.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px) rotate(${rotation.toFixed(2)}deg)`;
    });

    archiveFrame = window.requestAnimationFrame(animateArchive);
  }

  function stopArchiveMotion() {
    if (archiveFrame !== null) {
      window.cancelAnimationFrame(archiveFrame);
      archiveFrame = null;
    }
    window.removeEventListener("scroll", updateArchiveScroll);
    archiveFloats.forEach(({ element }) =>
      element.style.removeProperty("transform"),
    );
    archiveFloats = [];
  }

  function startArchiveMotion() {
    stopArchiveMotion();

    if (reducedMotionQuery.matches || compactViewportQuery.matches) return;

    archiveFloats = Array.from(
      document.querySelectorAll<HTMLElement>(".archive-float"),
    ).map((element, index) => ({
      element,
      driftX: Number(element.dataset.driftX ?? 0),
      driftY: Number(element.dataset.driftY ?? 0),
      driftRotation: Number(element.dataset.driftRot ?? 0),
      phase: index * 2.399,
    }));

    if (!archiveFloats.length) return;
    currentScroll = targetScroll = window.scrollY;
    window.addEventListener("scroll", updateArchiveScroll, { passive: true });
    archiveFrame = window.requestAnimationFrame(animateArchive);
  }

  function scheduleArchiveMotionRestart() {
    if (archiveResizeTimer !== null) {
      window.clearTimeout(archiveResizeTimer);
    }
    archiveResizeTimer = window.setTimeout(startArchiveMotion, 140);
  }

  function initArchiveMotion() {
    startArchiveMotion();
    window.removeEventListener("resize", scheduleArchiveMotionRestart);
    window.addEventListener("resize", scheduleArchiveMotionRestart, {
      passive: true,
    });
    reducedMotionQuery.removeEventListener("change", startArchiveMotion);
    reducedMotionQuery.addEventListener("change", startArchiveMotion);
    compactViewportQuery.removeEventListener("change", startArchiveMotion);
    compactViewportQuery.addEventListener("change", startArchiveMotion);
  }

  function cleanupArchiveMotion() {
    stopArchiveMotion();
    window.removeEventListener("resize", scheduleArchiveMotionRestart);
    reducedMotionQuery.removeEventListener("change", startArchiveMotion);
    compactViewportQuery.removeEventListener("change", startArchiveMotion);
    if (archiveResizeTimer !== null) {
      window.clearTimeout(archiveResizeTimer);
      archiveResizeTimer = null;
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArchiveMotion, {
      once: true,
    });
    document.addEventListener("DOMContentLoaded", initTypographicDoors, {
      once: true,
    });
    document.addEventListener("DOMContentLoaded", initDisputedChronology, {
      once: true,
    });
  } else {
    initArchiveMotion();
    initTypographicDoors();
    initDisputedChronology();
  }

  document.addEventListener("astro:page-load", initArchiveMotion);
  document.addEventListener("astro:page-load", initTypographicDoors);
  document.addEventListener("astro:page-load", initDisputedChronology);
  document.addEventListener("astro:before-swap", cleanupArchiveMotion);
  document.addEventListener("astro:before-swap", cleanupTypographicDoors);
  document.addEventListener("astro:before-swap", cleanupDisputedChronology);
</script>

