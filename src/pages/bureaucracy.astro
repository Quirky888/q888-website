<script>
  // ── Scroll reveal observer ──────────────────────────────────────
  function initBurReveal() {
    const html = document.documentElement;
    if (!html.dataset.motionReady) {
      html.dataset.motionReady = "1";
    }

    const staggerParents = document.querySelectorAll("[data-motion-stagger]");
    const singles = document.querySelectorAll(
      ".bur-wrap .q888-reveal:not([data-motion-stagger])"
    );

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-revealed");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.08 }
    );

    staggerParents.forEach((el) => io.observe(el));
    singles.forEach((el) => io.observe(el));
  }

  initBurReveal();
  document.addEventListener("astro:page-load", initBurReveal);

  // ── Rejection Archive accordion ──────────────────────────────
  function initRejectionAccordion() {
    document.querySelectorAll("[data-bur-case]").forEach((card) => {
      const trigger = card.querySelector(".bur-case-header") as HTMLButtonElement | null;
      const body = card.querySelector(".bur-case-body") as HTMLElement | null;
      const icon = card.querySelector(".bur-case-toggle-icon") as HTMLElement | null;
      if (!trigger || !body) return;
      if (trigger.dataset.burCaseInit) return;
      trigger.dataset.burCaseInit = "1";

      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
        if (isOpen) {
          body.hidden = true;
          if (icon) icon.textContent = "+";
          card.classList.remove("is-open");
        } else {
          body.hidden = false;
          if (icon) icon.textContent = "−";
          card.classList.add("is-open");
        }
      });
    });
  }

  initRejectionAccordion();
  document.addEventListener("astro:page-load", initRejectionAccordion);

  // ── Data-stream canvas (hero background) ────────────────────
  function initDataStream() {
    const canvas = document.getElementById("bur-datastream") as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any)._burStreamInit) return;
    (canvas as any)._burStreamInit = true;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const resize = () => {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    const chars = "01QBUREAUCRACY▲◈//░▒";
    const fontSize = 11;
    let columns: number[];

    const reset = () => {
      const cols = Math.floor(canvas.width / fontSize);
      columns = Array.from({ length: cols }, () => Math.random() * canvas.height);
    };
    reset();
    window.addEventListener("resize", reset, { passive: true });

    let raf: number;
    let isDrawing = false;
    
    const draw = () => {
      if (!isDrawing) return;
      ctx.fillStyle = "rgba(10,10,10,0.08)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "rgba(255, 255, 255, 0.38)"; // Bumped opacity to make it visible
      ctx.font = `${fontSize}px ui-monospace, monospace`;
      for (let i = 0; i < columns.length; i++) {
        const ch = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(ch, i * fontSize, columns[i]);
        if (columns[i] > canvas.height && Math.random() > 0.975) columns[i] = 0;
        else columns[i] += fontSize;
      }
      raf = requestAnimationFrame(draw);
    };

    // stop when hero is off-screen
    const hero = document.getElementById("bur-hero");
    if (hero) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) {
          if (!isDrawing) {
            isDrawing = true;
            draw();
          }
        } else {
          isDrawing = false;
          cancelAnimationFrame(raf);
        }
      }).observe(hero);
    }
  }

  // ── Glitch pulse on restricted labels ──────────────────────
  function initGlitch() {
    document.querySelectorAll(".bur-crb-val-restricted").forEach((el) => {
      if ((el as HTMLElement).dataset.glitchInit) return;
      (el as HTMLElement).dataset.glitchInit = "1";
      setInterval(() => {
        if (Math.random() > 0.7) el.classList.add("bur-glitch-active");
        setTimeout(() => el.classList.remove("bur-glitch-active"), 140);
      }, 3200);
    });
  }

  initDataStream();
  initGlitch();
  document.addEventListener("astro:page-load", () => {
    initDataStream();
    initGlitch();
  });
</script>

