    left: 0.8rem;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .registration-fragment {
    position: absolute;
    z-index: 6;
    right: -1.2rem;
    top: 13%;
    padding: 0.62rem 0.72rem;
    border: 1px solid rgba(21, 23, 20, 0.48);
    color: var(--ink);
    background:
      linear-gradient(
        120deg,
        rgba(232, 52, 146, 0.12),
        rgba(0, 168, 186, 0.12) 55%,
        rgba(158, 189, 56, 0.13)
      ),
      rgba(251, 250, 246, 0.82);
    box-shadow: 0.3rem 0.45rem 0 rgba(21, 23, 20, 0.07);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
    transform: rotate(3deg);
  }

  .record-list {
    margin: 1.2rem 0 0;
  }

  .record-list div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line);
  }

  .record-list dt,
  .record-list dd {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .record-list dt {
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    display: inline-block;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 0 rgba(158, 189, 56, 0.45);
    animation: status-breathe 3.4s ease-in-out infinite;
  }

  .dossier-index {
    position: sticky;
    top: 2.65rem;
    z-index: 20;
    min-height: 3.6rem;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0 max(1.5rem, calc((100vw - 78rem) / 2));
    overflow-x: auto;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(244, 243, 237, 0.9);
    backdrop-filter: blur(18px) saturate(1.08);
    scrollbar-width: none;
  }

  .dossier-index::-webkit-scrollbar {
    display: none;
  }

  .dossier-index a {
    position: relative;
    flex: 0 0 auto;
    padding: 1.12rem 0;
    color: var(--ink);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .dossier-index a:hover {
    color: var(--ink);
  }

  .dossier-index a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.74rem;
    left: 0;
    height: 1px;
    background: var(--hologram);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .dossier-index a:hover::after,
  .dossier-index a:focus-visible::after {
    transform: scaleX(1);
  }

  .dossier-section {
    position: relative;
    scroll-margin-top: 7rem;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 3.5rem);
    padding: clamp(5.5rem, 9vw, 9rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .dossier-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.2rem;
    width: 1px;
    height: clamp(5.5rem, 9vw, 9rem);
    background: linear-gradient(var(--moss), rgba(79, 104, 73, 0));
    opacity: 0.42;
  }

  .section-number {
    grid-row: 1 / span 2;
    padding-top: 0.3rem;
    position: relative;
    color: var(--ink);
  }

  .section-number::after {
    content: "";
    position: absolute;
    top: 1.9rem;
    left: 0.15rem;
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--moss);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 0.32rem rgba(79, 104, 73, 0.05);
  }

  .section-heading {
    max-width: 48rem;
  }

  .section-heading-row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3rem;
  }

  .section-heading-row > p {
    max-width: 25rem;
    margin: 0 0 0.3rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .section-heading h2 {
    margin: 0.85rem 0 0;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(2.7rem, 6.2vw, 5.9rem);
    font-weight: 700;
    letter-spacing: -0.068em;
    line-height: 0.91;
  }

  .section-content {
    grid-column: 2;
    margin-top: clamp(2.75rem, 5vw, 5rem);
  }

  .practice-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .prose p {
    margin: 0 0 1.3rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.72;
  }

  .lead-prose p:first-child {
    color: var(--ink);
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.42;
  }

  blockquote {
    margin: 0;
    padding: 1.6rem 0 1.6rem 1.6rem;
    position: relative;
    border-left: 2px solid var(--moss);
    color: var(--charcoal);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: clamp(1.18rem, 2vw, 1.55rem);
    font-style: italic;
    line-height: 1.45;
  }

  blockquote::before {
    content: "";
    position: absolute;
    top: 1rem;
    left: -0.32rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--hologram);
    box-shadow: 0 0 1rem rgba(0, 168, 186, 0.28);
  }

  blockquote cite {
    display: block;
    margin-top: 1.25rem;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .practice-facts div {
    padding: 1.25rem 1.5rem 0 0;
  }

  .practice-facts div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .practice-facts dt {
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-facts dd {
    margin: 0.65rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .work-list,
  .field-list {
    border-top: 1px solid var(--ink);
  }

  .work-row {
    --signal: var(--moss);
    --signal-wash: rgba(79, 104, 73, 0.08);
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns:
      2.2rem minmax(10rem, 0.8fr) minmax(16rem, 1.4fr)
      7rem 1rem;
    align-items: center;
    gap: 1.25rem;
    min-height: 6.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      padding 240ms ease,
      background 240ms ease;
  }

  .work-row::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.18rem;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 240ms ease;
  }

  .work-row::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--signal), transparent);
    opacity: 0;
    transform: translateX(-35%);
    transition:
      opacity 240ms ease,
      transform 420ms ease;
  }

  .work-row[data-signal="cyan"] {
    --signal: var(--cyan);
    --signal-wash: rgba(0, 168, 186, 0.075);
  }

  .work-row[data-signal="magenta"] {
    --signal: var(--magenta);
    --signal-wash: rgba(232, 52, 146, 0.065);
  }

  .work-row[data-signal="lime"] {
    --signal: var(--lime);
    --signal-wash: rgba(158, 189, 56, 0.09);
  }

  .work-row[data-signal="clay"] {
    --signal: var(--clay);
    --signal-wash: rgba(181, 93, 57, 0.07);
  }

  .work-row:hover {
    padding-inline: 1rem 0.55rem;
    background: linear-gradient(90deg, var(--signal-wash), transparent 68%);
  }

  .work-row:hover::before,
  .work-row:focus-visible::before {
    transform: scaleY(1);
  }

  .work-row:hover::after,
  .work-row:focus-visible::after {
    opacity: 0.7;
    transform: translateX(0);
  }

  .work-number,
  .work-status {
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work-name {
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    transition: color 180ms ease;
  }

  .work-description {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.58;
  }

  .work-status {
    color: var(--signal);
    text-align: right;
  }

  .work-status::before {
    content: "";
    width: 0.34rem;
    height: 0.34rem;
    display: inline-block;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0 currentColor;
    animation: row-signal 4.6s ease-in-out infinite;
  }

  .work-arrow {
    color: var(--signal);
    font-size: 1rem;
    transition: transform 220ms ease;
  }

  .work-row:hover .work-arrow {
    transform: translate(0.18rem, -0.18rem);
  }

  .field-row {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(11rem, 0.8fr) minmax(10rem, 0.65fr) minmax(16rem, 1.4fr)
      8rem;
    gap: 1.5rem;
    align-items: start;
    padding: 1.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .field-place h3 {
    margin: 0;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .field-place span,
  .field-status {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .field-row p {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .field-status {
    margin: 0;
    color: var(--moss);
    text-align: right;
  }

  .field-status::before {
    content: "";
    display: inline-block;
    width: 1.15rem;
    height: 1px;
    margin-right: 0.5rem;
    vertical-align: middle;
    background: var(--moss);
  }

  .myth-drawer {
    grid-column: 2;
    margin-top: 1.15rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .myth-drawer summary {
    position: relative;
    min-height: 5.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    cursor: pointer;
    list-style: none;
    transition:
      padding 220ms ease,
      background 220ms ease;
  }

  .myth-drawer summary::-webkit-details-marker {
    display: none;
  }

  .myth-drawer summary span {
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .myth-drawer summary span::after {
    content: "+";
    display: inline-block;
    margin-left: 0.75rem;
    color: var(--cyan);
    font-family: "Space Mono", ui-monospace, monospace;
  }

  .myth-drawer[open] summary span::after {
    content: "−";
  }

  .myth-drawer summary small {
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .myth-drawer summary:hover,
  .myth-drawer[open] summary {
    padding-inline: 0.85rem;
    background: linear-gradient(
      90deg,
      rgba(0, 168, 186, 0.07),
      rgba(232, 52, 146, 0.045),
      transparent 78%
    );
  }

  .myth-drawer[open] summary {
    border-bottom: 1px solid var(--line);
  }

  .chronology-shell {
    position: relative;
    overflow: hidden;
    margin: 0 0 2rem;
    background:
      radial-gradient(
        circle at 18% 8%,
        rgba(232, 52, 146, 0.085),
        transparent 28rem
      ),
      radial-gradient(
        circle at 84% 72%,
        rgba(0, 168, 186, 0.1),
        transparent 34rem
      ),
      linear-gradient(145deg, var(--paper-deep), var(--paper-light));
    color: var(--ink);
    animation: archive-layer-enter 520ms ease both;
  }

  .chronology-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      112deg,
      transparent 0 5.8rem,
      rgba(79, 104, 73, 0.025) 5.85rem 5.9rem
    );
    mask-image: linear-gradient(#000, transparent 68%);
  }

  .chronology-intro {
    max-width: 55rem;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .chronology-stamp {
    margin: 0;
    color: var(--moss);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .chronology-intro h3 {
    margin: 1.5rem 0;
    max-width: 48rem;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(2.2rem, 4.8vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .chronology-description {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.72;
  }

  .chronology-order-control {
    max-width: 40rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .chronology-order-control button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.35rem 0;
    border: 0;
    color: var(--ink);
    background: transparent;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: 0.94rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: left;
    cursor: pointer;
  }

  .chronology-order-control [data-chronology-glyph] {
    display: inline-block;
    color: var(--moss);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 0.8;
    transition: translate 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .chronology-order-control button:hover [data-chronology-glyph] {
    translate: 0.2rem 0;
  }

  [data-chronology-mode="mycelial"]
    .chronology-order-control
    [data-chronology-glyph] {
    translate: 0 0;
  }

  .chronology-order-control > p {
    max-width: 23ch;
    margin: 0;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.045em;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
  }

  .myth-timeline {
    position: relative;
    margin: 0;
    padding: 1rem clamp(1.5rem, 5vw, 4.5rem) 4rem;
    list-style: none;
  }

  .myth-timeline::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: 4rem;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgba(0, 168, 186, 0.72),
      var(--clay),
      rgba(79, 104, 73, 0.72),
      transparent
    );
    box-shadow: 0 0 1.5rem rgba(0, 168, 186, 0.14);
    transform: translateX(-50%);
  }

  .myth-entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr);
    align-items: start;
    margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
  }

  .myth-entry:nth-child(odd) .myth-card {
    grid-column: 1;
    transform: rotate(-0.45deg);
  }

  .myth-entry:nth-child(even) .myth-card {
    grid-column: 3;
    transform: rotate(0.45deg);
  }

  .myth-node {
    position: relative;
    z-index: 2;
    grid-column: 2;
    grid-row: 1;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    justify-self: center;
    margin-top: 1.2rem;
    border: 3px solid var(--paper-deep);
    border-radius: 58% 42% 54% 46% / 42% 58% 45% 55%;
    background: var(--myth-accent, var(--clay));
    box-shadow:
      0 0 0 1px var(--myth-accent, var(--clay)),
      0 0 1.5rem rgba(0, 168, 186, 0.08);
    color: #fffdf5;
    transform: rotate(-7deg);
  }

  .myth-node span {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .myth-card {
    grid-row: 1;
    overflow: hidden;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-top: 2px solid var(--myth-accent, var(--clay));
    border-left: 1px solid rgba(21, 23, 20, 0.16);
    border-radius: 0.15rem 0.65rem 0.15rem 0.45rem;
    background: rgba(251, 250, 246, 0.78);
    box-shadow: 0.75rem 0.85rem 0 rgba(21, 23, 20, 0.045);
    color: var(--ink);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease;
  }

  .myth-entry:nth-child(even) .myth-card {
    border-right: 1px solid rgba(21, 23, 20, 0.16);
    border-left: 0;
    border-radius: 0.65rem 0.15rem 0.45rem 0.15rem;
  }

  .myth-entry:nth-child(odd) .myth-card:hover {
    transform: rotate(-0.45deg) translate(-0.3rem, -0.15rem);
    box-shadow: 1rem 1rem 0 rgba(0, 168, 186, 0.065);
    background: var(--paper-light);
  }

  .myth-entry:nth-child(even) .myth-card:hover {
    transform: rotate(0.45deg) translate(0.3rem, -0.15rem);
    box-shadow: -1rem 1rem 0 rgba(232, 52, 146, 0.05);
    background: var(--paper-light);
  }

  .myth-era {
    margin: 0;
    color: var(--myth-accent, var(--clay));
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .myth-card h3 {
    margin: 1.1rem 0;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .myth-story {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .myth-evidence {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .myth-evidence > span,
  .myth-evidence a {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.045em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .myth-evidence > span {
    color: var(--muted);
  }

  .myth-evidence a {
    flex: 0 0 auto;
    color: var(--myth-accent, var(--clay));
    font-weight: 700;
    text-decoration: none;
  }

  .myth-evidence a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .myth-tone-clay {
    --myth-accent: #a55e3e;
  }
  .myth-tone-violet {
    --myth-accent: #735b86;
  }
  .myth-tone-moss {
    --myth-accent: #547151;
  }
  .myth-tone-blue {
    --myth-accent: #456c78;
  }
  .myth-tone-gold {
    --myth-accent: #9a782f;
  }
  .myth-tone-unknown {
    --myth-accent: #6d6870;
  }

  .myth-card-concealed {
    min-height: clamp(9rem, 18vw, 14rem);
    display: grid;
    place-items: center;
    border-color: rgba(109, 104, 112, 0.45);
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(232, 52, 146, 0.08),
        transparent 46%
      ),
      rgba(251, 250, 246, 0.58);
  }

  .myth-card-concealed > span {
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 700;
    line-height: 0.75;
    color: transparent;
    background: linear-gradient(
      120deg,
      var(--ink) 18%,
      var(--magenta) 46%,
      var(--cyan) 68%,
      var(--ink) 88%
    );
    background-clip: text;
    -webkit-background-clip: text;
    filter: drop-shadow(0.12rem 0.14rem 0 rgba(79, 104, 73, 0.14));
    transform: rotate(-6deg);
  }

  .chronology-closing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .chronology-closing span {
    padding: 1.15rem;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
  }

  .chronology-closing span + span {
    border-left: 1px solid var(--line);
  }

  .compost-content {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(1.5rem, 4vw, 2.8rem);
    background:
      radial-gradient(
        circle at 82% 12%,
        rgba(158, 189, 56, 0.16),
        transparent 20rem
      ),
      var(--moss-soft);
    animation: archive-layer-enter 520ms ease both;
  }

  .compost-content p,
  .protocol li {
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .compost-lead {
    margin-top: 0;
    font-size: 1.28rem !important;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .protocol > p {
    margin-top: 0;
    color: var(--moss);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .protocol ol {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
  }

  .compost-note {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(79, 105, 77, 0.3);
    color: var(--moss);
    font-style: italic;
  }

  .compost-case {
    grid-column: 1 / -1;
    overflow: hidden;
    border-top: 2px solid var(--moss);
    border-right: 1px solid rgba(79, 104, 73, 0.32);
    border-bottom: 1px solid rgba(79, 104, 73, 0.32);
    border-left: 1px solid rgba(79, 104, 73, 0.32);
    background: rgba(251, 250, 246, 0.84);
  }

  .compost-case-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  .compost-case-number,
  .compost-reason-label {
    margin: 0;
    color: var(--moss);
    font-family: "Space Mono", ui-monospace, monospace !important;
    font-size: 0.64rem !important;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .compost-case h3 {
    margin: 0.5rem 0 0;
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(2.1rem, 4.6vw, 4.15rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .compost-case-status {
    flex: 0 0 auto;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--clay);
    border-radius: 50%;
    color: var(--clay);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(3deg);
  }

  .compost-case-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .compost-case-facts div {
    min-height: 6.5rem;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .compost-case-facts div:nth-child(3n) {
    border-right: 0;
  }

  .compost-case-facts div:nth-last-child(-n + 3) {
    border-bottom: 0;
  }

  .compost-case-facts dt {
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .compost-case-facts dd {
    margin: 1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .compost-reason {
    display: grid;
    grid-template-columns: minmax(9rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .compost-reason h4 {
    margin: 0 0 1.5rem;
    color: var(--clay);
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .compost-reason p,
  .compost-reason li,
  .compost-public-note p {
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .compost-reason p {
    color: var(--muted);
  }

  .compost-reason ol {
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.25rem 1.25rem 2.75rem;
    background: var(--paper);
  }

  .compost-reason li + li {
    margin-top: 0.45rem;
  }

  .compost-public-note {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    background:
      linear-gradient(112deg, rgba(255, 255, 255, 0.025), transparent 42%),
      var(--moss);
    color: var(--paper-light);
  }

  .compost-public-note p {
    margin: 0;
  }

  .compost-case-verdict {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .compost-case-verdict span {
    padding: 1.25rem;
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .compost-case-verdict span + span {
    border-left: 1px solid var(--line);
  }

  .compost-case-verdict small {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .earth {
    border-bottom: 0;
  }

  .earth-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .earth-intro {
    color: var(--ink) !important;
    font-size: clamp(1.28rem, 2.2vw, 1.78rem) !important;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.48 !important;
  }

  .contact-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.7rem, 4vw, 2.5rem);
    border: 1px solid var(--ink);
    background:
      radial-gradient(
        circle at 100% 0,
        rgba(0, 168, 186, 0.17),
        transparent 14rem
      ),
      var(--ink);
    color: var(--paper-light);
  }

  .contact-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 0.2rem;
    background: var(--hologram);
  }

  .contact-card::after {
    content: "BRIDGE / EARTH ↔ Q888";
    position: absolute;
    right: 1.1rem;
    bottom: 0.8rem;
    color: rgba(251, 250, 246, 0.35);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.46rem;
    letter-spacing: 0.1em;
  }

  .contact-card > p {
    margin: 0;
    color: #b7c8ae;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card > a {
    display: inline-block;
    margin: 1.25rem 0 2.5rem;
    color: var(--paper-light);
    font-family: "Space Grotesk", "Syne", sans-serif;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .contact-actions a {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--paper-light);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      padding 220ms ease,
      color 220ms ease,
      background 220ms ease;
  }

  .contact-actions a::after {
    content: "↗";
    color: var(--cyan);
    transition: transform 220ms ease;
  }

  .contact-actions a:hover {
    padding-inline: 0.65rem;
    background: linear-gradient(
      90deg,
      rgba(232, 52, 146, 0.12),
      rgba(0, 168, 186, 0.1)
    );
  }

  .contact-actions a:hover::after {
    transform: translate(0.18rem, -0.18rem);
  }

  .contact-card small {
    display: block;
    margin-top: 1.5rem;
    color: #a9a89e;
    padding-right: 2rem;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    line-height: 1.6;
  }

  .dossier-footer {
    min-height: 6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @keyframes specimen-halo {
    0% {
      border-color: rgba(0, 168, 186, 0.28);
      transform: rotate(5deg) scale(1);
    }
    50% {
      border-color: rgba(232, 52, 146, 0.32);
      transform: rotate(7deg) scale(1.018);
    }
    100% {
      border-color: rgba(0, 168, 186, 0.28);
      transform: rotate(5deg) scale(1);
    }
  }

  @keyframes hero-sticker-trace {
    0%,
    56% {
      left: -55%;
      opacity: 0;
    }
    66% {
      opacity: 0.7;
    }
    84%,
    100% {
      left: 125%;
      opacity: 0;
    }
  }

  @keyframes status-breathe {
    0%,
    100% {
      opacity: 0.62;
      transform: scale(0.82);
      box-shadow: 0 0 0 0 rgba(158, 189, 56, 0);
    }
    50% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0.3rem rgba(158, 189, 56, 0.13);
    }
  }

  @keyframes row-signal {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.78);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes archive-layer-enter {
    from {
      opacity: 0;
      transform: translateY(-0.55rem);
      filter: saturate(0.7);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: saturate(1);
    }
  }

  @media (max-width: 900px) {
    .dossier {
      padding-top: 0;
      background: var(--paper);
    }

    .dossier-hero {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 5rem;
    }

    .dossier-hero::after {
      display: none;
    }

    .artist-cv-sticker {
      position: relative;
      top: auto;
      left: auto;
      grid-column: 1;
      justify-self: end;
      width: clamp(12rem, 38vw, 17rem);
      margin: -2rem 2rem -5rem 0;
    }

    .hero-record {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 2rem;
      border-top: 1px solid var(--line-strong);
      border-left: 0;
      padding: 2rem 0 0;
    }

    .specimen-mark {
      align-self: start;
    }

    .record-list {
      margin-top: 0;
    }

    .dossier-index {
      top: 0;
      padding-inline: 1.5rem;
    }

    .section-heading-row {
      align-items: start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .work-row {
      grid-template-columns: 2rem 1fr auto;
      gap: 0.5rem 1rem;
    }

    .work-name {
      grid-column: 2;
    }

    .work-description {
      grid-column: 2 / -1;
      font-size: 1rem;
    }

    .work-status {
      grid-column: 3;
      grid-row: 1;
    }

    .work-arrow {
      display: none;
    }

    .field-row {
      grid-template-columns: 1fr 1fr;
    }

    .field-row p {
      font-size: 1rem;
    }

    .field-status {
      text-align: left;
    }

    .compost-case-facts {
      grid-template-columns: repeat(2, 1fr);
    }

    .compost-case-facts div,
    .compost-case-facts div:nth-child(3n),
    .compost-case-facts div:nth-last-child(-n + 3) {
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .compost-case-facts div:nth-child(2n) {
      border-right: 0;
    }

    .compost-case-facts div:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    :global(html) {
      scroll-padding-top: 5rem;
    }

    .dossier-hero,
    .dossier-section,
    .dossier-footer {
      width: min(100% - 2rem, 78rem);
    }

    .dossier-hero {
      min-height: auto;
      padding: 3rem 0 4rem;
    }

    .dossier::after {
      display: none;
    }

    .bureaucracy-notice {
      grid-template-columns: 1fr;
      margin-bottom: 3rem;
    }

    .hero-mark {
      font-size: clamp(4.5rem, 25vw, 7rem);
    }

    .hero-earth-name {
      margin-top: 2.2rem;
      padding-left: 1.1rem;
    }

    .hero-role {
      margin-top: 2.5rem;
      line-height: 1.5;
    }

    .artist-cv-sticker {
      width: min(62vw, 13rem);
      margin: -1rem 0 -2rem;
    }

    .artist-cv-sticker-surface {
      font-size: clamp(2.9rem, 15vw, 4rem);
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .action {
      width: 100%;
      box-sizing: border-box;
    }

    .hero-record {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .specimen-mark {
      aspect-ratio: 1.45;
    }

    .specimen-mark::before,
    .hero-mark::before,
    .artist-cv-sticker-surface::before {
      animation: none;
    }

    .registration-fragment {
      right: 0;
    }

    .dossier-index {
      min-height: 3.4rem;
      gap: 1.4rem;
      padding-inline: 1rem;
    }

    .dossier-index a {
      padding: 1rem 0;
    }

    .index-label {
      display: none;
    }

    .dossier-section {
      grid-template-columns: 1fr;
      padding: 4.5rem 0;
    }

    .dossier-section::before {
      left: 0.18rem;
      height: 3.2rem;
    }

    .section-number {
      grid-row: auto;
      margin-bottom: 1.25rem;
      padding-left: 1rem;
    }

    .section-number::after {
      top: 0.32rem;
      left: 0;
    }

    .section-content,
    .myth-drawer {
      grid-column: 1;
    }

    .section-heading h2 {
      font-size: clamp(2.6rem, 14vw, 4rem);
    }

    .practice-grid,
    .earth-grid,
    .compost-content {
      grid-template-columns: 1fr;
    }

    .practice-facts {
      grid-template-columns: 1fr;
    }

    .practice-facts div {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--line);
    }

    .practice-facts div + div {
      padding-left: 0;
      border-left: 0;
    }

    .work-row {
      grid-template-columns: 1.7rem 1fr;
      padding: 1.25rem 0;
    }

    .work-row:hover {
      padding-inline: 0.65rem 0;
    }

    .work-number {
      grid-row: 1 / span 3;
      align-self: start;
      padding-top: 0.25rem;
    }

    .work-name,
    .work-description,
    .work-status {
      grid-column: 2;
    }

    .work-status {
      grid-row: auto;
      text-align: left;
    }

    .field-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .myth-drawer summary {
      align-items: start;
      flex-direction: column;
      justify-content: center;
      gap: 0.4rem;
    }

    .chronology-intro {
      padding: 2.25rem 1.25rem 3rem;
    }

    .chronology-order-control {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .chronology-order-control > p {
      max-width: none;
      text-align: left;
    }

    .myth-timeline {
      padding: 0.5rem 1rem 3rem 3.4rem;
    }

    .myth-timeline::before {
      top: 0.5rem;
      bottom: 3rem;
      left: 1.8rem;
    }

    .myth-entry {
      display: block;
      margin-bottom: 1.5rem;
    }

    .myth-entry:nth-child(odd) .myth-card,
    .myth-entry:nth-child(even) .myth-card,
    .myth-entry:nth-child(odd) .myth-card:hover,
    .myth-entry:nth-child(even) .myth-card:hover {
      transform: none;
    }

    .myth-node {
      position: absolute;
      top: 1rem;
      left: -2.75rem;
      width: 2rem;
      height: 2rem;
      margin: 0;
    }

    .myth-card,
    .myth-entry:nth-child(even) .myth-card {
      padding: 1.35rem;
      border-right: 0;
      border-left: 1px solid rgba(21, 23, 20, 0.16);
      border-radius: 0.15rem 0.55rem 0.15rem 0.35rem;
    }

    .myth-story,
    .compost-content p,
    .protocol li,
    .compost-reason p,
    .compost-reason li,
    .compost-public-note p {
      font-size: 1rem;
    }

    .myth-evidence {
      align-items: flex-start;
      flex-direction: column;
    }

    .chronology-closing {
      grid-template-columns: 1fr;
    }

    .chronology-closing span + span {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .compost-content {
      padding: 1.25rem;
    }

    .compost-case-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .compost-case-status {
      align-self: flex-start;
    }

    .compost-case-facts,
    .compost-reason,
    .compost-public-note,
    .compost-case-verdict {
      grid-template-columns: 1fr;
    }

    .compost-case-facts div,
    .compost-case-facts div:nth-child(2n),
    .compost-case-facts div:nth-child(3n),
    .compost-case-facts div:nth-last-child(-n + 2),
    .compost-case-facts div:nth-last-child(-n + 3) {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .compost-case-facts div:last-child {
      border-bottom: 0;
    }

    .compost-reason {
      gap: 1.25rem;
    }

    .compost-case-verdict span + span {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .compost-note {
      grid-column: 1;
    }

    .contact-card {
      margin-inline: -1rem;
      padding: 1.5rem 1rem 6rem;
    }

    .dossier-footer {
      min-height: 8rem;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-bottom: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .archive-float {
      will-change: auto;
    }

    .specimen-mark::before,
    .hero-mark::before,
    .artist-cv-sticker-surface::before,
    .status-dot,
    .work-status::before,
    .chronology-shell,
    .compost-content {
      animation: none !important;
    }

    .dossier-index a::after,
    .work-row,
    .work-row::before,
    .work-row::after,
    .work-name,
    .work-arrow,
    .myth-drawer summary,
    .chronology-order-control [data-chronology-glyph],
    .myth-card,
    .contact-actions a,
    .contact-actions a::after {
      transition: none !important;
    }
  }

  @media print {
    :global([data-subpage-nav]),
    :global(.slim-nav),
    .dossier-index,
    .hero-actions,
    .artist-cv-sticker,
    .myth-drawer,
    .contact-actions {
      display: none !important;
