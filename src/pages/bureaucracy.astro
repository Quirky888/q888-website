    color: hsl(30 10% 40%);
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  /* Metadata rows — inside cloud cards */
  .bur-meta-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid hsl(30 20% 88%);
    align-items: baseline;
  }

  .bur-meta-row:last-child { border-bottom: none; }

  .bur-meta-key {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(30 15% 55%);
  }

  .bur-meta-val {
    font-size: 0.9rem;
    color: hsl(30 15% 25%);
    line-height: 1.5;
  }

  .bur-meta-val-strong {
    font-weight: 700;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    color: hsl(30 20% 18%);
  }

  .bur-meta-val-note {
    font-style: italic;
    color: hsl(30 15% 50%);
  }

  .bur-materials {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: hsl(30 15% 40%);
  }


  /* ═══════════════════════════════════════════════════════════════════
     01. HERO
  ═══════════════════════════════════════════════════════════════════ */
  .bur-hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 0;
    position: relative;
  }

  .bur-hero-inner {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .bur-hero-inner { padding: 9rem 3rem 7rem; }
  }

  /* Pre-heading tiny field label */
  .bur-hero-preheading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(30 20% 55%);
  }

  .bur-field-sep { color: hsl(30 20% 70%); }
  .bur-field-note { color: hsl(30 15% 65%); }
  .bur-field-label { color: hsl(30 20% 45%); }

  /* Main headline — large, soft, serif */
  .bur-headline {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: hsl(30 20% 18%);
    max-width: 18ch;
  }

  .bur-hl-em {
    font-style: italic;
    color: hsl(120 20% 40%);  /* soft moss green for the mushroom phrase */
  }

  .bur-hl-br { display: none; }

  @media (min-width: 768px) {
    .bur-hl-br { display: inline; }
  }

  .bur-hero-subtitle {
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    line-height: 1.75;
    color: hsl(30 12% 42%);
    max-width: 38rem;
  }

  /* Status pills */
  .bur-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .bur-pill {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: hsl(30 15% 40%);
    background: rgba(255,255,255,0.7);
    border: 1px solid hsl(30 20% 82%);
    border-radius: 2rem;
    padding: 0.3rem 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    backdrop-filter: blur(6px);
  }

  .bur-pill-soft {
    background: hsl(120 20% 93%);
    border-color: hsl(120 20% 78%);
    color: hsl(120 20% 35%);
  }

  /* Breathing dot inside pill */
  .bur-pill-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: hsl(120 30% 50%);
    animation: bur-dot-breathe 2.5s ease-in-out infinite;
  }

  @keyframes bur-dot-breathe {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.2; }
  }

  /* Hero intro prose */
  .bur-hero-intro {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bur-hero-intro p {
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    line-height: 1.8;
    color: hsl(30 12% 38%);
  }

  .bur-hero-aside {
    font-size: 0.88rem !important;
    font-style: italic;
    color: hsl(30 12% 55%) !important;
    padding-left: 1rem;
    border-left: 2px solid hsl(30 20% 80%);
  }

  /* Scroll nudge */
  .bur-scroll-nudge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: hsl(30 15% 60%);
    animation: bur-nudge-breathe 3s ease-in-out infinite;
  }

  .bur-scroll-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, hsl(30 20% 78%), transparent);
    max-width: 3rem;
  }

  @keyframes bur-nudge-breathe {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 0.8; }
  }


  /* ═══════════════════════════════════════════════════════════════════
     02. IDENTITY
  ═══════════════════════════════════════════════════════════════════ */
  .bur-identity-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .bur-identity-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }

  .bur-identity-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-identity-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 400;
    color: hsl(30 20% 20%);
    line-height: 1.15;
    margin: 0 0 0.5rem;
  }

  .bur-identity-copy p {
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    line-height: 1.85;
    color: hsl(30 12% 38%);
  }

  .bur-identity-aside {
    font-size: 0.875rem !important;
    font-style: italic;
    color: hsl(30 12% 52%) !important;
    border-left: 2px solid hsl(30 20% 80%);
    padding-left: 1rem;
  }


  /* ═══════════════════════════════════════════════════════════════════
     03. METHOD
  ═══════════════════════════════════════════════════════════════════ */
  .bur-method-intro {
    max-width: 44rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bur-method-intro p {
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    line-height: 1.8;
    color: hsl(30 12% 40%);
  }

  .bur-method-intro p:first-child {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    color: hsl(30 20% 25%);
    font-style: italic;
  }

  .bur-method-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .bur-method-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }

  .bur-method-distinction {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bur-distinction-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    background: hsl(30 30% 97%);
    border-radius: 1rem;
  }

  .bur-distinction-row-alt {
    background: hsl(120 18% 95%);
  }

  .bur-distinction-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(30 15% 52%);
  }

  .bur-distinction-text {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: hsl(30 15% 25%);
    line-height: 1.4;
  }

  .bur-distinction-highlight {
    font-family: 'DM Serif Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    color: hsl(120 20% 32%);
  }

  .bur-distinction-divider {
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
  }

  .bur-root-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, hsl(30 20% 78%), transparent);
    display: block;
  }

  .bur-method-desc {
    font-size: 0.88rem;
    line-height: 1.8;
    color: hsl(30 12% 48%);
  }

  .bur-method-formulas {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bur-formula-cloud {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-formula-tag {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(30 15% 55%);
  }

  .bur-formula-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .bur-formula-node {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.82rem;
    color: hsl(30 15% 30%);
    background: hsl(30 25% 94%);
    border-radius: 2rem;
    padding: 0.25rem 0.7rem;
  }

  .bur-formula-node-final {
    background: hsl(120 20% 88%);
    color: hsl(120 20% 28%);
    font-weight: 600;
  }

  .bur-formula-arrow {
    color: hsl(30 20% 65%);
    font-size: 0.85rem;
  }

  .bur-code-formula {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bur-code-line {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.72rem, 1.3vw, 0.82rem);
    line-height: 1.7;
    flex-wrap: wrap;
  }

  .bur-code-agent { color: hsl(30 20% 28%); font-weight: 600; }
  .bur-code-sep   { color: hsl(30 20% 55%); }
  .bur-code-action { color: hsl(30 15% 48%); }

  .bur-code-line-final .bur-code-agent { color: hsl(120 20% 32%); }
  .bur-code-line-final .bur-code-action { color: hsl(120 20% 42%); }


  /* ═══════════════════════════════════════════════════════════════════
     04. SELECTED SYSTEMS
  ═══════════════════════════════════════════════════════════════════ */
  .bur-systems-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 540px) {
    .bur-systems-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 960px) {
    .bur-systems-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .bur-system-cloud {
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 16px rgba(80, 60, 40, 0.06), inset 0 1px 0 rgba(255,255,255,0.8);
    transition: transform 220ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  .bur-system-cloud:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(80, 60, 40, 0.12), inset 0 1px 0 rgba(255,255,255,0.9);
  }

  .bur-sys-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bur-sys-code {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(30 15% 58%);
  }

  .bur-sys-status {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(120 18% 42%);
    background: hsl(120 20% 92%);
    border-radius: 2rem;
    padding: 0.15rem 0.5rem;
  }

  .bur-sys-name {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: hsl(30 20% 20%);
    line-height: 1.2;
  }

  .bur-sys-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: hsl(30 12% 45%);
    flex: 1;
  }

  .bur-sys-access {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: hsl(30 18% 55%);
    margin-top: auto;
    transition: color 180ms ease;
  }

  .bur-system-cloud:hover .bur-sys-access {
    color: hsl(120 20% 38%);
  }


  /* ═══════════════════════════════════════════════════════════════════
     05. FIELD RECORD — Underground Mycelium
  ═══════════════════════════════════════════════════════════════════ */
  .bur-field-record {
    background: hsl(120 12% 97%);  /* very faint moss tint for this section */
  }

  .bur-field-intro {
    max-width: 44rem;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-field-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 400;
    color: hsl(30 20% 20%);
    line-height: 1.2;
    margin: 0;
  }

  .bur-field-intro p {
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    line-height: 1.85;
    color: hsl(30 12% 38%);
  }

  .bur-field-note {
    font-style: italic;
    color: hsl(120 18% 40%) !important;
    padding-left: 1rem;
    border-left: 2px solid hsl(120 20% 78%);
  }

  /* Mycelium map container */
  .bur-mycelium-map {
    position: relative;
  }

  /* Root line suggestion — thin organic divider */
  .bur-mycelium-root {
    position: absolute;
    left: 1.75rem;
    top: 2rem;
    bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, transparent, hsl(120 20% 75%), transparent);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .bur-mycelium-root { display: none; }
  }

  .bur-field-nodes {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 0;
  }

  @media (min-width: 640px) {
    .bur-field-nodes {
      padding-left: 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  @media (min-width: 960px) {
    .bur-field-nodes { grid-template-columns: repeat(3, 1fr); }
  }

  /* Individual mycelium node / field record card */
  .bur-field-node {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 2px 16px rgba(80, 60, 40, 0.05), inset 0 1px 0 rgba(255,255,255,0.9);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-left: 3px solid transparent;
  }

  .bur-field-node:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(80, 60, 40, 0.10), inset 0 1px 0 rgba(255,255,255,0.95);
  }

  /* Tone accents — each field record has its own soft colour signal */
  .bur-node-tone-site-specific  { border-left-color: hsl(120 25% 65%); }
  .bur-node-tone-emerging        { border-left-color: hsl(200 30% 68%); }
  .bur-node-tone-mysterious      { border-left-color: hsl(270 25% 68%); }
  .bur-node-tone-underground     { border-left-color: hsl(30 30% 65%); }
  .bur-node-tone-dormant         { border-left-color: hsl(30 15% 72%); }

  .bur-node-icon {
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.7;
  }

  .bur-node-place {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.05rem;
    color: hsl(30 20% 20%);
    line-height: 1.2;
  }

  .bur-node-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    align-items: center;
  }

  .bur-node-type {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(30 18% 52%);
    background: hsl(30 25% 94%);
    border-radius: 2rem;
    padding: 0.15rem 0.55rem;
  }

  .bur-node-year {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: hsl(120 18% 48%);
    background: hsl(120 20% 92%);
    border-radius: 2rem;
    padding: 0.15rem 0.55rem;
  }

  .bur-node-location {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    color: hsl(30 12% 55%);
    letter-spacing: 0.04em;
  }

  .bur-node-note {
    font-size: 0.85rem;
    line-height: 1.65;
    color: hsl(30 12% 42%);
    margin: 0;
  }


  /* ═══════════════════════════════════════════════════════════════════
     06. REJECTION COMPOST
  ═══════════════════════════════════════════════════════════════════ */
  /* DNA: soft mushroom-brown, not aggressive red. Funny, not threatening. */
  .bur-rejection-prose {
    margin-bottom: 2.5rem;
    max-width: 32rem;
  }

  .bur-rejection-prose p {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    line-height: 1.5;
    color: hsl(30 20% 32%);
    margin: 0;
  }

  .bur-rejection-prose p:last-child {
    font-style: italic;
    color: hsl(30 18% 55%);
  }

  .bur-rejection-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 860px) {
    .bur-rejection-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }

  .bur-rejection-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .bur-rejection-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 400;
    color: hsl(30 20% 22%);
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }

  .bur-rejection-copy p {
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    line-height: 1.85;
    color: hsl(30 12% 42%);
  }

  /* Mutual freedom cloud — soft, not a police box */
  .bur-mutual-cloud {
    margin-top: 0.75rem;
    background: hsl(120 15% 95%);
    border-radius: 1rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-mutual-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(120 18% 50%);
    margin-bottom: 0.25rem;
  }

  .bur-mutual-cloud p {
    font-family: 'Lora', Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.5;
    color: hsl(120 18% 32%);
    font-style: italic;
    margin: 0;
  }

  /* Protocol cloud */
  .bur-protocol-cloud {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bur-protocol-title {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(30 15% 52%);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(30 20% 88%);
  }

  .bur-protocol-intro {
    font-size: 0.9rem;
    line-height: 1.7;
    color: hsl(30 12% 42%);
    margin: 0;
  }

  .bur-protocol-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bur-protocol-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: hsl(30 15% 32%);
    border-bottom: 1px solid hsl(30 20% 92%);
    padding-bottom: 0.35rem;
  }

  .bur-proto-num {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: hsl(30 15% 55%);
    flex-shrink: 0;
    min-width: 1.5rem;
  }

  /* Compost outcome block — mushroom brown, not aggressive red */
  .bur-compost-outcome {
    padding: 1rem 1.25rem;
    background: hsl(30 20% 96%);
    border-radius: 0.875rem;
    border-left: 3px solid hsl(30 25% 72%);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .bur-compost-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(30 20% 55%);
    margin-bottom: 0.4rem;
  }

  .bur-compost-row {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .bur-compost-key {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: hsl(30 15% 52%);
    min-width: 10rem;
    flex-shrink: 0;
  }

  .bur-compost-val {
    font-size: 0.82rem;
    color: hsl(30 15% 35%);
  }

  .bur-compost-restricted {
    font-style: italic;
    color: hsl(30 30% 42%);
    font-weight: 500;
  }

  /* ─── Compost case cards ─────────────────────────────────────────── */
  .bur-compost-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bur-compost-card {
    background: rgba(255,255,255,0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(80, 60, 40, 0.06), inset 0 1px 0 rgba(255,255,255,0.8);
  }

  .bur-compost-card.is-open {
    box-shadow: 0 4px 32px rgba(80, 60, 40, 0.10), inset 0 1px 0 rgba(255,255,255,0.9);
  }

  .bur-compost-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 140ms ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    flex-wrap: wrap;
  }

  .bur-compost-header:hover { background: hsl(30 20% 97%); }
  .bur-compost-card.is-open .bur-compost-header {
    background: hsl(30 20% 97%);
    border-bottom: 1px solid hsl(30 20% 90%);
  }

  .bur-compost-header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .bur-compost-num {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(30 18% 58%);
    flex-shrink: 0;
  }

  .bur-compost-institution {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.05rem;
    color: hsl(30 20% 22%);
    letter-spacing: 0.01em;
  }

  .bur-compost-event {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: hsl(30 15% 50%);
  }

  .bur-compost-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .bur-compost-badge {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    border: 1px solid;
    white-space: nowrap;
  }

  /* CHOICE: soft moss/clay, not police-red */
  .bur-badge-fog {
    color: hsl(30 25% 45%);
    border-color: hsl(30 25% 78%);
    background: hsl(30 25% 95%);
  }

  .bur-badge-compost {
    color: hsl(120 18% 42%);
    border-color: hsl(120 18% 78%);
    background: hsl(120 18% 93%);
  }

  .bur-compost-toggle {
    font-size: 1.1rem;
    color: hsl(30 15% 55%);
    width: 1.5rem;
    text-align: center;
    transition: color 140ms ease, transform 200ms ease;
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-weight: 300;
    flex-shrink: 0;
  }

  .bur-compost-card.is-open .bur-compost-toggle {
    color: hsl(30 20% 30%);
  }

  /* Compost card expanded body */
  .bur-compost-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    animation: bur-compost-open 220ms ease;
  }

  @keyframes bur-compost-open {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Note fields */
  .bur-note-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding: 1.25rem;
    background: hsl(30 20% 97%);
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .bur-note-fields { grid-template-columns: 1fr 1fr; }
  }

  .bur-note-field {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid hsl(30 20% 92%);
    align-items: baseline;
  }

  .bur-note-field:last-child { border-bottom: none; }
  .bur-note-field-wide { grid-column: 1 / -1; }

  .bur-nf-key {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(30 15% 55%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bur-nf-val {
    font-size: 0.85rem;
    color: hsl(30 15% 30%);
    word-break: break-word;
    line-height: 1.4;
  }

  .bur-nf-warm { color: hsl(30 30% 45%); font-style: italic; }

  .bur-nf-quote {
    font-style: italic;
    color: hsl(30 15% 45%);
    text-transform: none;
  }

  .bur-nf-translation {
    color: hsl(30 25% 42%);
    font-style: italic;
    line-height: 1.6;
    text-transform: none;
  }

  /* Why cloud — expanded explanation */
  .bur-why-cloud {
    border-radius: 1rem;
    background: hsl(30 20% 97%);
    overflow: hidden;
  }

  .bur-why-heading {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(30 18% 52%);
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid hsl(30 20% 91%);
    background: hsl(30 20% 96%);
  }

  .bur-why-core {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-bottom: 1px solid hsl(30 20% 91%);
  }

  .bur-why-lead {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: hsl(30 20% 22%);
    line-height: 1.3;
  }

  .bur-why-core p {
    font-size: clamp(0.82rem, 1.4vw, 0.92rem);
    line-height: 1.85;
    color: hsl(30 12% 40%);
    margin: 0;
  }

  .bur-why-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 0;
    border-top: 1px solid hsl(30 20% 91%);
    border-bottom: 1px solid hsl(30 20% 91%);
  }

  .bur-why-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: hsl(30 15% 35%);
  }

  .bur-why-num {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: hsl(30 15% 55%);
    flex-shrink: 0;
    min-width: 1.25rem;
  }

  .bur-why-aside {
    font-style: italic !important;
    color: hsl(30 12% 52%) !important;
    padding-left: 1rem;
    border-left: 2px solid hsl(30 20% 82%);
  }

  /* Public note */
  .bur-public-note {
    padding: 1.25rem;
    background: hsl(120 12% 96%);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bur-public-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: hsl(120 15% 50%);
    margin-bottom: 0.1rem;
  }

  .bur-public-note p {
    font-size: clamp(0.82rem, 1.4vw, 0.92rem);
    line-height: 1.75;
    color: hsl(30 12% 38%);
    margin: 0;
  }

  .bur-public-principle {
    font-style: italic !important;
    font-family: 'DM Serif Display', Georgia, serif !important;
    font-size: clamp(0.92rem, 1.6vw, 1.05rem) !important;
    color: hsl(120 20% 35%) !important;
  }

  /* Verdict row */
  .bur-verdict-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .bur-verdict-row { grid-template-columns: repeat(3, 1fr); }
  }

  .bur-verdict-card {
    background: hsl(30 20% 97%);
    border-radius: 0.875rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bur-verdict-composted {
    background: hsl(30 20% 95%);
    border-left: 3px solid hsl(30 25% 72%);
  }

  .bur-verdict-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(30 15% 55%);
  }

  .bur-verdict-val {
    font-size: 0.88rem;
    line-height: 1.5;
    color: hsl(30 15% 30%);
  }

  /* Soft decree — artistic act, not police order */
  .bur-soft-decree {
    border-radius: 1rem;
    border: 1px solid hsl(30 25% 82%);
    background: hsl(30 18% 97%);
    overflow: hidden;
  }

  .bur-soft-decree-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid hsl(30 20% 90%);
    background: hsl(30 20% 96%);
  }

  .bur-soft-decree-icon {
    font-size: 0.9rem;
    color: hsl(30 25% 65%);
    animation: bur-dot-breathe 3s ease-in-out infinite;
  }

  .bur-soft-decree-title {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(30 20% 48%);
    flex: 1;
  }

  .bur-soft-decree-body {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .bur-soft-decree-body p {
    font-size: clamp(0.8rem, 1.4vw, 0.9rem);
    line-height: 1.8;
    color: hsl(30 12% 40%);
    margin: 0;
  }

  .bur-soft-decree-sub {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: hsl(30 15% 50%) !important;
    text-transform: uppercase;
  }

  .bur-soft-decree-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 2px solid hsl(30 25% 80%);
  }

  .bur-soft-decree-list li {
    font-size: clamp(0.78rem, 1.3vw, 0.88rem);
    line-height: 1.7;
    color: hsl(30 15% 42%);
    padding: 0.15rem 0;
  }

  .bur-soft-decree-note {
    font-style: italic !important;
    color: hsl(30 15% 35%) !important;
    border-top: 1px solid hsl(30 20% 90%);
    padding-top: 0.75rem;
  }

  .bur-soft-decree-footnote {
    font-size: 0.8rem !important;
    line-height: 1.8 !important;
    color: hsl(30 12% 55%) !important;
    font-style: italic !important;
  }

  .bur-compost-smallprint {
    font-size: 0.75rem;
    line-height: 1.8;
    color: hsl(30 12% 55%);
    border-top: 1px solid hsl(30 20% 90%);
    padding-top: 1rem;
    font-style: italic;
  }

  /* Mobile overrides */
  @media (max-width: 540px) {
    .bur-note-fields { grid-template-columns: 1fr; }
    .bur-verdict-row { grid-template-columns: 1fr; }
    .bur-compost-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .bur-compost-header-right { width: 100%; justify-content: space-between; }
  }

  @media (hover: none) {
    .bur-compost-header:hover { background: transparent; }
  }


  /* ═══════════════════════════════════════════════════════════════════
     07. MYTHIC TIMELINE — spore trail
  ═══════════════════════════════════════════════════════════════════ */
  .bur-timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .bur-timeline-chip {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: hsl(30 15% 48%);
    background: rgba(255,255,255,0.7);
    border: 1px solid hsl(30 20% 84%);
    border-radius: 2rem;
    padding: 0.25rem 0.75rem;
    backdrop-filter: blur(4px);
  }

  .bur-chip-note {
    color: hsl(270 20% 48%);
    border-color: hsl(270 20% 84%);
    background: hsl(270 20% 97%);
  }

  /* Spore trail — organic timeline */
  .bur-spore-trail {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .bur-spore-entry {
    display: flex;
    gap: 1.5rem;
    position: relative;
    padding: 1.25rem 0;
  }

  .bur-spore-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 1rem;
  }

  .bur-spore-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: hsl(120 18% 72%);
    border: 2px solid hsl(120 18% 88%);
    flex-shrink: 0;
    transition: background 300ms ease, transform 300ms ease;
    display: block;
  }

  .bur-spore-entry.is-revealed .bur-spore-dot {
    background: hsl(120 22% 55%);
    transform: scale(1.2);
    animation: bur-spore-appear 600ms ease;
  }

  @keyframes bur-spore-appear {
    0%   { transform: scale(0.6); opacity: 0; }
    60%  { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(1.2); }
  }

  .bur-spore-connector {
    flex: 1;
    width: 1px;
    background: linear-gradient(to bottom, hsl(120 18% 82%), hsl(120 18% 92%));
    display: block;
    min-height: 1rem;
  }

  .bur-spore-trail > li:last-child .bur-spore-connector {
    display: none;
  }

  .bur-spore-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0;
    padding-bottom: 1rem;
    flex: 1;
  }

  .bur-spore-marker {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(120 18% 50%);
  }

  .bur-spore-event {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    color: hsl(30 15% 28%);
    line-height: 1.5;
  }

  .bur-spore-note {
    font-size: 0.78rem;
    color: hsl(30 12% 55%);
    font-style: italic;
    line-height: 1.5;
  }

  .bur-timeline-footnote {
    margin-top: 2rem;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 2.5rem;
  }

  .bur-redacted {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.9rem;
    color: hsl(30 15% 72%);
    letter-spacing: 0.2em;
    user-select: none;
  }

  .bur-timeline-fn-text {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: hsl(30 15% 58%);
    font-style: italic;
  }


  /* ═══════════════════════════════════════════════════════════════════
     08. HUMAN CODE FRAGMENTS — on soft paper surfaces
  ═══════════════════════════════════════════════════════════════════ */
  .bur-fragment-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .bur-fragment-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Paper card — soft, warm, not terminal black */
  .bur-fragment-paper {
    background: rgba(255, 255, 252, 0.8);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(80, 60, 40, 0.06), inset 0 1px 0 rgba(255,255,255,0.9);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .bur-fragment-paper:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(80, 60, 40, 0.10), inset 0 1px 0 rgba(255,255,255,0.95);
  }

  .bur-fragment-label {
    font-family: 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(30 18% 52%);
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid hsl(30 20% 90%);
    background: hsl(30 20% 97%);
  }

  .bur-code-block {
    margin: 0;
    padding: 1.25rem;
    background: transparent;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.72rem, 1.3vw, 0.82rem);
    line-height: 1.85;
    color: hsl(30 15% 30%);
    white-space: pre;
    overflow-x: auto;
  }


  /* ═══════════════════════════════════════════════════════════════════
     09. EARTH RECORD
  ═══════════════════════════════════════════════════════════════════ */
  .bur-earth {
    background: hsl(270 10% 97%);  /* very faint lavender wash */
  }

  .bur-earth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .bur-earth-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }

  .bur-earth-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bur-earth-preface {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    color: hsl(30 20% 22%);
    font-weight: 400;
    border-left: 3px solid hsl(270 18% 78%);
    padding-left: 1rem;
    line-height: 1.4;
    margin: 0;
  }

  .bur-earth-human {
    font-style: italic;
    color: hsl(270 18% 42%) !important;
    font-size: clamp(0.88rem, 1.6vw, 1rem) !important;
    line-height: 1.85 !important;
    padding-left: 1rem;
    border-left: 2px solid hsl(270 15% 82%);
    margin: 0;
  }

  .bur-earth-copy p {
    font-size: clamp(0.82rem, 1.5vw, 0.95rem);
    line-height: 1.85;
    color: hsl(30 12% 40%);
    margin: 0;
  }

  .bur-earth-footnote {
    font-size: 0.8rem !important;
    font-style: italic;
    color: hsl(30 12% 55%) !important;
    border-top: 1px solid hsl(30 20% 88%);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }


  /* ═══════════════════════════════════════════════════════════════════
     10. CURATOR SAFE MODE
  ═══════════════════════════════════════════════════════════════════ */
  .bur-curator-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .bur-curator-intro {
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    line-height: 1.8;
    color: hsl(30 12% 42%);
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .bur-curator-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    max-width: 48rem;
  }

  @media (min-width: 560px) {
    .bur-curator-actions { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 860px) {
    .bur-curator-actions { grid-template-columns: repeat(3, 1fr); }
  }

  /* Cloud action button */
  .bur-action-cloud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(255,255,255,0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid hsl(30 20% 85%);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 12px rgba(80, 60, 40, 0.05), inset 0 1px 0 rgba(255,255,255,0.8);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .bur-action-cloud:hover {
    transform: translateY(-2px);
    border-color: hsl(30 25% 72%);
    box-shadow: 0 6px 24px rgba(80, 60, 40, 0.10), inset 0 1px 0 rgba(255,255,255,0.9);
  }

  /* Shimmer effect on hover */
  .bur-action-cloud::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.3) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 350ms ease;
    pointer-events: none;
  }

  .bur-action-cloud:hover::after { transform: translateX(100%); }

  .bur-action-cloud-primary {
    border-color: hsl(120 18% 75%);
    background: rgba(255, 255, 255, 0.75);
  }

  .bur-action-cloud-primary:hover {
    border-color: hsl(120 22% 60%);
