---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
import NarMailChatbot from "../components/NarMailChatbot.astro";
import { getEntry } from "astro:content";
import DOMPurify from "isomorphic-dompurify";

const narMailEntry = await getEntry("products", "nar-mail-express");
if (!narMailEntry || narMailEntry.data.slug !== "nar-mail-express") {
  throw new Error("Required Nar-Mail content entry is missing.");
}
const narMail = narMailEntry.data;
---

<Layout
  title="Nar-Mail Express — Interdimensional Postal Artwork by Q888"
  description="Nar-Mail Express is a conceptual postal artwork by Q888: two-headed cat couriers carry messages across incompatible realities and deliver them when the receiver is ready."
  image={narMail.heroImage}
  canonicalPath="/narmail/"
  mainEntityType="CreativeWork"
  mainEntityName="Nar-Mail Express"
  keywords={["Nar-Mail Express", "postal art", "mail art", "speculative art", "two-headed cat", "Q888"]}
>
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />

  <main class="relative min-h-screen pt-10 md:pt-11">
    <div class="narmail-eden-wrap">
      <div class="narmail-layout">
        <section class="narmail-hero">
          <div class="narmail-hero-image">
            <img src={narMail.heroImage} alt={narMail.heroAlt} loading="eager" decoding="async" width="1200" height="800" />
          </div>
          <div class="narmail-hero-overlay px-6 sm:px-10 lg:px-16 pb-16">
            <div class="mx-auto">
              <h1 class="narmail-headline uppercase font-medium tracking-[-0.045em] leading-[0.88] text-[clamp(4rem,9vw,10.5rem)] text-black">
                {narMail.headline}
              </h1>
              <div class="mt-12 mx-auto text-[clamp(1.6rem,2.8vw,3rem)] leading-[1.15] text-black">
                <p>{narMail.subheadline}</p>
                <p class="mt-4 text-[clamp(1rem,1.2vw,1.3rem)] opacity-70">{narMail.subheadlineAside}</p>
              </div>
              <div class="narmail-mono narmail-mono-gold mt-12 text-lg sm:text-xl leading-relaxed uppercase tracking-widest text-left">
                <div>{narMail.statusLines[0]}</div>
                <div>{narMail.statusLines[1]}</div>
                <div>{narMail.statusLines[2]}</div>
              </div>
            </div>
          </div>
        </section>

        <div class="narmail-main-content px-6 sm:px-10 lg:px-16 pb-16">
          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.aboutHeading}</h2>
            <p>{narMail.aboutParagraphs[0]}</p>
            <p>{narMail.aboutParagraphs[1]}</p>
            <p>{narMail.aboutParagraphs[2]}</p>
            <p>{narMail.aboutParagraphs[3]}</p>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.howItWorksHeading}</h2>
            <h3 class="narmail-h3">{narMail.dualReadingHeading}</h3>
            <p>{narMail.dualReadingIntro}</p>
            <p set:html={DOMPurify.sanitize(narMail.dualReadingFirst)}></p>
            <p set:html={DOMPurify.sanitize(narMail.dualReadingSecond)}></p>
            <p>{narMail.dualReadingClosing}</p>
            <h3 class="narmail-h3">{narMail.deliveryTimelineHeading}</h3>
            <p>{narMail.deliveryTimelineIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.deliveryTimelineBullets[0]}</li>
              <li>{narMail.deliveryTimelineBullets[1]}</li>
              <li>{narMail.deliveryTimelineBullets[2]}</li>
            </ul>
            <p>{narMail.deliveryTimelineClosing}</p>
            <h3 class="narmail-h3">{narMail.serviceFeaturesHeading}</h3>
            <ul class="narmail-features">
              <li>{narMail.serviceFeaturesBullets[0]}</li>
              <li>{narMail.serviceFeaturesBullets[1]}</li>
              <li>{narMail.serviceFeaturesBullets[2]}</li>
              <li>{narMail.serviceFeaturesBullets[3]}</li>
              <li>{narMail.serviceFeaturesBullets[4]}</li>
              <li>{narMail.serviceFeaturesBullets[5]}</li>
            </ul>
          </section>

          <section class="narmail-artwork-card-section">
            <div
              class="artwork-info-card narmail-glass"
              id="narmail-gallery-trigger"
              role="button"
              tabindex="0"
              aria-label="Open Nar-Mail artwork gallery"
            >
              <!-- Decorative airmail diagonal stripes on left/right/top/bottom edges -->
              <div class="envelope-stripes-border"></div>

              <div class="artwork-card-content">
                <!-- Left: Postage Stamp Artwork Frame -->
                <div class="artwork-stamp-frame">
                  <div class="postage-stamp">
                    <img
                      src="/images/nar_mail_artwork.webp"
                      alt="Nar-Mail Express Stamp Preview"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="300"
                    />
                    <div class="stamp-hologram-glare"></div>
                    <div class="stamp-inner-gold"></div>
                  </div>
                </div>

                <!-- Right: Content & Action -->
                <div class="artwork-card-text-wrap">
                  <div class="artwork-card-tag font-mono">// SPECULATIVE VISUAL ARCHIVE</div>
                  <h3 class="artwork-card-title narmail-title">{narMail.artworkCardTitle}</h3>
                  <p class="artwork-card-description">{narMail.artworkCardDescription}</p>
                  
                  <button class="artwork-card-button narmail-btn" type="button" aria-label="Open full gallery viewer" tabindex="-1">
                    <span>{narMail.artworkCardButtonLabel}</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.securityHeading}</h2>
            <p>{narMail.securityIntro}</p>
            <h3 class="narmail-h3">{narMail.securityBlocks[0].heading}</h3>
            <h4 class="narmail-h4">{narMail.securityBlocks[0].subheading}</h4>
            <p>{narMail.securityBlocks[0].body}</p>
            <h4 class="narmail-h4">{narMail.securityBlocks[1].subheading}</h4>
            <p>{narMail.securityBlocks[1].body}</p>
            <h4 class="narmail-h4">{narMail.securityBlocks[2].subheading}</h4>
            <p>{narMail.securityBlocks[2].body}</p>
            <h3 class="narmail-h3">{narMail.securityBlocks[3].heading}</h3>
            <h4 class="narmail-h4">{narMail.securityBlocks[3].subheading}</h4>
            <p>{narMail.securityBlocks[3].body}</p>
            <h4 class="narmail-h4">{narMail.securityBlocks[4].subheading}</h4>
            <p>{narMail.securityBlocks[4].body}</p>
            <h4 class="narmail-h4">{narMail.securityBlocks[5].subheading}</h4>
            <p>{narMail.securityBlocks[5].body}</p>
            <h3 class="narmail-h3">{narMail.securityLevelsHeading}</h3>
            <p><strong>{narMail.securityLevels[0].level}</strong><br />{narMail.securityLevels[0].description}</p>
            <p><strong>{narMail.securityLevels[1].level}</strong><br />{narMail.securityLevels[1].description}</p>
            <p><strong>{narMail.securityLevels[2].level}</strong><br />{narMail.securityLevels[2].description}</p>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.whatYouCanSendHeading}</h2>
            <p>{narMail.declaredIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.declaredItems[0]}</li>
              <li>{narMail.declaredItems[1]}</li>
              <li>{narMail.declaredItems[2]}</li>
            </ul>
            <p>{narMail.unofficialIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.unofficialItems[0]}</li>
              <li>{narMail.unofficialItems[1]}</li>
              <li>{narMail.unofficialItems[2]}</li>
              <li>{narMail.unofficialItems[3]}</li>
            </ul>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.witnessHeading}</h2>
            <p>{narMail.witnessIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.witnessItems[0]}</li>
              <li>{narMail.witnessItems[1]}</li>
              <li>{narMail.witnessItems[2]}</li>
              <li>{narMail.witnessItems[3]}</li>
              <li>{narMail.witnessItems[4]}</li>
            </ul>
            <p>{narMail.witnessClosing}</p>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.paymentHeading}</h2>
            <p>{narMail.paymentAcceptIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.paymentAcceptItems[0]}</li>
              <li>{narMail.paymentAcceptItems[1]}</li>
              <li>{narMail.paymentAcceptItems[2]}</li>
              <li>{narMail.paymentAcceptItems[3]}</li>
            </ul>
            <p>{narMail.paymentRefuseIntro}</p>
            <ul class="narmail-list">
              <li>{narMail.paymentRefuseItems[0]}</li>
              <li>{narMail.paymentRefuseItems[1]}</li>
              <li>{narMail.paymentRefuseItems[2]}</li>
            </ul>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.historicalHeading}</h2>
            <p>{narMail.historicalParagraphs[0]}</p>
            <p>{narMail.historicalParagraphs[1]}</p>
          </section>

          <section class="narmail-section narmail-guarantee">
            <h2 class="narmail-h2">{narMail.guaranteeHeading}</h2>
            <p>{narMail.guaranteeIntro}</p>
            <blockquote class="narmail-blockquote">
              {narMail.guaranteeQuoteLines[0]}<br />
              {narMail.guaranteeQuoteLines[1]}
            </blockquote>
            <p>{narMail.guaranteeClosing}</p>
          </section>

          <section class="narmail-section">
            <h2 class="narmail-h2">{narMail.termsHeading}</h2>
            <ol class="narmail-terms">
              {narMail.termsItems.map((item) => (
                <li set:html={DOMPurify.sanitize(item)}></li>
              ))}
            </ol>
          </section>
          <NarMailChatbot />
        </div>

        <div class="narmail-image-above-footer px-6 sm:px-10 lg:px-16">
          <img src={narMail.footerImage} alt={narMail.footerImageAlt} class="narmail-q-a-image" loading="lazy" decoding="async" width="400" height="400" />
        </div>

        <footer class="narmail-footer">
          <div class="narmail-footer-container px-6 sm:px-10 lg:px-16">
            <div class="narmail-footer-scatter">
              <p class="narmail-footer-line narmail-footer-headline">{narMail.footerLines[0]}</p>
              <p class="narmail-footer-line narmail-footer-dreams">{narMail.footerLines[1]}</p>
              <p class="narmail-footer-line narmail-footer-invest">{narMail.footerLines[2]}</p>
              <p class="narmail-footer-line narmail-footer-link-wrap">
                <a href="/overpriced/" class="narmail-footer-link">{narMail.footerLines[3]}</a>
              </p>
              <p class="narmail-footer-line narmail-footer-what">{narMail.footerLines[4]}</p>
              <p class="narmail-footer-line narmail-footer-check">{narMail.footerLines[5]}</p>
              <p class="narmail-footer-line narmail-footer-check">{narMail.footerLines[6]}</p>
              <p class="narmail-footer-line narmail-footer-check">{narMail.footerLines[7]}</p>
              <p class="narmail-footer-line narmail-footer-price">{narMail.footerLines[8]}</p>
              <p class="narmail-footer-line narmail-footer-contact">
                <a href={`mailto:${narMail.footerEmail}`}>{narMail.footerEmail}</a>
                <span class="narmail-footer-sep">|</span>
                <a href={narMail.footerInstagramUrl} target="_blank" rel="noopener">{narMail.footerInstagramHandle}</a>
              </p>
              <div class="narmail-footer-cta">
                <a href="/#infocigan" class="narmail-retreat-btn no-underline inline-block">{narMail.ctaLabel}</a>
              </div>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <!-- ══════════════════════════════════ GALLERY DIALOG ══════════════════════════════════ -->
    <dialog
      class="narmail-gallery-dialog"
      id="narmail-gallery-dialog"
      aria-label="Nar-Mail Express campaign gallery"
    >
      <!-- Controls bar -->
      <div class="gallery-controls" id="narmail-gallery-controls">
        <!-- Left: nav -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-prev" id="narmail-prev-btn" aria-label="Previous image" title="Previous (←)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-counter" id="narmail-gallery-counter" aria-live="polite">1 / 1</span>
          <button class="gallery-btn gallery-next" id="narmail-next-btn" aria-label="Next image" title="Next (→)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-label" id="narmail-gallery-label" aria-live="polite"></span>
        </div>

        <!-- Right: actions -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-zoom-in" id="narmail-zoom-in" aria-label="Zoom in" title="Zoom in (+)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-zoom-out" id="narmail-zoom-out" aria-label="Zoom out" title="Zoom out (-)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-reset" id="narmail-reset-zoom" aria-label="Reset zoom" title="Reset view (0)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <a class="gallery-btn gallery-download" id="narmail-download-btn" aria-label="Download image" title="Download image" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3V16M12 16L7 11M12 16L17 11M5 20H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <button class="gallery-btn gallery-fullscreen" id="narmail-fullscreen-btn" aria-label="Toggle fullscreen" title="Fullscreen (F)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="narmail-fs-icon-expand">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="narmail-fs-icon-shrink" class="hidden">
              <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-close" id="narmail-close-btn" aria-label="Close gallery" title="Close (Esc)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Image viewport -->
      <div class="gallery-viewport" id="narmail-gallery-viewport">
        <div class="gallery-img-container" id="narmail-img-container">
          <img
            class="gallery-img"
            id="narmail-gallery-img"
            src=""
            alt=""
            draggable="false"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="gallery-zoom-pill" id="narmail-zoom-pill" aria-live="polite" aria-atomic="true">100%</div>
      </div>
    </dialog>
  </main>

  <div class="hidden md:block">
    <SystemMeta position="bottom" />
  </div>
</Layout>

<script>
  /* ─────────────────────────────────────────────────────────────────
     NAR-MAIL GALLERY — Native <dialog> + Fullscreen API
     ───────────────────────────────────────────────────────────────── */
  type GalleryImage = { src: string; alt: string; label: string };

  const IMAGES: GalleryImage[] = [
    { src: "/images/nar_mail_artwork.webp", alt: "Nar-Mail Express Visual Archive", label: "Visual Archive" },
  ];

  function initGallery() {
    // Force cleanup on page load / page swap to avoid carrying over viewer state
    document.documentElement.classList.remove("is-viewer-open");
    document.body.style.overflow = "";

    const trigger   = document.getElementById("narmail-gallery-trigger");
    const dialog    = document.getElementById("narmail-gallery-dialog") as HTMLDialogElement | null;
    if (!trigger || !dialog) return;
    if (dialog.dataset.galleryInit) return;
    dialog.dataset.galleryInit = "1";

    const img        = document.getElementById("narmail-gallery-img") as HTMLImageElement;
    const counter    = document.getElementById("narmail-gallery-counter")!;
    const label      = document.getElementById("narmail-gallery-label")!;
    const container  = document.getElementById("narmail-img-container")!;
    const viewport   = document.getElementById("narmail-gallery-viewport")!;
    const pill       = document.getElementById("narmail-zoom-pill")!;
    const prevBtn    = document.getElementById("narmail-prev-btn")!;
    const nextBtn    = document.getElementById("narmail-next-btn")!;
    const zoomInBtn  = document.getElementById("narmail-zoom-in")!;
    const zoomOutBtn = document.getElementById("narmail-zoom-out")!;
    const resetBtn   = document.getElementById("narmail-reset-zoom")!;
    const dlBtn      = document.getElementById("narmail-download-btn") as HTMLAnchorElement;
    const fsBtn      = document.getElementById("narmail-fullscreen-btn")!;
    const closeBtn   = document.getElementById("narmail-close-btn")!;
    const fsExpand   = document.getElementById("narmail-fs-icon-expand")!;
    const fsShrink   = document.getElementById("narmail-fs-icon-shrink")!;

    if (IMAGES.length <= 1) {
      prevBtn.style.display = "none";
      nextBtn.style.display = "none";
      counter.style.display = "none";
    }

    let currentIdx = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    const MIN_SCALE = 1;
    const MAX_SCALE = 5;
    const ZOOM_STEP = 0.35;
    let pillTimer: ReturnType<typeof setTimeout>;
    let initialDist = 0;
    let initialScale = 1;

    // ── Image loading ──
    function loadImage(idx: number) {
      const entry = IMAGES[idx];
      img.src = entry.src;
      img.alt = entry.alt;
      dlBtn.href = entry.src;
      dlBtn.download = entry.src.split("/").pop() ?? "narmail-artwork";
      counter.textContent = `${idx + 1} / ${IMAGES.length}`;
      label.textContent = entry.label;
      prevBtn.toggleAttribute("disabled", idx === 0);
      nextBtn.toggleAttribute("disabled", idx === IMAGES.length - 1);
    }

    // ── Transform ──
    function applyTransform() {
      container.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      const pct = `${Math.round(scale * 100)}%`;
      pill.textContent = pct;
      pill.classList.add("show");
      clearTimeout(pillTimer);
      pillTimer = setTimeout(() => pill.classList.remove("show"), 1200);
    }

    function resetTransform() {
      scale = 1; tx = 0; ty = 0;
      container.style.transform = "";
    }

    function zoomIn() {
      scale = Math.min(scale + ZOOM_STEP, MAX_SCALE);
      applyTransform();
    }

    function zoomOut() {
      scale = Math.max(scale - ZOOM_STEP, MIN_SCALE);
      if (scale <= MIN_SCALE) { tx = 0; ty = 0; }
      applyTransform();
    }

    // ── Open / close ──
    function openGallery(idx = 0) {
      currentIdx = idx;
      loadImage(currentIdx);
      resetTransform();
      document.documentElement.classList.add("is-viewer-open");
      document.body.style.overflow = "hidden";
      dialog!.showModal();
    }

    function closeGallery() {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
      dialog!.close();
      document.documentElement.classList.remove("is-viewer-open");
      document.body.style.overflow = "";
      resetTransform();
    }

    // ── Fullscreen ──
    function updateFsIcon() {
      const isFs = !!document.fullscreenElement;
      fsExpand.classList.toggle("hidden", isFs);
      fsShrink.classList.toggle("hidden", !isFs);
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        dialog!.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    document.addEventListener("fullscreenchange", updateFsIcon);

    // ── Drag / pan ──
    function onPointerDown(e: PointerEvent) {
      if (scale <= 1) return;
      isDragging = true;
      viewport.setPointerCapture(e.pointerId);
      viewport.style.cursor = "grabbing";
      startX = e.clientX - tx;
      startY = e.clientY - ty;
    }

    // Explicit function onPointerMove
    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      tx = e.clientX - startX;
      ty = e.clientY - startY;
      applyTransform();
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      viewport.releasePointerCapture(e.pointerId);
      viewport.style.cursor = "";
    }

    // ── Wheel zoom ──
    function onWheel(e: WheelEvent) {
      e.preventDefault();
      if (e.deltaY < 0) zoomIn(); else zoomOut();
    }

    // ── Touch pinch ──
    function getTouchDist(e: TouchEvent) {
      return Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY,
      );
    }

    function onTouchStart(e: TouchEvent) {
      if (e.touches.length === 2) {
        initialDist  = getTouchDist(e);
        initialScale = scale;
      }
    }

    function onTouchMove(e: TouchEvent) {
      if (e.touches.length === 2) {
        e.preventDefault();
        const ratio = getTouchDist(e) / initialDist;
        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, initialScale * ratio));
        applyTransform();
      }
    }

    // ── Keyboard ──
    function onKeyDown(e: KeyboardEvent) {
      if (!dialog?.open) return;
      switch (e.key) {
        case "ArrowLeft":  if (currentIdx > 0)                    { currentIdx--; loadImage(currentIdx); resetTransform(); } break;
        case "ArrowRight": if (currentIdx < IMAGES.length - 1)    { currentIdx++; loadImage(currentIdx); resetTransform(); } break;
        case "+": case "=": zoomIn();   break;
        case "-":           zoomOut();  break;
        case "0":           resetTransform(); pill.textContent = "100%"; break;
        case "f": case "F": toggleFullscreen(); break;
      }
    }

    // ── Nav buttons ──
    prevBtn.addEventListener("click", () => {
      if (currentIdx > 0) { currentIdx--; loadImage(currentIdx); resetTransform(); }
    });
    nextBtn.addEventListener("click", () => {
      if (currentIdx < IMAGES.length - 1) { currentIdx++; loadImage(currentIdx); resetTransform(); }
    });

    // ── Event wiring ──
    trigger.addEventListener("click",   () => openGallery(0));
    trigger.addEventListener("keydown", (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "Enter" || ke.key === " ") { ke.preventDefault(); openGallery(0); }
    });

    closeBtn.addEventListener("click",    closeGallery);
    zoomInBtn.addEventListener("click",   zoomIn);
    zoomOutBtn.addEventListener("click",  zoomOut);
    resetBtn.addEventListener("click",    () => { resetTransform(); });
    fsBtn.addEventListener("click",       toggleFullscreen);

    // Light dismiss: close when clicking the backdrop
    dialog!.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (target === dialog) closeGallery();
    });

    // Native cancel event (ESC key)
    dialog!.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeGallery();
    });

    viewport.addEventListener("pointerdown", onPointerDown as EventListener);
    viewport.addEventListener("pointermove", onPointerMove as EventListener);
    viewport.addEventListener("pointerup",   onPointerUp   as EventListener);
    viewport.addEventListener("wheel",       onWheel as EventListener, { passive: false });
    viewport.addEventListener("touchstart",  onTouchStart as EventListener, { passive: true });
    viewport.addEventListener("touchmove",   onTouchMove  as EventListener, { passive: false });

    document.addEventListener("keydown", onKeyDown);

    // Cleanup on Astro page transitions
    const cleanup = () => {
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("fullscreenchange", updateFsIcon);
      document.documentElement.classList.remove("is-viewer-open");
      document.body.style.overflow = "";
      document.removeEventListener("astro:before-swap", cleanup);
    };
    document.addEventListener("astro:before-swap", cleanup);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }
  document.addEventListener("astro:page-load", initGallery);
</script>

