  }

  .destination-word--1 { transform: translateY(0.1em) rotate(-4deg); }
  .destination-word--2 { transform: translate(-0.08em, -0.07em) rotate(3deg); }
  .destination-word--3 { transform: translate(-0.14em, 0.08em) rotate(-2.5deg); }

  .destination-letter {
