  }

  .destination-word::before,
  .destination-word::after {
    content: attr(data-word);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .destination-word::before {
    color: rgba(32, 140, 141, 0.46);
    filter: blur(1.35px);
    opacity: 0.9;
    transform: translate(-0.08em, 0.055em) skewX(-4deg);
    transition: transform 0.45s ease, opacity 0.45s ease;
  }

  .destination-word::after {
    background: linear-gradient(90deg, #a67c00 10%, #ffcc33 46%, #208c8d 62%, #a67c00 90%);
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
