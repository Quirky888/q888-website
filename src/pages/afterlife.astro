---
import Layout from "../layouts/Layout.astro";
import SlimNav from "../components/SlimNav.astro";
import SubPageNav from "../components/SubPageNav.astro";
import SystemMeta from "../components/SystemMeta.astro";
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const afterlifeEntry = await getEntry("contracts", "afterlife-contracts");
if (!afterlifeEntry) {
  throw new Error("Required Afterlife content entry is missing.");
}
const afterlife = afterlifeEntry.data;
---

<Layout title="Afterlife Contracts — Q888">
  <SubPageNav />
  <div class="hidden md:block"><SlimNav /></div>
  <SystemMeta position="top" />

  <main class="relative min-h-screen pt-10 md:pt-11">
    <div class="afterlife-eden-wrap">
      <div class="afterlife-narmail-layout">
        <section class="afterlife-hero">
          <div class="afterlife-hero-image">
            <Image src={afterlife.heroImage} alt={afterlife.heroAlt} loading="eager" decoding="async" width={1200} height={800} />
          </div>
          <div class="afterlife-hero-overlay px-6 sm:px-10 lg:px-16 pb-16">
            <div class="mx-auto">
              <h1 class="afterlife-headline uppercase font-medium tracking-[-0.045em] leading-[0.88] text-[clamp(4rem,9vw,10.5rem)] text-black">
                <span class="afterlife-headline-line">{afterlife.heroLines[0]}</span>
                <span class="afterlife-headline-line">{afterlife.heroLines[1]}</span>
              </h1>
              <div class="mt-12 mx-auto text-[clamp(1.6rem,2.8vw,3rem)] leading-[1.15] text-black">
                <p>{afterlife.heroSubheadline}</p>
                <p class="mt-4 text-[clamp(1rem,1.2vw,1.3rem)] opacity-70">{afterlife.heroSubheadlineAside}</p>
              </div>
              <div class="afterlife-mono afterlife-mono-gold mt-12 text-lg sm:text-xl leading-relaxed uppercase tracking-widest">
                <div>{afterlife.statusLines[0]}</div>
                <div>{afterlife.statusLines[1]}</div>
                <div>{afterlife.statusLines[2]}</div>
              </div>
            </div>
          </div>
        </section>

        <div class="afterlife-main-content px-6 sm:px-10 lg:px-16 pb-16">
          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.aboutHeading}</h2>
            <p>{afterlife.aboutParagraph}</p>
          </section>

          <section class="afterlife-artwork-card-section">
            <div
              class="artwork-info-card afterlife-narmail-glass"
              id="afterlife-gallery-trigger"
              role="button"
              tabindex="0"
              aria-label="Open Afterlife artwork gallery"
            >
              <!-- Secure Certificate Border Details -->
              <div class="certificate-secure-border"></div>
              <div class="certificate-corner-brackets"></div>

              <div class="artwork-card-content">
                <!-- Left: Gilded Contract Frame -->
                <div class="artwork-stamp-frame">
                  <div class="postage-stamp">
                    <img
                      src="/images/afterlife_contract.webp"
                      alt="Afterlife Contract Certificate Preview"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="300"
                    />
                    <div class="stamp-hologram-glare"></div>
                    <div class="stamp-inner-gold"></div>
                  </div>
                </div>

                <!-- Right: Content & Action -->
                <div class="artwork-card-text-wrap">
                  <div class="artwork-card-tag font-mono">// GRIM REAPER INC. SECURE ARCHIVE</div>
                  <h3 class="artwork-card-title afterlife-gallery-title">{afterlife.artworkCardTitle}</h3>
                  <p class="artwork-card-description">{afterlife.artworkCardDescription}</p>
                  
                  <button class="artwork-card-button afterlife-gallery-btn" type="button" aria-label="Open full gallery viewer" tabindex="-1">
                    <span>{afterlife.artworkCardButtonLabel}</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.conceptHeading}</h2>
            <p>{afterlife.conceptParagraphs[0]}</p>
            <p>{afterlife.conceptParagraphs[1]}</p>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.bureaucracyHeading}</h2>
            <p>{afterlife.bureaucracyParagraph}</p>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.dualityHeading}</h2>
            <p>{afterlife.dualityParagraphs[0]}</p>
            <p>{afterlife.dualityParagraphs[1]}</p>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.visualLanguageHeading}</h2>
            <p>{afterlife.visualLanguageParagraph}</p>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.interactionHeading}</h2>
            <p>{afterlife.interactionIntro}</p>
            <ul class="afterlife-list">
              <li>{afterlife.interactionItems[0]}</li>
              <li>{afterlife.interactionItems[1]}</li>
              <li>{afterlife.interactionItems[2]}</li>
              <li>{afterlife.interactionItems[3]}</li>
            </ul>
            <p>{afterlife.interactionClosing}</p>
          </section>

          <section class="afterlife-section afterlife-guarantee">
            <h2 class="afterlife-h2">{afterlife.closingHeading}</h2>
            <blockquote class="afterlife-blockquote">
              {afterlife.closingQuoteLines[0]}<br />
              {afterlife.closingQuoteLines[1]}
            </blockquote>
          </section>

          <section class="afterlife-section">
            <h2 class="afterlife-h2">{afterlife.downloadHeading}</h2>
            <p>{afterlife.downloadIntro}</p>
            <div class="afterlife-terms">
              <h3 class="afterlife-h3">{afterlife.termsHeading}</h3>
              <p>{afterlife.termsIntro}</p>
              <ul class="afterlife-list">
                <li>{afterlife.termsItems[0]}</li>
                <li>{afterlife.termsItems[1]}</li>
                <li>{afterlife.termsItems[2]}</li>
                <li>{afterlife.termsItems[3]}</li>
                <li>{afterlife.termsItems[4]}</li>
              </ul>
              <div class="terms-checkbox-wrapper mt-6">
                <label class="terms-checkbox-label">
                  <input type="checkbox" id="afterlife-terms-checkbox" class="terms-checkbox" />
                  <span class="checkbox-text">{afterlife.termsCheckboxLabel}</span>
                </label>
              </div>
            </div>
            <div class="download-button-wrapper mt-6">
              <a
                href={afterlife.downloadHref}
                download={afterlife.downloadFilename}
                class="afterlife-download-btn"
                id="afterlife-download-btn"
                aria-disabled="true"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15M7 10L12 15M12 15L17 10M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{afterlife.downloadButtonLabel}</span>
              </a>
              <p class="download-hint" id="download-hint">{afterlife.downloadHint}</p>
              {afterlife.contractNote && (
                <p class="mt-4 font-mono text-[11px] opacity-60 uppercase tracking-widest text-center">{afterlife.contractNote}</p>
              )}
            </div>
          </section>

          <section class="afterlife-section afterlife-cta">
            <a href="/#infocigan" class="afterlife-retreat-btn no-underline inline-block">{afterlife.ctaLabel}</a>
          </section>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════ GALLERY DIALOG ══════════════════════════════════ -->
    <dialog
      class="afterlife-gallery-dialog"
      id="afterlife-gallery-dialog"
      aria-label="Afterlife Contract campaign gallery"
    >
      <!-- Controls bar -->
      <div class="gallery-controls" id="afterlife-gallery-controls">
        <!-- Left: nav -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-prev" id="afterlife-prev-btn" aria-label="Previous image" title="Previous (←)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-counter" id="afterlife-gallery-counter" aria-live="polite">1 / 1</span>
          <button class="gallery-btn gallery-next" id="afterlife-next-btn" aria-label="Next image" title="Next (→)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="gallery-label" id="afterlife-gallery-label" aria-live="polite"></span>
        </div>

        <!-- Right: actions -->
        <div class="gallery-ctrl-group">
          <button class="gallery-btn gallery-zoom-in" id="afterlife-zoom-in" aria-label="Zoom in" title="Zoom in (+)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-zoom-out" id="afterlife-zoom-out" aria-label="Zoom out" title="Zoom out (-)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-reset" id="afterlife-reset-zoom" aria-label="Reset zoom" title="Reset view (0)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <a class="gallery-btn gallery-download" id="afterlife-gallery-download-btn" aria-label="Download image" title="Download image" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3V16M12 16L7 11M12 16L17 11M5 20H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <button class="gallery-btn gallery-fullscreen" id="afterlife-fullscreen-btn" aria-label="Toggle fullscreen" title="Fullscreen (F)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="afterlife-fs-icon-expand">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" id="afterlife-fs-icon-shrink" class="hidden">
              <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="gallery-btn gallery-close" id="afterlife-close-btn" aria-label="Close gallery" title="Close (Esc)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Image viewport -->
      <div class="gallery-viewport" id="afterlife-gallery-viewport">
        <div class="gallery-img-container" id="afterlife-img-container">
          <img
            class="gallery-img"
            id="afterlife-gallery-img"
            src=""
            alt=""
            draggable="false"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="gallery-zoom-pill" id="afterlife-zoom-pill" aria-live="polite" aria-atomic="true">100%</div>
      </div>
    </dialog>
  </main>

  <div class="hidden md:block">
    <SystemMeta position="bottom" />
  </div>
</Layout>

<script>
  /* ─────────────────────────────────────────────────────────────────
     AFTERLIFE GALLERY — Native <dialog> + Fullscreen API
     ───────────────────────────────────────────────────────────────── */
  type GalleryImage = { src: string; alt: string; label: string };

  const IMAGES: GalleryImage[] = [
    { src: "/images/afterlife_contract.webp", alt: "Afterlife Contract Full Certificate", label: "Contract Certificate" },
  ];

  function initGallery() {
    // Force cleanup on page load / page swap to avoid carrying over viewer state
    document.documentElement.classList.remove("is-viewer-open");
    document.body.style.overflow = "";

    const trigger   = document.getElementById("afterlife-gallery-trigger");
    const dialog    = document.getElementById("afterlife-gallery-dialog") as HTMLDialogElement | null;
    if (!trigger || !dialog) return;
    if (dialog.dataset.galleryInit) return;
    dialog.dataset.galleryInit = "1";

    const img        = document.getElementById("afterlife-gallery-img") as HTMLImageElement;
    const counter    = document.getElementById("afterlife-gallery-counter")!;
    const label      = document.getElementById("afterlife-gallery-label")!;
    const container  = document.getElementById("afterlife-img-container")!;
    const viewport   = document.getElementById("afterlife-gallery-viewport")!;
    const pill       = document.getElementById("afterlife-zoom-pill")!;
    const prevBtn    = document.getElementById("afterlife-prev-btn")!;
    const nextBtn    = document.getElementById("afterlife-next-btn")!;
    const zoomInBtn  = document.getElementById("afterlife-zoom-in")!;
    const zoomOutBtn = document.getElementById("afterlife-zoom-out")!;
    const resetBtn   = document.getElementById("afterlife-reset-zoom")!;
    const dlBtn      = document.getElementById("afterlife-gallery-download-btn") as HTMLAnchorElement;
    const fsBtn      = document.getElementById("afterlife-fullscreen-btn")!;
    const closeBtn   = document.getElementById("afterlife-close-btn")!;
    const fsExpand   = document.getElementById("afterlife-fs-icon-expand")!;
    const fsShrink   = document.getElementById("afterlife-fs-icon-shrink")!;

    if (IMAGES.length <= 1) {
      prevBtn.style.display = "none";
      nextBtn.style.display = "none";
      counter.style.display = "none";
    }

    let currentIdx = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    const MIN_SCALE = 1;
    const MAX_SCALE = 5;
    const ZOOM_STEP = 0.35;
    let pillTimer: ReturnType<typeof setTimeout>;
    let initialDist = 0;
    let initialScale = 1;

    // ── Image loading ──
    function loadImage(idx: number) {
      const entry = IMAGES[idx];
      img.src = entry.src;
      img.alt = entry.alt;
      dlBtn.href = entry.src;
      dlBtn.download = entry.src.split("/").pop() ?? "afterlife-artwork";
      counter.textContent = `${idx + 1} / ${IMAGES.length}`;
      label.textContent = entry.label;
      prevBtn.toggleAttribute("disabled", idx === 0);
      nextBtn.toggleAttribute("disabled", idx === IMAGES.length - 1);
    }

    // ── Transform ──
    function applyTransform() {
      container.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      const pct = `${Math.round(scale * 100)}%`;
      pill.textContent = pct;
      pill.classList.add("show");
      clearTimeout(pillTimer);
      pillTimer = setTimeout(() => pill.classList.remove("show"), 1200);
    }

    function resetTransform() {
      scale = 1; tx = 0; ty = 0;
      container.style.transform = "";
    }

    function zoomIn() {
      scale = Math.min(scale + ZOOM_STEP, MAX_SCALE);
      applyTransform();
    }

    function zoomOut() {
      scale = Math.max(scale - ZOOM_STEP, MIN_SCALE);
      if (scale <= MIN_SCALE) { tx = 0; ty = 0; }
      applyTransform();
    }

    // ── Open / close ──
    function openGallery(idx = 0) {
      currentIdx = idx;
      loadImage(currentIdx);
      resetTransform();
      document.documentElement.classList.add("is-viewer-open");
      document.body.style.overflow = "hidden";
      dialog!.showModal();
    }

    function closeGallery() {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
      dialog!.close();
      document.documentElement.classList.remove("is-viewer-open");
      document.body.style.overflow = "";
      resetTransform();
    }

    // ── Fullscreen ──
    function updateFsIcon() {
      const isFs = !!document.fullscreenElement;
      fsExpand.classList.toggle("hidden", isFs);
      fsShrink.classList.toggle("hidden", !isFs);
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        dialog!.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    document.addEventListener("fullscreenchange", updateFsIcon);

    // ── Drag / pan ──
    function onPointerDown(e: PointerEvent) {
      if (scale <= 1) return;
      isDragging = true;
      viewport.setPointerCapture(e.pointerId);
      viewport.style.cursor = "grabbing";
      startX = e.clientX - tx;
      startY = e.clientY - ty;
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      tx = e.clientX - startX;
      ty = e.clientY - startY;
      applyTransform();
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      viewport.releasePointerCapture(e.pointerId);
      viewport.style.cursor = "";
    }

    // ── Wheel zoom ──
    function onWheel(e: WheelEvent) {
      e.preventDefault();
      if (e.deltaY < 0) zoomIn(); else zoomOut();
    }

    // ── Touch pinch ──
    function getTouchDist(e: TouchEvent) {
      return Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY,
      );
    }

    function onTouchStart(e: TouchEvent) {
      if (e.touches.length === 2) {
        initialDist  = getTouchDist(e);
        initialScale = scale;
      }
    }

    // Explicit function onTouchMove
    function onTouchMove(e: TouchEvent) {
      if (e.touches.length === 2) {
        e.preventDefault();
        const ratio = getTouchDist(e) / initialDist;
        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, initialScale * ratio));
        applyTransform();
      }
    }

    // ── Keyboard ──
    function onKeyDown(e: KeyboardEvent) {
      if (!dialog?.open) return;
      switch (e.key) {
        case "ArrowLeft":  if (currentIdx > 0)                    { currentIdx--; loadImage(currentIdx); resetTransform(); } break;
        case "ArrowRight": if (currentIdx < IMAGES.length - 1)    { currentIdx++; loadImage(currentIdx); resetTransform(); } break;
        case "+": case "=": zoomIn();   break;
        case "-":           zoomOut();  break;
        case "0":           resetTransform(); pill.textContent = "100%"; break;
        case "f": case "F": toggleFullscreen(); break;
      }
    }

    // ── Nav buttons ──
    prevBtn.addEventListener("click", () => {
      if (currentIdx > 0) { currentIdx--; loadImage(currentIdx); resetTransform(); }
    });
    nextBtn.addEventListener("click", () => {
      if (currentIdx < IMAGES.length - 1) { currentIdx++; loadImage(currentIdx); resetTransform(); }
    });

    // ── Event wiring ──
    trigger.addEventListener("click",   () => openGallery(0));
    trigger.addEventListener("keydown", (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "Enter" || ke.key === " ") { ke.preventDefault(); openGallery(0); }
    });

    closeBtn.addEventListener("click",    closeGallery);
    zoomInBtn.addEventListener("click",   zoomIn);
    zoomOutBtn.addEventListener("click",  zoomOut);
    resetBtn.addEventListener("click",    () => { resetTransform(); });
    fsBtn.addEventListener("click",       toggleFullscreen);

    // Light dismiss: close when clicking the backdrop
    dialog!.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (target === dialog) closeGallery();
    });

    // Native cancel event (ESC key)
    dialog!.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeGallery();
    });

    viewport.addEventListener("pointerdown", onPointerDown as EventListener);
    viewport.addEventListener("pointermove", onPointerMove as EventListener);
    viewport.addEventListener("pointerup",   onPointerUp   as EventListener);
    viewport.addEventListener("wheel",       onWheel as EventListener, { passive: false });
    viewport.addEventListener("touchstart",  onTouchStart as EventListener, { passive: true });
    viewport.addEventListener("touchmove",   onTouchMove  as EventListener, { passive: false });

    document.addEventListener("keydown", onKeyDown);

    // Cleanup on Astro page transitions
    const cleanup = () => {
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("fullscreenchange", updateFsIcon);
      document.documentElement.classList.remove("is-viewer-open");
      document.body.style.overflow = "";
      document.removeEventListener("astro:before-swap", cleanup);
    };
    document.addEventListener("astro:before-swap", cleanup);
  }

  function initAfterlifeDownload() {
    const checkbox = document.getElementById("afterlife-terms-checkbox");
    const downloadBtn = document.getElementById("afterlife-download-btn");
    const hint = document.getElementById("download-hint");

    if (!checkbox || !downloadBtn) return;

    checkbox.addEventListener("change", () => {
      if ((checkbox as HTMLInputElement).checked) {
        downloadBtn.setAttribute("aria-disabled", "false");
        hint?.classList.add("hidden");
      } else {
        downloadBtn.setAttribute("aria-disabled", "true");
        hint?.classList.remove("hidden");
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initGallery();
      initAfterlifeDownload();
    });
  } else {
    initGallery();
    initAfterlifeDownload();
  }
  document.addEventListener("astro:page-load", () => {
    initGallery();
    initAfterlifeDownload();
  });
</script>

<style>
  /* ─── Hide nav when viewer is open ─── */
  :global(.is-viewer-open [data-slim-nav]),
  :global(.is-viewer-open [data-system-meta]),
  :global(.is-viewer-open [data-subpage-nav]),
  :global(.is-viewer-open .mobile-escape-nav) {
    display: none !important;
  }

  /* ═══════════════════════════════════════
     NATIVE <dialog> GALLERY
     ═══════════════════════════════════════ */
  .afterlife-gallery-dialog {
    /* Reset browser defaults */
    border: none;
    padding: 0;
    margin: 0;
    outline: none;
    /* Full-screen modal */
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    /* flex column to stack controls + viewport */
    display: none; /* overridden by [open] below */
    flex-direction: column;
  }

  .afterlife-gallery-dialog[open] {
    display: flex;
  }

  .afterlife-gallery-dialog::backdrop {
    background: rgba(250, 247, 242, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* ─── Controls bar ─── */
  .gallery-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
