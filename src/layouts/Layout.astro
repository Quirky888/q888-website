---
import "../styles/global.css";
import {
	ARTIST_ID,
	ARTIST_NAME,
	ARTIST_PROFILES,
	DEFAULT_DESCRIPTION,
	DEFAULT_SOCIAL_IMAGE,
	SITE_NAME,
	SITE_URL,
	WEBSITE_ID,
	type SchemaNode,
} from "../lib/siteIdentity";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalPath?: string;
	pageType?: "website" | "article" | "profile" | "collection";
	mainEntityType?: "CreativeWork" | "VisualArtwork" | "SoftwareApplication" | "Product";
	mainEntityName?: string;
	mainEntityData?: SchemaNode;
	keywords?: string[];
	noindex?: boolean;
	structuredData?: SchemaNode[];
}

const {
	title = SITE_NAME,
	description = DEFAULT_DESCRIPTION,
	image = DEFAULT_SOCIAL_IMAGE,
	canonicalPath = Astro.url.pathname,
	pageType = "website",
	mainEntityType,
	mainEntityName,
	mainEntityData = {},
	keywords = [],
	noindex = false,
	structuredData = [],
} = Astro.props;

const siteBase = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(canonicalPath, siteBase).href;
const socialImageUrl = new URL(image, siteBase).href;
const pageId = `${canonicalUrl}#webpage`;
const mainEntityId = `${canonicalUrl}#main-entity`;

const pageSchemaType = {
	website: "WebPage",
	article: "Article",
	profile: "ProfilePage",
	collection: "CollectionPage",
}[pageType];

const artistNode: SchemaNode = {
	"@type": "Person",
	"@id": ARTIST_ID,
	name: ARTIST_NAME,
	alternateName: SITE_NAME,
	description: DEFAULT_DESCRIPTION,
	url: `${SITE_URL}/bureaucracy/`,
	image: `${SITE_URL}/images/bur-icons/mushroom.png`,
	jobTitle: "Artist-developer",
	homeLocation: {
		"@type": "Place",
		name: "Edinburgh, Scotland",
	},
	sameAs: ARTIST_PROFILES,
};

const websiteNode: SchemaNode = {
	"@type": "WebSite",
	"@id": WEBSITE_ID,
	url: `${SITE_URL}/`,
	name: SITE_NAME,
	alternateName: ["Q888 Space", "Quirky888"],
	description: DEFAULT_DESCRIPTION,
	inLanguage: "en",
	publisher: { "@id": ARTIST_ID },
};

const pageNode: SchemaNode = {
	"@type": pageSchemaType,
	"@id": pageId,
	url: canonicalUrl,
	name: title,
	description,
	inLanguage: "en",
	isPartOf: { "@id": WEBSITE_ID },
	about: pageType === "profile" ? { "@id": ARTIST_ID } : undefined,
	mainEntity:
		pageType === "profile"
			? { "@id": ARTIST_ID }
			: mainEntityType
				? { "@id": mainEntityId }
				: undefined,
	primaryImageOfPage: {
		"@type": "ImageObject",
		url: socialImageUrl,
		contentUrl: socialImageUrl,
		creator: { "@id": ARTIST_ID },
		creditText: `${ARTIST_NAME} / ${SITE_NAME}`,
		copyrightNotice: `© ${ARTIST_NAME} / ${SITE_NAME}`,
	},
};

const mainEntityNode: SchemaNode | null = mainEntityType
	? {
			"@type": mainEntityType,
			"@id": mainEntityId,
			name: mainEntityName ?? title.replace(/\s+[—|]\s+.*$/, ""),
			description,
			url: canonicalUrl,
			image: socialImageUrl,
			creator: { "@id": ARTIST_ID },
			copyrightHolder: { "@id": ARTIST_ID },
			keywords: keywords.length ? keywords.join(", ") : undefined,
			...mainEntityData,
		}
	: null;

const graph = [
	artistNode,
	websiteNode,
	pageNode,
	...(mainEntityNode ? [mainEntityNode] : []),
	...structuredData,
];

// LEARN: Escaping "<" prevents local content from accidentally closing the JSON-LD script tag.
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": graph,
}).replace(/</g, "\\u003c");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
		<meta name="author" content={`${ARTIST_NAME} / ${SITE_NAME}`} />
		<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={pageType === "article" ? "article" : pageType === "profile" ? "profile" : "website"} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="en_GB" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script type="application/ld+json" set:html={jsonLd} is:inline></script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Critical fonts: load immediately -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Doto:wght@200&family=Space+Grotesk:wght@700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Doto:wght@200&family=Space+Grotesk:wght@700&display=swap" />
		<!-- Non-critical portal fonts: deferred until after load, invisible to initial paint -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap" id="portal-fonts-preload" />
		<!-- Portal font stylesheet injected after page load by JS below -->
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap" /></noscript>
		<!-- Hero image preload: mobile gets avif, desktop gets webp -->
		<link rel="preload" as="image" href="/images/q888_mobile.avif" media="(max-width: 768px) and (orientation: portrait)" fetchpriority="high" />
		<link rel="preload" as="image" href="/images/Q888_hero.webp" media="(min-width: 769px)" fetchpriority="high" />
		<!-- Split-flap: deferred, skips mobile parse entirely -->
		<script type="module" src="/vendor/hotfx-split-flap.js" is:inline></script>
	</head>
	<body>
		<slot />

		<script>
			(function initSplitFlapReducedMotion() {
				const run = () => {
					const usePlainText =
						window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
						window.matchMedia('(max-width: 1024px)').matches ||
						(window.matchMedia('(max-width: 1400px)').matches && window.matchMedia('(hover: none)').matches);
					if (!usePlainText) return;
					document.querySelectorAll('.system-meta hotfx-split-flap.meta-value-split-flap, .landing-status-bar hotfx-split-flap.landing-meta-split-flap').forEach((el) => {
						const span = document.createElement('span');
						const htmlEl = el as HTMLElement;
						if (htmlEl.classList.contains('meta-value-split-flap')) {
							span.className = 'meta-value';
							span.dataset.field = htmlEl.dataset.field ?? '';
						} else if (htmlEl.classList.contains('landing-meta-split-flap')) {
							span.className = 'landing-meta-span text-black';
						}
						span.textContent = htmlEl.getAttribute('data-target-text') || htmlEl.textContent || '';
						htmlEl.replaceWith(span);
					});
				};
				if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
				else run();
			})();

			window.addEventListener('error', (e) => {
				console.error('[Global Error]', e.message, e.filename, e.lineno, e.colno);
			});
			window.addEventListener('unhandledrejection', (e) => {
				console.error('[Unhandled Promise Rejection]', e.reason);
			});
			if (import.meta.env.DEV) {
				console.log('[Q888] Page loaded');
				console.log('[Q888] Viewport:', window.innerWidth, 'x', window.innerHeight);
				console.log('[Q888] User Agent:', navigator.userAgent);
			}


			// Defer non-critical portal fonts until after page is fully interactive.
			// Bungee, Playfair Display, Space Mono, Syne are only used inside
			// portal panels — they should not block initial paint on mobile.
			const loadPortalFonts = () => {
				if ((window as any).__portalFontsLoaded) return;
				(window as any).__portalFontsLoaded = true;
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap';
				document.head.appendChild(link);
			};
			// Load after window load; on slow connections this fires well after FCP
			if (document.readyState === 'complete') {
				setTimeout(loadPortalFonts, 200);
			} else {
				window.addEventListener('load', () => setTimeout(loadPortalFonts, 200), { once: true });
			}

			// Global cleanup to avoid carrying over gallery viewer state
			(function cleanupViewerState() {
				const cleanup = () => {
					document.documentElement.classList.remove("is-viewer-open");
					document.body.style.overflow = "";
				};
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", cleanup);
				} else {
					cleanup();
				}
				document.addEventListener("astro:page-load", cleanup);
			})();
		</script>


	</body>
</html>
