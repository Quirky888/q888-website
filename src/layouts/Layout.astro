---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Q888" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Critical fonts: load immediately -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Doto:wght@200&family=Space+Grotesk:wght@700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Doto:wght@200&family=Space+Grotesk:wght@700&display=swap" />
		<!-- Non-critical portal fonts: deferred until after load, invisible to initial paint -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap" id="portal-fonts-preload" />
		<!-- Portal font stylesheet injected after page load by JS below -->
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap" /></noscript>
		<!-- Hero image preload: mobile gets avif, desktop gets webp -->
		<link rel="preload" as="image" href="/images/q888_mobile.avif" media="(max-width: 768px) and (orientation: portrait)" fetchpriority="high" />
		<link rel="preload" as="image" href="/images/Q888_hero.webp" media="(min-width: 769px)" fetchpriority="high" />
		<!-- Split-flap: deferred, skips mobile parse entirely -->
		<script is:inline defer src="/vendor/hotfx-split-flap.js"></script>
	</head>
	<body>
		<slot />

		<script>
			(function initSplitFlapReducedMotion() {
				const run = () => {
					const usePlainText =
						window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
						window.matchMedia('(max-width: 1024px)').matches ||
						(window.matchMedia('(max-width: 1400px)').matches && window.matchMedia('(hover: none)').matches);
					if (!usePlainText) return;
					document.querySelectorAll('.system-meta hotfx-split-flap.meta-value-split-flap, .landing-status-bar hotfx-split-flap.landing-meta-split-flap').forEach((el) => {
						const span = document.createElement('span');
						const htmlEl = el as HTMLElement;
						if (htmlEl.classList.contains('meta-value-split-flap')) {
							span.className = 'meta-value';
							span.dataset.field = htmlEl.dataset.field ?? '';
						}
						span.textContent = htmlEl.textContent ?? '';
						htmlEl.replaceWith(span);
					});
				};
				if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
				else run();
			})();

			window.addEventListener('error', (e) => {
				console.error('[Global Error]', e.message, e.filename, e.lineno, e.colno);
			});
			window.addEventListener('unhandledrejection', (e) => {
				console.error('[Unhandled Promise Rejection]', e.reason);
			});
			if (import.meta.env.DEV) {
				console.log('[Q888] Page loaded');
				console.log('[Q888] Viewport:', window.innerWidth, 'x', window.innerHeight);
				console.log('[Q888] User Agent:', navigator.userAgent);
			}


			// Defer non-critical portal fonts until after page is fully interactive.
			// Bungee, Playfair Display, Space Mono, Syne are only used inside
			// portal panels — they should not block initial paint on mobile.
			const loadPortalFonts = () => {
				if ((window as any).__portalFontsLoaded) return;
				(window as any).__portalFontsLoaded = true;
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://fonts.googleapis.com/css2?family=Bungee&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Syne:wght@400;700&display=swap';
				document.head.appendChild(link);
			};
			// Load after window load; on slow connections this fires well after FCP
			if (document.readyState === 'complete') {
				setTimeout(loadPortalFonts, 200);
			} else {
				window.addEventListener('load', () => setTimeout(loadPortalFonts, 200), { once: true });
			}

			// Global cleanup to avoid carrying over gallery viewer state
			(function cleanupViewerState() {
				const cleanup = () => {
					document.documentElement.classList.remove("is-viewer-open");
					document.body.style.overflow = "";
				};
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", cleanup);
				} else {
					cleanup();
				}
				document.addEventListener("astro:page-load", cleanup);
			})();
		</script>


	</body>
</html>
