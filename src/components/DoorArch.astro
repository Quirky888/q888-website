---
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  descriptor?: string;
  href: string;
  /** A project without a card image keeps an empty arch. */
  image?: string | null;
  index: number;
  /** Extra attributes for doors that also open a drawer. */
  attrs?: Record<string, string>;
}

const { id, title, descriptor, href, image, index, attrs = {} } = Astro.props;
---

<!-- DNA: every project is a door. The caption sits under the work, never over it. -->
<a href={href} id={`project-${id}`} data-project={id} class="arch" {...attrs}>
  <span class="arch-frame">
    {image && <Image src={image} alt="" width={600} height={860} loading="lazy" decoding="async" />}
  </span>
  <span class="arch-number qd-mono">{String(index + 1).padStart(2, "0")}</span>
  <span class="arch-title">{title}</span>
  {descriptor && <span class="arch-descriptor">{descriptor}</span>}
</a>

<style>
  /* Colours come from the section's tokens, so the same door works on fog and on Infocigan night. */
  .arch {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .arch-frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4.3;
    overflow: hidden;
    border-radius: 999px 999px 10px 10px;
    background: var(--line-soft);
    box-shadow: 0 0 0 1px var(--line-soft);
    transition: box-shadow 600ms ease;
  }

  .arch-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition:
      filter 800ms ease,
      transform 1200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The sliver of light from a door left ajar. */
  .arch-frame::after {
    content: "";
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 0;
    background: linear-gradient(90deg, transparent, var(--door-glow));
    transition: width 600ms ease;
  }

  .arch-number {
    display: block;
    margin-top: 0.9rem;
  }

  .arch-title {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-door-display);
    font-size: clamp(1.125rem, 1.9vw, 1.75rem);
    font-weight: 600;
    font-variation-settings: "wdth" 82;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .arch-descriptor {
    display: block;
    max-width: 22em;
    margin-top: 0.4rem;
    font-family: var(--font-door-display);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .arch:focus-visible .arch-frame {
    box-shadow:
      0 0 3.75rem var(--door-glow),
      0 0 0 2px var(--door-gold);
  }

  /* Closed doors are monochrome only where a pointer can open them; touch screens see colour. */
  @media (hover: hover) {
    .arch-frame :global(img) {
      filter: grayscale(1) contrast(1.05);
    }

    .arch:hover .arch-frame,
    .arch:focus-visible .arch-frame {
      box-shadow:
        0 0 3.75rem var(--door-glow),
        0 0 0 1px var(--door-gold);
    }

    .arch:hover .arch-frame :global(img),
    .arch:focus-visible .arch-frame :global(img) {
      filter: none;
      transform: scale(1.09);
    }

    .arch:hover .arch-frame::after {
      width: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-frame,
    .arch-frame :global(img),
    .arch-frame::after {
      transition: none;
    }

    .arch:hover .arch-frame :global(img),
    .arch:focus-visible .arch-frame :global(img) {
      transform: scale(1.02);
    }
  }
</style>
