---
export type MarketWireProject = {
  slug: string;
  title: string;
  descriptor: string;
  system: string;
  href: string;
};

interface Props {
  projects: MarketWireProject[];
}

const { projects } = Astro.props;
const initialProject = projects[0];
const initialMessage = initialProject
  ? `${initialProject.title.toUpperCase()} OPENS ABOVE EXPECTATIONS. MEANING REMAINS UNREGULATED.`
  : "INFOCIGAN MARKET OPEN. VALUE REMAINS A MATTER OF PERSONAL COURAGE.";
const serializedProjects = JSON.stringify(projects).replaceAll("<", "\\u003c");
---

<!--
  LEARN: The wire uses the real project collection, then recombines local copy.
  It stays autonomous without an API, a secret key, or invented live-market claims.
-->
<aside class="infocigan-wire" data-infocigan-wire aria-label="Infocigan insider wire">
  <button
    class="infocigan-wire-button"
    type="button"
    data-infocigan-wire-next
    title="Request another confidential market signal"
  >
    <span class="infocigan-wire-pulse" aria-hidden="true"></span>
    Insider wire
  </button>

  <a
    class="infocigan-wire-link"
    href={initialProject?.href ?? "/#infocigan"}
    data-infocigan-wire-link
  >
    <span class="infocigan-wire-source" aria-hidden="true">Market whisper /</span>
    <span data-infocigan-wire-message>{initialMessage}</span>
  </a>

  <script
    type="application/json"
    is:inline
    data-infocigan-wire-projects
    set:html={serializedProjects}
  ></script>
</aside>

<style>
  .infocigan-wire {
    position: relative;
    z-index: 10;
    display: none;
    grid-template-columns: auto minmax(0, 1fr);
    width: 100%;
    min-height: 2.8rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--bg-fog) 94%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
  }

  @media (min-width: 901px) {
    .infocigan-wire {
      display: grid;
    }
  }

  .infocigan-wire-button {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.8rem;
    padding: 0 1.35rem;
    border: 0;
    border-right: 1px solid rgba(0, 0, 0, 0.16);
    color: #0b0b09;
    background: linear-gradient(
      105deg,
      #9e7400 0%,
      #d8a915 30%,
      #ffdb63 48%,
      #be8c00 68%,
      #f2c544 100%
    );
    background-size: 240% 100%;
    font: inherit;
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    animation: infocigan-wire-gold 7s linear infinite;
  }

  .infocigan-wire-button:hover,
  .infocigan-wire-button:focus-visible {
    background-position: 100% 50%;
  }

  .infocigan-wire-button:focus-visible,
  .infocigan-wire-link:focus-visible {
    outline: 2px solid #111;
    outline-offset: -3px;
  }

  .infocigan-wire-pulse {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #111;
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.34);
    animation: infocigan-wire-pulse 2.2s ease-out infinite;
  }

  .infocigan-wire-link {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0 1.2rem;
    overflow: hidden;
    color: #111;
    font-size: clamp(0.62rem, 0.72vw, 0.72rem);
    font-weight: 520;
    letter-spacing: 0.075em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .infocigan-wire-link > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .infocigan-wire-link.is-changing > span:last-child {
    opacity: 0;
    transform: translateY(0.35rem);
  }

  .infocigan-wire-source {
    flex: 0 0 auto;
    margin-right: 0.7rem;
    color: #a67c00;
    font-weight: 750;
  }

  @keyframes infocigan-wire-gold {
    to {
      background-position: 240% 50%;
    }
  }

  @keyframes infocigan-wire-pulse {
    60%,
    100% {
      box-shadow: 0 0 0 0.4rem rgba(0, 0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .infocigan-wire-button,
    .infocigan-wire-pulse {
      animation: none;
    }

    .infocigan-wire-link > span:last-child {
      transition: none;
    }
  }
</style>

<script>
  type WireProject = {
    slug: string;
    title: string;
    descriptor: string;
    system: string;
    href: string;
  };

  const projectSignals: Record<string, string[]> = {
    "overpriced-stickers": [
      "ADHESIVE ASSETS QUIETLY OUTPERFORM GOLD IN EMOTIONAL YIELD.",
      "STICKER SUPPLY REMAINS PHYSICAL. DEMAND IS NOW MOSTLY METAPHYSICAL.",
      "OVERPRICED INDEX UP 888%. ANALYSTS BLAME COLLECTIVE IMAGINATION.",
    ],
    "q-bag": [
      "Q-BAG HOLDINGS EXPAND WHEN ANALYSTS STOP MEASURING THE INSIDE.",
      "REUSABLE COFFEE INFRASTRUCTURE RECLASSIFIED AS PORTABLE MYTH.",
      "Q-BAG VOLUME EXCEEDS EUCLIDEAN GUIDANCE. CARRY POSITION MAINTAINED.",
    ],
    "afterlife-contracts": [
      "AFTERLIFE FUTURES EXTEND GAINS BEYOND INVESTOR LIFETIME. SETTLEMENT UNCONFIRMED.",
      "POST-EXISTENCE PAPERWORK NOW PRICED ABOVE MORTAL CONFIDENCE.",
      "ESTATE DESK REPORTS STRONG DEMAND FROM CLIENTS NOT YET DECEASED.",
    ],
    "president-of-the-galaxy": [
      "ZERO POWER. MAXIMUM CAMPAIGN CONFIDENCE. GALACTIC VOTERS HOLD.",
      "AUTHORITY FICTION STABLE DESPITE COMPLETE ABSENCE OF JURISDICTION.",
      "CAMPAIGN SHARES RISE AFTER CANDIDATE PROMISES ALMOST NOTHING.",
    ],
    "nar-mail-express": [
      "DELIVERY FUTURES RALLY. ARRIVAL TIMES NOW MEASURED IN EMOTIONAL READINESS.",
      "NAR-MAIL ROUTE EXPANDS THROUGH A POSTAL DISTRICT THAT MAY NOT EXIST.",
      "CONFIDENTIAL MESSAGE DELAYED UNTIL RECIPIENT BECOMES THE RIGHT PERSON.",
    ],
    "dyno-milk": [
      "EXTINCTION REVERSED. CALCIUM OUTLOOK TURNS AGGRESSIVELY PREHISTORIC.",
      "DYNO MILK ENTERS PRE-INCUBATION. ANALYSTS ADVISED NOT TO SHAKE.",
      "BIO-DAIRY DESK REPORTS STRONG BONES AND WEAK REGULATORY PRECEDENT.",
    ],
    "aero-sticker": [
      "AERO V1 GAINS 8.88 STYLE-WATTS. WIND DECLINES TO COMMENT.",
      "ATMOSPHERIC DRAG FALLS AFTER £230 STICKER ISSUES CONFIDENT GUIDANCE.",
      "AERO POSITION UPGRADED FROM SYMBOLIC TO VISUALLY UNDENIABLE.",
    ],
  };

  const genericSignals = [
    (project: WireProject) =>
      `${project.title} QUIETLY ACCUMULATED BY INVESTORS WHO DENY KNOWING WHAT IT IS.`,
    (project: WireProject) =>
      `ANALYSTS RAISE ${project.title} FROM “IMPOSSIBLE” TO “DIFFICULT TO EXPLAIN AT DINNER”.`,
    (project: WireProject) =>
      `OFF-MARKET WHISPER: ${project.title} MAY BE UNDERVALUED BY EVERY METRIC EXCEPT ITS OWN.`,
    (project: WireProject) =>
      `${project.system} REPORTS UNUSUAL CONFIDENCE. MEANING MAY COMPOUND WITHOUT APPROVAL.`,
  ];

  function initInfociganWire() {
    const wire = document.querySelector<HTMLElement>("[data-infocigan-wire]");
    if (!wire || wire.dataset.ready === "true") return;

    const data = wire.querySelector<HTMLScriptElement>(
      "[data-infocigan-wire-projects]",
    );
    const message = wire.querySelector<HTMLElement>(
      "[data-infocigan-wire-message]",
    );
    const link = wire.querySelector<HTMLAnchorElement>(
      "[data-infocigan-wire-link]",
    );
    const nextButton = wire.querySelector<HTMLButtonElement>(
      "[data-infocigan-wire-next]",
    );
    if (!data || !message || !link || !nextButton) return;

    let projects: WireProject[] = [];
    try {
      projects = JSON.parse(data.textContent || "[]") as WireProject[];
    } catch {
      return;
    }
    if (!projects.length) return;

    wire.dataset.ready = "true";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let projectQueue: WireProject[] = [];
    let intervalId = 0;
    let changeTimeoutId = 0;

    // CHOICE: Shuffle the whole collection so every project is promoted before repeats.
    const refillQueue = () => {
      projectQueue = [...projects];
      for (let index = projectQueue.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [projectQueue[index], projectQueue[swapIndex]] = [
          projectQueue[swapIndex],
          projectQueue[index],
        ];
      }
    };

    const createSignal = (project: WireProject) => {
      const specific = projectSignals[project.slug];
      if (specific?.length && Math.random() < 0.72) {
        return specific[Math.floor(Math.random() * specific.length)];
      }
      const template =
        genericSignals[Math.floor(Math.random() * genericSignals.length)];
      return template(project);
    };

    const showNextSignal = () => {
      if (!projectQueue.length) refillQueue();
      const project = projectQueue.shift();
      if (!project) return;

      const update = () => {
        message.textContent = createSignal(project);
        link.href = project.href;
        link.setAttribute("aria-label", `Explore ${project.title}`);
        link.classList.remove("is-changing");
      };

      window.clearTimeout(changeTimeoutId);
      if (reducedMotion.matches) {
        update();
      } else {
        link.classList.add("is-changing");
        changeTimeoutId = window.setTimeout(update, 190);
      }
    };

    const stopRotation = () => {
      window.clearInterval(intervalId);
      intervalId = 0;
    };

    const startRotation = () => {
      stopRotation();
      if (!reducedMotion.matches) {
        intervalId = window.setInterval(showNextSignal, 6800);
      }
    };

    const handleManualNext = () => {
      showNextSignal();
      if (!wire.contains(document.activeElement)) startRotation();
    };
    const handleFocusOut = (event: FocusEvent) => {
      const nextTarget = event.relatedTarget;
      if (!(nextTarget instanceof Node) || !wire.contains(nextTarget)) {
        startRotation();
      }
    };
    const handleMotionChange = () => startRotation();

    nextButton.addEventListener("click", handleManualNext);
    wire.addEventListener("mouseenter", stopRotation);
    wire.addEventListener("mouseleave", startRotation);
    wire.addEventListener("focusin", stopRotation);
    wire.addEventListener("focusout", handleFocusOut);
    reducedMotion.addEventListener("change", handleMotionChange);

    refillQueue();
    startRotation();

    const cleanup = () => {
      stopRotation();
      window.clearTimeout(changeTimeoutId);
      nextButton.removeEventListener("click", handleManualNext);
      wire.removeEventListener("mouseenter", stopRotation);
      wire.removeEventListener("mouseleave", startRotation);
      wire.removeEventListener("focusin", stopRotation);
      wire.removeEventListener("focusout", handleFocusOut);
      reducedMotion.removeEventListener("change", handleMotionChange);
      wire.dataset.ready = "false";
      document.removeEventListener("astro:before-swap", cleanup);
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInfociganWire, {
      once: true,
    });
  } else {
    initInfociganWire();
  }
  document.addEventListener("astro:page-load", initInfociganWire);
</script>
