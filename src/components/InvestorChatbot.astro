---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";

const stickers = await getCollection("stickers");
const stickersData = stickers.map(({ data }) => ({
  id: data.id,
  title: data.title,
  tagline: data.tagline,
  ask: data.ask,
  availableCount: data.availableCount,
  editionTotal: data.editionTotal,
  status: data.status,
  provenance: data.provenance,
  description: data.description
}));

const projects = await getCollection("projects");
const projectsData = projects.map(({ data }) => ({
  slug: data.slug,
  title: data.cardTitle,
  descriptor: data.cardDescriptor,
  system: data.cardSystem,
  panelTitle: data.panelTitle,
  panelDescription: data.panelDescription,
  panelSpecs: data.panelSpecs
}));

// Manually append Digital Ink and Edinburgh Magical Map metadata to projectsData
projectsData.push({
  slug: "digital-ink",
  title: "Digital Ink",
  descriptor: "A system for meaning, scarcity, and traceable digital creation.",
  system: "SYS: INK",
  panelTitle: "Digital Ink",
  panelDescription: "What if digital art had memory? What if every brushstroke carried weight, history, and emotional resonance? Digital Ink challenges the disposable nature of infinite digital tools by introducing constraint-based creativity, the Symbolic Smart Pixel Protocol (SSPP), Apple Vision + GPT-4o poetic transformation, and 1,000 Smart Inks on iPadOS.",
  panelSpecs: [
    { label: "PLATFORM", value: "iPadOS (iPad-only)" },
    { label: "STATUS", value: "AVAILABLE NOW" },
    { label: "ROLE", value: "Concept · Product Design · UX · SwiftUI" },
    { label: "YEAR", value: "2025–2026" }
  ]
});

projectsData.push({
  slug: "edinburgh-map",
  title: "Edinburgh Magical Map",
  descriptor: "A mythic cartography of place, memory, and hidden doors.",
  system: "SYS: MAP",
  panelTitle: "Edinburgh Magical Map",
  panelDescription: "Welcome to Edinburgh — where magic retired but still drinks in public. A mythic cartography showing 15 secret locations and their hidden history/lore, including Castle on Chicken Legs, Real Edinburgh Castle hidden under Arthur's Seat, Troll Market, Star Bank, and Star House.",
  panelSpecs: [
    { label: "LAYER", value: "EDINBURGH CITY / UNDERWORLD OVERLAY" },
    { label: "ACCESS", value: "COUNCIL-GATED" },
    { label: "STATUS", value: "ACTIVE (REDACTED)" }
  ]
});

const edenStoriesPath = path.join(process.cwd(), "public", "eden-stories.json");
const edenStoriesData = JSON.parse(fs.readFileSync(edenStoriesPath, "utf-8"));
const mapLocations = edenStoriesData.locations.map((loc: any) => ({
  id: loc.id,
  name: loc.name,
  emoji: loc.emoji,
  short: loc.short,
  long: loc.long
}));
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400&family=JetBrains+Mono:wght@300&display=swap" rel="stylesheet">

<div id="investor-chat-widget" class="investor-chat-widget">
  <button id="investor-chat-toggle" class="investor-toggle-btn" aria-label="Open Infocigan chat">
    <span>✦</span>
    <div class="investor-currency-badge">$</div>
  </button>

  <div id="investor-chat-window" class="investor-chat-container" aria-hidden="true">
    <div class="investor-gold-line-top"></div>

    <div class="investor-header">
      <div>
        <h1 class="investor-cinzel-title">INFOCIGAN</h1>
        <div class="investor-status-area">
          <div class="investor-status-dot"></div>
          Consulting The Investor
        </div>
      </div>
      <div class="investor-header-actions">
        <button id="investor-chat-reset" class="investor-action-btn investor-reset-btn" aria-label="New conversation" title="New conversation">↺</button>
        <button id="investor-chat-close" class="investor-action-btn investor-close-btn" aria-label="Close chat">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
    <div id="investor-chat-messages" class="investor-message-area"></div>
    <div id="investor-chat-warning" class="investor-chat-warning" aria-live="polite"></div>

    <div class="investor-input-container">
      <div id="investor-chat-cooldown" class="investor-chat-cooldown hidden">
        <span>Available in <span id="investor-cooldown-timer">15:00</span></span>
      </div>
      <div class="investor-input-wrapper">
        <input
          type="text"
          id="investor-chat-input"
          class="investor-chat-input"
          placeholder="Inquire further…"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="text"
          data-1p-ignore="true"
          data-lpignore="true"
          data-bwignore="true"
          data-form-type="other"
        />
        <button id="investor-chat-send" class="investor-send-btn" aria-label="Send message">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ stickersData, projectsData, mapLocations }}>
  // @ts-nocheck
  const INVESTOR_CHAT_API = "/.netlify/functions/investor-chat";
  const INVESTOR_MAX_MESSAGES = 18;
  const INVESTOR_GREETING = "Welcome to the trading zone. Are you here to acquire an Overpriced Sticker, secure an Afterlife Contract, or fund the next President of the Galaxy?";

  function escapeHtmlInvestor(s) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function renderInlineMarkdownInvestor(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
      .replace(/__(.+?)__/g, "<strong>$1</strong>")
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: var(--investor-burnished-gold); text-decoration: underline;">$1</a>');
  }

  function renderMarkdownInvestor(text) {
    const normalized = escapeHtmlInvestor(text).replace(/\r\n/g, "\n");
    const lines = normalized.split("\n");
    const blocks = [];
    let i = 0;

    while (i < lines.length) {
      const line = lines[i].trim();
      if (!line) {
        i += 1;
        continue;
      }

      if (/^[-*]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^[-*]\s+/, ""));
          i += 1;
        }
        blocks.push(`<ul>${items.map((item) => `<li>${renderInlineMarkdownInvestor(item)}</li>`).join("")}</ul>`);
        continue;
      }

      if (/^\d+\.\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\d+\.\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^\d+\.\s+/, ""));
          i += 1;
        }
        blocks.push(`<ol>${items.map((item) => `<li>${renderInlineMarkdownInvestor(item)}</li>`).join("")}</ol>`);
        continue;
      }

      const paragraph = [];
      while (i < lines.length && lines[i].trim() && !/^[-*]\s+/.test(lines[i].trim()) && !/^\d+\.\s+/.test(lines[i].trim())) {
        paragraph.push(lines[i].trim());
        i += 1;
      }
      blocks.push(`<p>${renderInlineMarkdownInvestor(paragraph.join("<br>"))}</p>`);
    }

    return blocks.join("");
  }

  class InvestorChatbot {
    constructor() {
      this.widget = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-widget"));
      this.toggle = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-toggle"));
      this.window = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-window"));
      this.close = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-close"));
      this.resetBtn = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-reset"));
      this.messagesEl = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-messages"));
      this.input = /** @type {HTMLInputElement | null} */ (document.getElementById("investor-chat-input"));
      this.send = /** @type {HTMLElement | null} */ (document.getElementById("investor-chat-send"));
      this.hasInitialized = false;
      this.isLoading = false;
      this.scrollRequest = 0;
      this.typingShownAt = 0;
      this.typingHideTimer = 0;
      /** @type {Array<{role: "user"|"assistant", content: string}>} */
      this.history = [];

      this.init();
    }

    init() {
      if (this.hasInitialized || !this.widget) return;
      this.hasInitialized = true;
      this.toggle?.setAttribute("aria-expanded", "false");

      this.toggle?.addEventListener("click", () => this.toggleChat());
      this.close?.addEventListener("click", () => this.closeChat());
      this.close?.addEventListener("touchend", (e) => { e.preventDefault(); this.closeChat(); }, { passive: false });
      this.resetBtn?.addEventListener("click", () => this.handleReset());
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && this.window?.classList.contains("investor-active")) {
          this.closeChat();
        }
      });
      this.send?.addEventListener("click", () => this.sendMessage());
      this.input?.addEventListener("keypress", (event) => {
        if (event.key === "Enter") this.sendMessage();
      });

      this.loadSession();
      this.updateUIState();
      this.startCooldownTimer();

      setTimeout(() => this.showGreeting(), 500);
    }

    loadSession() {
      const stored = localStorage.getItem("investor_chat_session");
      const now = Date.now();
      const ONE_DAY = 24 * 60 * 60 * 1000;

      if (stored) {
        try {
          const data = JSON.parse(stored);
          if (now - data.lastTimestamp > ONE_DAY) {
            this.resetSession();
          } else {
            this.session = data;
          }
        } catch (e) {
          this.resetSession();
        }
      } else {
        this.resetSession();
      }
    }

    resetSession() {
      this.session = {
        sessionId: crypto.randomUUID(),
        messageCount: 0,
        cooldownUntil: 0,
        lastTimestamp: Date.now()
      };
      this.saveSession();
    }

    saveSession() {
      this.session.lastTimestamp = Date.now();
      localStorage.setItem("investor_chat_session", JSON.stringify(this.session));
    }

    handleReset() {
      if (this.isLoading) return;
      this.resetSession();
      if (this.messagesEl) this.messagesEl.innerHTML = "";
      this.history = [];
      this.updateUIState();
      this.showGreeting();
    }

    incrementMessageCount() {
      this.session.messageCount++;
      if (this.session.messageCount >= 15 && this.session.cooldownUntil <= Date.now()) {
        this.session.cooldownUntil = Date.now() + 900000;
        this.startCooldownTimer();
      }
      this.saveSession();
      this.updateUIState();
    }

    updateUIState() {
      const now = Date.now();
      const isCooldown = this.session.cooldownUntil > now;
      const warningEl = document.getElementById("investor-chat-warning");
      const cooldownEl = document.getElementById("investor-chat-cooldown");
      const inputWrapper = this.input?.parentElement;

      if (isCooldown) {
        this.setInputDisabled(true);
        cooldownEl?.classList.remove("hidden");
        inputWrapper?.classList.add("hidden");
      } else {
        const reachedLimit = this.session.messageCount >= 15;
        this.setInputDisabled(reachedLimit);
        cooldownEl?.classList.add("hidden");
        inputWrapper?.classList.remove("hidden");
      }

      if (this.session.messageCount >= 13 && this.session.messageCount < 15) {
        if (warningEl) {
          warningEl.textContent = "The Broker is getting very busy. Interdimensional liquidity is tight right now.";
          warningEl.classList.add("visible");
        }
      } else {
        warningEl?.classList.remove("visible");
      }
    }

    startCooldownTimer() {
      const timerEl = document.getElementById("investor-cooldown-timer");
      const updateTimer = () => {
        const now = Date.now();
        const remaining = Math.max(0, this.session.cooldownUntil - now);

        if (remaining > 0) {
          const mins = Math.floor(remaining / 60000);
          const secs = Math.floor((remaining % 60000) / 1000);
          if (timerEl) timerEl.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
          setTimeout(updateTimer, 1000);
        } else if (this.session.cooldownUntil > 0) {
          this.session.cooldownUntil = 0;
          this.session.messageCount = 0;
          this.saveSession();
          this.updateUIState();
        }
      };
      updateTimer();
    }

    toggleChat() {
      this.window?.classList.toggle("investor-active");
      const isOpen = this.window?.classList.contains("investor-active");
      this.window?.setAttribute("aria-hidden", String(!isOpen));
      this.toggle?.classList.toggle("investor-toggle-hidden", !!isOpen);
      this.toggle?.setAttribute("aria-expanded", String(!!isOpen));
      if (isOpen) this.input?.focus();
    }

    openChat() {
      this.window?.classList.add("investor-active");
      this.window?.setAttribute("aria-hidden", "false");
      this.toggle?.classList.add("investor-toggle-hidden");
      this.toggle?.setAttribute("aria-expanded", "true");
      this.input?.focus();
    }

    closeChat() {
      this.window?.classList.remove("investor-active");
      this.window?.setAttribute("aria-hidden", "true");
      this.toggle?.classList.remove("investor-toggle-hidden");
      this.toggle?.setAttribute("aria-expanded", "false");
      this.toggle?.focus();
    }

    addMessage(text, isBot = false) {
      if (!this.messagesEl) return;
      const item = document.createElement("div");
      item.className = "investor-message-item " + (isBot ? "investor-message-item--agent" : "investor-message-item--user");
      const lastItem = this.messagesEl.lastElementChild;
      const lastWasBot = lastItem?.querySelector(".investor-agent-msg");
      const lastWasUser = lastItem?.querySelector(".investor-user-msg");
      if (lastItem && ((isBot && lastWasUser) || (!isBot && lastWasBot))) {
        item.classList.add("investor-divider-strong");
      }
      const meta = isBot ? "INFOCIGAN" : "YOU";
      const msgClass = isBot ? "investor-agent-msg" : "investor-user-msg";
      const body = isBot ? renderMarkdownInvestor(text) : `<p>${escapeHtmlInvestor(text)}</p>`;
      item.innerHTML = `<div class="investor-meta-label">${escapeHtmlInvestor(meta)}</div><div class="${msgClass}"><div class="investor-msg-text">${body}</div></div>`;
      this.messagesEl.appendChild(item);
      this.scrollToBottom();
    }

    createStreamingBotMessage() {
      if (!this.messagesEl) return null;
      const item = document.createElement("div");
      item.className = "investor-message-item investor-message-item--agent";
      const lastItem = this.messagesEl.lastElementChild;
      const lastWasUser = lastItem?.querySelector(".investor-user-msg");
      if (lastItem && lastWasUser) {
        item.classList.add("investor-divider-strong");
      }
      item.innerHTML = '<div class="investor-meta-label">INFOCIGAN</div><div class="investor-agent-msg"><div class="investor-msg-text"></div></div>';
      this.messagesEl.appendChild(item);
      const contentEl = item.querySelector(".investor-msg-text");
      if (this.messagesEl) {
        this.messagesEl.scrollTop = item.offsetTop - 12;
      }
      return contentEl;
    }

    updateStreamingBotMessage(contentEl, text) {
      if (!contentEl) return;
      contentEl.innerHTML = renderMarkdownInvestor(text);
    }

    showTypingIndicator() {
      document.getElementById("investor-typing-indicator")?.remove();
      const item = document.createElement("div");
      item.className = "investor-message-item investor-message-item--agent";
      item.id = "investor-typing-indicator";
      item.innerHTML = '<div class="investor-meta-label">INFOCIGAN</div><div class="investor-typing"><span class="investor-typing-label">Typing…</span><div class="investor-typing-dots" aria-hidden="true"><div class="investor-dot"></div><div class="investor-dot"></div><div class="investor-dot"></div></div></div>';
      this.messagesEl?.appendChild(item);
      this.typingShownAt = performance.now();
      this.scrollToBottom();
    }

    hideTypingIndicator(immediate = false) {
      const minVisibleMs = 1200;
      const remove = () => {
        document.getElementById("investor-typing-indicator")?.remove();
        this.typingHideTimer = 0;
      };

      if (immediate) {
        if (this.typingHideTimer) {
          clearTimeout(this.typingHideTimer);
          this.typingHideTimer = 0;
        }
        remove();
        return;
      }

      const elapsed = performance.now() - this.typingShownAt;

      if (elapsed >= minVisibleMs) {
        remove();
        return;
      }

      if (this.typingHideTimer) {
        clearTimeout(this.typingHideTimer);
      }
      this.typingHideTimer = window.setTimeout(remove, Math.max(0, minVisibleMs - elapsed));
    }

    scrollToBottom(smooth = false) {
      if (!this.messagesEl) return;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!smooth || reduceMotion) {
        this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
        return;
      }
      if (this.scrollRequest) return;
      this.scrollRequest = requestAnimationFrame(() => {
        this.messagesEl?.scrollTo({
          top: this.messagesEl.scrollHeight,
          behavior: "smooth",
        });
        this.scrollRequest = 0;
      });
    }

    showGreeting() {
      this.addMessage(INVESTOR_GREETING, true);
      this.history.push({ role: "assistant", content: INVESTOR_GREETING });
      this.input?.focus();
    }

    sendMessage() {
      if (this.session.cooldownUntil > Date.now() || this.session.messageCount >= 15) return;

      const text = this.input?.value.trim();
      if (!text || this.isLoading) return;
      if (this.history.length >= INVESTOR_MAX_MESSAGES) return;

      this.addMessage(text, false);
      this.history.push({ role: "user", content: text });

      this.incrementMessageCount();

      if (this.input) {
        this.input.value = "";
        this.input.focus(); // Focus after submission
      }
      this.callApi();
    }

    async callApi() {
      if (this.isLoading) return;
      this.isLoading = true;
      this.showTypingIndicator();
      this.setInputDisabled(true);

      try {
        const result = await this.streamApiResponse(this.history);
        if (result.content) {
          this.history.push({ role: "assistant", content: result.content });
          this.incrementMessageCount();
        }
        if (result.interrupted && !result.content) {
          this.addMessage("Connection interrupted before a reply arrived. Please resend your message.", true);
        }
        this.input?.focus();
      } catch {
        this.hideTypingIndicator();
        this.addMessage("Connection failed. The trading zone may be temporarily offline.", true);
        this.input?.focus();
      } finally {
        this.isLoading = false;
        this.setInputDisabled(false);
        this.input?.focus();
      }
    }

    setInputDisabled(disabled) {
      if (this.input) this.input.disabled = disabled;
      if (this.send) this.send.disabled = disabled;
    }

    async streamApiResponse(messages) {
      const res = await fetch(INVESTOR_CHAT_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages, stickers: stickersData, projects: projectsData, mapLocations }),
      });

      if (!res.ok) {
        const err = await this.parseApiError(res);
        this.hideTypingIndicator();
        this.addMessage(err, true);
        return { content: "", interrupted: false };
      }

      if (!res.body) {
        this.hideTypingIndicator();
        this.addMessage("Streaming unavailable in this browser. Please update and retry.", true);
        return { content: "", interrupted: false };
      }

      this.hideTypingIndicator(true);
      const contentEl = this.createStreamingBotMessage();
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let content = "";
      let completed = false;

      try {
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let boundary = buffer.indexOf("\n\n");

          while (boundary !== -1) {
            const block = buffer.slice(0, boundary).replace(/\r/g, "");
            buffer = buffer.slice(boundary + 2);
            const data = this.parseSseBlock(block);

            if (data?.type === "token" && typeof data.content === "string") {
              content += data.content;
              this.updateStreamingBotMessage(contentEl, content);
            } else if (data?.type === "error") {
              throw new Error(data.message || "Streaming failed");
            } else if (data?.type === "done") {
              completed = true;
            }
            boundary = buffer.indexOf("\n\n");
          }
        }
      } catch {
        if (content) {
          const interrupted = `${content}\n\nConnection interrupted. You can resend to continue.`;
          this.updateStreamingBotMessage(contentEl, interrupted);
          return { content, interrupted: true };
        }
        throw new Error("Connection interrupted");
      }

      if (!completed) {
        if (content) {
          const interrupted = `${content}\n\nConnection interrupted. You can resend to continue.`;
          this.updateStreamingBotMessage(contentEl, interrupted);
          return { content, interrupted: true };
        }
        return { content: "", interrupted: true };
      }

      return { content, interrupted: false };
    }

    parseSseBlock(block) {
      if (!block.trim()) return null;
      const dataLines = block
        .split("\n")
        .filter((line) => line.startsWith("data:"))
        .map((line) => line.slice(5).trimStart());
      if (dataLines.length === 0) return null;
      try {
        return JSON.parse(dataLines.join("\n"));
      } catch {
        return null;
      }
    }

    async parseApiError(res) {
      const bodyText = await res.text();
      let data = {};
      try {
        data = JSON.parse(bodyText);
      } catch {}

      if (res.status === 404) {
        return "Infocigan API not found. Use the Netlify dev URL from the terminal.";
      }
      const sourceError = data && typeof data === "object" && "error" in data ? data.error : bodyText;
      if (sourceError) {
        const err = typeof sourceError === "string" ? sourceError : JSON.stringify(sourceError);
        try {
          const parsed = JSON.parse(String(sourceError));
          return parsed.error?.message || parsed.message || String(sourceError);
        } catch {
          return err;
        }
      }
      return res.status === 500
        ? "Infocigan temporarily offline. Check OPENAI_API_KEY in .env and restart npm run dev:netlify."
        : "Response unavailable. Please rephrase or try again.";
    }
  }

  function initInvestorChatbot() {
    const widget = document.getElementById("investor-chat-widget");
    if (!widget || widget.getAttribute("data-investor-chat-init") === "true") return;
    widget.setAttribute("data-investor-chat-init", "true");
    new InvestorChatbot();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInvestorChatbot, { once: true });
  } else {
    initInvestorChatbot();
  }

  document.addEventListener("astro:page-load", initInvestorChatbot);
</script>

<style>
  #investor-chat-widget {
    --investor-espresso: #1e1510;
    --investor-pitch: #0d0a09;
    --investor-burnished-gold: #c5a059;
    --investor-matte-gold: #8e6d2d;
    --investor-cream: #e0d5c8;
    --investor-gold-alpha: rgba(197, 160, 89, 0.15);
  }

  .investor-chat-widget {
    position: fixed;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    right: max(1rem, env(safe-area-inset-right, 0px));
    z-index: 9998;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    color: var(--investor-cream);
  }

  @media (max-width: 768px) {
    .investor-chat-widget {
      display: none !important;
    }
  }

  .investor-toggle-btn {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
