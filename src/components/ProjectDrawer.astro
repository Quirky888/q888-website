<style is:global>
  :root {
    --eden-beacon-idle: rgba(0, 0, 0, 0.35);
    --eden-portal-ring: #1a1a1c;
    --eden-portal-accent: #4a154b;
    --eden-portal-haze: rgba(0, 0, 0, 0.15);
  }

  .eden-hotspot {
    pointer-events: auto;
    cursor: pointer;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .eden-hotspot .hotspot-trigger {
    fill: transparent !important;
    stroke: none !important;
    pointer-events: all;
    cursor: pointer;
  }

  @media (hover: none) and (pointer: coarse) {
    .eden-hotspot .hotspot-trigger {
      stroke: rgba(255, 255, 255, 0.05) !important;
      stroke-width: 2 !important;
    }
  }

  /* 1) Idle state: Secret Stars (faint beacon) */
  .eden-hotspot .hotspot-glow {
    fill: var(--eden-beacon-idle) !important;
    fill-opacity: 0.50 !important;
    stroke: none !important;
    filter: blur(3px) !important;
    pointer-events: none;
    transition: all 800ms cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: center;
    transform-box: fill-box;
    will-change: transform, opacity;
    
    /* Random unsynced twinkle */
    animation: beacon-ping var(--twinkle-dur, 4s) ease-in-out var(--twinkle-delay, 0s) infinite;
  }

  @keyframes beacon-ping {
    0%, 100% { 
      transform: scale(0.75); 
      fill-opacity: calc(0.15 * var(--twinkle-strength, 1)); 
    }
    50% { 
      transform: scale(1.1); 
      fill-opacity: calc(0.4 * var(--twinkle-strength, 1)); 
    }
  }

  /* 2) Portal Rings (Hidden when idle) */
  .hotspot-ring-inner,
  .hotspot-ring-outer {
    fill: none;
    stroke: var(--eden-portal-ring);
    stroke-width: 0.5;
    opacity: 0;
    pointer-events: none;
    transform-origin: center;
    transform-box: fill-box;
    transition: opacity 600ms ease, stroke-width 600ms ease, transform 1200ms cubic-bezier(0.23, 1, 0.32, 1);
    filter: drop-shadow(0 0 2px var(--eden-portal-haze));
  }

  /* 3) Hover State: Portal Mechanism */
  .eden-hotspot:hover .hotspot-ring-inner,
  .eden-hotspot:focus-visible .hotspot-ring-inner {
    opacity: 1;
    stroke-width: 12;
    stroke: var(--eden-portal-ring);
    animation: stabilizing-energy 12s linear infinite;
    filter: drop-shadow(0 0 3px rgba(0,0,0,0.2));
  }

  .eden-hotspot:hover .hotspot-ring-outer,
  .eden-hotspot:focus-visible .hotspot-ring-outer {
    opacity: 0.9;
    stroke-width: 8;
    stroke: var(--eden-portal-accent);
    transform: scale(1.05);
    animation: stabilizing-energy 20s linear infinite reverse;
    filter: drop-shadow(0 0 6px var(--eden-portal-accent));
  }

  .eden-hotspot:hover .hotspot-glow,
  .eden-hotspot:focus-visible .hotspot-glow {
    animation: none !important;
    fill: transparent !important;
    stroke: var(--eden-portal-accent) !important;
    stroke-width: 16 !important;
    stroke-opacity: 0.8 !important;
    fill-opacity: 0.1 !important;
    filter: blur(1px) drop-shadow(0 0 12px var(--eden-portal-accent)) !important;
    transform: scale(1.2);
  }

  @keyframes stabilizing-energy {
    from { stroke-dasharray: 4 20; stroke-dashoffset: 80; }
    to { stroke-dasharray: 4 20; stroke-dashoffset: 0; }
  }

  /* 4) Tooltip Label */
  .hotspot-label {
    font-family: var(--font-sans); /* Hero sans */
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--text-muted);
    opacity: 0;
    pointer-events: none;
    transition: all 400ms ease;
    filter: drop-shadow(0 0 4px rgba(255,255,255,0.4));
  }

  .eden-hotspot:hover .hotspot-label,
  .eden-hotspot:focus-visible .hotspot-label {
    opacity: 1;
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .eden-hotspot .hotspot-glow,
    .hotspot-ring-inner,
    .hotspot-ring-outer,
    .hotspot-label {
      transition: none !important;
      animation: none !important;
    }
  }

  /* Mobile Performance Fix: Disable heavy SVG filters/animations on Android + iOS */
  @media (max-width: 768px) {
    .eden-hotspot .hotspot-glow,
    .eden-hotspot:hover .hotspot-glow,
    .eden-hotspot:focus-visible .hotspot-glow {
      filter: none !important;
      animation: none !important;
    }
    
    .eden-hotspot:hover .hotspot-glow,
    .eden-hotspot:focus-visible .hotspot-glow {
      animation: none !important;
      fill-opacity: 0.8 !important;
      transform: scale(1.2);
    }

    .hotspot-ring-inner,
    .hotspot-ring-outer,
    .eden-hotspot:hover .hotspot-ring-inner,
    .eden-hotspot:focus-visible .hotspot-ring-inner,
    .eden-hotspot:hover .hotspot-ring-outer,
    .eden-hotspot:focus-visible .hotspot-ring-outer {
      filter: none !important;
    }
  }
</style>

<script>
  (() => {
    const panel = document.querySelector('[data-drawer-panel="digital-ink"]');
    if (!panel) return;

    const scrollContainer = panel.querySelector('.drawer-scroll');
    if (!scrollContainer) return;

    const image2 = panel.querySelector('[data-di-reveal="image2"]');
    const image3 = panel.querySelector('[data-di-reveal="image3"]');
    if (!image2 && !image3) return;

    let ticking = false;
    let lastScrollTop = 0;
    let image3Latched = false;

    function checkReveal() {
      if (!scrollContainer || !scrollContainer.isConnected) return;
      const containerRect = scrollContainer.getBoundingClientRect();
      const containerHeight = containerRect.height;
      if (containerHeight === 0) return;

      const currentScrollTop = scrollContainer.scrollTop;
      const scrollingDown = currentScrollTop > lastScrollTop;

      const containerCenter = containerRect.top + containerHeight / 2;
      const threshold = containerHeight * 0.15;

      if (image2) {
        const rect2 = image2.getBoundingClientRect();
        const center2 = rect2.top + rect2.height / 2;
        const dist2 = Math.abs(containerCenter - center2);
        if (dist2 < threshold) image2.classList.add('is-active');
        else image2.classList.remove('is-active');
      }

      if (image3) {
        const rect3 = image3.getBoundingClientRect();
        const center3 = rect3.top + rect3.height / 2;
        const dist3 = Math.abs(containerCenter - center3);
        const isInZone = dist3 < threshold;
        const isAboveReset = center3 < (containerCenter - threshold * 1.4);
        if (scrollingDown && isInZone) image3Latched = true;
        else if (!scrollingDown && isAboveReset) image3Latched = false;
        if (image3Latched) image3.classList.add('is-active');
        else image3.classList.remove('is-active');
      }

      lastScrollTop = currentScrollTop;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(checkReveal);
        ticking = true;
      }
    }

    scrollContainer.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('orientationchange', onScroll, { passive: true });

    const observer = new MutationObserver(() => {
      if (panel.classList.contains('is-active')) {
        lastScrollTop = scrollContainer.scrollTop;
        checkReveal();
        setTimeout(checkReveal, 100);
      }
    });
    observer.observe(panel, { attributes: true, attributeFilter: ['class'] });

    function cleanup() {
      scrollContainer?.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      window.removeEventListener('orientationchange', onScroll);
      observer.disconnect();
      document.removeEventListener('astro:before-swap', cleanup);
      window.removeEventListener('beforeunload', cleanup);
    }
    document.addEventListener('astro:before-swap', cleanup);
    window.addEventListener('beforeunload', cleanup);
  })();

  (() => {
    let glitchIntervalId: ReturnType<typeof setInterval> | null = null;
    let io: IntersectionObserver | null = null;

    function startGlitches() {
      if (glitchIntervalId) return;
      const yearEl = document.querySelector('[data-eden-year-glitch]') as HTMLElement;
      const actEl = document.querySelector('[data-eden-act-glitch]') as HTMLElement;
      const updateNumbers = () => {
        if (yearEl?.isConnected) yearEl.dataset.reveal = Math.floor(Math.random() * 100).toString().padStart(2, '0');
        if (actEl?.isConnected) actEl.dataset.reveal = Math.floor(Math.random() * 1000).toString().padStart(3, '0');
      };
      glitchIntervalId = setInterval(updateNumbers, 500);
      updateNumbers();
    }

    function stopGlitches() {
      if (glitchIntervalId) {
        clearInterval(glitchIntervalId);
        glitchIntervalId = null;
      }
    }

    function initGlitches() {
      const panel = document.querySelector('[data-drawer-panel="edinburgh-map"]');
      if (!panel) return;
      stopGlitches();
      if (io) io.disconnect();
      io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) startGlitches();
        else stopGlitches();
      }, { threshold: 0.1 });
      io.observe(panel);
      if (panel.classList.contains('is-active')) startGlitches();
    }

    function cleanup() {
      stopGlitches();
      io?.disconnect();
      io = null;
      document.removeEventListener('astro:page-load', initGlitches);
      document.removeEventListener('astro:before-swap', cleanup);
      window.removeEventListener('beforeunload', cleanup);
    }

    initGlitches();
    document.addEventListener('astro:page-load', initGlitches);
    document.addEventListener('astro:before-swap', cleanup);
    window.addEventListener('beforeunload', cleanup);
  })();

  // ─── Digital Ink: Drawer-Scoped Scroll-Reveal Observer ──────────────
  (() => {
    const prefersReduced = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initDiReveal() {
      const diPanel = document.querySelector('[data-drawer-panel="digital-ink"]');
      if (!diPanel) return;

      const scrollRoot = diPanel.querySelector('.drawer-scroll') as HTMLElement | null;
      if (!scrollRoot) return;

      const items = Array.from(
        diPanel.querySelectorAll<HTMLElement>('[data-di-reveal-section]')
      );

      if (prefersReduced()) {
        items.forEach(el => el.classList.add('di-revealed'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.add('di-revealed');
            observer.unobserve(entry.target);
          });
        },
        {
          root: scrollRoot,
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.05,
        }
      );

      items.forEach(el => observer.observe(el));

      function cleanupObserver() {
        observer.disconnect();
        document.removeEventListener('astro:before-swap', cleanupObserver);
      }
      document.addEventListener('astro:before-swap', cleanupObserver);
    }

    initDiReveal();
    document.addEventListener('astro:page-load', initDiReveal);
  })();
</script>
