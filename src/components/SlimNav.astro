---
const navLinks = [
  { label: "Projects", href: "/#projects" },
  { label: "Infocigan", href: "/#infocigan" },
  { label: "Bureaucracy", href: "/bureaucracy/" },
  { label: "Contact", href: "/#contact" },
];
---

<nav class="slim-nav" data-slim-nav aria-label="Primary navigation">
  <div
    class="slim-dismiss"
    data-slim-dismiss
    aria-hidden="true"
    hidden
  ></div>

  <div class="slim-nav-inner">
    <a href="/#landing" class="slim-wordmark" data-scroll>Q888</a>

    <button
      class="slim-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="slim-nav-links"
      aria-label="Open navigation menu"
      data-slim-toggle
    >
      <span class="slim-toggle-bar" aria-hidden="true"></span>
      <span class="slim-toggle-bar" aria-hidden="true"></span>
    </button>

    <div class="slim-links" id="slim-nav-links" data-slim-links>
      {navLinks.map((link) => (
        <a href={link.href} class="slim-link" data-scroll>{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  function initSlimNav() {
    document.querySelectorAll("[data-slim-nav]").forEach((nav) => {
      if (nav.hasAttribute("data-slim-nav-initialized")) return;

      const toggle = nav.querySelector("[data-slim-toggle]");
      const links = nav.querySelector("[data-slim-links]");
      const dismiss = nav.querySelector("[data-slim-dismiss]");
      if (
        !(toggle instanceof HTMLButtonElement) ||
        !(dismiss instanceof HTMLElement) ||
        !links
      ) return;

      const mobileViewport = window.matchMedia("(max-width: 767px)");

      const setOpen = (isOpen: boolean) => {
        nav.classList.toggle("open", isOpen);
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute(
          "aria-label",
          isOpen ? "Close navigation menu" : "Open navigation menu",
        );
        links.classList.toggle("open", isOpen);
        dismiss.hidden = !isOpen;
      };

      const handleViewportChange = () => {
        setOpen(false);
      };

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      dismiss.addEventListener("click", () => {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      });

      mobileViewport.addEventListener("change", handleViewportChange);

      links.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      nav.addEventListener("keydown", (event) => {
        if (
          event instanceof KeyboardEvent &&
          event.key === "Escape" &&
          toggle.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false);
          toggle.focus({ preventScroll: true });
        }
      });

      document.addEventListener(
        "astro:before-swap",
        () => {
          mobileViewport.removeEventListener("change", handleViewportChange);
        },
        { once: true },
      );

      nav.setAttribute("data-slim-nav-initialized", "true");
    });
  }

  initSlimNav();
  document.addEventListener("astro:page-load", initSlimNav);
</script>

<style>
  .slim-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999999;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    pointer-events: auto;
    padding-top: env(safe-area-inset-top, 0);
  }

  @media (max-width: 767px) {
    .slim-nav {
      background: transparent;
      border-bottom-color: transparent;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      pointer-events: none;
    }

    .slim-nav.open {
      background: rgba(245, 245, 245, 0.95);
      border-bottom-color: var(--line-soft);
    }

    .slim-nav.open .slim-wordmark {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .slim-dismiss {
    display: none;
  }

  @media (max-width: 767px) {
    .slim-dismiss {
      position: absolute;
      inset: 0 0 auto;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      padding: 0;
      background: transparent;
      border: 0;
      cursor: default;
      pointer-events: auto;
    }

    .slim-dismiss[hidden] {
      display: none;
    }
  }

  .slim-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    min-height: 44px;
    padding: 0 max(1rem, env(safe-area-inset-right, 0px)) 0
      max(1rem, env(safe-area-inset-left, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .slim-nav-inner {
      min-height: 0;
      padding: 0.75rem 2rem;
    }
  }

  .slim-wordmark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-ink);
    text-decoration: none;
    transition: color 150ms ease;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  @media (max-width: 767px) {
    .slim-wordmark {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (min-width: 768px) {
    .slim-wordmark {
      min-height: auto;
      display: inline;
    }
  }

  .slim-wordmark:hover {
    color: var(--text-muted);
  }

  .slim-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    position: relative;
    z-index: 2;
    border: 1px solid var(--line-soft);
    border-radius: 50%;
    background: rgba(245, 245, 245, 0.95);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .slim-toggle {
      display: none;
    }
  }

  .slim-nav.open .slim-toggle {
    box-shadow: none;
  }

  .slim-toggle-bar {
    display: block;
    width: 16px;
    height: 1px;
    background: var(--text-ink);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  .slim-toggle[aria-expanded="true"] .slim-toggle-bar:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }

  .slim-toggle[aria-expanded="true"] .slim-toggle-bar:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  .slim-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    padding: 0.5rem max(1rem, env(safe-area-inset-right, 0px)) 0.625rem
      max(1rem, env(safe-area-inset-left, 0px));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1rem;
  }

  .slim-links.open {
    display: grid;
  }

  @media (min-width: 768px) {
    .slim-links {
      display: flex;
      position: static;
      flex-direction: row;
      gap: 1.5rem;
      padding: 0;
      border: none;
      background: transparent;
    }
  }

  .slim-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 120ms ease, opacity 120ms ease, background 120ms ease;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .slim-link {
      min-height: auto;
      display: inline;
    }
  }

  .slim-link:hover {
    color: var(--text-ink);
  }

  .slim-link:active,
  .slim-link.touch-active {
    color: var(--text-ink);
    opacity: 0.7;
  }

  @media (hover: none) and (pointer: coarse) {
    .slim-link:active,
    .slim-link.touch-active {
      background: rgba(0, 0, 0, 0.05);
      padding: 0.25rem 0.5rem;
      margin: -0.25rem -0.5rem;
      border-radius: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slim-wordmark,
    .slim-toggle-bar {
      transition: none;
    }
  }
</style>
