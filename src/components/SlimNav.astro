---
const navLinks = [
  { label: "Projects", href: "#projects" },
  { label: "Infocigan", href: "#infocigan" },
  { label: "Contact", href: "#contact" },
];
---

<nav class="slim-nav" data-slim-nav>
  <div class="slim-nav-inner">
    <a href="#landing" class="slim-wordmark" data-scroll>Q888</a>
    
    <button 
      class="slim-toggle" 
      aria-label="Menu"
      aria-expanded="false"
      type="button"
    >
      <span class="slim-toggle-bar"></span>
      <span class="slim-toggle-bar"></span>
    </button>
    
    <div class="slim-links" data-slim-links>
      {navLinks.map((link) => (
        <a href={link.href} class="slim-link" data-scroll>{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  function initSlimNavToggle() {
    const nav = document.querySelector('[data-slim-nav]');
    if (!nav || nav.hasAttribute('data-slim-nav-initialized')) return;
    const toggle = nav.querySelector('.slim-toggle');
    const links = nav.querySelector('[data-slim-links]');
    if (!toggle || !links) return;
    nav.setAttribute('data-slim-nav-initialized', 'true');
    
    const toggleMenu = (e?: Event) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      console.log('[SlimNav] Toggle menu:', expanded ? 'closing' : 'opening');
      toggle.setAttribute('aria-expanded', String(!expanded));
      links.classList.toggle('open');
    };

    toggle.addEventListener('click', toggleMenu);
    toggle.addEventListener('touchend', (e) => {
      e.preventDefault();
      toggleMenu();
    }, { passive: false });

    links.querySelectorAll('a').forEach((link, index) => {
      const closeMenu = () => {
        console.log('[SlimNav] Link clicked/touched:', (link as HTMLAnchorElement).href);
        toggle.setAttribute('aria-expanded', 'false');
        links.classList.remove('open');
        (link as HTMLElement).classList.remove('touch-active');
      };
      
      link.addEventListener('click', closeMenu);
      
      link.addEventListener('touchstart', () => {
        (link as HTMLElement).classList.add('touch-active');
      }, { passive: true });
      
      link.addEventListener('touchend', (e) => {
        e.preventDefault();
        closeMenu();
      }, { passive: false });
    });
  }
  
  initSlimNavToggle();
  document.addEventListener('astro:page-load', initSlimNavToggle);
</script>

<style>
  .slim-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999999;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .slim-nav {
      background: rgba(245, 245, 245, 0.95);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  .slim-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.625rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .slim-nav-inner {
      padding: 0.75rem 2rem;
    }
  }

  .slim-wordmark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-ink);
    text-decoration: none;
    transition: color 150ms ease;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .slim-wordmark:hover {
    color: var(--text-muted);
  }

  .slim-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .slim-toggle {
      display: none;
    }
  }

  .slim-toggle-bar {
    display: block;
    width: 16px;
    height: 1px;
    background: var(--text-ink);
    transition: opacity 120ms ease;
  }

  .slim-toggle[aria-expanded="true"] .slim-toggle-bar:first-child {
    opacity: 0.4;
  }

  .slim-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    padding: 0.75rem 1rem;
    flex-direction: column;
    gap: 0.625rem;
  }

  .slim-links.open {
    display: flex;
  }

  @media (min-width: 768px) {
    .slim-links {
      display: flex;
      position: static;
      flex-direction: row;
      gap: 1.5rem;
      padding: 0;
      border: none;
      background: transparent;
    }
  }

  .slim-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 120ms ease, opacity 120ms ease, background 120ms ease;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .slim-link {
      min-height: auto;
      display: inline;
    }
  }

  .slim-link:hover {
    color: var(--text-ink);
  }

  .slim-link:active,
  .slim-link.touch-active {
    color: var(--text-ink);
    opacity: 0.7;
  }

  @media (hover: none) and (pointer: coarse) {
    .slim-link:active,
    .slim-link.touch-active {
      background: rgba(0, 0, 0, 0.05);
      padding: 0.25rem 0.5rem;
      margin: -0.25rem -0.5rem;
      border-radius: 4px;
    }
  }
</style>
