---
import DoorArch from "./DoorArch.astro";

// The two Q888 doors. Infocigan's micro-projects have their own doors inside the Infocigan section.
const doors = [
  {
    id: "digital-ink",
    title: "Digital Ink",
    descriptor: "A system for meaning, scarcity, and traceable digital creation.",
    href: "/dink/",
    image: "/images/project_ink-768.webp",
  },
  {
    id: "edinburgh-map",
    title: "Edinburgh Magical Map",
    descriptor: "A mythic cartography of place, memory, and hidden doors.",
    href: "/map/",
    image: "/images/Project_map-768.webp",
    attrs: { "data-drawer-trigger": "edinburgh-map", "data-nav-direction": "right" },
  },
];
---

<section data-threshold="projects" class="worlds qd-wrap">
  <header class="worlds-head">
    <h2>Projects</h2>
    <p class="qd-mono">{String(doors.length).padStart(2, "0")} doors</p>
  </header>

  <ul class="worlds-arches">
    {doors.map((door, index) => (
      <li>
        <DoorArch {...door} index={index} />
      </li>
    ))}
  </ul>
</section>

<style>
  .worlds {
    display: grid;
    gap: 2.5rem clamp(1.5rem, 4vw, 4rem);
    padding-block: 1.25rem clamp(5rem, 11vw, 10rem);
    color: var(--text-ink);
    background: var(--bg-fog);
    border-top: 1px solid var(--line-soft);
  }

  .worlds-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .worlds-head h2 {
    margin: 0;
    font-family: var(--font-door-display);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 700;
    font-variation-settings: "wdth" 80;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .worlds-head p {
    margin: 0;
  }

  .worlds-arches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The stagger gives the pair a walking rhythm instead of a product grid. */
  .worlds-arches li:nth-child(even) {
    margin-top: 3rem;
  }

  @media (min-width: 900px) {
    .worlds {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .worlds-head {
      flex-direction: column;
      justify-content: flex-start;
    }

    .worlds-arches li:nth-child(even) {
      margin-top: 6rem;
    }
  }
</style>
