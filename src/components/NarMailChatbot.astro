---
// No props needed
---

<div id="nar-chat-widget" class="nar-chat-widget">
  <button id="nar-chat-toggle" class="nar-chat-toggle" aria-label="Open Nar-Mail Express chat">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="nar-chat-badge">?</span>
  </button>

  <div id="nar-chat-window" class="nar-chat-window" aria-hidden="true">
    <div class="nar-chat-header">
      <div class="nar-chat-header-content">
        <h3>Nar-Mail Express°</h3>
        <p class="nar-chat-status">Square Bubbles Bureaucracy Division</p>
      </div>
      <button id="nar-chat-close" class="nar-chat-close" aria-label="Close chat">&times;</button>
    </div>

    <div id="nar-chat-messages" class="nar-chat-messages"></div>

    <div class="nar-chat-input-wrapper">
      <input
        type="text"
        id="nar-chat-input"
        class="nar-chat-input"
        placeholder="Type your inquiry"
        autocomplete="off"
      />
      <button id="nar-chat-send" class="nar-chat-send" aria-label="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const NAR_CHAT_API = "/.netlify/functions/nar-chat";
  const MAX_MESSAGES = 18;

  function escapeHtml(s) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  class NarMailChatbot {
    constructor() {
      this.widget = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-widget"));
      this.toggle = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-toggle"));
      this.window = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-window"));
      this.close = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-close"));
      this.messagesEl = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-messages"));
      this.input = /** @type {HTMLInputElement | null} */ (document.getElementById("nar-chat-input"));
      this.send = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-send"));
      this.hasInitialized = false;
      this.isLoading = false;
      /** @type {Array<{role: "user"|"assistant", content: string}>} */
      this.history = [];

      this.init();
    }

    init() {
      if (this.hasInitialized || !this.widget) return;
      this.hasInitialized = true;

      this.toggle?.addEventListener("click", () => this.openChat());
      this.close?.addEventListener("click", () => this.closeChat());
      this.close?.addEventListener("touchend", (e) => { e.preventDefault(); this.closeChat(); }, { passive: false });
      this.send?.addEventListener("click", () => this.sendMessage());
      this.input?.addEventListener("keypress", (event) => {
        if (event.key === "Enter") this.sendMessage();
      });
      this.input?.addEventListener("input", () => {
        if (this.input?.value.length > 0) this.input?.removeAttribute("placeholder");
      });

      setTimeout(() => this.fetchGreeting(), 500);
    }

    openChat() {
      this.window?.classList.add("is-open");
      this.window?.setAttribute("aria-hidden", "false");
      this.toggle?.classList.add("is-hidden");
      this.input?.focus();
    }

    closeChat() {
      this.window?.classList.remove("is-open");
      this.window?.setAttribute("aria-hidden", "true");
      this.toggle?.classList.remove("is-hidden");
    }

    /**
     * @param {string} text
     * @param {boolean} [isBot=false]
     */
    addMessage(text, isBot = false) {
      const msg = document.createElement("div");
      msg.className = `nar-chat-message ${isBot ? "bot" : "user"}`;
      const label = isBot ? "K-Nar" : "You";
      msg.innerHTML = `<span class="nar-chat-message-label">${escapeHtml(label)}</span><div class="nar-chat-message-content">${escapeHtml(text)}</div>`;
      this.messagesEl?.appendChild(msg);
      this.scrollToBottom();
    }

    /**
     * @param {string} text
     * @param {number} [delay=800]
     */
    addBotMessage(text, delay = 800) {
      this.showTypingIndicator();
      setTimeout(() => {
        this.hideTypingIndicator();
        this.addMessage(text, true);
        this.input?.focus();
      }, delay);
    }

    showTypingIndicator() {
      this.hideTypingIndicator();
      const indicator = document.createElement("div");
      indicator.className = "nar-chat-typing";
      indicator.id = "typing-indicator";
      indicator.innerHTML = "<span></span><span></span><span></span>";
      this.messagesEl?.appendChild(indicator);
      this.scrollToBottom();
    }

    hideTypingIndicator() {
      document.getElementById("typing-indicator")?.remove();
    }

    scrollToBottom() {
      if (this.messagesEl) {
        this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
      }
    }

    sendMessage() {
      const text = this.input?.value.trim();
      if (!text || this.isLoading) return;
      if (this.history.length >= MAX_MESSAGES) return;

      this.addMessage(text, false);
      this.history.push({ role: "user", content: text });
      if (this.input) this.input.value = "";
      this.callApi();
    }

    async fetchGreeting() {
      this.showTypingIndicator();
      const messages = [{ role: "user", content: "[User has opened the Nar-Mail Express chat.]" }];
      try {
        const res = await fetch(NAR_CHAT_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages }),
        });
        const data = await res.json().catch(() => ({}));
        this.hideTypingIndicator();
        if (res.ok && data.content) {
          this.addMessage(data.content, true);
          this.history.push({ role: "assistant", content: data.content });
        } else {
          const err = this.parseApiError(res, data);
          this.addMessage(err, true);
        }
        this.input?.focus();
      } catch {
        this.hideTypingIndicator();
        this.addMessage("Connection failed. The Square Bubbles Council may be napping.", true);
        this.input?.focus();
      }
    }

    async callApi() {
      if (this.isLoading) return;
      this.isLoading = true;
      this.showTypingIndicator();
      this.setInputDisabled(true);

      try {
        const res = await fetch(NAR_CHAT_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: this.history }),
        });
        const data = await res.json().catch(() => ({}));
        this.hideTypingIndicator();
        if (res.ok && data.content) {
          this.addMessage(data.content, true);
          this.history.push({ role: "assistant", content: data.content });
        } else {
          const err = this.parseApiError(res, data);
          this.addMessage(err, true);
        }
        this.input?.focus();
      } catch {
        this.hideTypingIndicator();
        this.addMessage("Connection failed. The mushroom network may be congested.", true);
        this.input?.focus();
      } finally {
        this.isLoading = false;
        this.setInputDisabled(false);
      }
    }

    setInputDisabled(disabled) {
      if (this.input) this.input.disabled = disabled;
      if (this.send) this.send.disabled = disabled;
    }

    parseApiError(res, data) {
      if (res.status === 404) {
        return "Form 888-N: Chat API not found. Use the Netlify dev URL from the terminal (e.g. localhost:8888) — not the raw Astro port.";
      }
      if (data.error) {
        const err = typeof data.error === "string" ? data.error : JSON.stringify(data.error);
        try {
          const parsed = JSON.parse(err);
          return parsed.error?.message || parsed.message || err;
        } catch {
          return err;
        }
      }
      return res.status === 500
        ? "Nar-Mail system temporarily offline. Check OPENAI_API_KEY in .env and restart npm run dev:netlify."
        : "Form 888-E: Response unavailable. Please rephrase or try again.";
    }
  }

  function initNarMailChatbot() {
    const widget = document.getElementById("nar-chat-widget");
    if (!widget || widget.getAttribute("data-nar-chat-init") === "true") return;
    widget.setAttribute("data-nar-chat-init", "true");
    new NarMailChatbot();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNarMailChatbot, { once: true });
  } else {
    initNarMailChatbot();
  }

  document.addEventListener("astro:page-load", initNarMailChatbot);
</script>

<style>
  #nar-chat-widget,
  #nar-chat-widget * {
    color: #ffffff !important;
  }

  .nar-chat-widget {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  }

  .nar-chat-toggle {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(95, 210, 230) 0%, rgb(45, 140, 155) 100%);
    border: 2px solid rgb(180, 235, 245);
    color: rgb(7, 19, 35);
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(95, 210, 230, 0.4);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nar-chat-toggle:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 32px rgba(95, 210, 230, 0.6);
  }

  .nar-chat-toggle.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
  }

  .nar-chat-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background: rgb(235, 215, 175);
    color: rgb(7, 19, 35);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    animation: nar-chat-pulse 2s infinite;
  }

  @keyframes nar-chat-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .nar-chat-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 4rem);
    height: 550px;
    max-height: calc(100vh - 140px);
    background: rgb(12, 25, 40);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 2px solid rgb(95, 210, 230);
    border-radius: 20px;
    box-shadow:
      0 0 60px rgba(95, 210, 230, 0.5),
      inset 0 1px 0 rgba(180, 235, 245, 0.2);
    display: none;
    flex-direction: column;
    overflow: hidden;
  }

  .nar-chat-window.is-open {
    display: flex;
    animation: nar-chat-slide-up 0.3s ease-out;
  }

  @keyframes nar-chat-slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nar-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: rgb(8, 18, 30);
    border-bottom: 1px solid rgba(95, 210, 230, 0.3);
  }

  #nar-chat-widget .nar-chat-header-content h3 {
    color: #ffffff !important;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.05em;
  }

  #nar-chat-widget .nar-chat-status {
    color: rgba(255, 255, 255, 0.95) !important;
    font-size: 0.8rem;
    margin: 0.25rem 0 0;
    font-style: italic;
  }

  #nar-chat-widget .nar-chat-close {
    background: none;
    border: none;
    color: #ffffff !important;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .nar-chat-close:hover {
    background: rgba(95, 210, 230, 0.2);
    color: rgb(95, 210, 230);
  }

  .nar-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nar-chat-message {
    display: flex;
    animation: nar-chat-message-in 0.3s ease-out;
  }

  @keyframes nar-chat-message-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nar-chat-message.bot {
    justify-content: flex-start;
  }

  .nar-chat-message.user {
    justify-content: flex-end;
  }

  .nar-chat-message {
    flex-direction: column;
    align-items: flex-start;
  }

  .nar-chat-message.user {
    align-items: flex-end;
  }

  .nar-chat-message-label {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.9;
    margin-bottom: 0.25rem;
  }

  #nar-chat-widget .nar-chat-message-content {
    max-width: 75%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #ffffff !important;
  }

  #nar-chat-widget .nar-chat-message.bot .nar-chat-message-content {
    background: rgba(95, 210, 230, 0.25);
    color: #ffffff !important;
    border: 1px solid rgba(95, 210, 230, 0.4);
  }

  #nar-chat-widget .nar-chat-message.user .nar-chat-message-content {
    background: rgba(100, 80, 60, 0.5);
    color: #ffffff !important;
    border: 1px solid rgba(200, 165, 105, 0.4);
    font-weight: 700;
  }

  .nar-chat-typing {
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: rgba(95, 210, 230, 0.25);
    border: 1px solid rgba(95, 210, 230, 0.4);
    border-radius: 12px;
    width: fit-content;
  }

  .nar-chat-typing span {
    width: 8px;
    height: 8px;
    background: rgb(95, 210, 230);
    border-radius: 50%;
    animation: nar-chat-typing 1.4s infinite;
  }

  .nar-chat-typing span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .nar-chat-typing span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes nar-chat-typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.7;
    }
    30% {
      transform: translateY(-10px);
      opacity: 1;
    }
  }

  .nar-chat-input-wrapper {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: rgb(8, 18, 30);
    border-top: 1px solid rgba(95, 210, 230, 0.3);
  }

  #nar-chat-widget .nar-chat-input {
    flex: 1;
    background: rgba(20, 40, 60, 0.9);
    border: 1px solid rgba(95, 210, 230, 0.5);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #ffffff !important;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .nar-chat-input:focus {
    border-color: rgb(95, 210, 230);
  }

  #nar-chat-widget .nar-chat-input::placeholder {
    color: rgba(255, 255, 255, 0.95) !important;
  }

  .nar-chat-send {
    background: linear-gradient(135deg, rgb(95, 210, 230) 0%, rgb(45, 140, 155) 100%);
    border: none;
    border-radius: 8px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(7, 19, 35);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nar-chat-send:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(95, 210, 230, 0.4);
  }

  .nar-chat-send:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  #nar-chat-widget .nar-chat-input:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .nar-chat-messages::-webkit-scrollbar {
    width: 6px;
  }

  .nar-chat-messages::-webkit-scrollbar-track {
    background: rgba(15, 35, 55, 0.5);
  }

  .nar-chat-messages::-webkit-scrollbar-thumb {
    background: rgba(95, 210, 230, 0.4);
    border-radius: 3px;
  }

  .nar-chat-messages::-webkit-scrollbar-thumb:hover {
    background: rgba(95, 210, 230, 0.6);
  }

  @media (max-width: 480px) {
    .nar-chat-widget {
      bottom: 1rem;
      right: 1rem;
    }

    .nar-chat-window {
      width: calc(100vw - 2rem);
      height: calc(100vh - 100px);
      bottom: 70px;
      right: 0;
    }
  }
</style>
