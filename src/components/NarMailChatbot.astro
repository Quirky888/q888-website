---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";

const projects = await getCollection("projects");
const projectsData = projects.map(({ data }) => ({
  slug: data.slug,
  title: data.cardTitle,
  descriptor: data.cardDescriptor,
  system: data.cardSystem,
  panelTitle: data.panelTitle,
  panelDescription: data.panelDescription,
  panelSpecs: data.panelSpecs
}));

// Manually append Digital Ink and Edinburgh Magical Map metadata to projectsData
projectsData.push({
  slug: "digital-ink",
  title: "Digital Ink",
  descriptor: "A system for meaning, scarcity, and traceable digital creation.",
  system: "SYS: INK",
  panelTitle: "Digital Ink",
  panelDescription: "What if digital art had memory? What if every brushstroke carried weight, history, and emotional resonance? Digital Ink challenges the disposable nature of infinite digital tools by introducing constraint-based creativity, the Symbolic Smart Pixel Protocol (SSPP), Apple Vision + GPT-4o poetic transformation, and 1,000 Smart Inks on iPadOS.",
  panelSpecs: [
    { label: "PLATFORM", value: "iPadOS (iPad-only)" },
    { label: "STATUS", value: "AVAILABLE NOW" },
    { label: "ROLE", value: "Concept · Product Design · UX · SwiftUI" },
    { label: "YEAR", value: "2025–2026" }
  ]
});

projectsData.push({
  slug: "edinburgh-map",
  title: "Edinburgh Magical Map",
  descriptor: "A mythic cartography of place, memory, and hidden doors.",
  system: "SYS: MAP",
  panelTitle: "Edinburgh Magical Map",
  panelDescription: "Welcome to Edinburgh — where magic retired but still drinks in public. A mythic cartography showing 15 secret locations and their hidden history/lore, including Castle on Chicken Legs, Real Edinburgh Castle hidden under Arthur's Seat, Troll Market, Star Bank, and Star House.",
  panelSpecs: [
    { label: "LAYER", value: "EDINBURGH CITY / UNDERWORLD OVERLAY" },
    { label: "ACCESS", value: "COUNCIL-GATED" },
    { label: "STATUS", value: "ACTIVE (REDACTED)" }
  ]
});

const edenStoriesPath = path.join(process.cwd(), "public", "eden-stories.json");
const edenStoriesData = JSON.parse(fs.readFileSync(edenStoriesPath, "utf-8"));
const mapLocations = edenStoriesData.locations.map((loc: any) => ({
  id: loc.id,
  name: loc.name,
  emoji: loc.emoji,
  short: loc.short,
  long: loc.long
}));
---

<div id="nar-chat-widget" class="nar-chat-widget">
  <button id="nar-chat-toggle" class="nar-chat-toggle" aria-label="Open Nar-Mail Express chat">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="nar-chat-badge">?</span>
  </button>

  <div id="nar-chat-window" class="nar-chat-window" aria-hidden="true">
    <div class="nar-chat-header">
      <div class="nar-chat-header-content">
        <h3>Nar-Mail Express°</h3>
        <p class="nar-chat-status">Square Bubbles Bureaucracy Division</p>
      </div>
      <div class="nar-chat-header-actions">
        <button id="nar-chat-reset" class="nar-chat-reset" aria-label="New conversation" title="New conversation">↺</button>
        <button id="nar-chat-close" class="nar-chat-close" aria-label="Close chat">&times;</button>
      </div>
    </div>

    <div id="nar-chat-messages" class="nar-chat-messages"></div>
    <div id="nar-chat-warning" class="nar-chat-warning" aria-live="polite"></div>

    <div class="nar-chat-input-wrapper">
      <div id="nar-chat-cooldown" class="nar-chat-cooldown hidden">
        <span>Available in <span id="nar-cooldown-timer">15:00</span></span>
      </div>
      <input
        type="text"
        id="nar-chat-input"
        class="nar-chat-input"
        placeholder="Type your inquiry"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        inputmode="text"
        data-1p-ignore="true"
        data-lpignore="true"
        data-bwignore="true"
        data-form-type="other"
      />
      <button id="nar-chat-send" class="nar-chat-send" aria-label="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ projectsData, mapLocations }}>
  // @ts-nocheck
  const NAR_CHAT_API = "/.netlify/functions/nar-chat";
  const MAX_MESSAGES = 18;

  function escapeHtml(s) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function renderInlineMarkdown(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
      .replace(/__(.+?)__/g, "<strong>$1</strong>")
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: rgb(95, 210, 230); text-decoration: underline;">$1</a>');
  }

  function renderMarkdown(text) {
    const normalized = escapeHtml(text).replace(/\r\n/g, "\n");
    const lines = normalized.split("\n");
    const blocks = [];
    let i = 0;

    while (i < lines.length) {
      const line = lines[i].trim();
      if (!line) {
        i += 1;
        continue;
      }

      if (/^[-*]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^[-*]\s+/, ""));
          i += 1;
        }
        blocks.push(`<ul>${items.map((item) => `<li>${renderInlineMarkdown(item)}</li>`).join("")}</ul>`);
        continue;
      }

      if (/^\d+\.\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\d+\.\s+/.test(lines[i].trim())) {
          items.push(lines[i].trim().replace(/^\d+\.\s+/, ""));
          i += 1;
        }
        blocks.push(`<ol>${items.map((item) => `<li>${renderInlineMarkdown(item)}</li>`).join("")}</ol>`);
        continue;
      }

      const paragraph = [];
      while (i < lines.length && lines[i].trim() && !/^[-*]\s+/.test(lines[i].trim()) && !/^\d+\.\s+/.test(lines[i].trim())) {
        paragraph.push(lines[i].trim());
        i += 1;
      }
      blocks.push(`<p>${renderInlineMarkdown(paragraph.join("<br>"))}</p>`);
    }

    return blocks.join("");
  }

  class NarMailChatbot {
    constructor() {
      this.widget = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-widget"));
      this.toggle = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-toggle"));
      this.window = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-window"));
      this.close = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-close"));
      this.resetBtn = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-reset"));
      this.messagesEl = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-messages"));
      this.input = /** @type {HTMLInputElement | null} */ (document.getElementById("nar-chat-input"));
      this.send = /** @type {HTMLElement | null} */ (document.getElementById("nar-chat-send"));
      this.hasInitialized = false;
      this.isLoading = false;
      this.scrollRequest = 0;
      this.typingShownAt = 0;
      this.typingHideTimer = 0;
      /** @type {Array<{role: "user"|"assistant", content: string}>} */
      this.history = [];

      this.init();
    }

    init() {
      if (this.hasInitialized || !this.widget) return;
      this.hasInitialized = true;
      this.toggle?.setAttribute("aria-expanded", "false");

      this.toggle?.addEventListener("click", () => this.openChat());
      this.close?.addEventListener("click", () => this.closeChat());
      this.close?.addEventListener("touchend", (e) => { e.preventDefault(); this.closeChat(); }, { passive: false });
      this.resetBtn?.addEventListener("click", () => this.handleReset());
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && this.window?.classList.contains("is-open")) {
          this.closeChat();
        }
      });
      this.send?.addEventListener("click", () => this.sendMessage());
      this.input?.addEventListener("keypress", (event) => {
        if (event.key === "Enter") this.sendMessage();
      });
      this.input?.addEventListener("input", () => {
        if (this.input?.value.length > 0) this.input?.removeAttribute("placeholder");
      });

      this.loadSession();
      this.updateUIState();
      this.startCooldownTimer();

      setTimeout(() => this.fetchGreeting(), 500);
    }

    loadSession() {
      const stored = localStorage.getItem("nar_chat_session");
      const now = Date.now();
      const ONE_DAY = 24 * 60 * 60 * 1000;

      if (stored) {
        try {
          const data = JSON.parse(stored);
          // Auto-reset if older than 24h
          if (now - data.lastTimestamp > ONE_DAY) {
            this.resetSession();
          } else {
            this.session = data;
          }
        } catch (e) {
          this.resetSession();
        }
      } else {
        this.resetSession();
      }
    }

    resetSession() {
      this.session = {
        sessionId: crypto.randomUUID(),
        messageCount: 0,
        cooldownUntil: 0,
        lastTimestamp: Date.now()
      };
      this.saveSession();
    }

    saveSession() {
      this.session.lastTimestamp = Date.now();
      localStorage.setItem("nar_chat_session", JSON.stringify(this.session));
    }

    handleReset() {
      if (this.isLoading) return;
      this.resetSession();
      if (this.messagesEl) this.messagesEl.innerHTML = "";
      this.history = [];
      this.updateUIState();
      this.fetchGreeting();
    }

    incrementMessageCount() {
      this.session.messageCount++;
      if (this.session.messageCount >= 15 && this.session.cooldownUntil <= Date.now()) {
        this.session.cooldownUntil = Date.now() + 900000;
        this.startCooldownTimer();
      }
      this.saveSession();
      this.updateUIState();
    }

    updateUIState() {
      const now = Date.now();
      const isCooldown = this.session.cooldownUntil > now;
      const warningEl = document.getElementById("nar-chat-warning");
      const cooldownEl = document.getElementById("nar-chat-cooldown");

      if (isCooldown) {
        this.setInputDisabled(true);
        cooldownEl?.classList.remove("hidden");
        this.input?.classList.add("hidden");
      } else {
        const reachedLimit = this.session.messageCount >= 15;
        this.setInputDisabled(reachedLimit);
        cooldownEl?.classList.add("hidden");
        this.input?.classList.remove("hidden");
      }

      if (this.session.messageCount >= 13 && this.session.messageCount < 15) {
        if (warningEl) {
          warningEl.textContent = "The interdimensional postal service is getting very busy. Kotiki-Nar will be unavailable soon due to cosmic circumstances.";
          warningEl.classList.add("visible");
        }
      } else {
        warningEl?.classList.remove("visible");
      }
    }

    startCooldownTimer() {
      const timerEl = document.getElementById("nar-cooldown-timer");
      const updateTimer = () => {
        const now = Date.now();
        const remaining = Math.max(0, this.session.cooldownUntil - now);

        if (remaining > 0) {
          const mins = Math.floor(remaining / 60000);
          const secs = Math.floor((remaining % 60000) / 1000);
          if (timerEl) timerEl.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
          setTimeout(updateTimer, 1000);
        } else if (this.session.cooldownUntil > 0) {
          // Cooldown just expired
          this.session.cooldownUntil = 0;
          this.session.messageCount = 0; // Reset count after cooldown
          this.saveSession();
          this.updateUIState();
        }
      };
      updateTimer();
    }

    openChat() {
      this.window?.classList.add("is-open");
      this.window?.setAttribute("aria-hidden", "false");
      this.toggle?.classList.add("is-hidden");
      this.toggle?.setAttribute("aria-expanded", "true");
      this.input?.focus();
    }

    closeChat() {
      this.window?.classList.remove("is-open");
      this.window?.setAttribute("aria-hidden", "true");
      this.toggle?.classList.remove("is-hidden");
      this.toggle?.setAttribute("aria-expanded", "false");
      this.toggle?.focus();
    }

    /**
     * @param {string} text
     * @param {boolean} [isBot=false]
     */
    addMessage(text, isBot = false) {
      if (!this.messagesEl) return;
      const msg = document.createElement("div");
      msg.className = `nar-chat-message ${isBot ? "bot" : "user"}`;
      const label = isBot ? "K-Nar" : "You";
      const content = isBot ? renderMarkdown(text) : `<p>${escapeHtml(text)}</p>`;
      msg.innerHTML = `<span class="nar-chat-message-label">${escapeHtml(label)}</span><div class="nar-chat-message-content">${content}</div>`;
      this.messagesEl.appendChild(msg);
      this.scrollToBottom();
    }

    createStreamingBotMessage() {
      if (!this.messagesEl) return null;
      const msg = document.createElement("div");
      msg.className = "nar-chat-message bot";
      msg.innerHTML = `<span class="nar-chat-message-label">K-Nar</span><div class="nar-chat-message-content"></div>`;
      this.messagesEl.appendChild(msg);
      const contentEl = msg.querySelector(".nar-chat-message-content");
      if (this.messagesEl) {
        this.messagesEl.scrollTop = msg.offsetTop - 12;
      }
      return contentEl;
    }

    updateStreamingBotMessage(contentEl, text) {
      if (!contentEl) return;
      contentEl.innerHTML = renderMarkdown(text);
    }

    showTypingIndicator() {
      this.hideTypingIndicator();
      const indicator = document.createElement("div");
      indicator.className = "nar-chat-typing";
      indicator.id = "nar-typing-indicator";
      indicator.innerHTML = '<span class="nar-chat-typing-label">Typing…</span><span class="nar-chat-typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>';
      this.messagesEl?.appendChild(indicator);
      this.typingShownAt = performance.now();
      this.scrollToBottom();
    }

    hideTypingIndicator(immediate = false) {
      const minVisibleMs = 1200;
      const remove = () => {
        document.getElementById("nar-typing-indicator")?.remove();
        this.typingHideTimer = 0;
      };

      if (immediate) {
        if (this.typingHideTimer) {
          clearTimeout(this.typingHideTimer);
          this.typingHideTimer = 0;
        }
        remove();
        return;
      }

      const elapsed = performance.now() - this.typingShownAt;

      if (elapsed >= minVisibleMs) {
        remove();
        return;
      }

      if (this.typingHideTimer) {
        clearTimeout(this.typingHideTimer);
      }
      this.typingHideTimer = window.setTimeout(remove, Math.max(0, minVisibleMs - elapsed));
    }

    scrollToBottom(smooth = false) {
      if (!this.messagesEl) return;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!smooth || reduceMotion) {
        this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
        return;
      }
      if (this.scrollRequest) return;
      this.scrollRequest = requestAnimationFrame(() => {
        this.messagesEl?.scrollTo({
          top: this.messagesEl.scrollHeight,
          behavior: "smooth",
        });
        this.scrollRequest = 0;
      });
    }

    sendMessage() {
      if (this.session.cooldownUntil > Date.now() || this.session.messageCount >= 15) return;

      const text = this.input?.value.trim();
      if (!text || this.isLoading) return;
      if (this.history.length >= MAX_MESSAGES) return;

      this.addMessage(text, false);
      this.history.push({ role: "user", content: text });
      
      this.incrementMessageCount();

      if (this.input) {
        this.input.value = "";
        this.input.focus(); // Focus after submission
      }
      this.callApi();
    }

    async fetchGreeting() {
      this.showTypingIndicator();
      const messages = [{ role: "user", content: "[User has opened the Nar-Mail Express chat.]" }];
      try {
        const result = await this.streamApiResponse(messages);
        if (result.content) {
          this.history.push({ role: "assistant", content: result.content });
          this.incrementMessageCount();
        }
        if (result.interrupted && !result.content) {
          this.addMessage("Connection interrupted before a reply arrived. Please try again.", true);
        }
        this.input?.focus();
      } catch {
        this.hideTypingIndicator();
        this.addMessage("Connection failed. The Square Bubbles Council may be napping.", true);
        this.input?.focus();
      }
    }

    async callApi() {
      if (this.isLoading) return;
      this.isLoading = true;
      this.showTypingIndicator();
      this.setInputDisabled(true);

      try {
        const result = await this.streamApiResponse(this.history);
        if (result.content) {
          this.history.push({ role: "assistant", content: result.content });
          this.incrementMessageCount();
        }
        if (result.interrupted && !result.content) {
          this.addMessage("Connection interrupted before a reply arrived. Please resend your message.", true);
        }
        this.input?.focus();
      } catch {
        this.hideTypingIndicator();
        this.addMessage("Connection failed. The mushroom network may be congested.", true);
        this.input?.focus();
      } finally {
        this.isLoading = false;
        this.setInputDisabled(false);
        this.input?.focus();
      }
    }

    setInputDisabled(disabled) {
      if (this.input) this.input.disabled = disabled;
      if (this.send) this.send.disabled = disabled;
    }

    async streamApiResponse(messages) {
      const res = await fetch(NAR_CHAT_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages, projects: projectsData, mapLocations }),
      });

      if (!res.ok) {
        const err = await this.parseApiError(res);
        this.hideTypingIndicator();
        this.addMessage(err, true);
        return { content: "", interrupted: false };
      }

      if (!res.body) {
        this.hideTypingIndicator();
        this.addMessage("Streaming unavailable in this browser. Please update and retry.", true);
        return { content: "", interrupted: false };
      }

      this.hideTypingIndicator(true);
      const contentEl = this.createStreamingBotMessage();
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let content = "";
      let completed = false;

      try {
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let boundary = buffer.indexOf("\n\n");

          while (boundary !== -1) {
            const block = buffer.slice(0, boundary).replace(/\r/g, "");
            buffer = buffer.slice(boundary + 2);
            const data = this.parseSseBlock(block);

            if (data?.type === "token" && typeof data.content === "string") {
              content += data.content;
              this.updateStreamingBotMessage(contentEl, content);
            } else if (data?.type === "error") {
              throw new Error(data.message || "Streaming failed");
            } else if (data?.type === "done") {
              completed = true;
            }
            boundary = buffer.indexOf("\n\n");
          }
        }
      } catch {
        if (content) {
          const interrupted = `${content}\n\nConnection interrupted. You can resend to continue.`;
          this.updateStreamingBotMessage(contentEl, interrupted);
          return { content, interrupted: true };
        }
        throw new Error("Connection interrupted");
      }

      if (!completed) {
        if (content) {
          const interrupted = `${content}\n\nConnection interrupted. You can resend to continue.`;
          this.updateStreamingBotMessage(contentEl, interrupted);
          return { content, interrupted: true };
        }
        return { content: "", interrupted: true };
      }

      return { content, interrupted: false };
    }

    parseSseBlock(block) {
      if (!block.trim()) return null;
      const dataLines = block
        .split("\n")
        .filter((line) => line.startsWith("data:"))
        .map((line) => line.slice(5).trimStart());
      if (dataLines.length === 0) return null;
      try {
        return JSON.parse(dataLines.join("\n"));
      } catch {
        return null;
      }
    }

    async parseApiError(res) {
      const bodyText = await res.text();
      let data = {};
      try {
        data = JSON.parse(bodyText);
      } catch {}

      if (res.status === 404) {
        return "Form 888-N: Chat API not found. Use the Netlify dev URL from the terminal (e.g. localhost:8888) — not the raw Astro port.";
      }
      const sourceError = data && typeof data === "object" && "error" in data ? data.error : bodyText;
      if (sourceError) {
        const err = typeof sourceError === "string" ? sourceError : JSON.stringify(sourceError);
        try {
          const parsed = JSON.parse(String(sourceError));
          return parsed.error?.message || parsed.message || String(sourceError);
        } catch {
          return err;
        }
      }
      return res.status === 500
        ? "Nar-Mail system temporarily offline. Check OPENAI_API_KEY in .env and restart npm run dev:netlify."
        : "Form 888-E: Response unavailable. Please rephrase or try again.";
    }
  }

  function initNarMailChatbot() {
    const widget = document.getElementById("nar-chat-widget");
    if (!widget || widget.getAttribute("data-nar-chat-init") === "true") return;
    widget.setAttribute("data-nar-chat-init", "true");
    new NarMailChatbot();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNarMailChatbot, { once: true });
  } else {
    initNarMailChatbot();
  }

  document.addEventListener("astro:page-load", initNarMailChatbot);
</script>

<style>
  #nar-chat-widget {
    color: #ffffff;
  }
  #nar-chat-widget button,
  #nar-chat-widget input {
    color: #ffffff;
  }

  .nar-chat-widget {
    position: fixed;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    right: max(1rem, env(safe-area-inset-right, 0px));
    z-index: 9999;
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  }

  @media (max-width: 768px) {
    .nar-chat-widget {
      display: none !important;
    }
  }

  .nar-chat-toggle {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(95, 210, 230) 0%, rgb(45, 140, 155) 100%);
    border: 2px solid rgb(180, 235, 245);
    color: rgb(7, 19, 35);
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(95, 210, 230, 0.4);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nar-chat-toggle:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 32px rgba(95, 210, 230, 0.6);
  }

  .nar-chat-toggle.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
  }

  .nar-chat-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background: rgb(235, 215, 175);
    color: rgb(7, 19, 35);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    animation: nar-chat-pulse 2s infinite;
  }

  @keyframes nar-chat-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .nar-chat-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
    height: 550px;
    max-height: calc(100dvh - 140px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
    background: rgb(12, 25, 40);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 2px solid rgb(95, 210, 230);
    border-radius: 20px;
    box-shadow:
      0 0 60px rgba(95, 210, 230, 0.5),
