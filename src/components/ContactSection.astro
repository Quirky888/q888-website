---
const openTo = [
  "Exhibitions, residencies, commissions and acquisitions.",
  "Artistic collaborations, research, talks and workshops.",
  "Experimental technology, interactive narratives and digital strategy.",
  "Pilot partners, production support and backing for projects ready to move.",
];

const elsewhere = [
  { label: "Instagram @quirky_888", href: "https://instagram.com/quirky_888" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/aleksander-sestakovs-a9068442/" },
  { label: "GitHub", href: "https://github.com/Quirky888" },
  {
    label: "Working Artwork Archive",
    href: "https://periodic-snail-98e.notion.site/318afef9a7c2805a8d53e46fca38e092?v=319afef9a7c2800d83ab000c2ac68015",
  },
];
---

<section id="contact" data-section="contact" class="contact qd-wrap">
  <p class="qd-mono">Contact &amp; collaboration</p>
  <h2>The shore <em>after</em> chaos.</h2>

  <a href="mailto:hello@q888.space" class="contact-mail">hello@q888.space</a>

  <div class="contact-columns">
    <div>
      <h3 class="qd-mono">Open to</h3>
      <ul>
        {openTo.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="qd-mono">Capacity</h3>
      <p>
        Unexpected directions are welcome too. Current capacity is limited,
        so each possibility begins with a conversation about scale, timing and
        what can realistically be made together.
      </p>
    </div>

    <div>
      <h3 class="qd-mono">Elsewhere</h3>
      <ul>
        {elsewhere.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
      <!-- DNA: the only telemetry left is a human one: what time it is where the work is made. -->
      <p class="contact-clock qd-mono">Edinburgh, right now · <span data-door-clock>--:--</span></p>
    </div>
  </div>

  <footer class="contact-foot">
    <p class="qd-mono">
      © Alexander Sestakovs / Q888. All rights reserved. Artwork may not be reproduced, commercially used, modified, or used for AI training without permission, except where permitted by law.
    </p>
    <div class="contact-legal">
      <a href="/privacy/" class="qd-mono">Digital Ink Privacy</a>
      <a href="/copyright/" class="qd-mono">Copyright, Licensing &amp; Ethical Use</a>
    </div>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    padding-block: clamp(5rem, 12vw, 11rem) 3rem;
    font-family: var(--font-door-display);
    color: var(--text-ink);
    background: var(--bg-fog);
    border-top: 1px solid var(--line-soft);
  }

  .contact > .qd-mono {
    margin: 0 0 1rem;
  }

  .contact h2 {
    margin: 0;
    font-family: var(--font-door-serif);
    font-size: clamp(3.25rem, 10.5vw, 11.875rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .contact h2 em {
    color: var(--door-gold);
  }

  .contact-mail {
    display: inline-block;
    margin-top: clamp(1.75rem, 5vw, 4rem);
    font-size: clamp(1.6rem, 5vw, 4.75rem);
    font-weight: 600;
    font-variation-settings: "wdth" 85;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid var(--door-gold);
    transition: color 300ms ease;
  }

  .contact-mail:hover {
    color: var(--door-gold);
  }

  .contact-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .contact-columns h3 {
    margin: 0 0 0.6rem;
    font-weight: 400;
  }

  .contact-columns ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-columns p {
    max-width: 26em;
    margin: 0;
  }

  .contact-columns a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line-soft);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 300ms ease;
  }

  .contact-columns a:hover {
    text-decoration-color: var(--door-gold);
  }

  .contact a:focus-visible {
    outline: 2px solid var(--door-gold);
    outline-offset: 3px;
  }

  .contact-columns .contact-clock {
    margin-top: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .contact-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .contact-foot p {
    max-width: 42rem;
    margin: 0;
    font-size: 0.625rem;
  }

  .contact-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .contact-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.6875rem;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .contact-legal a:hover {
    color: var(--text-ink);
  }

  @media (min-width: 760px) {
    .contact-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact a {
      transition: none;
    }
  }
</style>
