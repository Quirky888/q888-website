---

<section 
  id="contact" 
  data-section="contact" 
  class="relative min-h-screen py-32 px-6 md:px-12 lg:px-24 bg-[var(--bg-cosmic)] border-t border-[var(--line-silver)] flex flex-col justify-between"
>
  <div class="max-w-6xl mx-auto w-full">
    <!-- Header Block -->
    <header class="mb-24">
      <h2 class="text-[3rem] md:text-[5rem] font-light tracking-tight leading-none mb-4 text-[var(--text-silver)]">
        CONTACT & COLLABORATION
      </h2>
      <p class="text-[var(--text-silver-muted)] text-sm md:text-base max-w-xl">
        The shore after chaos.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-32">
      <!-- Open To List -->
      <div>
        <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--text-silver-muted)] mb-8">
          // WHAT_I_AM_OPEN_TO
        </h3>
        <ul class="space-y-4 text-[var(--text-silver)] font-light">
          <li class="flex items-start gap-4">
            <span class="opacity-30">•</span>
            <span>Identity system design and digital strategy.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="opacity-30">•</span>
            <span>Speculative technology research and development.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="opacity-30">•</span>
            <span>Interactive narratives and experimental web.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="opacity-30">•</span>
            <span>Artifact curation and branding for the strange.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="opacity-30">•</span>
            <span>Consulting for systems in transition.</span>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-12">
        <div>
          <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--text-silver-muted)] mb-8">
            // COMMUNICATION_CHANNELS
          </h3>
          <div class="space-y-6">
            <a 
              href="mailto:hello@q888.space" 
              class="block text-2xl md:text-3xl text-[var(--text-silver)] hover:text-white transition-colors border-b border-transparent hover:border-[var(--text-silver)] w-fit"
            >
              hello@q888.space
            </a>
            
            <div class="flex gap-8 text-[var(--text-silver)] text-sm">
              <a href="https://instagram.com/quirky_888" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram @quirky_888</a>
              <a href="https://www.linkedin.com/in/aleksander-sestakovs-a9068442/" target="_blank" rel="noopener" class="hover:text-white transition-colors">LinkedIn</a>
              <a href="https://github.com/Quirky888" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a>
            </div>
            <a
              href="https://periodic-snail-98e.notion.site/318afef9a7c2805a8d53e46fca38e092?v=319afef9a7c2800d83ab000c2ac68015"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 block text-lg w-fit bg-gradient-to-r from-gray-400 via-gray-100 to-gray-500 bg-clip-text text-transparent font-bold tracking-wide transition-all duration-300 hover:scale-105 hover:from-white hover:via-gray-200 hover:to-white"
            >
              ✦ View My Art Portfolio ✦
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="max-w-6xl mx-auto w-full mt-24 flex flex-wrap items-end justify-between gap-6">
    <p class="max-w-2xl font-mono text-[9px] leading-relaxed tracking-[0.08em] uppercase text-[var(--text-silver-muted)]">
      © Aleksandrs Sestakovs / Q888. All rights reserved. Artwork may not be reproduced, commercially used, modified, or used for AI training without permission, except where permitted by law.
    </p>
    <div class="flex flex-wrap justify-end gap-6">
      <a
        href="/privacy/"
        class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--text-silver-muted)] hover:text-[var(--text-silver)] transition-colors w-fit"
      >
        Digital Ink Privacy
      </a>
      <a
        href="/copyright/"
        class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--text-silver-muted)] hover:text-[var(--text-silver)] transition-colors w-fit"
      >
        Copyright, Licensing &amp; Ethical Use
      </a>
    </div>
  </footer>
</section>
