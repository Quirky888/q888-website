---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const navLinks = [
  { label: "Projects", href: "/#projects" },
  { label: "Digital Ink", href: "/digital-ink" },
  { label: "Map", href: "/edinburgh-map" },
  { label: "Infocigan", href: "/infocigan" },
  { label: "Contact", href: "/contact" },
];
---

<nav class:list={["top-nav", className]}>
  <div class="nav-inner">
    <a href="/" class="wordmark">Q888</a>
    
    <button 
      class="mobile-toggle" 
      aria-label="Toggle navigation"
      aria-expanded="false"
      type="button"
    >
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>
    
    <div class="nav-links" data-nav-links>
      <a href="/#projects" class="nav-link">Projects</a>
      <a href="/digital-ink" class="nav-link">Digital Ink</a>
      <a href="/edinburgh-map" class="nav-link">Map</a>
      <a href="/infocigan" class="nav-link">Infocigan</a>
      <a href="/contact" class="nav-link">Contact</a>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const toggle = document.querySelector('.mobile-toggle');
    const links = document.querySelector('[data-nav-links]');
    if (!toggle || !links || links.hasAttribute('data-top-nav-initialized')) return;
    links.setAttribute('data-top-nav-initialized', 'true');
    
    const toggleMenu = (e?: Event) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      console.log('[TopNav] Toggle menu:', expanded ? 'closing' : 'opening');
      toggle.setAttribute('aria-expanded', String(!expanded));
      links.classList.toggle('open');
    };

    toggle.addEventListener('click', toggleMenu);
    toggle.addEventListener('touchend', (e) => {
      e.preventDefault();
      toggleMenu();
    }, { passive: false });

    links.querySelectorAll('a').forEach((link, index) => {
      const closeMenu = () => {
        console.log('[TopNav] Link clicked/touched:', (link as HTMLAnchorElement).href);
        toggle.setAttribute('aria-expanded', 'false');
        links.classList.remove('open');
        (link as HTMLElement).classList.remove('touch-active');
      };
      
      link.addEventListener('click', closeMenu);
      
      link.addEventListener('touchstart', () => {
        (link as HTMLElement).classList.add('touch-active');
      }, { passive: true });
      
      link.addEventListener('touchend', (e) => {
        e.preventDefault();
        closeMenu();
      }, { passive: false });
    });
  }
  
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999999;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .top-nav {
      background: rgba(245, 245, 245, 0.95);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  .nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .nav-inner {
      padding: 1rem 2rem;
    }
  }

  .wordmark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-ink);
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .wordmark:hover {
    color: var(--text-muted);
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .toggle-bar {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--text-ink);
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
    padding: 1rem;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-links.open {
    display: flex;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      position: static;
      flex-direction: row;
      gap: 1.5rem;
      padding: 0;
      border: none;
      background: transparent;
    }
  }

  .nav-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    position: relative;
    z-index: 1;
    transition: color 120ms ease, opacity 120ms ease, background 120ms ease;
  }

  .nav-link:hover {
    color: var(--text-ink);
  }

  .nav-link:active,
  .nav-link.touch-active {
    color: var(--text-ink);
    opacity: 0.7;
  }

  @media (hover: none) and (pointer: coarse) {
    .nav-link:active,
    .nav-link.touch-active {
      background: rgba(0, 0, 0, 0.05);
      padding: 0.25rem 0.5rem;
      margin: -0.25rem -0.5rem;
      border-radius: 4px;
    }
  }
</style>
