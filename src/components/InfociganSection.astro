---
import { getCollection } from "astro:content";
import InfociganMarketWire, {
  type MarketWireProject,
} from "./InfociganMarketWire.astro";
import InfociganArtifactExchange, {
  type ArtifactExchangeProject,
} from "./InfociganArtifactExchange.astro";

const urlMap: Record<string, string> = {
  "overpriced-stickers": "/overpriced/",
  "q-bag": "/qbag/",
  "nar-mail-express": "/narmail/",
  "afterlife-contracts": "/afterlife/",
  "president-of-the-galaxy": "/president/",
  "dyno-milk": "/dyno/",
  "aero-sticker": "/aero/",
};

const zones: ArtifactExchangeProject[] = (await getCollection("projects"))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map(({ data }) => ({
    slug: data.slug,
    title: data.cardTitle,
    descriptor: data.cardDescriptor,
    system: data.cardSystem,
    image: data.cardImage,
    imageMobile: data.cardImageMobile,
    holographic: data.cardHolographic,
    format: data.cardFormat,
    href: urlMap[data.slug] || `/${data.slug}/`,
  }));

const marketWireProjects: MarketWireProject[] = zones.map((zone) => ({
  slug: zone.slug,
  title: zone.title,
  descriptor: zone.descriptor,
  system: zone.system,
  href: urlMap[zone.slug] || `/${zone.slug}/`,
}));
---

<!-- Q888:SECTION_START id="INFOCIGAN" -->
<section 
  id="infocigan" 
  data-section="infocigan" 
  class="w-full min-h-screen relative mt-14 md:mt-20 border-t md:border-t-0 border-[var(--line-soft)] bg-[var(--bg-fog)] overflow-hidden flex flex-col"
>
  <!-- CHOICE: The same editorial skeleton as the portfolio introduction, wearing Infocigan gold. -->
  <div class="infocigan-hero">
    <p class="infocigan-kicker">Infocigan · Speculative marketplace · Value optional</p>

    <h2 class="infocigan-title gold-shine" data-viewport-animation>INFOCIGAN</h2>

    <div class="infocigan-intro-copy">
      <p class="infocigan-declaration">
        A speculative marketplace for objects, belief, and optional nonsense.
      </p>

      <div class="infocigan-market-notes" aria-label="Infocigan market conditions">
        <span>Market state: unstable</span>
        <span>Value logic: symbolic</span>
        <span>Trust level: optional</span>
      </div>
    </div>

    <img
      src="/images/InfoCigan_%20success.webp"
      alt=""
      class="infocigan-hero-image"
      loading="lazy"
      decoding="async"
      width="440"
      height="550"
    />
  </div>

  <!-- Q888:SECTION_START id="INFOCIGAN_ABOUT" -->
  <article class="infocigan-about" aria-labelledby="infocigan-about-title">
    <header class="infocigan-about-heading" data-motion-reveal>
      <p>Orientation note · Read before trading</p>
      <h3 id="infocigan-about-title">What is Infocigan?</h3>
    </header>

    <div class="infocigan-about-story" data-motion-reveal>
      <p class="infocigan-about-lead">
        Infocigan is not just a project — it’s a playful philosophy, a portal,
        and a system-aware art experiment where imagination, absurdity, and
        speculative value quietly intersect.
      </p>
      <p>
        Some say it began as a sticker. Others say it began long before that,
        when someone accidentally paid too much for something... and liked the
        feeling.
      </p>
      <div class="infocigan-possibilities">
        <p>It might be a joke.</p>
        <p>It might be a serious financial model from an alternate dimension.</p>
        <p>
          It might be a long-term investment into a human–mushroom–AE hybrid
          whose future potential is... hard to value using conventional metrics.
        </p>
      </div>
      <p>Either way — Infocigan has a vibe. And it sticks.</p>
    </div>

    <div class="infocigan-about-panels" data-motion-stagger data-motion-children="[data-motion-item]">
      <section data-motion-item>
        <h4>An evolving constellation</h4>
        <p>
          At its core, Infocigan connects collectible stickers, reusable coffee
          bags, future folklore, holographic political campaigns, afterlife
          contracts, infinite-water rituals, and smart pixels carrying whispered
          stories.
        </p>
        <p>
          It’s not rebellion — it’s a reframing of value, sentiment, ownership,
          and the joy of having something nobody else understands yet.
        </p>
      </section>

      <section class="infocigan-value-panel" data-motion-item>
        <h4>Value logic</h4>
        <p>Here, “Overpriced” isn’t a mistake — it’s a mirror.</p>
        <strong class="infocigan-gold-statement gold-shine" data-viewport-animation>
          “Over price” means above currency.
        </strong>
        <p>
          What is value really worth—and why shouldn’t an object outlive the
          currency, artist, or planet that first tried to price it?
        </p>
      </section>

      <section data-motion-item>
        <h4>Artifact layers</h4>
        <ul class="infocigan-artifact-list">
          <li><span>/</span> Some unlock maps.</li>
          <li><span>/</span> Some confuse corrupt inspectors.</li>
          <li><span>/</span> Some whisper at 3am.</li>
          <li><span>/</span> Some turn coffee rituals into collector quests.</li>
          <li>
            <span>/</span> Some hold sentimental value that no money in this
            galaxy can buy.
          </li>
        </ul>
      </section>
    </div>

    <section class="infocigan-definition" data-motion-reveal>
      <h4>Think of Infocigan as:</h4>
      <ul>
        <li><span>✦</span> A trading zone between realities.</li>
        <li><span>✦</span> A long joke that accidentally becomes a cultural artifact.</li>
        <li>
          <span>✦</span> A quiet investment in Q888—future President of the Galaxy,
          storyteller of Square Bubbles, and architect of emotional commerce.
        </li>
      </ul>
    </section>
  </article>
  <!-- Q888:SECTION_END id="INFOCIGAN_ABOUT" -->

  <InfociganMarketWire projects={marketWireProjects} />

  <InfociganArtifactExchange projects={zones} />

  <!-- Full-Width Bold Closing Statement Footer -->
  <footer class="w-full bg-[var(--bg-fog)] py-16 px-6 md:px-24 border-t border-[var(--line-soft)] relative z-20">
    <div class="gold-shine not-italic font-mono text-base md:text-3xl font-bold uppercase tracking-[0.1em] flex flex-col gap-4 md:gap-6" data-viewport-animation>
      <p class="leading-tight text-left">Remember: Everything here is 100% real… in at least one dimension.</p>
      <p class="leading-tight text-right">Follow the myth. Support the movement. Protect your coffee machine.</p>
    </div>
  </footer>

</section>
<!-- Q888:SECTION_END id="INFOCIGAN" -->

<style>
  .infocigan-hero {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(17rem, 0.78fr) minmax(19rem, 1fr);
    column-gap: clamp(3rem, 9vw, 9rem);
    row-gap: 1.25rem;
    align-items: start;
    width: 100%;
    min-height: 30rem;
    padding: 6rem 6rem 7rem;
    overflow: visible;
    color: var(--text-ink);
    background: var(--bg-fog);
    border-bottom: 1px solid var(--line-soft);
  }

  .infocigan-kicker {
    grid-column: 1 / -1;
    margin: 0 0 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: #a67c00;
  }

  .infocigan-title {
    margin: 0;
    max-width: 9ch;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: 650;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .infocigan-intro-copy {
    position: relative;
    z-index: 2;
    max-width: 35rem;
    padding-right: clamp(7rem, 12vw, 11rem);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .infocigan-declaration {
    margin: 0;
    font-size: clamp(1rem, 1.55vw, 1.22rem);
    font-weight: 360;
    line-height: 1.62;
  }

  .infocigan-market-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
    color: #a67c00;
  }

  .infocigan-market-notes span:not(:last-child)::after {
    content: " /";
    color: var(--text-muted);
  }

  .infocigan-hero-image {
    position: absolute;
    right: clamp(1.5rem, 4vw, 6rem);
    bottom: 0;
    z-index: 1;
    display: block;
    width: clamp(13rem, 25vw, 25rem);
    height: auto;
    object-fit: contain;
    pointer-events: none;
    transform: translateY(24%);
    filter: saturate(1.04);
  }

  .infocigan-about {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(20rem, 1fr);
    gap: clamp(3rem, 9vw, 9rem);
    padding: clamp(5rem, 9vw, 9rem) clamp(1.5rem, 6vw, 6rem);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--text-ink);
    background: var(--bg-fog);
  }

  .infocigan-about-heading {
    align-self: start;
  }

  .infocigan-about-heading > p,
  .infocigan-about h4 {
    margin: 0;
    color: #a67c00;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.66rem;
    font-weight: 540;
    letter-spacing: 0.14em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .infocigan-about-heading > p {
    margin-bottom: 1.3rem;
  }

  .infocigan-about h3 {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3.2rem, 6.3vw, 6.5rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .infocigan-about-story {
    display: grid;
    gap: 1.55rem;
    max-width: 48rem;
    font-size: clamp(1rem, 1.55vw, 1.24rem);
    font-weight: 360;
    line-height: 1.62;
  }

  .infocigan-about-story p {
    margin: 0;
  }

  .infocigan-about-lead {
    font-size: clamp(1.2rem, 2.1vw, 1.75rem);
    font-weight: 570;
    letter-spacing: -0.025em;
    line-height: 1.45;
  }

  .infocigan-possibilities {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.2rem;
    color: var(--text-muted);
    border-left: 1px solid #a67c00;
    font-style: italic;
  }

  .infocigan-about-panels {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(1rem, 3vw, 3rem);
    border-top: 1px solid var(--text-ink);
    border-bottom: 1px solid var(--text-ink);
  }

  .infocigan-about-panels > section {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .infocigan-about-panels > section + section {
    border-left: 1px solid var(--line-soft);
  }

  .infocigan-about-panels p {
    margin: 1.15rem 0 0;
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.62;
  }

  .infocigan-value-panel {
    background: rgba(255, 255, 255, 0.32);
  }

  .infocigan-artifact-list {
    display: grid;
    gap: 0.72rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    letter-spacing: -0.01em;
    line-height: 1.55;
  }

  .infocigan-artifact-list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.55rem;
  }

  .infocigan-artifact-list span,
  .infocigan-definition li > span {
    color: #a67c00;
  }

  .infocigan-gold-statement {
    display: block;
    margin: 1.2rem 0 1.4rem;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: clamp(1.6rem, 2.75vw, 2.9rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .infocigan-definition {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(12rem, 0.38fr) 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 4rem);
  }

  .infocigan-definition ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .infocigan-definition li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.6rem;
    font-size: clamp(0.96rem, 1.2vw, 1.08rem);
    line-height: 1.55;
  }

  .gold-shine {
    color: #a67c00;
    background: linear-gradient(
      to right, 
      #a67c00 20%, 
      #ce9e00 40%, 
      #ffcc33 50%, 
      #ce9e00 60%, 
      #a67c00 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  /* The header and explanation collapse independently, avoiding the previous class collision. */
  @media (max-width: 900px) {
    .infocigan-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 4rem 1.5rem;
      row-gap: 1.75rem;
    }

    .infocigan-kicker,
    .infocigan-title,
    .infocigan-intro-copy {
      grid-column: 1;
    }

    .infocigan-kicker {
      margin-bottom: 0;
    }

    .infocigan-title {
      font-size: clamp(3.2rem, 16vw, 4.5rem);
    }

    .infocigan-intro-copy {
      max-width: 32rem;
      padding-right: 0;
    }

    .infocigan-market-notes,
    .infocigan-hero-image {
      display: none;
    }

    .infocigan-about {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .infocigan-about-panels,
    .infocigan-definition ul {
      grid-template-columns: 1fr;
    }

    .infocigan-about-panels > section + section {
      border-top: 1px solid var(--line-soft);
      border-left: 0;
    }

    .infocigan-definition {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gold-shine {
      animation: none;
    }
  }
</style>
