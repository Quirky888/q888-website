---
import SystemMeta from "./SystemMeta.astro";
import SlimNav from "./SlimNav.astro";
import SubPageNav from "./SubPageNav.astro";
import LandingHero from "./LandingHero.astro";
import ProjectsThreshold from "./ProjectsThreshold.astro";
import ProjectDrawer from "./ProjectDrawer.astro";
import InfociganSection from "./InfociganSection.astro";
import ContactSection from "./ContactSection.astro";

interface Props {
  projectToOpen?: "digital-ink" | "edinburgh-map";
}

const { projectToOpen } = Astro.props;
---

{projectToOpen && <SubPageNav />}
<div class={projectToOpen ? "hidden md:block" : ""}>
  <SlimNav />
</div>
<SystemMeta position="top" />

<main class="relative min-h-[100dvh] overflow-x-hidden pt-10 md:pt-11" data-open-project={projectToOpen}>
  <section id="landing" data-section="landing" class="relative -mt-10 md:-mt-11">
    <LandingHero />
  </section>

  <section id="projects" data-section="projects">
    <ProjectsThreshold />
  </section>

  <InfociganSection />

  <ContactSection />
</main>

<div class="hidden md:block">
  <SystemMeta position="bottom" />
</div>
<ProjectDrawer />

<script>
  import { initThresholdMotion } from "../scripts/thresholdMotion";
  import { initProjectDrawer, destroyProjectDrawer, openDrawer } from "../scripts/drawerNav";
  import { initSystemMetaState, destroySystemMetaState } from "../scripts/systemMetaState";
  import { initIpGeoCoords } from "../scripts/ipGeoCoords";
  import { initNavScroll, destroyNavScroll } from "../scripts/navScroll";
  import { initRevealMotion, destroyRevealMotion } from "../scripts/revealMotion";

  let didInit = false;
  let didBindLifecycle = false;

  function init() {
    if (didInit) return;

    initNavScroll();
    initSystemMetaState();
    initIpGeoCoords();
    initThresholdMotion();
    initProjectDrawer();
    initRevealMotion();

    didInit = true;

    const projectToOpen = document.querySelector("main")?.getAttribute("data-open-project");
    if (projectToOpen && !window.location.hash) {
      const scrollAndOpen = async () => {
        const target = document.getElementById("projects");
        if (target) {
          target.scrollIntoView({ behavior: "instant" });
          // double check scroll after a tiny frame jump to fight browser scroll restoration
          requestAnimationFrame(() => {
             target.scrollIntoView({ behavior: "instant" });
          });
        }
        
        requestAnimationFrame(async () => {
          if (projectToOpen === "edinburgh-map") await openDrawer("edinburgh-map", "right", false);
          else if (projectToOpen === "digital-ink") await openDrawer("digital-ink", "left", false);
        });
      };

      // If we're already initialized or it's a quick navigation, we might need a tiny delay
      // to let the browser finish its initial scroll handling.
      if (document.readyState === "complete") {
        scrollAndOpen();
      } else {
        window.addEventListener("load", scrollAndOpen, { once: true });
      }
    }
  }

  function cleanup() {
    if (!didInit) return;

    destroyNavScroll();
    destroySystemMetaState();
    destroyProjectDrawer();
    destroyRevealMotion();
    import("../scripts/edinburghMap").then((m) => m.destroyEdinburghMap()).catch(() => {});

    didInit = false;
  }

  if (!didBindLifecycle) {
    if (document.readyState !== "loading") {
      init();
    } else {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    }

    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", cleanup);
    window.addEventListener("beforeunload", cleanup);
    didBindLifecycle = true;
  }
</script>
