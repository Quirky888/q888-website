---
interface Props {
  position: "top" | "bottom";
}

const { position } = Astro.props;

const metaItems = [
  { field: "system_status", label: "SYSTEM_STATUS", value: "QUIET", width: 9 },
  { field: "oracle_mode", label: "ORACLE_MODE", value: "ENGAGED", width: 7 },
  { field: "whisper_protocol", label: "WHISPER_PROTOCOL", value: "ACTIVE", width: 8 },
  { field: "coords", label: "COORDS", value: "55.9439712N 3.1621543W", width: 22 },
];
---

<div 
  class:list={[
    "system-meta fixed inset-x-0 font-mono text-xs tracking-wide uppercase text-neutral-400 select-none px-4 py-3 md:px-8 md:py-4 z-50",
    position === "top" ? "top-0" : "bottom-0"
  ]}
  data-system-meta={position}
>
  <div class="mx-auto w-full max-w-6xl min-w-0 grid grid-cols-2 gap-x-4 gap-y-2 md:flex md:items-center md:justify-between md:gap-x-6 md:gap-y-0">
    {metaItems.map((item) => (
      <div class="system-meta-item flex min-w-0 gap-2 whitespace-nowrap">
        <span class="shrink-0 opacity-50">{item.label}:</span>
        <hotfx-split-flap class="meta-value meta-value-split-flap" data-field={item.field} width={item.width}>{item.value}</hotfx-split-flap>
      </div>
    ))}
  </div>
</div>

<style>
  .meta-value {
    transition: opacity 180ms ease-out;
  }
  
  .meta-value.is-changing {
    opacity: 0.6;
  }

  .system-meta hotfx-split-flap.meta-value-split-flap {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .system-meta hotfx-split-flap.meta-value-split-flap::part(flap) {
    color: var(--text-muted);
    background: transparent;
  }

  .system-meta hotfx-split-flap.meta-value-split-flap::part(char) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .system-meta hotfx-split-flap.meta-value-split-flap::part(divider) {
    background: var(--text-muted);
    opacity: 0.25;
  }
</style>
