---
/**
 * InkPixels — a thin row of Ink-coloured squares between chapters.
 * The squares arrive one by one when the row scrolls into view. Purely decorative.
 */
interface Props {
  seed?: number;
}

const { seed = 7 } = Astro.props;
const colours = ["#8f8d88", "#a6a39b", "#6f6d68", "#b9b6ae", "#6b705a", "#7e8466", "#b99a45", "#6f7f96", "#5f7a52", "#b44a45", "#9b4f7e"];
let state = seed * 9301 + 49297;
const squares = Array.from({ length: 28 }, (_, index) => {
  state = (state * 1664525 + 1013904223) % 4294967296;
  const roll = state / 4294967296;
  return {
    colour: colours[Math.floor(roll * colours.length)],
    delay: Math.round((index / 28) * 700 + roll * 350),
    empty: roll > 0.7,
  };
});
---

<div class="ink-pixels" data-pixels aria-hidden="true">
  <div class="ink-pixels-wrap">
    <div class="ink-pixels-row">
      {squares.map((square) => (
        <i class:list={[square.empty && "is-empty"]} style={`--c:${square.colour};--d:${square.delay}ms`}></i>
      ))}
    </div>
  </div>
</div>

<style>
  .ink-pixels {
    padding-block: clamp(1rem, 3vw, 2rem);
  }
  .ink-pixels-wrap {
    inline-size: 100%;
    max-inline-size: 1180px;
    margin-inline: auto;
    padding-inline: max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-left)) max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-right));
  }
  .ink-pixels-row {
    display: grid;
    grid-template-columns: repeat(28, minmax(0, 22px));
    justify-content: space-between;
    gap: 6px;
  }
  .ink-pixels i {
    display: block;
    aspect-ratio: 1;
    background: var(--c);
    opacity: 0.85;
  }
  .ink-pixels i.is-empty {
    background: none;
    border: 1px solid rgba(241, 236, 227, 0.2);
    opacity: 1;
  }
  @media (max-width: 640px) {
    .ink-pixels-row {
      grid-template-columns: repeat(14, minmax(0, 22px));
    }
    .ink-pixels i:nth-child(n + 15) {
      display: none;
    }
  }
  /* Only hidden when JS can reveal them again. */
  :global(html.ink-js) .ink-pixels i {
    opacity: 0;
    transform: scale(0.35);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: var(--d);
  }
  :global(html.ink-js) .ink-pixels.is-in i {
    opacity: 0.85;
    transform: none;
  }
  :global(html.ink-js) .ink-pixels.is-in i.is-empty {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.ink-js) .ink-pixels i {
      opacity: 0.85;
      transform: none;
      transition: none;
    }
    :global(html.ink-js) .ink-pixels i.is-empty {
      opacity: 1;
    }
  }
</style>
