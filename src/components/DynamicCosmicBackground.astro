---
const DEEP_SPACE = "7, 19, 35";
const TEAL = "45, 140, 155";
const CYAN = "95, 210, 230";
const ICE_BLUE = "180, 235, 245";
const GOLD = "200, 165, 105";

const variants = [
  { a: TEAL, b: CYAN, c: ICE_BLUE },
  { a: CYAN, b: ICE_BLUE, c: GOLD },
  { a: DEEP_SPACE, b: TEAL, c: CYAN },
  { a: ICE_BLUE, b: GOLD, c: TEAL },
  { a: TEAL, b: GOLD, c: CYAN },
  { a: CYAN, b: TEAL, c: ICE_BLUE },
];
const total = 10;     // Desktop count
const totalMobile = 3; // Mobile: render only 3 in HTML, not just hiding via CSS
---

<div class="dynamic-cosmic-bg" aria-hidden="true">
  <!--
    Desktop: 10 rainbow elements for richness.
    Mobile: only 3 rendered in HTML (not just hidden via CSS) to keep DOM small.
    The ".mobile-only" / ".desktop-only" classes are toggled via CSS below.
  -->
  <div class="rainbow-container">
    {Array.from({ length: total }, (_, i) => {
      const v = variants[i % variants.length];
      const delay = (i * 1.8) % 45;
      const driftDelay = ((i * 0.9) % 18).toFixed(2);
      return (
        <div
          class={`rainbow rainbow-${i}${i >= totalMobile ? ' desktop-rainbow' : ''}`}
          style={`animation-delay: -${delay}s, -${driftDelay}s; --a: ${v.a}; --b: ${v.b}; --c: ${v.c};`}
        />
      );
    })}
  </div>
  <div class="v v-left"></div>
  <div class="v v-right"></div>
  <div class="h h-bottom"></div>
  <div class="h h-top"></div>
  <div class="cosmic-gradient"></div>
</div>

<style>
  .dynamic-cosmic-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: rgb(20, 35, 50);
    will-change: transform;
    /* Skip compositing when the portal panel is off-screen */
    content-visibility: auto;
  }

  .rainbow {
    height: 100dvh;
    width: 1px; /* Minimal width */
    position: absolute;
    transform: rotate(10deg);
    transform-origin: top right;
    top: 0;
    right: -25vw;
    box-shadow:
      -150px 0 100px 60px rgba(7, 19, 35, 0.4),
      -70px 0 70px 40px rgba(var(--a), 0.35),
      -20px 0 60px 35px rgba(var(--b), 0.4),
      20px 0 60px 35px rgba(var(--b), 0.4),
      70px 0 70px 40px rgba(var(--c), 0.35),
      150px 0 100px 60px rgba(95, 210, 230, 0.15);
    animation: cosmic-slide 45s linear infinite, cosmic-drift 16s ease-in-out infinite;
    will-change: transform;
  }

  @media (max-width: 768px) {
    /* Hide extra desktop elements — only 3 are rendered on mobile (see .desktop-rainbow) */
    .desktop-rainbow {
      display: none;
    }

    .rainbow {
      /* Simplify shadow stack for mobile performance */
      box-shadow:
        -50px 0 50px 30px rgba(var(--a), 0.25),
        20px 0 40px 20px rgba(var(--b), 0.3);
      /* Disable drift animation and will-change on mobile to avoid extra compositor layers */
      animation: cosmic-slide 45s linear infinite;
      will-change: auto;
    }
  }

  @keyframes cosmic-slide {
    from { right: -25vw; }
    to { right: 125vw; }
  }

  @keyframes cosmic-drift {
    0%, 100% { transform: rotate(10deg) translateY(0); }
    50% { transform: rotate(10deg) translateY(-2.5dvh); }
  }

  .h {
    position: absolute;
    width: 100%;
    height: 0;
    pointer-events: none;
    box-shadow: 0 0 60dvh 50dvh rgba(45, 140, 155, 0.1);
  }

  .h-top { top: 0; }
  .h-bottom { bottom: 0; }

  .v {
    position: absolute;
    width: 0;
    height: 100dvh;
    bottom: 0;
    pointer-events: none;
    box-shadow: 0 0 40vw 30vw rgba(15, 35, 55, 0.15);
  }

  .v-left { left: 0; }
  .v-right { right: 0; left: auto; }

  .cosmic-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at top center,
      rgba(20, 35, 50, 0.85) 0%,
      rgba(15, 35, 55, 0.6) 50%,
      rgba(7, 19, 35, 0.9) 100%
    );
    animation: cosmic-gradient-drift 22s ease-in-out infinite;
    will-change: transform;
  }

  @media (max-width: 768px) {
    /* Disable the gradient drift animation on mobile — saves a compositor layer */
    .cosmic-gradient {
      animation: none;
      will-change: auto;
    }
  }

  @keyframes cosmic-gradient-drift {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, -1.2dvh, 0) scale(1.01); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rainbow {
      animation: none;
      opacity: 0.2;
    }

    .cosmic-gradient {
      animation: none;
    }
  }
</style>
