<script>
  type DigitalInkWindow = Window & {
    __digitalInkStudyAbort?: AbortController;
    __digitalInkRecordAbort?: AbortController;
    __digitalInkVideoAbort?: AbortController;
    __digitalInkVideoPaused?: boolean;
  };

  function initHeroFilm() {
    const video = document.querySelector<HTMLVideoElement>("[data-ink-hero-video]");
    const tools = document.querySelector<HTMLElement>("[data-ink-film-tools]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-ink-film-toggle]");
    const hero = document.querySelector<HTMLElement>(".ink-hero");
    if (!video || !tools || !toggle || !hero) return;

    const pageWindow = window as DigitalInkWindow;
    pageWindow.__digitalInkVideoAbort?.abort();
    const controller = new AbortController();
    pageWindow.__digitalInkVideoAbort = controller;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let inView = true;
    video.playbackRate = 0.7;

    const syncPlayback = () => {
      const canAnimate = window.innerWidth > 600 && !reducedMotion.matches;
      const pausedByVisitor = Boolean(pageWindow.__digitalInkVideoPaused);
      tools.hidden = !canAnimate;
      toggle.textContent = pausedByVisitor ? "Resume background" : "Pause background";

      if (canAnimate && inView && !pausedByVisitor) {
        if (!video.getAttribute("src") && video.dataset.src) {
          video.src = video.dataset.src;
          video.load();
        }
        void video.play().catch(() => undefined);
      } else {
        video.pause();
        if (!canAnimate && video.hasAttribute("src")) {
          video.removeAttribute("src");
          video.load();
        }
      }
    };

    // CHOICE: keep the film as atmosphere, with an explicit pause and a static mobile/reduced-motion surface.
    toggle.addEventListener("click", () => {
      pageWindow.__digitalInkVideoPaused = !pageWindow.__digitalInkVideoPaused;
      syncPlayback();
    }, { signal: controller.signal });
    window.addEventListener("resize", syncPlayback, { passive: true, signal: controller.signal });
    reducedMotion.addEventListener("change", syncPlayback, { signal: controller.signal });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncPlayback();
    });
    observer.observe(hero);
    controller.signal.addEventListener("abort", () => observer.disconnect(), { once: true });
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });
    syncPlayback();
  }

  function initArtStudies() {
    const studies = Array.from(
      document.querySelectorAll<HTMLElement>("[data-art-study]"),
    );
    if (studies.length === 0) return;

    const pageWindow = window as DigitalInkWindow;
    pageWindow.__digitalInkStudyAbort?.abort();
    const controller = new AbortController();
    pageWindow.__digitalInkStudyAbort = controller;

    const canvasStudy = studies.find(
      (study) => study.dataset.artStudy === "canvas",
    );
    const memoryStudy = studies.find(
      (study) => study.dataset.artStudy === "memory",
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const portraitMobile = window.matchMedia(
      "(max-width: 767px) and (orientation: portrait)",
    );
    let previousScrollY = window.scrollY;
    let memoryLatched = false;
    let ticking = false;

    const setStudyState = (
      study: HTMLElement | undefined,
      isRevealed: boolean,
    ) => {
      if (!study) return;
      study.classList.toggle("is-revealed", isRevealed);
      study
        .querySelector("[data-study-base]")
        ?.setAttribute("aria-hidden", String(isRevealed));
      study
        .querySelector("[data-study-overlay]")
        ?.setAttribute("aria-hidden", String(!isRevealed));

      const cue = study.querySelector<HTMLElement>("[data-study-cue]");
      if (cue) {
        cue.textContent = isRevealed
          ? "MEMORY IS SPEAKING"
          : (cue.dataset.resting ?? "BRING ME TO THE CENTRE ↓");
      }
    };

    const checkReveal = () => {
      if (reducedMotion.matches) {
        studies.forEach((study) => setStudyState(study, false));
        ticking = false;
        return;
      }
      const viewportCenter = window.innerHeight / 2;
      // CHOICE: a generous centre band gives the artwork enough time to surface
      // during natural reading, instead of demanding a perfectly timed scroll.
      const threshold = window.innerHeight * 0.26;
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > previousScrollY;

      if (canvasStudy) {
        const rect = canvasStudy
          .querySelector(".art-study-frame")
          ?.getBoundingClientRect();
        if (rect) {
          const distance = Math.abs(
            viewportCenter - (rect.top + rect.height / 2),
          );
          setStudyState(canvasStudy, distance < threshold);
        }
      }

      if (memoryStudy) {
        if (portraitMobile.matches) {
          memoryLatched = true;
        } else {
          const rect = memoryStudy
            .querySelector(".art-study-frame")
            ?.getBoundingClientRect();
          if (rect) {
            const center = rect.top + rect.height / 2;
            const inRevealZone = Math.abs(viewportCenter - center) < threshold;
            const aboveResetPoint = center < viewportCenter - threshold * 1.4;
            if (scrollingDown && inRevealZone) memoryLatched = true;
            else if (!scrollingDown && aboveResetPoint) memoryLatched = false;
          }
        }
        setStudyState(memoryStudy, memoryLatched);
      }

      previousScrollY = currentScrollY;
      ticking = false;
    };

    const requestRevealCheck = () => {
      if (ticking) return;
      requestAnimationFrame(checkReveal);
      ticking = true;
    };

    reducedMotion.addEventListener("change", requestRevealCheck, {
      signal: controller.signal,
    });
    window.addEventListener("scroll", requestRevealCheck, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", requestRevealCheck, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("hashchange", requestRevealCheck, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("orientationchange", requestRevealCheck, {
      passive: true,
      signal: controller.signal,
    });
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal: controller.signal,
    });
    requestRevealCheck();
    requestAnimationFrame(requestRevealCheck);
  }

  function initRecordLinks() {
    const record = document.querySelector<HTMLDetailsElement>("#technical-record");
    if (!record) return;
    const pageWindow = window as DigitalInkWindow;
    pageWindow.__digitalInkRecordAbort?.abort();
    const controller = new AbortController();
    pageWindow.__digitalInkRecordAbort = controller;
    const openHashTarget = () => {
      const hash = window.location.hash.slice(1);
      const target = hash ? document.getElementById(hash) : null;
      if (target && record.contains(target)) {
        // CHOICE: links into the closed record open it before the browser scrolls.
        record.open = true;
        target.scrollIntoView({ block: "start" });
      }
    };
    openHashTarget();
    document.querySelectorAll<HTMLAnchorElement>(".ink-page a[href^='#']").forEach((link) => {
      link.addEventListener("click", () => {
        const target = document.getElementById(link.hash.slice(1));
        if (target && record.contains(target)) record.open = true;
      }, { signal: controller.signal });
    });
    window.addEventListener("hashchange", openHashTarget, { signal: controller.signal });
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });
  }

  initHeroFilm();
  initArtStudies();
  initRecordLinks();
  document.addEventListener("astro:page-load", initHeroFilm);
  document.addEventListener("astro:page-load", initArtStudies);
  document.addEventListener("astro:page-load", initRecordLinks);
</script>
