---
const memoryLayers = [
  {
    number: "01",
    name: "Visible trace",
    text: "One representative colour: the photograph reduced to finite digital material.",
  },
  {
    number: "02",
    name: "Source trace",
    text: "An optional compressed preview, no larger than 192 pixels on its longest edge.",
  },
  {
    number: "03",
    name: "Descriptive memory",
    text: "Machine-generated language—including its uncertainty and occasional mistakes.",
  },
  {
    number: "04",
    name: "Situated memory",
    text: "Date, place, provenance and the artist’s own note, kept distinct from machine interpretation.",
  },
  {
    number: "05",
    name: "Acquired memory",
    text: "Concepts encountered through selected texts and PDFs after the ink was created.",
  },
  {
    number: "06",
    name: "Social memory",
    text: "Traceable knowledge exchanged with other inks. This remains a residency research question.",
  },
  {
    number: "07",
    name: "Invented memory",
    text: "An AI reconstruction: explicitly an invention, never presented as recovery of the source.",
  },
];

const practiceEvidence = [
  [
    "A PUBLIC ARTWORK",
    "A native SwiftUI artwork for iPad, approved by Apple and available now on the App Store.",
  ],
  [
    "A STUDIO INSTRUMENT",
    "Used and changed by the artist. Its population keeps moving, so this page does not freeze it into a misleading count.",
  ],
  [
    "FINITE MATERIAL",
    "Painting spends available ink. Erasing returns it. Every placed pixel remains connected to its origin.",
  ],
  [
    "OPEN RESEARCH",
    "Biography and education work now; social learning, exhibition replay and the 116-Pixel Archive remain active questions.",
  ],
];

const heroPixels = Array.from({ length: 24 }, (_, index) => ({
  x: (index * 47 + 11) % 100,
  y: (index * 31 + 7) % 100,
  size: 2 + (index % 4),
  delay: -((index % 9) * 0.55),
  tone: index % 7,
}));
---

<main class="ink-page">
  <section class="ink-hero" aria-labelledby="ink-title">
    <div class="ink-pixel-field" aria-hidden="true">
      {
        heroPixels.map((pixel) => (
          <i
            style={`--x:${pixel.x}%;--y:${pixel.y}%;--s:${pixel.size}px;--delay:${pixel.delay}s;--tone:${pixel.tone}`}
          />
        ))
      }
    </div>

    <div class="ink-wrap">
      <header class="ink-hero-heading">
        <p class="ink-project-name">DIGITAL INK</p>
        <p class="ink-kicker">
          A WORKING ARTWORK BY ALEKSANDRS SESTAKOVS / Q888 · NATIVE iPadOS
        </p>
        <h1 id="ink-title">EVERY PIXEL<br />CAN HAVE <span>A PAST.</span></h1>
      </header>

      <div class="ink-hero-story">
        <div class="ink-dialogue">
          <p class="human-voice">
            <b>Q888:</b> I wanted digital material to feel less disposable—and
            more like something we might care for.
          </p>
          <p class="ink-voice">
            <i aria-hidden="true"></i><span
              ><b>SMART INK:</b> I was many pixels. Now I carry what happened to me.</span>
          </p>
        </div>
        <div class="ink-hero-copy">
          <p class="ink-lede">
            A chosen image becomes a finite Smart Ink with its own colour,
            memory, biography and provenance. It can be used, educated,
            rearranged—and remembered.
          </p>
          <div class="ink-actions">
            <a
              class="ink-button ink-button-primary"
              href="https://apps.apple.com/us/app/digital-ink/id6757157376"
              target="_blank"
              rel="noopener noreferrer">Meet Digital Ink on the App Store ↗</a
            >
            <a class="ink-button" href="#how-it-lives">Follow one ink ↓</a>
          </div>
          <p class="ink-availability">
            NEW VERSION APPROVED BY APPLE · AVAILABLE NOW
          </p>
        </div>
      </div>

      <div class="ink-hero-specimen">
        <figure class="ink-device">
          <img
            src="/images/DigitalInk_Ipad_kn.webp"
            alt="Digital Ink running on an iPad, showing a finite-pixel drawing interface with two Q888 cat figures beside it"
            width="1200"
            height="800"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            THE APP IN THE ARTIST’S STUDIO · FINITE CANVAS / LIVING MATERIAL
          </figcaption>
        </figure>
        <div class="ink-specimen-note">
          <span class="ink-specimen-swatch" aria-hidden="true"></span>
          <p>
            <b>ONE SMART INK</b><br />One colour. A growing past. No infinite
            copies.
          </p>
        </div>
      </div>

      <aside class="ink-status" aria-label="Current Digital Ink status">
        <div class="ink-status-light"><span></span> AVAILABLE NOW</div>
        <p>
          <strong>The new version has been approved by Apple.</strong> Digital Ink
          is a public app and an artwork still being actively used and developed.
        </p>
        <p class="ink-status-meta">
          NATIVE iPadOS · SWIFTUI · CREATED BY ALEKSANDRS SESTAKOVS / Q888
        </p>
      </aside>
    </div>
  </section>

  <section
    class="ink-section ink-intro"
    id="how-it-lives"
    aria-labelledby="living-material-title"
  >
    <div class="ink-wrap ink-two-column">
      <div>
        <p class="ink-kicker">01 · THE EXISTING WORK</p>
        <h2 id="living-material-title">
          I wanted pixels to have consequences.
        </h2>
      </div>
      <div class="ink-prose">
        <p>
          Digital Ink is both a working native iPad app and an artwork by
          Aleksandrs Sestakovs / Q888. A photograph, artwork or screenshot
          chosen by the artist becomes a unique Smart Ink with colour, identity,
          memory and provenance.
        </p>
        <p>
          The human makes the first choice. The ink then begins a life of its
          own inside the rules of the app. Painting spends it; erasing returns
          it; learning and reconstruction change what it carries. Every placed
          pixel remains connected to where it came from.
        </p>
      </div>
    </div>

    <div
      class="ink-wrap ink-sequence"
      aria-label="Smart Ink transformation sequence"
    >
      <article>
        <span>01 · CHOOSE</span><strong>A human points to one image</strong><p>
          The app begins only with the photograph, artwork or screenshot
          deliberately invited in.
        </p>
      </article>
      <i aria-hidden="true">→</i>
      <article>
        <span>02 · COMPRESS</span><strong>The crowd becomes one</strong><p>
          Many pixels collapse into one colour, one identity and an optional
          192-pixel source trace.
        </p>
      </article>
      <i aria-hidden="true">→</i>
      <article>
        <span>03 · LIVE</span><strong>The one becomes a world</strong><p>
          Painting, learning, relationships, provenance and imperfect
          reconstruction accumulate around it.
        </p>
      </article>
    </div>
  </section>

  <section class="ink-section ink-studies" aria-labelledby="studies-title">
    <div class="ink-wrap">
      <p class="ink-kicker">02 · ARTISTIC INTERFACE STUDIES</p>
      <div class="ink-two-column studies-intro">
        <h2 id="studies-title">The interface also became a drawing surface.</h2>
        <div class="ink-prose">
          <p>
            These are authored visual records made during Digital Ink’s
            development, not neutral product screenshots. The recorded date,
            interface state and rough edges remain because development time is
            part of the work’s provenance.
          </p>
          <p>
            As each study crosses the centre of the screen, its artistic memory
            surfaces. Scroll back and the application record can return. Nothing
            is corrected when the two realities disagree.
          </p>
        </div>
      </div>
    </div>

    <div class="study-stack">
      <figure class="art-study" id="canvas-study" data-art-study="canvas">
        <div class="art-study-shell ink-wrap">
          <div class="art-study-toolbar">
            <figcaption>
              <span>STUDY 01 · CANVAS / TUE 13 JAN · 17:23</span>
              <strong>The finite canvas grows an emotional root system.</strong>
              <q>I have 174 pieces left. I am not a colour picker.</q>
            </figcaption>
            <span
              class="art-study-scroll-cue"
              data-study-cue
              data-resting="BRING ME TO THE CENTRE ↓"
              >BRING ME TO THE CENTRE ↓</span
            >
          </div>
          <div class="art-study-frame art-study-frame--canvas">
            <img
              class="art-study-base"
              data-study-base
              src="/images/screen.webp"
              alt="Digital Ink canvas interface dated Tuesday 13 January at 17:23, containing a finite pixel artwork"
              width="2422"
              height="1535"
              loading="lazy"
              decoding="async"
            />
            <img
              class="art-study-overlay"
              data-study-overlay
              aria-hidden="true"
              src="/images/screen_overlay.webp"
              alt="Artistic interpretation of the Digital Ink canvas, with hand-drawn roots, creatures and emotional ink symbols growing from the interface"
              width="2422"
              height="1535"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </figure>

      <figure
        class="art-study art-study--memory"
        id="memory-study"
        data-art-study="memory"
      >
        <div class="art-study-shell ink-wrap">
          <div class="art-study-toolbar">
            <figcaption>
              <span>STUDY 02 · PIXEL BIOGRAPHY / MEMORY RECORD</span>
              <strong
                >A pixel remembers an Afterlife Contract imperfectly.</strong
              >
              <q
                >What I remember is not what I was. It is what happened to me.</q
              >
            </figcaption>
            <span
              class="art-study-scroll-cue"
              data-study-cue
              data-resting="DESCEND THROUGH MY MEMORY ↓"
              >DESCEND THROUGH MY MEMORY ↓</span
            >
          </div>
          <div class="art-study-frame art-study-frame--memory">
            <img
              class="art-study-base"
              data-study-base
              src="/images/memory.webp"
              alt="Digital Ink Smart Ink biography showing machine description, personal memory and learned concepts"
              width="2745"
              height="1492"
              loading="lazy"
              decoding="async"
            />
            <img
              class="art-study-overlay"
              data-study-overlay
              aria-hidden="true"
              src="/images/memory_overlay.webp"
              alt="Artistic memory interpretation joining a Smart Ink biography to fragments of an Afterlife Contract and hand-drawn marks"
              width="2745"
              height="1669"
              loading="lazy"
              decoding="async"
            />
            <p class="art-study-fog" aria-hidden="true">
              I REMEMBER …<br />being many pixels…
            </p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="ink-section ink-memory" aria-labelledby="memory-title">
    <div class="ink-wrap">
      <p class="ink-kicker">03 · SEVEN FORMS OF REMEMBERING</p>
      <h2 id="memory-title">An ink does not have one memory.</h2>
      <p class="ink-section-intro">
        It carries distinct layers so source evidence, personal testimony,
        learned knowledge and machine invention do not quietly become the same
        thing.
      </p>
      <div class="memory-layout">
        <aside
          class="memory-being"
          aria-label="One Smart Ink carrying seven distinct forms of memory"
        >
          <div class="memory-being-orbit" aria-hidden="true"><i></i></div>
          <p>
            <b>ONE IMAGE, CHOSEN BY A HUMAN.</b><br />One Smart Ink, carrying
            seven different relationships to its past.
          </p>
        </aside>
        <div class="memory-grid">
          {
            memoryLayers.map((layer) => (
              <article class="memory-card">
                <span>{layer.number}</span>
                <div>
                  <>
                    <h3>{layer.name}</h3>
                    <p>{layer.text}</p>
                  </>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="ink-section ink-evidence" aria-labelledby="practice-title">
    <div class="ink-wrap">
      <p class="ink-kicker">04 · EVIDENCE OF PRACTICE</p>
      <h2 id="practice-title">The concept has a practice—not a fixed count.</h2>
      <p class="ink-section-intro">
        Digital Ink is used regularly, so its population changes. The lasting
        evidence is not yesterday’s number; it is a public app, a studio
        instrument, a finite material system and an open field of research.
      </p>
      <div class="practice-grid">
        {
          practiceEvidence.map(([title, text], index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))
        }
      </div>
      <div class="ink-two-column ink-capabilities">
        <article>
          <h3>Biography &amp; education</h3>
          <p>
            Smart Inks can hold Vision Memory, structured visual interpretation,
            personal notes, learned concepts, education level, relationships,
            provenance and generated reconstructions. Selected PDFs teach
            concepts and hashtags without turning the PDF itself into AI input.
          </p>
        </article>
        <article>
          <h3>Affinity &amp; autonomy</h3>
          <p>
            Inks can rearrange or group according to colour and stored
            information. The current system supports a general population; fully
            traceable neighbour teaching and exhibition-grade replay remain
            development work, not completed claims.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="ink-section ink-boundary" aria-labelledby="boundary-title">
    <div class="ink-wrap ink-two-column">
      <div>
        <p class="ink-kicker">05 · THE ONLINE BOUNDARY</p>
        <h2 id="boundary-title">The ink asks before it leaves the iPad.</h2>
      </div>
      <div class="boundary-cards">
        <article>
          <span>ON DEVICE</span>
          <h3>Built-in recognition</h3>
          <p>
            Apple-provided recognition can describe selected images without
            credits or an internet connection. Its interpretations may be
            limited or inaccurate.
          </p>
        </article>
        <article>
          <span>OPTIONAL · ONLINE</span>
          <h3>Assist &amp; reconstruction</h3>
          <p>
            With explicit permission, selected information travels through
            Digital Ink’s Cloudflare service to OpenAI. Online Assist costs 1
            credit; AI Memory Reconstruction costs 10. Purchasing credits is
            never treated as consent.
          </p>
        </article>
        <a class="ink-policy-link" href="/privacy/"
          >Read the complete Digital Ink Privacy Policy <b>↗</b></a
        >
      </div>
    </div>
  </section>

  <section class="ink-section archive-section" aria-labelledby="archive-title">
    <div class="archive-pixels" aria-hidden="true">
      {Array.from({ length: 116 }, (_, index) => <i style={`--i:${index}`} />)}
    </div>
    <div class="ink-wrap archive-content">
      <p class="ink-kicker">06 · FUTURE RESEARCH EDITION</p>
      <div class="archive-heading-row">
        <h2 id="archive-title">THE 116-PIXEL<br />ARCHIVE</h2>
        <span class="wip-stamp">WORK IN<br />PROGRESS</span>
      </div>
      <p class="archive-lede">
        A proposed controlled archive in which 116 photographs become 116 Smart
        Inks. They would form recorded relationships, exchange limited
        knowledge, make compositions and attempt—imperfectly—to remember what
        their archive once contained.
      </p>

      <div class="not-built">
        <strong>This edition does not yet exist.</strong>
        <p>
          Digital Ink is the working foundation. The residency process would
          discover the archive’s rules before a dedicated application is built.
        </p>
      </div>

      <ol class="archive-process">
        <li>
          <span>NOW</span><div>
            <h3>Define the archive protocol</h3><p>
              Source and consent, memory rights, affinity, exchange, forgetting,
              intervention and what the audience may see.
            </p>
          </div>
        </li>
        <li>
          <span>12</span><div>
            <h3>Run a controlled prototype</h3><p>
              Twelve photographs test whether the rules create meaningful
              differences before scale hardens them into software.
            </p>
          </div>
        </li>
        <li>
          <span>116</span><div>
            <h3>Build the dedicated edition</h3><p>
              Only after observation: a separate, controlled population with
              event history, replay, backup and exhibition-safe operation.
            </p>
          </div>
        </li>
      </ol>

      <blockquote>
        The question is not whether the machine can recover the photograph. It
        is what remains after colour, testimony, education, contamination and
        invention have each had their turn.
      </blockquote>
      <p class="future-route">
        A dedicated <code>/116</code> process page will be added when the research
        has a process to show.
      </p>
    </div>
  </section>

  <footer class="ink-footer">
    <div class="ink-wrap">
      <p>
        Every pixel remembers where it came from.<br /><span
          >Some memories remain politely unreliable.</span>
      </p>
      <nav aria-label="Digital Ink links">
        <a
          href="https://apps.apple.com/us/app/digital-ink/id6757157376"
          target="_blank"
          rel="noopener noreferrer">App Store ↗</a
        >
        <a href="/privacy/">Privacy policy</a>
        <a href="mailto:hello@q888.space">Contact</a>
      </nav>
    </div>
  </footer>
</main>

<style>
  .ink-page {
    --blue: #a9c9e7;
    --peach: #e5aa82;
    --paper: #f4f0e9;
    --muted: #b9b9b2;
    --night: #232421;
    --line: rgba(244, 240, 233, 0.18);
    background: var(--night);
    color: var(--paper);
    font-family: "Space Grotesk", system-ui, sans-serif;
    overflow: hidden;
  }
  .ink-wrap {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }
  .ink-hero {
    position: relative;
    padding: clamp(7.5rem, 10vw, 9rem) 0 5rem;
    background-color: #363733;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(rgba(0, 0, 0, 0.13) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.13) 1px, transparent 1px);
    background-size:
      32px 32px,
      32px 32px,
      160px 160px,
      160px 160px;
    isolation: isolate;
  }
  .ink-pixel-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.34;
    pointer-events: none;
  }
  .ink-pixel-field::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(54, 55, 51, 0.15),
      rgba(54, 55, 51, 0.74)
    );
  }
  .ink-pixel-field i {
    --pixel-colour: hsl(
      calc(22 + var(--tone) * 18) 36% calc(58% + var(--tone) * 2%)
    );
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * 6px);
    aspect-ratio: 1;
    background: var(--pixel-colour);
    animation: pixel-breathe 7s ease-in-out var(--delay) infinite;
  }
  .ink-pixel-field i:nth-child(3n) {
    background: #9ebbd0;
  }
  .ink-pixel-field i:nth-child(5n) {
    width: calc(var(--s) * 11px);
    opacity: 0.45;
  }
  .ink-two-column {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    position: relative;
  }
  .ink-kicker {
    color: #d8e6f2;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: clamp(0.86rem, 1.15vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.6;
  }
  .ink-hero-heading {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem 2rem;
  }
  .ink-project-name {
    margin: 0;
    padding: 0.55rem 0.75rem;
    background: var(--paper);
    color: #2b2c29;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .ink-hero-heading .ink-kicker {
    margin: 0;
    color: #d8d7d0;
  }
  h1 {
    grid-column: 1/-1;
    margin: 2rem 0 2.8rem;
    max-width: 1100px;
    font-size: clamp(5rem, 10.8vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.82;
  }
  h1 span {
    color: var(--peach);
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.08em;
  }
  .ink-hero-story {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    margin-bottom: 4rem;
  }
  .human-voice {
    margin: 0;
    max-width: 590px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.7rem, 2.6vw, 2.55rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .human-voice b {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--peach);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.15em;
    text-shadow: 0 0 12px rgba(255, 149, 0, 0.25);
  }
  .ink-voice {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin: 2rem 0 0;
    color: #e9e5de;
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    font-weight: 600;
    line-height: 1.4;
  }
  .ink-voice i {
    flex: none;
    width: 1.2rem;
    aspect-ratio: 1;
    margin-top: 0.18em;
    background: #969188;
    box-shadow: 0 0 0 0.45rem rgba(150, 145, 136, 0.15);
  }
  .ink-voice b {
    color: var(--blue);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.75em;
    letter-spacing: 0.06em;
  }
  .ink-lede {
    max-width: 620px;
    margin-top: 0;
    color: #e0ddd6;
    font-size: clamp(1.22rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.55;
  }
  .ink-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .ink-button {
    border: 2px solid rgba(244, 240, 233, 0.5);
    color: var(--paper);
    padding: 1rem 1.2rem;
    text-decoration: none;
    font-size: clamp(0.9rem, 1.2vw, 1.02rem);
    font-weight: 700;
    line-height: 1.35;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }
  .ink-button:hover {
    border-color: var(--paper);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }
  .ink-button-primary {
    background: var(--paper);
    border-color: var(--paper);
    color: #2b2c29;
  }
  .ink-button-primary:hover {
    background: var(--peach);
    border-color: var(--peach);
    color: #2b2c29;
  }
  .ink-availability {
    color: #e3c6b2;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.55;
    margin-top: 1.2rem;
  }
  .ink-hero-specimen {
    position: relative;
    margin-top: 1rem;
  }
  .ink-device {
    margin: 0;
    position: relative;
