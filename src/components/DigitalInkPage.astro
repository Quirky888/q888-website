  .ink-wrap { width:min(1180px,calc(100% - 3rem)); margin-inline:auto; }
  .ink-hero { min-height:100svh; display:grid; align-items:center; position:relative; padding:10rem 0 6rem; background:radial-gradient(circle at 76% 44%,rgba(68,116,195,.18),transparent 25%),linear-gradient(180deg,#090c12,#07090d); }
  .ink-orbit { position:absolute; width:min(50vw,700px); aspect-ratio:1; border:1px solid rgba(119,170,247,.2); border-radius:50%; right:-12%; top:8%; box-shadow:0 0 100px rgba(62,122,219,.08) inset; }
  .ink-orbit::before,.ink-orbit::after { content:""; position:absolute; border:1px solid rgba(119,170,247,.11); border-radius:50%; inset:16%; } .ink-orbit::after{inset:36%;background:var(--blue);box-shadow:0 0 80px var(--blue);opacity:.75;}
  .ink-hero-grid,.ink-two-column { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr); gap:clamp(3rem,8vw,8rem); align-items:start; position:relative; }
  .ink-kicker { color:var(--blue); font-size:.72rem; letter-spacing:.2em; line-height:1.5; }
  h1 { margin:1.2rem 0 2rem; font-family:"Space Grotesk",sans-serif; font-size:clamp(5.5rem,15vw,13rem); letter-spacing:-.085em; line-height:.69; }
  h1 span { color:transparent; -webkit-text-stroke:1px rgba(240,242,244,.52); }
  .ink-lede { max-width:690px; color:#c8ccd2; font-family:system-ui,sans-serif; font-size:clamp(1.35rem,2.2vw,2rem); line-height:1.45; }
  .ink-actions { display:flex; gap:.8rem; flex-wrap:wrap; margin-top:2.5rem; }
  .ink-button { border:1px solid #343a45; color:#d8dce2; padding:1rem 1.15rem; text-decoration:none; font-size:.74rem; transition:.2s ease; } .ink-button:hover{border-color:var(--blue);color:white}.ink-button-primary{background:var(--blue);border-color:var(--blue);color:#07101e;font-weight:700}.ink-button-primary:hover{background:#a7c8fb;color:#07101e}
  .ink-status { margin-top:7rem; border-top:1px solid #303641; padding-top:1.2rem; backdrop-filter:blur(5px); }
  .ink-status-light { color:#b9c1cb; font-size:.68rem; letter-spacing:.18em; margin-bottom:1.5rem; }.ink-status-light span{display:inline-block;width:7px;height:7px;border-radius:50%;background:#80e2a8;box-shadow:0 0 12px #80e2a8;margin-right:.5rem}.ink-status dl{margin:0}.ink-status dl div{display:flex;justify-content:space-between;gap:2rem;border-bottom:1px solid #20252d;padding:.85rem 0;font-size:.72rem}.ink-status dt{color:#737c89}.ink-status dd{text-align:right;margin:0;color:#e6e8ec}
  .ink-device { margin:0; background:#030405; position:relative; }.ink-device img{display:block;width:100%;max-height:92svh;object-fit:cover;filter:saturate(.83) contrast(1.04)}.ink-device figcaption{position:absolute;left:1.5rem;bottom:1.25rem;background:rgba(4,6,9,.86);padding:.65rem .8rem;color:#aeb5c0;font-size:.62rem;letter-spacing:.15em}
  .ink-section{padding:clamp(6rem,11vw,10rem) 0;border-top:1px solid #1b2028}.ink-section h2{font-family:"Space Grotesk",sans-serif;font-size:clamp(3rem,7vw,6.8rem);line-height:.95;letter-spacing:-.055em;margin:1.2rem 0}.ink-prose p,.ink-section-intro,.ink-capabilities p,.boundary-cards p{font-family:system-ui,sans-serif;color:#afb5bf;font-size:1.13rem;line-height:1.72;margin:0 0 1.5rem}.ink-section-intro{max-width:750px;margin:2rem 0 4rem}
  .ink-sequence{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:1.4rem;align-items:center;margin-top:6rem}.ink-sequence article{min-height:220px;border:1px solid #252b34;padding:1.5rem;background:#0b0e13}.ink-sequence article span,.boundary-cards article span{display:block;color:var(--blue);font-size:.67rem;letter-spacing:.18em;margin-bottom:3rem}.ink-sequence strong{font-family:"Space Grotesk";font-size:1.45rem}.ink-sequence p{font-family:system-ui,sans-serif;color:#858e9b;line-height:1.55}.ink-sequence i{color:var(--blue);font-style:normal}
  .ink-studies{background:#050609;padding-bottom:0}.studies-intro{margin-bottom:6rem}.studies-intro h2{margin-top:0}.study-stack{display:grid;gap:1px;background:#000}.art-study{margin:0;background:#000;padding:3.5rem 0 5rem}.art-study-toolbar{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.2rem}.art-study figcaption{display:grid;gap:.55rem}.art-study figcaption span{color:var(--blue);font-size:.65rem;letter-spacing:.16em}.art-study figcaption strong{font-family:"Space Grotesk";font-size:clamp(1.25rem,2.2vw,2rem);font-weight:500}.art-study-scroll-cue{flex:0 0 auto;color:#8993a0;font-size:.62rem;letter-spacing:.14em;border-bottom:1px solid #35404d;padding-bottom:.55rem}.art-study-frame{display:grid;position:relative;width:min(1180px,calc(100% - 2rem));margin-inline:auto;background:#000;overflow:hidden;isolation:isolate}.art-study-frame--canvas{aspect-ratio:2422/1535}.art-study-frame--memory{aspect-ratio:2745/1669}.art-study-frame img{grid-area:1/1;width:100%;height:100%;object-fit:contain;display:block}.art-study-base{transition:opacity 1200ms cubic-bezier(.4,0,.2,1),filter 1200ms cubic-bezier(.4,0,.2,1);will-change:opacity,filter;opacity:1}.art-study-overlay{position:relative;z-index:2;opacity:0;filter:blur(4px);transform:scale(1.015);transition:opacity 1200ms cubic-bezier(.4,0,.2,1),filter 1200ms cubic-bezier(.4,0,.2,1),transform 1200ms cubic-bezier(.4,0,.2,1);will-change:opacity,filter,transform}.art-study.is-revealed .art-study-overlay{opacity:1;filter:blur(0);transform:scale(1)}.art-study.is-revealed .art-study-base{opacity:0;filter:blur(4px)}.art-study-frame::after{content:"ARTISTIC MEMORY";position:absolute;z-index:4;right:1rem;bottom:1rem;background:rgba(4,6,9,.86);color:#d7dce4;padding:.55rem .7rem;font-size:.6rem;letter-spacing:.15em;opacity:0;transform:translateY(8px);transition:.35s ease}.art-study.is-revealed .art-study-frame::after{opacity:1;transform:none}.art-study-fog{position:absolute;z-index:1;right:4%;top:50%;transform:translateY(-50%);margin:0;color:rgba(35,40,48,.28);font-family:"Space Grotesk",sans-serif;font-size:clamp(1.5rem,4vw,4.5rem);font-weight:700;letter-spacing:-.035em;line-height:1.08;text-align:left;filter:blur(1.5px);text-shadow:0 0 30px rgba(0,0,0,.08);transition:opacity 1000ms cubic-bezier(.4,0,.2,1),filter 1000ms cubic-bezier(.4,0,.2,1)}.art-study.is-revealed .art-study-fog{opacity:0;filter:blur(8px)}
  .ink-memory{background:#0b0e14}.memory-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #303642;border-left:1px solid #303642}.memory-card{padding:1.5rem;min-height:250px;border-right:1px solid #303642;border-bottom:1px solid #303642}.memory-card span{font-size:.7rem;color:var(--blue)}.memory-card h3,.ink-capabilities h3,.boundary-cards h3{font-family:"Space Grotesk";font-size:1.5rem;margin:3rem 0 1rem}.memory-card p{font-family:system-ui,sans-serif;color:#929aa6;line-height:1.55}.memory-card:last-child{background:rgba(119,170,247,.07)}
  .fact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#2b313b;margin:5rem 0}.fact-grid div{background:#080a0e;padding:2rem 1.4rem;min-height:190px}.fact-grid strong{display:block;color:var(--blue);font-family:"Space Grotesk";font-size:clamp(2.5rem,5vw,5rem);letter-spacing:-.06em}.fact-grid span{display:block;color:#959da9;font-size:.68rem;line-height:1.55;max-width:19ch}.ink-capabilities article{border-top:1px solid #333a45}.ink-capabilities h3{margin-top:1.3rem}
  .ink-boundary{background:#e8ebee;color:#12151a}.ink-boundary .ink-kicker{color:#275d9f}.ink-boundary h2{color:#11151a}.boundary-cards{display:grid;gap:1rem}.boundary-cards article{border:1px solid #bbc1c9;padding:1.5rem}.boundary-cards article span{color:#275d9f;margin-bottom:2rem}.boundary-cards h3{margin:0 0 .8rem}.boundary-cards p{color:#4c535d;font-size:1rem}.ink-policy-link{display:flex;justify-content:space-between;gap:2rem;background:#11151a;color:#fff;padding:1.4rem;text-decoration:none}.ink-policy-link:hover{background:#275d9f}
