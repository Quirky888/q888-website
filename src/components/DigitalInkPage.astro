</style>

<!-- The tone switch lets the shared navigation follow the page between light and dusk. -->
<style is:global>
  body:has(.ink-page) {
    transition: background-color 0.6s ease, color 0.6s ease;
  }
  html[data-ink-tone="dusk"] body:has(.ink-page) {
    --bg-fog: #211d1b;
    --text-ink: #f1ece3;
    --text-muted: #b9b1a5;
    --line-soft: rgba(241, 236, 227, 0.16);
    color-scheme: dark;
  }
  @media (prefers-reduced-motion: reduce) {
    body:has(.ink-page) {
      transition: none;
    }
  }
</style>

<script>
  type InkWindow = Window & { __inkAbort?: AbortController };

  const TAU = Math.PI * 2;
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
  const smooth = (edge0: number, edge1: number, value: number) => {
    const t = clamp((value - edge0) / (edge1 - edge0), 0, 1);
    return t * t * (3 - 2 * t);
  };
  const mulberry32 = (seed: number) => () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  // The field uses the real collection: mostly grey and swamp green, a few warm notes, rare colour.
  const FIELD_COLOURS: Array<[string, number]> = [
    ["#8f8d88", 18], ["#a6a39b", 14], ["#6f6d68", 11], ["#b9b6ae", 8],
    ["#6b705a", 11], ["#7e8466", 7], ["#9a8f78", 6], ["#6f7f96", 4],
    ["#2f2d2a", 5], ["#d6a63a", 4], ["#b4786f", 3], ["#4f9a5f", 2],
    ["#d24d46", 1], ["#b4559a", 1], ["#f2efe6", 3],
  ];
  const SPRITES: Array<{ rows: string[]; key: Record<string, string> }> = [
    {
      rows: ["...cc...", "..cccc..", ".cccccc.", "cccpcccc", "cppcccpc", "...ss...", "...ss...", "...sp...", "...ps...", "...bb..."],
      key: { c: "#8d8880", p: "#d4a1a8", s: "#d9cfc1", b: "#b9a58a" },
    },
    {
      rows: ["....p....", "...ppp...", "..ppypp..", "...ppp...", "....p....", "....g....", ".g..g..g.", "..g.g.g..", "...ggg...", "....g....", "....g....", "....g...."],
      key: { p: "#ea7f9b", y: "#f0b72c", g: "#6f9a5a" },
    },
  ];

  // A living field: squares arrive and leave all the time, and now and then the field draws a small
  // picture pixel by pixel, spending Ink, then erases it and gives the Ink back, as the app does.
  function initField(hero: HTMLElement, canvas: HTMLCanvasElement, signal: AbortSignal, reduced: MediaQueryList) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const hudInk = hero.querySelector<HTMLElement>("[data-ink-hud-ink]");
    const hudDrawn = hero.querySelector<HTMLElement>("[data-ink-hud-drawn]");
    const START_INK = 587;

    type Cell = { col: number; row: number; colour: string; fill: number; target: number; ox: number; oy: number; phase: number; appear: number; locked: boolean };
    type Ripple = { x: number; y: number; start: number };
    type Art = { order: Cell[]; step: number; phase: "draw" | "hold" | "erase" | "rest"; next: number };

    let cells: Cell[] = [];
    let grid: Cell[][] = [];
    let ripples: Ripple[] = [];
    let cols = 0, rows = 0, width = 0, height = 0, cell = 56;
    let running = false, inView = true, lastFrame = 0, carry = 0, drawn = 0, spriteCounter = 0;
    let art: Art | null = null;
    const hover = { x: -999, y: -999, power: 0, target: 0 };
    let rng = mulberry32(888);
    const total = FIELD_COLOURS.reduce((sum, [, weight]) => sum + weight, 0);
    const pick = () => {
      let acc = rng() * total;
      for (const [colour, weight] of FIELD_COLOURS) { acc -= weight; if (acc <= 0) return colour; }
      return FIELD_COLOURS[0][0];
    };
    const sideOf = (cx: number) => 0.3 + 0.7 * smooth(width * 0.25, width * 0.8, cx);
    const density = (cx: number) => 0.14 + 0.46 * smooth(width * 0.2, width * 0.85, cx);

    const setHud = () => {
      if (hudInk) hudInk.textContent = String(START_INK - drawn);
      if (hudDrawn) hudDrawn.textContent = String(drawn);
    };

    const build = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cell = clamp(Math.round(width / (width < 700 ? 8 : 22)), 38, 72);
      cols = Math.ceil(width / cell);
      rows = Math.ceil(height / cell);
      rng = mulberry32(888);
      const now = performance.now();
      cells = [];
      grid = [];
      for (let row = 0; row < rows; row++) {
        grid[row] = [];
        for (let col = 0; col < cols; col++) {
          const cx = col * cell + cell / 2;
          const item: Cell = {
            col, row, colour: pick(), fill: 0, target: rng() < density(cx) ? 1 : 0, ox: 1.4, oy: (rng() - 0.5) * 1.2,
            phase: rng() * TAU, appear: now + ((width - cx) / width) * 1100 + rng() * 500, locked: false,
          };
          if (reduced.matches) { item.fill = item.target; item.ox = 0; item.oy = 0; }
          cells.push(item);
          grid[row][col] = item;
        }
      }
      art = null;
      drawn = 0;
      setHud();
    };

    const waveAt = (cx: number, cy: number, now: number) => {
      let best = 0;
      for (const ripple of ripples) {
        const age = now - ripple.start;
        if (age < 0) continue;
        const band = Math.exp(-(((Math.hypot(cx - ripple.x, cy - ripple.y) - age * 0.55) / 130) ** 2));
        best = Math.max(best, band * (1 - age / 2400));
      }
      return best;
    };
    const hoverAt = (cx: number, cy: number) => hover.power * Math.exp(-((Math.hypot(cx - hover.x, cy - hover.y) / 160) ** 2)) * 0.95;

    const startArt = (now: number) => {
      const { rows: bitmap, key } = SPRITES[spriteCounter++ % SPRITES.length];
      const h = bitmap.length;
      const w = bitmap[0].length;
      if (cols < w + 1 || rows < h + 2) { art = { order: [], step: 0, phase: "rest", next: now + 4000 }; return; }
      const colMin = Math.max(0, Math.floor(cols * 0.45));
      const colStart = colMin + Math.floor(rng() * Math.max(1, cols - w - colMin));
      const rowStart = 1 + Math.floor(rng() * Math.max(1, Math.floor(rows * 0.62) - h));
      const order: Cell[] = [];
      for (let r = h - 1; r >= 0; r--) {
        for (let c = 0; c < w; c++) {
          const letter = bitmap[r][c];
          const target = grid[rowStart + r]?.[colStart + c];
          if (letter === "." || !target) continue;
          target.colour = key[letter];
          order.push(target);
        }
      }
      art = { order, step: 0, phase: "draw", next: now + 700 };
    };

    const stepArt = (now: number) => {
      if (!art) { startArt(now); return; }
      if (now < art.next) return;
      if (art.phase === "draw") {
        const item = art.order[art.step];
        if (item) { item.locked = true; item.target = 1; item.ox = (rng() - 0.5) * 1.4; item.oy = -1; drawn++; setHud(); }
        art.step++;
        if (art.step >= art.order.length) { art.phase = "hold"; art.next = now + 3600; } else art.next = now + 95;
      } else if (art.phase === "hold") {
        art.phase = "erase"; art.step = art.order.length - 1; art.next = now + 60;
      } else if (art.phase === "erase") {
        const item = art.order[art.step];
        if (item) { item.target = 0; item.locked = false; drawn = Math.max(0, drawn - 1); setHud(); }
        art.step--;
        if (art.step < 0) { art.phase = "rest"; art.next = now + 2600; } else art.next = now + 55;
      } else {
        startArt(now);
      }
    };

    const draw = (now: number, dt: number) => {
      const still = reduced.matches;
      hover.power += (hover.target - hover.power) * 0.1;
      ripples = ripples.filter((ripple) => now - ripple.start < 2800);

      if (!still) {
        carry += dt * 0.018;
        while (carry >= 1 && cells.length) {
          carry -= 1;
          const item = cells[Math.floor(rng() * cells.length)];
          if (item.locked || now < item.appear) continue;
          const wants = rng() < density(item.col * cell + cell / 2);
          if (wants && item.target === 0) {
            item.target = 1;
            item.colour = pick();
            const side = Math.floor(rng() * 4);
            item.ox = side === 0 ? 1.1 : side === 1 ? -1.1 : 0;
            item.oy = side === 2 ? 1.1 : side === 3 ? -1.1 : 0;
          } else if (!wants && item.target === 1) {
            item.target = 0;
          }
        }
        stepArt(now);
      }

      ctx.clearRect(0, 0, width, height);
      for (const item of cells) {
        const x = item.col * cell;
        const y = item.row * cell;
        const cx = x + cell / 2;
        const cy = y + cell / 2;
        const side = sideOf(cx);
        if (!still && now >= item.appear) {
          item.fill += (item.target - item.fill) * 0.13;
          item.ox *= 0.9;
          item.oy *= 0.9;
        }
        const glow = still ? 0 : Math.max(waveAt(cx, cy, now), hoverAt(cx, cy));
        const fill = clamp(item.fill + (item.target === 0 ? glow * 0.9 : glow * 0.2), 0, 1);
        if (fill < 0.04) {
          ctx.strokeStyle = `rgba(128,124,116,${0.2 * side})`;
          ctx.lineWidth = 1;
          ctx.strokeRect(x + 2.5, y + 2.5, cell - 5, cell - 5);
          continue;
        }
        const breathe = still ? 1 : 0.92 + 0.08 * Math.sin((now / 6000) * TAU + item.phase);
        const size = (cell - 5) * (0.4 + 0.6 * fill) * (1 + 0.2 * glow);
        ctx.globalAlpha = clamp(fill * 0.92 * side * breathe + glow * 0.3, 0, 1);
        ctx.fillStyle = item.colour;
        ctx.fillRect(cx + item.ox * cell - size / 2, cy + item.oy * cell - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    };

    const frame = (now: number) => {
      if (!running) return;
      const dt = Math.min(now - lastFrame, 64);
      lastFrame = now;
      draw(now, dt);
      requestAnimationFrame(frame);
    };
    const sync = () => {
      const shouldRun = inView && !document.hidden && !reduced.matches;
      if (shouldRun && !running) {
        running = true;
        lastFrame = performance.now();
        requestAnimationFrame(frame);
      } else if (!shouldRun) {
        running = false;
        draw(performance.now(), 0);
      }
    };

    hero.addEventListener("pointerdown", (event) => {
      if (reduced.matches || (event.target as HTMLElement).closest("a, button")) return;
      const rect = canvas.getBoundingClientRect();
      ripples.push({ x: event.clientX - rect.left, y: event.clientY - rect.top, start: performance.now() });
      if (ripples.length > 6) ripples.shift();
    }, { signal });
    hero.addEventListener("pointermove", (event) => {
      if (reduced.matches || event.pointerType !== "mouse") return;
      const rect = canvas.getBoundingClientRect();
      hover.x = event.clientX - rect.left;
      hover.y = event.clientY - rect.top;
      hover.target = 1;
    }, { signal });
    hero.addEventListener("pointerleave", () => { hover.target = 0; }, { signal });

    build();
    const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); });
    observer.observe(hero);
    const resizer = new ResizeObserver(() => { build(); draw(performance.now(), 0); });
    resizer.observe(canvas);
    document.addEventListener("visibilitychange", sync, { signal });
    reduced.addEventListener("change", sync, { signal });
    signal.addEventListener("abort", () => { running = false; observer.disconnect(); resizer.disconnect(); }, { once: true });

    if (!reduced.matches) {
      ripples.push({ x: width * 0.78, y: height * 0.35, start: performance.now() + 400 });
      ripples.push({ x: width * 0.2, y: height * 0.7, start: performance.now() + 1500 });
    }
    sync();
  }

  // One shared scroll loop: read everything first, write second, and ease the movement so it glides
  // instead of stepping. Transforms are written straight onto the moving element, never through
  // inherited variables, so a scroll frame does not restyle whole chapters.
  type Fx = { read: () => void; write: () => boolean };
  type Scheduler = { add: (fx: Fx) => void; kick: () => void };
  const ease = (current: number, target: number, rate: number, epsilon: number) => {
    const next = current + (target - current) * rate;
    return Math.abs(target - next) < epsilon ? target : next;
  };
  function createScheduler(signal: AbortSignal): Scheduler {
    const fxs: Fx[] = [];
    let raf = 0;
    let idleUntil = 0;
    const frame = (now: number) => {
      raf = 0;
      for (const fx of fxs) fx.read();
      let more = false;
      for (const fx of fxs) if (fx.write()) more = true;
      if (more || now < idleUntil) raf = requestAnimationFrame(frame);
    };
    const kick = () => {
      idleUntil = performance.now() + 160;
      if (!raf) raf = requestAnimationFrame(frame);
    };
    window.addEventListener("scroll", kick, { passive: true, signal });
    window.addEventListener("resize", kick, { passive: true, signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(raf), { once: true });
    return { add: (fx) => { fxs.push(fx); }, kick };
  }

  // A long, scroll-driven fall from one world into the other: squares climb from the bottom.
  function initDissolve(fxs: Scheduler, signal: AbortSignal, reduced: MediaQueryList) {
    const zones = Array.from(document.querySelectorAll<HTMLElement>("[data-ink-dissolve]"));
    const TINTS = {
      in: ["#211d1b", "#241d1f", "#2a211c", "#1f1b1f", "#261f1b"],
      out: ["#f5f5f5", "#f1f0ee", "#f7f6f4", "#efeeec", "#f3f2f0"],
    };
    type State = {
      zone: HTMLElement; canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D; kind: "in" | "out";
      cells: Array<{ col: number; row: number; thr: number; tint: number }>;
      cols: number; rows: number; cell: number; width: number; height: number;
      target: number; current: number; drawn: number; visible: boolean; primed: boolean;
    };
    const states: State[] = [];
    for (const zone of zones) {
      const canvas = zone.querySelector("canvas");
      const ctx = canvas?.getContext("2d");
      if (!canvas || !ctx) continue;
      states.push({
        zone, canvas, ctx, kind: zone.dataset.inkDissolve === "out" ? "out" : "in", cells: [], cols: 0, rows: 0, cell: 56,
        width: 0, height: 0, target: 0, current: 0, drawn: -1, visible: false, primed: false,
      });
    }

    const build = (state: State) => {
      const rect = state.canvas.getBoundingClientRect();
      state.width = rect.width;
      state.height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      state.canvas.width = Math.max(1, Math.round(rect.width * dpr));
      state.canvas.height = Math.max(1, Math.round(rect.height * dpr));
      state.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      state.cell = clamp(Math.round(rect.width / (rect.width < 700 ? 8 : 22)), 38, 72);
      state.cols = Math.ceil(rect.width / state.cell);
      state.rows = Math.ceil(rect.height / state.cell);
      const rng = mulberry32(state.kind === "in" ? 31 : 77);
      state.cells = [];
      for (let row = 0; row < state.rows; row++) {
        for (let col = 0; col < state.cols; col++) state.cells.push({ col, row, thr: rng(), tint: Math.floor(rng() * 5) });
      }
      state.drawn = -1;
    };
    const draw = (state: State) => {
      const ctx = state.ctx;
      const progress = state.current;
      ctx.clearRect(0, 0, state.width, state.height);
      const tints = TINTS[state.kind];
      for (const item of state.cells) {
        const fromBottom = (state.rows - 1 - item.row) / Math.max(1, state.rows - 1);
        const order = fromBottom * 0.6 + item.thr * 0.4;
        const t = clamp((progress * 1.25 - order) / 0.14, 0, 1);
        if (t <= 0) continue;
        const size = (state.cell + 1) * (0.3 + 0.7 * t);
        ctx.fillStyle = tints[item.tint];
        ctx.fillRect(item.col * state.cell + (state.cell - size) / 2, item.row * state.cell + (state.cell - size) / 2, size, size);
      }
      if (progress > 0.9) {
        ctx.globalAlpha = clamp((progress - 0.9) / 0.08, 0, 1);
        ctx.fillStyle = tints[0];
        ctx.fillRect(0, 0, state.width, state.height);
        ctx.globalAlpha = 1;
      }
    };

    states.forEach(build);
    fxs.add({
      read: () => {
        const vh = window.innerHeight;
        for (const state of states) {
          const rect = state.zone.getBoundingClientRect();
          state.visible = rect.bottom > -120 && rect.top < vh + 120;
          // Slow on purpose: it takes about a screen and a half of scrolling to finish.
          state.target = reduced.matches ? 1 : clamp((vh * 0.95 - rect.top) / (rect.height + vh * 0.65), 0, 1);
        }
      },
      write: () => {
        let more = false;
        for (const state of states) {
          if (!state.primed) { state.current = state.target; state.primed = true; }
          state.current = ease(state.current, state.target, 0.16, 0.0008);
          if (state.visible && Math.abs(state.current - state.drawn) > 0.0006) { draw(state); state.drawn = state.current; }
          if (state.current !== state.target) more = true;
        }
        return more;
      },
    });
    window.addEventListener("resize", () => { states.forEach(build); fxs.kick(); }, { passive: true, signal });
  }

  // Big sentences that fill with ink, word by word, as you scroll.
  function initFill(fxs: Scheduler, reduced: MediaQueryList) {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>("[data-ink-fill]"));
    if (!blocks.length || reduced.matches) return;
    const groups = blocks.map((block) => {
      const words: HTMLElement[] = [];
      const walk = (node: Node) => {
        for (const child of Array.from(node.childNodes)) {
          if (child.nodeType === Node.TEXT_NODE) {
            const text = child.textContent ?? "";
            if (!text.trim()) continue;
            const fragment = document.createDocumentFragment();
            for (const part of text.split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) { fragment.appendChild(document.createTextNode(" ")); continue; }
              const span = document.createElement("span");
              span.className = "ink-fw";
              span.textContent = part;
              words.push(span);
              fragment.appendChild(span);
            }
            child.replaceWith(fragment);
          } else if (child instanceof HTMLElement) {
            walk(child);
          }
        }
      };
      walk(block);
      return { block, words, target: 0, current: 0, drawn: -1, visible: false, primed: false };
    });
    fxs.add({
      read: () => {
        const vh = window.innerHeight;
        for (const group of groups) {
          const rect = group.block.getBoundingClientRect();
          group.visible = rect.bottom > -150 && rect.top < vh + 150;
          group.target = clamp((vh * 0.85 - rect.top) / (rect.height + vh * 0.3), 0, 1);
        }
      },
      write: () => {
        let more = false;
        for (const group of groups) {
          if (!group.primed) { group.current = group.target; group.primed = true; }
          group.current = ease(group.current, group.target, 0.2, 0.0005);
          if (group.visible && Math.abs(group.current - group.drawn) > 0.0005) {
            const count = group.words.length;
            group.words.forEach((word, index) => word.style.setProperty("--on", clamp(group.current * (count + 4) - index, 0, 1).toFixed(3)));
            group.drawn = group.current;
          }
          if (group.current !== group.target) more = true;
        }
        return more;
      },
    });
  }

  // Every clip plays by itself in a loop while it is on screen.
  function initClips(signal: AbortSignal, reduced: MediaQueryList) {
    const clips = Array.from(document.querySelectorAll<HTMLElement>("[data-ink-clip]"));
    const setState = (clip: HTMLElement, state: string) => {
      const video = clip.querySelector("video");
      const button = clip.querySelector<HTMLButtonElement>("[data-ink-clip-btn]");
      const label = clip.querySelector<HTMLElement>("[data-ink-clip-label]");
      if (!video || !button || !label) return;
      clip.dataset.state = state;
      const text = state === "playing" ? "Pause" : "Play";
      label.textContent = text;
      button.setAttribute("aria-label", `${text}: ${video.getAttribute("aria-label") ?? ""}`);
    };
    for (const clip of clips) {
      const video = clip.querySelector("video");
      const button = clip.querySelector<HTMLButtonElement>("[data-ink-clip-btn]");
      if (!video || !button) continue;
      let pausedByVisitor = false;
      const play = () => { void video.play().then(() => setState(clip, "playing")).catch(() => setState(clip, "idle")); };

      button.addEventListener("click", () => {
        if (video.paused) { pausedByVisitor = false; play(); }
        else { video.pause(); setState(clip, "idle"); pausedByVisitor = true; }
      }, { signal });
      clip.querySelector<HTMLElement>(".ink-clip-frame")?.addEventListener("click", (event) => {
        if (!(event.target as HTMLElement).closest("button")) button.click();
      }, { signal });

      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          if (!reduced.matches && !pausedByVisitor) play();
        } else if (!video.paused) {
          video.pause();
          setState(clip, "idle");
        }
      }, { threshold: 0.4 });
      observer.observe(clip);
      signal.addEventListener("abort", () => observer.disconnect(), { once: true });
    }
  }

  function countUp(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>("[data-count]").forEach((element) => {
      const target = Number(element.dataset.count);
      const start = performance.now();
      const tick = (now: number) => {
        const t = clamp((now - start) / 1400, 0, 1);
        element.textContent = String(Math.round(target * (1 - (1 - t) ** 3)));
        if (t < 1) requestAnimationFrame(tick);
      };
      element.textContent = "0";
      requestAnimationFrame(tick);
    });
  }

  function initReveal(signal: AbortSignal, reduced: MediaQueryList) {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal], [data-bars]"));
    if (reduced.matches) { items.forEach((item) => item.classList.add("is-in")); return; }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        // Anything already scrolled past counts as seen, so fast scrolling never leaves a blank section.
        if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
          const target = entry.target as HTMLElement;
          target.classList.add("is-in");
          if (target.hasAttribute("data-bars")) countUp(target);
          observer.unobserve(target);
        }
      }
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
    // Safety net: if the observer never reports, show everything after a moment.
    const timer = window.setTimeout(() => items.forEach((item) => item.classList.add("is-in")), 8000);
    signal.addEventListener("abort", () => { observer.disconnect(); window.clearTimeout(timer); }, { once: true });
  }

  // Headlines are cut into words (letters for the hero) that rise out of their own line.
  function splitText(root: HTMLElement, byLetter: boolean) {
    let index = 0;
    root.setAttribute("aria-label", (root.textContent ?? "").replace(/\s+/g, " ").trim());
    const walk = (node: Node) => {
      for (const child of Array.from(node.childNodes)) {
        if (child.nodeType === Node.TEXT_NODE) {
          const text = child.textContent ?? "";
          if (!text.trim()) continue;
          const fragment = document.createDocumentFragment();
          for (const part of text.split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) { fragment.appendChild(document.createTextNode(" ")); continue; }
            const word = document.createElement("span");
            word.className = "ink-sw";
            word.setAttribute("aria-hidden", "true");
            for (const piece of byLetter ? Array.from(part) : [part]) {
              const inner = document.createElement("span");
              inner.className = "ink-swi";
              inner.style.setProperty("--w", String(index++));
              inner.textContent = piece;
              word.appendChild(inner);
            }
            fragment.appendChild(word);
          }
          child.replaceWith(fragment);
        } else if (child instanceof HTMLElement && !child.classList.contains("ink-seal")) {
          walk(child);
        }
      }
    };
    walk(root);
    root.classList.add("ink-sp");
  }

  function initSplit(signal: AbortSignal, reduced: MediaQueryList) {
    if (reduced.matches) return;
    const hero = document.querySelector<HTMLElement>(".ink-page h1");
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".ink-page h2.ink-mega"));
    if (hero) {
      splitText(hero, true);
      const start = () => window.setTimeout(() => hero.classList.add("is-in"), 140);
      if (document.fonts?.ready) void document.fonts.ready.then(start); else start();
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      }
    }, { rootMargin: "0px 0px -12% 0px", threshold: 0.2 });
    headings.forEach((heading) => { splitText(heading, false); observer.observe(heading); });
    const timer = window.setTimeout(() => document.querySelectorAll(".ink-sp").forEach((item) => item.classList.add("is-in")), 8000);
    signal.addEventListener("abort", () => { observer.disconnect(); window.clearTimeout(timer); }, { once: true });
  }

  function initHeroDrift(hero: HTMLElement, fxs: Scheduler, reduced: MediaQueryList) {
    if (reduced.matches) return;
    const parts = Array.from(hero.querySelectorAll<HTMLElement>(".ink-hero-inner > *"));
    let target = 0;
    let current = 0;
    fxs.add({
      read: () => {
        const rect = hero.getBoundingClientRect();
        target = clamp(-rect.top / (rect.height * 0.7), 0, 1);
      },
      write: () => {
        current = ease(current, target, 0.16, 0.001);
        for (const part of parts) {
          part.style.transform = `translate3d(0, ${(current * 60).toFixed(2)}px, 0)`;
          if (part.tagName !== "H1") part.style.opacity = String(clamp(1 - current * 2.4, 0, 1));
        }
        return current !== target;
      },
    });
  }

  // On large screens the three places slide sideways as you scroll down: normal scroll speed, no hijacking.
  function initPlaces(fxs: Scheduler, signal: AbortSignal) {
    const section = document.querySelector<HTMLElement>("[data-ink-places]");
    const track = section?.querySelector<HTMLElement>("[data-ink-places-track]");
    const count = section?.querySelector<HTMLElement>("[data-ink-places-count]");
    if (!section || !track) return;
    const query = window.matchMedia("(min-width: 900px) and (prefers-reduced-motion: no-preference)");
    let maxShift = 0;
    let target = 0;
    let current = 0;
    let shownIndex = 0;
    const measure = () => {
      if (!query.matches) {
        section.style.removeProperty("--places-h");
        track.style.transform = "";
        return;
      }
      maxShift = Math.max(0, track.scrollWidth - window.innerWidth);
      section.style.setProperty("--places-h", `${window.innerHeight + maxShift}px`);
      fxs.kick();
    };
    fxs.add({
      read: () => {
        if (!query.matches) return;
        const progress = maxShift > 0 ? clamp(-section.getBoundingClientRect().top / maxShift, 0, 1) : 0;
        target = progress * maxShift;
      },
      write: () => {
        if (!query.matches) return false;
        current = ease(current, target, 0.2, 0.3);
        track.style.transform = `translate3d(${(-current).toFixed(1)}px, 0, 0)`;
        const index = maxShift > 0 ? Math.min(3, Math.floor((current / maxShift) * 2.999) + 1) : 1;
        if (count && index !== shownIndex) { count.textContent = `0${index} / 03`; shownIndex = index; }
        return current !== target;
      },
    });
    window.addEventListener("resize", measure, { passive: true, signal });
    window.addEventListener("load", measure, { once: true, signal });
    query.addEventListener("change", measure, { signal });
    // Styles and fonts can arrive after this script; measure again whenever the track changes size.
    const resizer = new ResizeObserver(measure);
    resizer.observe(track);
    signal.addEventListener("abort", () => resizer.disconnect(), { once: true });
    measure();
  }

  // The cursor companion: the landing’s soft square, stretched by speed, swelling over things you can use.
  function initBubble(signal: AbortSignal, reduced: MediaQueryList) {
    const page = document.querySelector<HTMLElement>(".ink-page");
    const bubble = document.querySelector<HTMLElement>("[data-ink-bubble]");
    const core = document.querySelector<HTMLElement>("[data-ink-bubble-core]");
    const label = document.querySelector<HTMLElement>("[data-ink-bubble-label]");
    if (!page || !bubble || !core || !label || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    page.classList.add("ink-bubble-on");
    let targetX = 0, targetY = 0, x = 0, y = 0, frame = 0;

    const follow = () => {
      const dx = targetX - x;
      const dy = targetY - y;
      const ease = reduced.matches ? 1 : 0.2;
      x += dx * ease;
      y += dy * ease;
      const speed = reduced.matches ? 0 : Math.min(Math.hypot(dx, dy) / 70, 1);
      const angle = Math.atan2(dy, dx);
      const stretch = speed * 0.4;
      bubble.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${angle}rad) scale(${1 + stretch}, ${1 - stretch * 0.45}) rotate(${-angle}rad)`;
      frame = Math.abs(dx) + Math.abs(dy) > 0.3 ? requestAnimationFrame(follow) : 0;
    };

    window.addEventListener("pointermove", (event) => {
      targetX = event.clientX;
      targetY = event.clientY;
      core.style.transform = `translate3d(${targetX}px, ${targetY}px, 0)`;
      bubble.classList.add("is-visible");
      core.classList.add("is-visible");
      const target = event.target instanceof Element ? event.target : null;
      const clip = target?.closest<HTMLElement>("[data-ink-clip]");
      const zoom = target?.closest("[data-ink-zoom]");
      const overButton = !!target?.closest("button");
      const media = (!!clip && !overButton) || !!zoom;
      bubble.classList.toggle("is-media", media);
      bubble.classList.toggle("is-large", !media && !!target?.closest("a, button, summary"));
      if (media) label.textContent = zoom ? "View" : clip?.dataset.state === "playing" ? "Pause" : "Play";
      if (!frame) frame = requestAnimationFrame(follow);
    }, { passive: true, capture: true, signal });
    window.addEventListener("pointerdown", () => bubble.classList.add("is-down"), { signal });
    window.addEventListener("pointerup", () => bubble.classList.remove("is-down"), { signal });
    const hide = () => { bubble.classList.remove("is-visible", "is-large", "is-media", "is-down"); core.classList.remove("is-visible"); };
    document.documentElement.addEventListener("mouseleave", hide, { signal });
    window.addEventListener("blur", hide, { signal });
    signal.addEventListener("abort", () => { cancelAnimationFrame(frame); page.classList.remove("ink-bubble-on"); }, { once: true });
  }

  // Screenshots and clips tilt toward the pointer, with a soft light that follows it.
  function initTilt(signal: AbortSignal, reduced: MediaQueryList) {
    if (reduced.matches || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    document.querySelectorAll<HTMLElement>(".ink-chapter .ink-frame").forEach((frame) => {
      frame.addEventListener("pointermove", (event) => {
        const rect = frame.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;
        frame.style.setProperty("--ry", `${((px - 0.5) * 8).toFixed(2)}deg`);
        frame.style.setProperty("--rx", `${((0.5 - py) * 8).toFixed(2)}deg`);
        frame.style.setProperty("--lx", `${(px * 100).toFixed(1)}%`);
        frame.style.setProperty("--ly", `${(py * 100).toFixed(1)}%`);
        frame.style.setProperty("--glare", "1");
      }, { signal });
      frame.addEventListener("pointerleave", () => {
        frame.style.setProperty("--rx", "0deg");
        frame.style.setProperty("--ry", "0deg");
        frame.style.setProperty("--glare", "0");
      }, { signal });
    });
  }

  // Things drift at different speeds as you scroll: media, the ghost numerals, the big type bands.
  function initScrollFx(fxs: Scheduler, reduced: MediaQueryList) {
    if (reduced.matches) return;
    type Item = { el: HTMLElement; ref: Element; kind: "media" | "ghost" | "band"; dir: number; target: number; current: number; primed: boolean };
    const items: Item[] = [];
    document.querySelectorAll<HTMLElement>(".ink-media, .ink-media-row, .ink-memory-grid, .ink-gallery").forEach((el) => {
      const ref = el.closest("section");
      if (ref) items.push({ el, ref, kind: "media", dir: 1, target: 0, current: 0, primed: false });
    });
    document.querySelectorAll<HTMLElement>(".ink-ghost").forEach((el) => {
      if (el.parentElement) items.push({ el, ref: el.parentElement, kind: "ghost", dir: 1, target: 0, current: 0, primed: false });
    });
    document.querySelectorAll<HTMLElement>("[data-ink-marquee]").forEach((band) => {
      const el = band.querySelector<HTMLElement>(".ink-marquee-track");
      if (el) items.push({ el, ref: band, kind: "band", dir: Number(band.dataset.dir ?? -1), target: 0, current: 0, primed: false });
    });
    fxs.add({
      read: () => {
        const vh = window.innerHeight;
        for (const item of items) {
          const rect = item.ref.getBoundingClientRect();
          if (rect.bottom < -vh || rect.top > vh * 2) continue;
          if (item.kind === "band") item.target = item.dir * (rect.top - vh / 2) * 0.55;
          else item.target = clamp((rect.top + rect.height / 2 - vh / 2) / vh, -1.2, 1.2) * (item.kind === "ghost" ? -90 : -22);
        }
      },
      write: () => {
        let more = false;
        for (const item of items) {
          if (!item.primed) { item.current = item.target; item.primed = true; }
          const next = ease(item.current, item.target, 0.14, 0.05);
          if (next === item.current) continue;
          item.current = next;
          item.el.style.transform = item.kind === "band" ? `translate3d(${next.toFixed(1)}px, 0, 0)` : `translate3d(0, ${next.toFixed(1)}px, 0)`;
          if (next !== item.target) more = true;
        }
        return more;
      },
    });
  }

  // The shared navigation turns dark while we are inside the app, and light again at the end.
  function initTone(fxs: Scheduler, signal: AbortSignal) {
    const dissolveIn = document.querySelector<HTMLElement>('[data-ink-dissolve="in"]');
    const dissolveOut = document.querySelector<HTMLElement>('[data-ink-dissolve="out"]');
    const dots = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-ink-dot]"));
    const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-ink-chapter]"));
    if (!dissolveIn) return;
    let dusk = false;
    let active = "";
    let nextDusk = false;
    let nextActive = "";
    fxs.add({
      read: () => {
        const vh = window.innerHeight;
        const entered = dissolveIn.getBoundingClientRect().bottom < vh * 0.8;
        const left = dissolveOut ? dissolveOut.getBoundingClientRect().top < vh * 0.35 : false;
        nextDusk = entered && !left;
        nextActive = "";
        for (const chapter of chapters) {
          if (chapter.getBoundingClientRect().top < vh * 0.45) nextActive = chapter.id;
        }
      },
      write: () => {
        // Only touch the page when something really changes.
        if (nextDusk !== dusk) {
          dusk = nextDusk;
          if (dusk) document.documentElement.dataset.inkTone = "dusk";
          else delete document.documentElement.dataset.inkTone;
        }
        if (nextActive !== active) {
          active = nextActive;
          dots.forEach((dot) => dot.classList.toggle("is-active", dot.dataset.inkDot === active));
        }
        return false;
      },
    });
    signal.addEventListener("abort", () => { delete document.documentElement.dataset.inkTone; }, { once: true });
  }

  function initLightbox(signal: AbortSignal) {
    const dialog = document.querySelector<HTMLDialogElement>("[data-ink-lightbox]");
    const image = dialog?.querySelector("img");
    if (!dialog || !image) return;
    document.querySelectorAll<HTMLAnchorElement>("[data-ink-zoom]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (typeof dialog.showModal !== "function") return;
        event.preventDefault();
        image.src = link.href;
        image.alt = link.dataset.alt ?? "";
        dialog.showModal();
      }, { signal });
    });
    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest("[data-close]")) dialog.close();
    }, { signal });
  }

  function initInkPage() {
    const page = document.querySelector<HTMLElement>(".ink-page");
    if (!page) return;
    const pageWindow = window as InkWindow;
    pageWindow.__inkAbort?.abort();
    const controller = new AbortController();
    pageWindow.__inkAbort = controller;
    const { signal } = controller;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.documentElement.classList.add("ink-js");
    const hero = page.querySelector<HTMLElement>("[data-ink-hero]");
    const canvas = page.querySelector<HTMLCanvasElement>("[data-ink-field]");
    if (hero && canvas) initField(hero, canvas, signal, reduced);
    const fxs = createScheduler(signal);
    if (hero) initHeroDrift(hero, fxs, reduced);
    initSplit(signal, reduced);
    initFill(fxs, reduced);
    initPlaces(fxs, signal);
    initDissolve(fxs, signal, reduced);
    initBubble(signal, reduced);
    initTilt(signal, reduced);
    initScrollFx(fxs, reduced);
    initClips(signal, reduced);
    initReveal(signal, reduced);
    initTone(fxs, signal);
    initLightbox(signal);
    fxs.kick();

    const leave = () => { controller.abort(); document.documentElement.classList.remove("ink-js"); };
    window.addEventListener("pagehide", leave, { once: true });
    document.addEventListener("astro:before-swap", leave, { once: true });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initInkPage, { once: true });
  else initInkPage();
</script>
