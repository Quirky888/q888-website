---
import InkClip from "./InkClip.astro";
import InkMarquee from "./InkMarquee.astro";

const APP_STORE = "https://apps.apple.com/us/app/digital-ink/id6757157376";

// Snapshot of the artist's own collection, 20 November 2026 (587 Inks at home).
const palette = [
  { name: "Grey", count: 406, colour: "#9a9a9a" },
  { name: "Yellow", count: 85, colour: "#f2c40f" },
  { name: "Blue", count: 40, colour: "#2f8cf0" },
  { name: "Black", count: 32, colour: "#161616" },
  { name: "Green", count: 19, colour: "#3cc36a" },
  { name: "Red", count: 3, colour: "#ff4a47" },
  { name: "Magenta", count: 1, colour: "#d63cf0" },
  { name: "White", count: 1, colour: "#f2f2f2" },
];

const chapters = [
  { id: "beginning", number: "01", name: "Beginning" },
  { id: "memory", number: "02", name: "Memory" },
  { id: "canvas", number: "03", name: "Canvas" },
  { id: "connections", number: "04", name: "Connections" },
  { id: "school", number: "05", name: "School" },
  { id: "gallery", number: "06", name: "Gallery" },
];

const inkTraces = [
  { name: "Visible trace", text: "One representative colour: the source image reduced to finite digital material." },
  { name: "Source trace", text: "An optional compressed preview, no larger than 192 pixels on its longest edge." },
  { name: "Machine description", text: "Machine-generated language, including its uncertainty and occasional mistakes." },
  { name: "Place & personal note", text: "Date, place, provenance and your own note, kept distinct from machine interpretation." },
  { name: "Learned concepts", text: "Concepts encountered through selected texts and PDFs after the Ink was created." },
  { name: "Relationship history", text: "Relationships with other Inks, including how a connection became active, dormant or historical." },
  { name: "Reconstruction", text: "An AI reconstruction: explicitly an invention, never presented as recovery of the source." },
];
---

<main class="ink-page" id="ink-top">
  <!-- The cursor companion: the landing’s soft square, a little livelier. -->
  <div class="ink-bubble" data-ink-bubble aria-hidden="true"><span class="ink-bubble-label" data-ink-bubble-label></span></div>
  <div class="ink-bubble-core" data-ink-bubble-core aria-hidden="true"></div>

  <nav class="ink-dots" aria-label="Chapters">
    {chapters.map((chapter) => (
      <a href={`#${chapter.id}`} data-ink-dot={chapter.id} aria-label={`${chapter.number} ${chapter.name}`}>
        <span class="ink-dot-num ink-mono" aria-hidden="true">{chapter.number}</span><i aria-hidden="true"></i>
      </a>
    ))}
  </nav>

  <!-- ───────── Hero: light, grey, alive ───────── -->
  <section class="ink-hero" aria-labelledby="ink-title" data-ink-hero>
    <canvas class="ink-field" data-ink-field aria-hidden="true"></canvas>
    <div class="ink-hud ink-mono" aria-hidden="true">
      <span>Ink in home <b data-ink-hud-ink>587</b></span>
      <span>Drawn <b data-ink-hud-drawn>0</b></span>
    </div>
    <div class="ink-wrap ink-hero-inner">
      <p class="ink-mono ink-hero-meta">Digital Ink · version 3.2 · iPad · iPadOS 26 or later</p>
      <h1 id="ink-title"><span class="ink-h1-line">Every pixel</span> <span class="ink-h1-line">has a <span class="ink-past">past.<i class="ink-seal" aria-hidden="true"></i></span></span></h1>
      <p class="ink-hero-sub">Turn a photo into one square of colour that can be drawn with, looked after and never duplicated.</p>
      <div class="ink-actions">
        <a class="ink-button ink-button-primary" href={APP_STORE} target="_blank" rel="noopener noreferrer">Get it on the App Store ↗</a>
        <a class="ink-button" href="#beginning">Follow a pixel ↓</a>
      </div>
      <p class="ink-mono ink-hint" aria-hidden="true">Click or tap the squares</p>
    </div>
  </section>

  <!-- ───────── Light part: raw material, before we go inside ───────── -->
  <div class="ink-light">
    <section class="ink-statement" aria-label="Why Digital Ink exists">
      <div class="ink-wrap">
        <p class="ink-fill" data-ink-fill>Digital art is easy to copy without losing anything. That makes it feel disposable. In Digital Ink every pixel is <mark class="ink-chip">unique</mark>, and none can be duplicated.</p>
      </div>
    </section>

    <!-- 01 · Beginning -->
    <section class="ink-chapter" id="beginning" aria-labelledby="beginning-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">01</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">01 / Beginning</p>
        <h2 id="beginning-title" class="ink-mega">One work that holds <mark class="ink-chip">all of them</mark>.</h2>
        <p class="ink-sub">Turn each piece into a single pixel. Make every pixel unique.</p>
        <div class="ink-media ink-media-wide" data-reveal>
          <InkClip base="transformation" width={1120} height={510} label="Photos in the Transformation screen turning one by one into Smart Inks" hud="Transformation" caption="Photos becoming Smart Inks. Waiting time is shortened." />
        </div>
        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>Digital Ink began in the summer of 2025, in a village in a forest in Georgia, Chateau Chapiteau. I had more than 300 digital works and wanted to make one work that held all of them. The idea was to turn each piece into a single pixel, and to make every pixel unique, so that it could not be copied.</p>
            <p>Digital art is easy to copy without losing anything, and I think that makes it feel disposable. I wanted something people would value more: sentimentally, and maybe one day in other ways too. Digital scarcity was in the air then, and I was curious what it would feel like inside an artwork.</p>
            <p>So I call each of these squares a <strong>Smart Ink</strong>: one colour, a finite supply of it and a growing record. A collection holds up to 1,000 on one iPad, and none can be duplicated. I hoped people would look after their pixels and use them again.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- Three places: big type that slides sideways on large screens -->
    <section class="ink-places" id="places" aria-labelledby="places-title" data-ink-places>
      <div class="ink-places-stick">
        <div class="ink-wrap ink-places-head">
          <p class="ink-mono ink-label">Three places <span class="ink-places-count" data-ink-places-count aria-hidden="true">01 / 03</span></p>
          <h2 id="places-title" class="ink-mega">Where an Ink <mark class="ink-chip">lives</mark>.</h2>
        </div>
        <div class="ink-places-track" data-ink-places-track>
          <article class="ink-place">
            <p class="ink-mono ink-place-num" aria-hidden="true">01</p>
            <h3 class="ink-place-word is-outline">Ink Home</h3>
            <p class="ink-place-line">A place to explore the materials.</p>
          </article>
          <article class="ink-place">
            <p class="ink-mono ink-place-num" aria-hidden="true">02</p>
            <h3 class="ink-place-word">Canvas</h3>
            <p class="ink-place-line">A place to draw with them.</p>
          </article>
          <article class="ink-place">
            <p class="ink-mono ink-place-num" aria-hidden="true">03</p>
            <h3 class="ink-place-word is-outline">Gallery</h3>
            <p class="ink-place-line">A place to see the finished work.</p>
          </article>
        </div>
      </div>
    </section>
  </div>

  <!-- ───────── Slow fall from light into the app’s own dusk ───────── -->
  <div class="ink-dissolve ink-dissolve--in" data-ink-dissolve="in" aria-hidden="true"><canvas></canvas></div>

  <!-- ───────── Dusk part: inside the app ───────── -->
  <div class="ink-dusk" id="ink-dusk" data-ink-dusk>
    <!-- 02 · Memory -->
    <section class="ink-chapter" id="memory" aria-labelledby="memory-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">02</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">02 / Memory</p>
        <h2 id="memory-title" class="ink-mega ink-mega--long">The machine describes the picture. The <mark class="ink-chip">memory</mark> stays with you.</h2>
        <p class="ink-sub">A machine writes the description. It only knows what it can see.</p>

        <div class="ink-memory-grid" data-reveal>
          <InkClip base="ink-bio-a" width={1120} height={1186} label="Scrolling through the biography of an Ink: memory, provenance and essence" hud="Ink BIO" caption="An Ink’s biography." />
          <figure class="ink-figure">
            <a class="ink-frame ink-zoom" href="/images/dink/reconstructed-memory.webp" data-hud="Reconstructed memory" data-ink-zoom data-alt="A reconstructed memory: a collage around the pixelated flower, imagined by AI.">
              <img src="/images/dink/reconstructed-memory.webp" width="1179" height="978" loading="lazy" decoding="async" alt="A reconstructed memory: a collage around the pixelated flower, imagined by AI." />
            </a>
            <figcaption>A reconstruction is a new invention, never a recovered photograph.</figcaption>
          </figure>
        </div>

        <div class="ink-duo" data-reveal>
          <p class="ink-duo-a"><span class="ink-mono">The machine saw</span>“A whimsical pixelated flower amidst a sea of darkness.”</p>
          <p class="ink-duo-b"><span class="ink-mono">You remember</span>what the image <mark class="ink-chip">never showed</mark>.</p>
        </div>

        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>The description an Ink carries is written by a machine, and it only knows what it can see. It can be a little wrong, and it cannot know when, where or why I made the picture. That is fine. It is a neutral caption, something that helps me remember, or helps me show the picture to someone else. When you bring photos in, you can also add a short memory of your own; it appears in the Ink’s biography next to the machine’s description.</p>
            <p>What matters sits somewhere else, with the person who owns the Ink: the layers of feeling and memory an image holds for them. An Ink is unique because of its code, but just as much because of that.</p>
          </div>
        </details>
      </div>
    </section>

    <InkMarquee words={["One colour", "A finite supply", "A growing record"]} direction={-1} />

    <!-- 03 · Canvas -->
    <section class="ink-chapter" id="canvas" aria-labelledby="canvas-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">03</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">03 / Canvas</p>
        <h2 id="canvas-title" class="ink-mega">You draw with <mark class="ink-chip">what you have</mark>.</h2>
        <p class="ink-sub">Drawing spends an Ink, and erasing gives it back.</p>

        <figure class="ink-stat" data-reveal data-bars>
          <p class="ink-stat-line"><b class="ink-stat-num" data-count="406">406</b><span>of 587 Inks are grey.</span></p>
          <div class="ink-palette-bar" role="img" aria-label="Share of each colour in the artist’s collection: grey 406, yellow 85, blue 40, black 32, green 19, red 3, magenta 1, white 1.">
            {palette.map((colour, index) => (
              <span style={`flex:${colour.count} 1 0;background:${colour.colour};--i:${index}`} title={`${colour.name}: ${colour.count}`}></span>
            ))}
          </div>
          <ul class="ink-palette-legend ink-mono">
            {palette.map((colour) => (
              <li><i style={`background:${colour.colour}`}></i>{colour.name} <b data-count={colour.count}>{colour.count}</b></li>
            ))}
          </ul>
          <figcaption>My collection on 20 November 2026. Mostly grey.</figcaption>
        </figure>

        <div class="ink-media-row" data-reveal>
          <InkClip base="draw-mushroom" width={1024} height={1328} label="A mushroom taking shape on the Canvas, pixel by pixel" hud="Canvas" caption="A mushroom taking shape. Sped up." />
          <figure class="ink-figure">
            <a class="ink-frame ink-zoom" href="/images/dink/emotional-palette.webp" data-hud="Emotional palette" data-ink-zoom data-alt="The emotional palette: Inks grouped by air, earth, fire, love, mushroom and water, with the mushroom group open.">
              <img src="/images/dink/emotional-palette.webp" width="1400" height="1805" loading="lazy" decoding="async" alt="The emotional palette: Inks grouped by air, earth, fire, love, mushroom and water, with the mushroom group open." />
            </a>
            <figcaption>The emotional palette: air, earth, fire, love, mushroom, water.</figcaption>
          </figure>
        </div>

        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>Drawing spends an Ink, and erasing gives it back. Every pixel you place stays connected to the photo it came from.</p>
            <p>Colours run out. When one does, I look through my photographs and artworks for another whose average colour comes close. It is harder than it sounds: most images average out to grey or swamp green. So I draw with what I have, not with what I imagined.</p>
            <p>I suspect the limit is part of the point. The materials have their own character, and they do not always agree with the picture in my head.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- 04 · Connections: type and one line, no screenshots -->
    <section class="ink-chapter" id="connections" aria-labelledby="connections-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">04</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">04 / Connections</p>
        <h2 id="connections-title" class="ink-mega">Follow the <mark class="ink-chip">connections</mark>.</h2>
        <p class="ink-sub">A connection can be active or historical without erasing what came before.</p>
        <div class="ink-link-demo" data-reveal aria-hidden="true">
          <span class="ink-link-node is-active"><i></i><b class="ink-mono">Active</b></span>
          <span class="ink-link-line"></span>
          <span class="ink-link-node"><i></i><b class="ink-mono">Historical</b></span>
        </div>
        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>Ink Home gives the collection a place to live, in 2D or in 3D. You can follow the links between Inks, and a connection can be active or historical without erasing what came before. Inks can also stay unconnected.</p>
            <p>An Ink can be handed to another iPad, but never copied. It leaves one device and arrives on the other, and only one of them can use it at a time.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- 05 · School: pure type -->
    <section class="ink-chapter ink-school" id="school" aria-labelledby="school-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">05</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">05 / School</p>
        <h2 id="school-title" class="ink-mega">Something to <mark class="ink-chip">look after</mark>.</h2>
        <p class="ink-glowline" data-reveal>From level 4, an Ink begins to <em>glow</em>.</p>
        <p class="ink-sub">School began as a small game, a bit like a Tamagotchi.</p>
        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>School began as a small game, a bit like a Tamagotchi. You can add short books for your Inks, or short pieces you like, and let them study. Today the effect is visible rather than deep: as an Ink returns to school and its education grows, from level 4 it begins to glow and move a little differently on the Canvas, so it stands out from the others.</p>
            <p>Later, what an Ink has learned might shape its character, how it behaves at home and the connections it makes. That part is an idea, not a feature yet. I like that the project stays alive: new ideas arrive, and the technology to try them arrives later.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- 06 · Gallery -->
    <section class="ink-chapter" id="gallery" aria-labelledby="gallery-title" data-ink-chapter>
      <span class="ink-ghost" aria-hidden="true">06</span>
      <div class="ink-wrap">
        <p class="ink-mono ink-label">06 / Gallery</p>
        <h2 id="gallery-title" class="ink-mega ink-mega--long">When the picture is finished, it <mark class="ink-chip">goes quiet</mark>.</h2>
        <p class="ink-sub">Here, interpretation belongs to the person looking.</p>
        <figure class="ink-figure ink-gallery" data-reveal>
          <a class="ink-frame ink-zoom" href="/images/dink/gallery.webp" data-hud="Gallery" data-ink-zoom data-alt="The Gallery with two finished works, a mushroom made from 38 Inks and a flower made from 117 Inks.">
            <img src="/images/dink/gallery.webp" width="1380" height="1127" loading="lazy" decoding="async" alt="The Gallery with two finished works, a mushroom made from 38 Inks and a flower made from 117 Inks." />
          </a>
          <figcaption>Two works from my Gallery, made from 38 and 117 Inks.</figcaption>
        </figure>
        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>A finished work enters the Gallery and the image becomes quiet again. You can look into the Inks that made it and follow their histories, or simply spend time with the picture. Here, interpretation belongs to the person looking.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- Made first for myself -->
    <section class="ink-chapter ink-about" aria-labelledby="about-title">
      <div class="ink-wrap">
        <p class="ink-mono ink-label">About</p>
        <h2 id="about-title" class="ink-mega">Made first for <mark class="ink-chip">myself</mark>.</h2>
        <p class="ink-sub">An art installation I could carry in an iPad.</p>
        <details class="ink-more">
          <summary><span class="ink-mono">Read the story</span><i aria-hidden="true"></i></summary>
          <div class="ink-more-body">
            <p>I made Digital Ink first for myself. I wanted an art installation I could carry in an iPad, and I wanted to learn to build software with AI. In September 2025 I knew very little about code; since then I have worked with AI coding tools and learned as I went.</p>
            <p>I am not sure who else needs it. Probably people a little strange in the same way I am: people with too many pictures, who like small rules and slow things. If that is you, it is on the App Store. If not, I hope it is still interesting to look at.</p>
          </div>
        </details>
      </div>
    </section>
  </div>

  <!-- ───────── Back into the light ───────── -->
  <div class="ink-dissolve ink-dissolve--out" data-ink-dissolve="out" aria-hidden="true"><canvas></canvas></div>

  <div class="ink-finale" id="get-it">
    <InkMarquee words={["Every pixel", "has a past"]} direction={1} />

    <section class="ink-finale-main" aria-labelledby="cta-title">
      <div class="ink-wrap">
        <p class="ink-mono ink-label">Digital Ink · version 3.2</p>
        <h2 id="cta-title" class="ink-mega ink-finale-title">Digital Ink <span>for iPad</span></h2>
        <p class="ink-sub">Free on the App Store. Requires iPadOS 26 or later. iPad only.</p>
        <div class="ink-actions">
          <a class="ink-button ink-button-primary ink-button-lg" href={APP_STORE} target="_blank" rel="noopener noreferrer">Get it on the App Store ↗</a>
          <a class="ink-button ink-button-lg" href="/privacy/">Read the privacy policy</a>
        </div>
        <p class="ink-fine">The app is free. The optional online description and memory reconstruction use a few credits, because they run on paid AI services.</p>

        <div class="ink-privacy">
          <h3>You decide what is shared</h3>
          <p>Drawing and most Ink information stay on your iPad. Two features are optional and always ask first: an online description, which sends the selected image and its place name through Digital Ink’s service to OpenAI, and a memory reconstruction, which can share a small private trace of the image only if you choose to. Buying credits is not consent to share anything.</p>
          <a class="ink-text-link" href="/privacy/">Read the Digital Ink Privacy Policy ↗</a>
        </div>

        <details class="ink-record" id="technical-record">
          <summary>
            <span>
              <span class="ink-mono ink-label">Open system notes</span>
              <span class="ink-record-title" id="record-title">Under the hood</span>
              <span class="ink-record-invite">For people who want the technical version.</span>
            </span>
            <span class="ink-record-toggle" aria-hidden="true">+</span>
          </summary>
          <div class="ink-record-content">
            <p>Digital Ink is a native iPad application built in Swift and SwiftUI. Smart Inks and artworks are stored locally on the device. Online AI operations are optional and permission-based.</p>
            <section class="ink-record-section">
              <h3>App architecture</h3>
              <p>A native iPadOS application with local Smart Inks, artworks, biographies, education, relationship history and provenance. Optional online operations travel through Digital Ink’s Cloudflare service to OpenAI.</p>
            </section>
            <section class="ink-record-section">
              <h3>Smart Ink data &amp; source traces</h3>
              <p>A selected image becomes finite material with a representative colour, identity and recorded origin. An Ink can carry seven kinds of information, with source evidence, personal notes, learned concepts and machine invention kept distinct.</p>
              <dl class="ink-traces">
                {inkTraces.map((trace) => (<div><dt>{trace.name}</dt><dd>{trace.text}</dd></div>))}
              </dl>
            </section>
            <section class="ink-record-section">
              <h3>Scarcity &amp; Ink rules</h3>
              <p>Painting spends finite Ink; erasing can return material. Placed pixels remain connected to their source Ink. Colour, use and recorded history belong to the material rather than an unlimited colour picker.</p>
            </section>
            <section class="ink-record-section">
              <h3>Education</h3>
              <p>Selected texts and PDFs can add learned concepts to an Ink. These acquired concepts remain distinct from its original visual description and from personal notes. Education contributes to a developing biography; it is not a claim of consciousness.</p>
            </section>
            <section class="ink-record-section">
              <h3>Relationships &amp; Ink Home</h3>
              <p>Ink Home gives the collection a spatial form, with recorded connections and routes visible in a projected 3D environment. A connection can become active, dormant or historical without silently erasing its earlier state.</p>
            </section>
            <section class="ink-record-section">
              <h3>Provenance</h3>
              <p>An artwork can record who made it and which Smart Inks were involved. New artworks can carry stronger cryptographic verification without pretending older Inks always had it. Older records remain marked as Heritage Ink where the original evidence is incomplete.</p>
            </section>
            <section class="ink-record-section">
              <h3>Privacy, AI &amp; model information</h3>
              <div class="ink-boundaries">
                <article><h4>On device · Apple Vision</h4><p>Apple-provided visual recognition can analyse selected images without credits or an internet connection. Its interpretations may be limited or inaccurate. Local Ink information stays on the device unless you choose a feature that shares selected information.</p></article>
                <article><h4>Optional online · OpenAI</h4><p>With explicit permission for the operation, selected information travels through Cloudflare to OpenAI. Online descriptions and memory reconstructions use credits. Purchasing credits is never treated as consent.</p><p>Reconstruction generates a new image. It is an invention, never presented as recovery of the source photograph.</p></article>
              </div>
            </section>
            <section class="ink-record-section">
              <h3>How it is made</h3>
              <p>Built with AI coding tools: Cursor, Antigravity, Codex and Claude Code. I started in September 2025 knowing very little about code and learned as I went.</p>
            </section>
          </div>
        </details>

        <aside class="ink-future" aria-labelledby="archive-title">
          <p class="ink-mono ink-label">For the curious · a future project</p>
          <h3 id="archive-title">The 116-Pixel Archive</h3>
          <p>116 photographs would become 116 Smart Inks, so that their histories and relationships can grow as an artwork of their own. I would like to build it on Digital Ink so that it can be used on a phone. It does not exist yet.</p>
        </aside>
      </div>
    </section>

    <footer class="ink-footer">
      <div class="ink-wrap">
        <p>Digital Ink<br /><span>An ongoing artwork by Alexander Sestakovs / Q888</span></p>
        <nav aria-label="Digital Ink links">
          <a href={APP_STORE} target="_blank" rel="noopener noreferrer">App Store ↗</a>
          <a href="/privacy/">Privacy policy</a>
          <a href="mailto:hello@q888.space">Contact</a>
        </nav>
      </div>
    </footer>
  </div>

  <dialog class="ink-lightbox" data-ink-lightbox aria-label="Enlarged screenshot">
    <button class="ink-lightbox-close" type="button" data-close aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</main>

<style>
  /* ───────── Tokens ───────── */
  .ink-page {
    --fog: #f5f5f5;
    --paper: #ebe9e5;
    --ink: #1a1a1a;
    --muted: #5d5b56;
    --dusk: #211d1b;
    --cream: #f8f2e8;
    --cream-muted: #d4ccbe;
    --plum: #614454;
    --amber: #82603b;
    --amber-text: #efc58a;
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
    --display: var(--font-door-display, "Bricolage Grotesque", "Arial Narrow", Arial, sans-serif);
    --serif: var(--font-door-serif, "Instrument Serif", Georgia, serif);
    --mono: var(--font-door-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    /* Theme of the current zone, set below for the light and the dusk parts. */
    --fg: var(--ink);
    --fg-muted: var(--muted);
    --line: rgba(26, 26, 26, 0.16);
    --accent: #8a6c0c;
    --chip: #f2c46b;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 400;
    color: var(--fg);
    background: var(--fog);
  }
  .ink-page :global(*) {
    box-sizing: border-box;
    min-inline-size: 0;
  }
  :where(.ink-page h1, .ink-page h2, .ink-page h3, .ink-page h4, .ink-page p, .ink-page figure, .ink-page ol, .ink-page ul, .ink-page dl) {
    margin: 0;
  }
  .ink-page :global(p) {
    overflow-wrap: break-word;
  }
  .ink-wrap {
    inline-size: 100%;
    max-inline-size: 1320px;
    margin-inline: auto;
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
  }
  .ink-mono {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .ink-light,
  .ink-finale {
    --fg: var(--ink);
    --fg-muted: var(--muted);
    --line: rgba(26, 26, 26, 0.16);
    --accent: #8a6c0c;
    --chip: #f2c46b;
    color: var(--fg);
  }
  .ink-dusk {
    --fg: var(--cream);
    --fg-muted: var(--cream-muted);
    --line: rgba(248, 242, 232, 0.18);
    --accent: var(--amber-text);
    --chip: var(--amber-text);
    color: var(--fg);
  }

  /* ───────── Hero ───────── */
  .ink-hero {
    position: relative;
    isolation: isolate;
    min-block-size: 100svh;
    display: flex;
    align-items: flex-start;
    padding-block: clamp(6rem, 14vh, 9rem) 6rem;
    background: linear-gradient(180deg, var(--fog) 0%, var(--fog) 70%, var(--paper) 100%);
    overflow: clip;
  }
  .ink-field {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    z-index: -1;
  }
  .ink-hero-inner {
    position: relative;
  }
  .ink-hero-meta {
    color: var(--muted);
    margin-block-end: 1.5rem;
  }
  /* The headline is enormous and inverts against whatever square is behind it. */
  .ink-page h1 {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: "wdth" 82;
    font-size: clamp(3.7rem, 15.8vw, 15rem);
    line-height: 0.84;
    letter-spacing: -0.04em;
    color: #fff;
    mix-blend-mode: difference;
  }
  .ink-h1-line {
    display: block;
  }
  .ink-past {
    position: relative;
    display: inline-block;
  }
  /* The empty square from the landing: Q888’s quiet authorship seal. */
  .ink-seal {
    position: absolute;
    inset-block-start: 0.08em;
    inset-inline-end: -0.16em;
    inline-size: 0.075em;
    aspect-ratio: 1;
    border: max(2px, 0.008em) solid currentColor;
    transform: rotate(-1.5deg);
  }
  .ink-hero-sub {
    margin-block-start: 2.25rem;
    max-inline-size: 24em;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: 1.25;
    color: var(--ink);
  }
  .ink-hint {
    margin-block-start: 2.25rem;
    color: var(--muted);
  }
  .ink-hud {
    position: absolute;
    inset-block-start: clamp(4.5rem, 9vh, 6rem);
    inset-inline: auto max(var(--gutter), env(safe-area-inset-right));
    z-index: 2;
    display: flex;
    gap: 1.75rem;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .ink-hud b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* The hero drifts away slowly as you leave it; each part moves on its own so the headline can blend with the field. */
  .ink-hero-inner > * {
    will-change: transform;
  }

  /* ───────── Buttons ───────── */
  .ink-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
  .ink-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 48px;
    padding: 0.7rem 1.4rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .ink-button:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .ink-button-lg {
    min-block-size: 58px;
    padding-inline: 1.9rem;
    font-size: 1.1rem;
  }
  .ink-button-primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--fog);
  }
  .ink-button-primary:hover {
    background: #000;
  }
  .ink-button:focus-visible,
  .ink-text-link:focus-visible,
  .ink-dots a:focus-visible,
  .ink-zoom:focus-visible,
  .ink-more summary:focus-visible,
  .ink-record summary:focus-visible,
  .ink-footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ───────── Light zone ───────── */
  .ink-light {
    background: var(--paper);
  }
  .ink-statement {
    padding-block: clamp(5rem, 14vw, 11rem) clamp(2rem, 5vw, 4rem);
  }
  .ink-fill {
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: "wdth" 88;
    font-size: clamp(2.2rem, 6.4vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-inline-size: 22ch;
    text-wrap: balance;
  }
  :global(html.ink-js) .ink-fill :global(.ink-fw) {
    opacity: calc(0.16 + var(--on, 0) * 0.84);
  }

  /* ───────── Chapters ───────── */
  .ink-chapter {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4.5rem, 11vw, 9rem);
  }
  .ink-chapter > .ink-wrap {
    position: relative;
    z-index: 1;
  }
  #memory { --accent: #f6a8cd; --chip: #f6a8cd; }
  #canvas { --accent: #b9e29f; --chip: #b9e29f; }
  #connections { --accent: #f0a24a; --chip: #f0a24a; }
  #school { --accent: #f8d97f; --chip: #f8d97f; }
  #gallery { --accent: #f8f2e8; --chip: #f8f2e8; }
  .ink-label {
    color: var(--accent);
    margin-block-end: 1.25rem;
  }
  /* Enormous, contrasting headlines carry the story; the paragraphs are optional. */
  .ink-mega {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: "wdth" 84;
    font-size: clamp(2.9rem, 8.4vw, 8.2rem);
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-wrap: balance;
    max-inline-size: 15ch;
  }
  .ink-mega--long {
    font-size: clamp(2.5rem, 6.2vw, 6rem);
    max-inline-size: 20ch;
  }
  .ink-chip {
    display: inline-block;
    padding: 0 0.14em 0.05em;
    margin-inline: 0.02em;
    color: #1f1a17;
    background: var(--chip);
  }
  .ink-sub {
    margin-block-start: 1.75rem;
    max-inline-size: 28ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.2;
    color: var(--fg);
  }

  /* Ghost numerals behind the chapters. They are real elements so they can glide on their own layer. */
  .ink-ghost {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-end: 2vw;
    z-index: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(10rem, 30vw, 26rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 38%, transparent);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  /* ───────── Read more ───────── */
  .ink-more {
    margin-block-start: 2.5rem;
  }
  .ink-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-block-size: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    list-style: none;
    color: var(--fg);
  }
  .ink-more summary::-webkit-details-marker {
    display: none;
  }
  .ink-more summary i {
    position: relative;
    inline-size: 0.8rem;
    block-size: 0.8rem;
    transition: transform 0.3s ease;
  }
  .ink-more summary i::before,
  .ink-more summary i::after {
    content: "";
    position: absolute;
    background: currentColor;
    inset: 50% 0 auto 0;
    block-size: 1px;
  }
  .ink-more summary i::after {
    transform: rotate(90deg);
  }
  .ink-more[open] summary i {
    transform: rotate(45deg);
  }
  .ink-more-body {
    margin-block-start: 1.75rem;
    max-inline-size: 40rem;
  }
  .ink-more-body p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--fg);
  }
  .ink-more-body p + p {
    margin-block-start: 1.1rem;
  }
  .ink-more-body strong {
    font-weight: 600;
    color: var(--accent);
  }

  /* ───────── Media ───────── */
  .ink-page :global(.ink-frame) {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 18px;
    background: #17140f;
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -40px rgba(20, 16, 12, 0.55);
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.4s ease, box-shadow 0.5s ease;
  }
  .ink-page :global(.ink-frame img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .ink-page :global(.ink-frame)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--lx, 50%) var(--ly, 0%), rgba(255, 255, 255, 0.2), transparent 55%);
    opacity: var(--glare, 0);
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  /* In the dusk the dark screens sit on a cream mat, like a print on a table, so they never sink into the background. */
  .ink-dusk :global(.ink-frame) {
    border: 0;
    padding: clamp(8px, 1vw, 14px);
    background: var(--cream);
    border-radius: 22px;
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.85), 0 0 90px -24px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .ink-dusk :global(.ink-frame img),
  .ink-dusk :global(.ink-frame video) {
    border-radius: 12px;
  }
  .ink-dusk :global(.ink-clip-frame) {
    background: var(--cream);
  }
  .ink-page :global(.ink-frame)::before {
    content: attr(data-hud);
    position: absolute;
    inset: 0.8rem auto auto 0.9rem;
    z-index: 2;
    padding: 0.35rem 0.6rem;
    font: 500 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f8f2e8;
    background: rgba(24, 20, 18, 0.7);
    border: 1px solid rgba(248, 242, 232, 0.28);
    pointer-events: none;
  }
  .ink-dusk :global(.ink-frame)::before {
    inset: calc(clamp(8px, 1vw, 14px) + 0.8rem) auto auto calc(clamp(8px, 1vw, 14px) + 0.9rem);
  }
  .ink-page :global(.ink-frame:not([data-hud]))::before {
    display: none;
  }
  .ink-zoom {
    cursor: zoom-in;
  }
  .ink-page :global(figcaption) {
    margin-block-start: 0.9rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.55;
    color: var(--fg-muted);
    max-inline-size: 34rem;
  }
  .ink-media-wide {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    max-inline-size: 70rem;
  }
  .ink-media-row {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-block-start: clamp(3rem, 7vw, 5rem);
  }
  .ink-memory-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }
  .ink-gallery {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    max-inline-size: 64rem;
  }

  /* Memory: what the machine saw, and what you remember. Pure type. */
  .ink-duo {
    margin-block-start: clamp(3.5rem, 8vw, 7rem);
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .ink-duo .ink-mono {
    display: block;
    margin-block-end: 0.6rem;
    color: var(--accent);
  }
  .ink-duo-a {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.6rem, 3.6vw, 3.4rem);
    line-height: 1.12;
    color: var(--fg-muted);
    max-inline-size: 26ch;
  }
  .ink-duo-b {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: "wdth" 84;
    font-size: clamp(2.4rem, 7.4vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    max-inline-size: 14ch;
  }

  /* Canvas: one big number says it better than a legend. */
  .ink-stat {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    max-inline-size: 60rem;
  }
  .ink-stat-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem clamp(1rem, 2.4vw, 2rem);
  }
  .ink-stat-num {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: "wdth" 80;
    font-size: clamp(6rem, 22vw, 18rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--chip);
    font-variant-numeric: tabular-nums;
  }
  .ink-stat-line span {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    line-height: 1.1;
  }
  .ink-palette-bar {
    display: flex;
    block-size: 3rem;
    gap: 2px;
    margin-block-start: 2rem;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .ink-palette-bar span {
    display: block;
    min-inline-size: 4px;
  }
  .ink-palette-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0;
    margin-block-start: 0.85rem;
    list-style: none;
    color: var(--fg-muted);
  }
  .ink-palette-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ink-palette-legend i {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border: 1px solid rgba(248, 242, 232, 0.35);
  }
  .ink-palette-legend b {
    font-weight: 500;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  :global(html.ink-js) .ink-palette-bar span {
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: calc(var(--i, 0) * 110ms);
  }
  :global(html.ink-js) .ink-stat.is-in .ink-palette-bar span {
    transform: none;
  }

  /* Connections: two squares and the line between them, drawn as you arrive. */
  .ink-link-demo {
    display: flex;
    align-items: center;
    max-inline-size: 56rem;
    margin-block-start: clamp(3rem, 7vw, 5rem);
  }
  .ink-link-node {
    position: relative;
    flex: none;
    display: grid;
    justify-items: center;
  }
  .ink-link-node i {
    display: block;
    inline-size: clamp(3rem, 8vw, 6rem);
    aspect-ratio: 1;
    border: 2px solid var(--accent);
    opacity: 0.55;
  }
  .ink-link-node.is-active i {
    background: var(--accent);
    opacity: 1;
    box-shadow: 0 0 60px -6px var(--accent);
  }
  .ink-link-node b {
    position: absolute;
    inset-block-start: calc(100% + 0.8rem);
    font-weight: 500;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .ink-link-line {
    flex: 1;
    block-size: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  :global(html.ink-js) .ink-link-line {
    transform: scaleX(0);
    transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.1, 1) 0.3s;
  }
  :global(html.ink-js) .ink-link-demo.is-in .ink-link-line {
    transform: none;
  }

  /* School: type that glows. */
  .ink-glowline {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: "wdth" 86;
    font-size: clamp(2.2rem, 6.6vw, 6.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    max-inline-size: 16ch;
  }
  .ink-glowline em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--chip);
    text-shadow: 0 0 0 transparent;
    animation: ink-glow 7s ease-in-out infinite;
  }
  @keyframes ink-glow {
    0%, 100% { text-shadow: 0 0 0 rgba(248, 217, 127, 0); }
    50% { text-shadow: 0 0 28px rgba(248, 217, 127, 0.85), 0 0 70px rgba(248, 217, 127, 0.45); }
  }

  /* ───────── Three places ───────── */
  .ink-places {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .ink-places-count {
    margin-inline-start: 1rem;
    color: var(--fg-muted);
  }
  .ink-places-track {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
    margin-block-start: clamp(2rem, 5vw, 3rem);
  }
  .ink-place-num {
    color: var(--accent);
    margin-block-end: 0.5rem;
  }
  .ink-place-word {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: "wdth" 80;
    font-size: clamp(4.2rem, 19vw, 17rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--fg);
  }
  .ink-place-word.is-outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
  }
  .ink-place-line {
    margin-block-start: 1rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    color: var(--fg);
  }

  /* ───────── Slow dissolve between light and dusk ───────── */
  .ink-dissolve {
    position: relative;
    block-size: clamp(60svh, 90svh, 60rem);
    overflow: hidden;
  }
  .ink-dissolve--in {
    background: linear-gradient(180deg, var(--paper), var(--dusk));
  }
  .ink-dissolve--out {
    background: linear-gradient(180deg, var(--dusk), var(--fog));
  }
  .ink-dissolve canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }
  :global(html.ink-js) .ink-dissolve--in {
    background: var(--paper);
  }
  :global(html.ink-js) .ink-dissolve--out {
    background: var(--dusk);
  }

  /* ───────── Dusk zone ───────── */
  .ink-dusk {
    position: relative;
    background:
      radial-gradient(64rem 42rem at 6% -4%, rgba(176, 82, 138, 0.4), transparent 70%),
      radial-gradient(58rem 40rem at 104% 28%, rgba(226, 150, 64, 0.32), transparent 70%),
      radial-gradient(60rem 44rem at -2% 66%, rgba(112, 92, 204, 0.26), transparent 70%),
      radial-gradient(52rem 38rem at 100% 90%, rgba(176, 82, 138, 0.3), transparent 70%),
      var(--dusk);
  }
  .ink-dusk .ink-button-primary {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--dusk);
  }

  /* ───────── Finale: back in the light, like the landing ───────── */
  .ink-finale {
    background: var(--fog);
  }
  .ink-finale-main {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 8vw, 6rem);
  }
  .ink-finale-title {
    max-inline-size: none;
    font-size: clamp(3.4rem, 13vw, 13rem);
    line-height: 0.88;
  }
  .ink-finale-title span {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: -0.02em;
  }
  .ink-fine {
    margin-block-start: 1.5rem;
    max-inline-size: 38rem;
