<script>
  // Time-lock: DM-0001 card unblurs on 2028-01-01 (matches the drawer logic).
  function revealDm() {
    document.querySelectorAll<HTMLElement>(".dm-classified-wrap[data-reveal-at]").forEach((el) => {
      const at = new Date(el.dataset.revealAt || "");
      if (Number.isNaN(at.getTime()) || new Date() < at) return;
      el.classList.remove("dm-classified-wrap");
      el.querySelector(".dm-classified-overlay")?.remove();
    });
  }
  revealDm();
  document.addEventListener("astro:page-load", revealDm);
