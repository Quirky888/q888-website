<script>
  (function () {
    const content = document.querySelector("[data-ticker-content]");
    if (!(content instanceof HTMLElement)) return;

    const unit = content.querySelector("[data-ticker-unit]");
    if (!(unit instanceof HTMLElement)) return;

    const pixelsPerSecond = 88;

    const applyTickerMetrics = function () {
      const width = Math.ceil(unit.getBoundingClientRect().width);
      if (width <= 0) return;
      content.style.setProperty("--ticker-distance", `${width}px`);
      content.style.setProperty("--ticker-duration", `${width / pixelsPerSecond}s`);
    };

    const initWhenReady = async function () {
      if (document.fonts && document.fonts.ready) {
        try {
          await document.fonts.ready;
        } catch {}
      }
      requestAnimationFrame(function () {
        requestAnimationFrame(applyTickerMetrics);
      });
    };

    initWhenReady();

    const io = new IntersectionObserver(function (entries) {
      if (entries.some(function (entry) { return entry.isIntersecting; })) {
        applyTickerMetrics();
        io.disconnect();
      }
    });
    io.observe(content);

    let resizeTimer = 0;
    const handleResize = function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyTickerMetrics, 150);
    };
    window.addEventListener("resize", handleResize, { passive: true });

    function cleanup() {
      window.removeEventListener("resize", handleResize);
      window.clearTimeout(resizeTimer);
      io.disconnect();
      document.removeEventListener("astro:before-swap", cleanup);
      window.removeEventListener("beforeunload", cleanup);
    }
    document.addEventListener("astro:before-swap", cleanup);
    window.addEventListener("beforeunload", cleanup);
  })();
</script>

