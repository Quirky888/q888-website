<script>
  (function () {
    const content = document.querySelector("[data-ticker-content]");
    if (!(content instanceof HTMLElement)) return;

    const unit = content.querySelector("[data-ticker-unit]");
    if (!(unit instanceof HTMLElement)) return;

    const pixelsPerSecond = 88;

    const applyTickerMetrics = function () {
      const width = Math.ceil(unit.getBoundingClientRect().width);
      if (width <= 0) return;
      content.style.setProperty("--ticker-distance", `${width}px`);
      content.style.setProperty("--ticker-duration", `${width / pixelsPerSecond}s`);
    };

    const initWhenReady = async function () {
      if (document.fonts && document.fonts.ready) {
        try {
          await document.fonts.ready;
        } catch {}
      }
      requestAnimationFrame(function () {
        requestAnimationFrame(applyTickerMetrics);
      });
    };

    initWhenReady();

    const io = new IntersectionObserver(function (entries) {
      if (entries.some(function (entry) { return entry.isIntersecting; })) {
        applyTickerMetrics();
        io.disconnect();
      }
    });
    io.observe(content);

    let resizeTimer = 0;
    const handleResize = function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyTickerMetrics, 150);
    };
    window.addEventListener("resize", handleResize, { passive: true });

    function cleanup() {
      window.removeEventListener("resize", handleResize);
      window.clearTimeout(resizeTimer);
      io.disconnect();
      document.removeEventListener("astro:before-swap", cleanup);
      window.removeEventListener("beforeunload", cleanup);
    }
    document.addEventListener("astro:before-swap", cleanup);
    window.addEventListener("beforeunload", cleanup);
  })();
</script>

<script is:inline define:vars={{ instruments, activeStickerId }}>
  (function () {
    window.toggleTermsModal = function () {
      const modal = document.getElementById("termsModal");
      if (!modal) return;
      modal.classList.toggle("hidden");

      if (!modal.classList.contains("hidden")) {
        if (!document.body.classList.contains("overflow-hidden")) {
          modal.setAttribute("data-prev-body-overflow", document.body.style.overflow || "");
          document.body.style.overflow = "hidden";
        }
      } else {
        const prev = modal.getAttribute("data-prev-body-overflow");
        if (prev !== null) {
          document.body.style.overflow = prev;
          modal.removeAttribute("data-prev-body-overflow");
        } else if (!document.body.classList.contains("overflow-hidden")) {
          document.body.style.overflow = "";
        }
      }
    };

    if (!document.documentElement.dataset.termsModalTouchCloseBound) {
      document.documentElement.dataset.termsModalTouchCloseBound = "1";
      document.addEventListener("touchend", (e) => {
        if (e.target?.closest?.(".terms-modal-close")) {
          e.preventDefault();
          window.toggleTermsModal?.();
        }
      }, { passive: false });
    }

    const drawer = document.getElementById("sticker-detail-drawer");
    const triggers = document.querySelectorAll("[data-drawer-trigger=\"sticker-detail\"]");
    const closeBtn = drawer?.querySelector("[data-close-drawer]");
    const tickerEl = drawer?.querySelector("[data-sticker-ticker]");
    const titleEl = drawer?.querySelector("[data-sticker-title]");
    const taglineEl = drawer?.querySelector("[data-sticker-tagline]");
    const imageEl = drawer?.querySelector("[data-sticker-image]");
    const galleryEl = drawer?.querySelector("[data-sticker-gallery]");
    const descEl = drawer?.querySelector("[data-sticker-description]");
    const subscriptionEl = drawer?.querySelector("[data-sticker-subscription]");
    const theoryEl = drawer?.querySelector("[data-sticker-theory]");
    const playlistEl = drawer?.querySelector("[data-sticker-playlist]");
    const mattersEl = drawer?.querySelector("[data-sticker-matters]");
    const missionEl = drawer?.querySelector("[data-sticker-mission]");
    const downloadEl = drawer?.querySelector("[data-sticker-download]");
    const specsEl = drawer?.querySelector("[data-sticker-specs]");
    const linksEl = drawer?.querySelector("[data-sticker-links]");
    const metaEl = drawer?.querySelector("[data-sticker-meta]");
    const negotiateBtn = drawer?.querySelector("[data-sticker-negotiate-btn]");
    const emailEl = drawer?.querySelector("[data-sticker-email]");

    const data = Array.isArray(instruments) ? instruments : [];

    function openDrawer(id, shouldPushState = true) {
      const inst = data.find((i) => i.id === id || i.slug === id || i.id.toLowerCase() === id.toLowerCase() || (i.slug && i.slug.toLowerCase() === id.toLowerCase()));
      if (!drawer || !inst) return;
      
      drawer.setAttribute("data-current-instrument-id", inst.id);
      if (tickerEl) tickerEl.textContent = inst.ticker;
      if (titleEl) titleEl.textContent = inst.title;
      if (taglineEl) taglineEl.textContent = inst.tagline;
      
      const blurOverlay = drawer?.querySelector("[data-sticker-blur-overlay]");
      if (imageEl && inst.imageUrl) {
        imageEl.src = inst.imageUrl;
        imageEl.alt = inst.imageAlt || inst.title;
        imageEl.classList.remove("hidden");
        
        if (inst.id === 'DM-0001') {
          const targetDate = new Date('2028-01-01T00:00:00Z');
          if (new Date() < targetDate) {
            imageEl.style.filter = "blur(24px) brightness(0.6)";
            if (blurOverlay) blurOverlay.classList.remove("hidden");
          } else {
            imageEl.style.filter = "none";
            if (blurOverlay) blurOverlay.classList.add("hidden");
          }
        } else {
          imageEl.style.filter = "none";
          if (blurOverlay) blurOverlay.classList.add("hidden");
        }
      } else if (imageEl) {
        imageEl.classList.add("hidden");
        if (blurOverlay) blurOverlay.classList.add("hidden");
      }
      
      if (galleryEl && inst.gallery && inst.gallery.length > 0) {
        galleryEl.innerHTML = inst.gallery.map(url => 
          `<img src="${url}" alt="${inst.title} detail" class="w-full aspect-square object-cover border border-[var(--line-soft)] transition-transform duration-200 hover:scale-105" />`
        ).join('');
        galleryEl.classList.remove("hidden");
      } else if (galleryEl) {
        galleryEl.classList.add("hidden");
      }
      
      if (descEl && inst.description) {
        const paragraphs = inst.description.split('\n\n').filter(p => p.trim());
        descEl.innerHTML = paragraphs.map(p => `<p>${p.trim()}</p>`).join('');
        descEl.classList.remove("hidden");
      } else if (descEl) {
        descEl.classList.add("hidden");
      }

      if (subscriptionEl) {
        if (inst.subscriptionModel) {
          const escape = (s) =>
            String(s)
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;");
          const bold = (s) => escape(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
          const formatTerms = (md) => {
            const lines = String(md).split("\n");
            let html = "";
            let inList = false;
            for (const rawLine of lines) {
              const line = rawLine.replace(/\r/g, "");
              const trimmed = line.trim();
              if (!trimmed) {
                if (inList) {
                  html += "</ul>";
                  inList = false;
                }
                html += "<br>";
                continue;
              }
              if (trimmed.startsWith("- ")) {
                if (!inList) {
                  html += "<ul>";
                  inList = true;
                }
                html += `<li>${bold(trimmed.slice(2))}</li>`;
                continue;
              }
              if (inList) {
                html += "</ul>";
                inList = false;
              }
              html += `${bold(trimmed)}<br>`;
            }
            if (inList) html += "</ul>";
            return html;
          };

          const termsHtml = formatTerms(inst.subscriptionModel);

          if (inst.showTermsAsLink) {
            subscriptionEl.innerHTML = `
              <div class="terms-link-section">
                <button
                  class="terms-link-button"
                  onclick="toggleTermsModal()"
