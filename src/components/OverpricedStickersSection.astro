      font-size: 0.875rem !important;
    }
  }

  /* FONTS: Bricolage Grotesque for everything set in type, system mono for
     records and labels. Nothing else on this page. */
  .overpriced-stickers-outer,
  .sticker-drawer {
    --op-font: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
    --op-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-family: var(--op-font);
  }
  .op-mono {
    font-family: var(--op-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* RETURN POLICY: same two-column rhythm as the hero copy, so the page reads
     as one composition. Title left, policy right. */
  .return-policy {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .return-title {
    margin: 0;
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-ink);
  }
  .return-body {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.6;
    color: var(--text-muted);
  }
  @media (min-width: 900px) {
    .return-policy {
      grid-template-columns: 5fr 4fr;
      gap: clamp(3rem, 8vw, 9rem);
    }
  }
  .footer-back a {
    font-family: var(--op-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* SECTION HEADER */
  .instruments-section-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    font-family: var(--op-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .instruments-section-divider {
    flex: 1;
    height: 1px;
    background: var(--line-soft);
    min-width: 1rem;
  }
  @media (max-width: 520px) {
    .instruments-section-header span:last-child {
      display: none;
    }
  }

  /* THE HALL: every sticker shown whole, in an identical quiet frame, three
     to a row. The calm comes from repetition and space, not from variety. */
  .instruments-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 5.5rem) clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    margin-bottom: 6rem;
  }
  @media (min-width: 640px) {
    .instruments-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .instruments-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ex {
    display: block;
    min-width: 0;
    cursor: pointer;
    outline: none;
  }
  .ex-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    /* frosted glass plate: soft light from one corner, cooler grey in the
       other, a white edge and a faint shadow underneath */
    border-radius: 14px;
    background:
      radial-gradient(70% 55% at 18% 16%, rgba(255, 255, 255, 0.95), transparent 70%),
      radial-gradient(65% 55% at 88% 92%, rgba(186, 189, 196, 0.5), transparent 70%),
      color-mix(in srgb, var(--text-ink) 6%, var(--bg-fog));
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(0, 0, 0, 0.05),
      0 26px 40px -28px rgba(0, 0, 0, 0.3);
    outline: 1px solid transparent;
    outline-offset: 0;
    transition:
      outline-color 0.5s ease,
      outline-offset 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ex-art img {
    position: absolute;
    z-index: 1;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
    display: block;
    /* hairline edge plus a soft shadow: follows the sticker's own outline,
       so cut-outs show their shape and white prints show their edge */
    filter: drop-shadow(0 0 0.6px rgba(0, 0, 0, 0.5))
      drop-shadow(0 12px 18px rgba(0, 0, 0, 0.16));
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ex-label {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }
  .ex-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.85rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text-ink);
  }
  .ex-title::after {
    content: " →";
    display: inline-block;
    opacity: 0;
    transform: translateX(-0.5rem);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ex-tag {
    margin: 0;
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .ex-meta {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.25rem;
    font-family: var(--op-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ex-ask {
    color: var(--text-ink);
  }
  .ex:hover .ex-art,
  .ex:focus-visible .ex-art {
    outline-color: var(--text-ink);
    outline-offset: 9px;
  }
  .ex:hover .ex-art img,
  .ex:focus-visible .ex-art img {
    transform: scale(1.035);
  }
  .ex:hover .ex-title::after,
  .ex:focus-visible .ex-title::after {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ex-art,
    .ex-art img,
    .ex-title::after {
      transition: none;
    }
    .ex:hover .ex-art img {
      transform: none;
    }
  }

