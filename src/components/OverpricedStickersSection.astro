---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  activeStickerId?: string;
}

const { activeStickerId } = Astro.props;

type Instrument = CollectionEntry<"stickers">["data"];
const instruments: Instrument[] = (await getCollection("stickers"))
  .map(({ data }) => data)
  .sort((a, b) => a.sortOrder - b.sortOrder);

const visibleInstruments = instruments.filter((i) => i.imageUrl);
const activeCount = visibleInstruments.filter(
  (i) => i.status === "LISTED",
).length;
const tickerFont = "'Doto', ui-monospace, SFMono-Regular, monospace";
const tickerText = `Q888 DETECTED UNAUTHORIZED VALUE GROWTH - "STICKER" NOW A RECOGNIZED COMMODITY (IN 1 UNIVERSE) - MARKET SENTIMENT: HYPER-MYTHIC - ORDER #0008 LOST IN TIME LOOP — REFUND: PHILOSOPHICAL - EYE OF LAIMA APPROVES CURRENT PRICING — FOR NOW - ARTIFACT #KOTIKI-002 WHISPERING TO BUYER - STICKER MEMORY IMPRINTED ON 3.5 MINDS - 📉 VALUE COLLAPSE AVERTED VIA INTERDIMENSIONAL BUREAU - RETURN REQUEST DENIED: MEANING IRREVERSIBLE - INFLATION INDEX: FEELS-BASED - SAVED TO COLLECTOR'S DREAM CACHE - TRADING ENABLED | LIQUIDITY: COSMIC MIST - OWNERSHIP LOCKED | METAPHYSICAL RIGHTS UNCLEAR - ⚖️ LEGAL STATUS: UNCLASSIFIED ART-WEAPON - ANALYTICS SUGGEST STICKERS OUTPERFORMING GOLD (IN EMOTIONAL RETURN) - 🎲 RISK LEVEL: EXISTENTIALLY ATTRACTIVE - CLIPPED TO REALITY WITH DIMENSIONAL PAPERCLIP - STICKER MUTATING | RARITY +12% - LAST SEEN IN RIGA | THEN NOWHERE - 📡 SIGNAL LOST | VALUE ESTIMATED VIA VIBES - 🔥 DEMAND SPIKE | SUPPLY: STUBBORNLY MYTHIC - OVERPRICED KNIGHT RIDING STEADY AT £∞ - NAR-MAIL EXPRESS MISDELIVERS TO PARALLEL SELF - GHOST COLLECTOR SIGHTED | BIDS TRANSLATED PSYCHICALLY - VALUE ASSESSMENT UNDER DIVINE REVIEW - TRUTH ENGINE OFFLINE — PRICES DEFAULTING TO POETIC - INVESTOR FEELING: "STRANGELY COMFORTABLE" - LISTED IN FOLKLORE MARKET INDEX UNDER "WEIRDLY VALUABLE" - FUTURE VALUE: STILL NEGOTIATING WITH TIME - INFOCIGAN AVAILABLE FOR CONSULTATION — EMOTIONAL LIQUIDITY PENDING REVIEW - SQUARE BUBBLES COUNCIL UPDATES PRICING QUARTERLY VIA COSMIC FEELING - STICKER MARKET SUPERVISED BY AN ENTITY THAT DOESN'T TECHNICALLY EXIST YET - ACTIVE: ${activeCount} | Q888 STATUS: TERMINAL`;

const tickerUnit = `${tickerText} — `;
const statusLabel = (status: string) =>
  ({
    LISTED: "Listed",
    BEYOND_TRANSACTION: "Beyond transaction",
    SOLD_OUT: "Sold out",
    SOLD: "Sold",
    NEGOTIABLE: "Negotiable",
    SUBSCRIPTION: "Subscription",
    RESERVED: "Reserved",
  })[status] ?? status;
const editionLabel = (i: Instrument) =>
  ["POG-2026", "NAR-OOPS"].includes(i.id)
    ? `Edition ${i.editionTotal}`
    : typeof i.availableCount === "number"
      ? `Ed. ${i.availableCount}/${i.editionTotal}`
      : `Ed. ${i.availableCount}/${i.editionTotal}`;
const heroLines = ["Overpriced", "Stickers"].map((w) => w.split(""));
---

<section
  class="overpriced-stickers-outer w-full h-full relative"
  style="background:transparent!important;position:relative;overflow:hidden;z-index:1"
>
  <div
    class="overpriced-inner w-full max-w-[120rem] mx-auto px-6 md:px-12 lg:px-24 xl:px-32 pt-2 md:pt-4 lg:pt-6 pb-12 md:pb-16 lg:pb-24"
    style="background:transparent!important"
  >
    <header class="hero relative mb-24 md:mb-32 lg:mb-40" data-motion-reveal>
      <div class="hero-kicker" aria-hidden="true">
        <span>Overpriced Stickers Ingc.</span>
        <span class="hero-kicker-rule"></span>
        <span>Q888 · Infocigan</span>
      </div>
      <h1 class="hero-title" aria-label="Overpriced Stickers">
        {heroLines.map((letters, line) => (
          <span class:list={["hero-line", line === 1 && "hero-line-2"]} aria-hidden="true">
            {letters.map((ch, i) => (
              <span class="hero-ch" style={`--i:${i + line * 4}`}>{ch}</span>
            ))}
          </span>
        ))}
      </h1>
      <div class="hero-lower">
        <p class="hero-sub">We called them stickers. The market disagreed.</p>
        <div class="hero-copy">
          <p>
            The price is calculated from something else: rarity, story, and a
            modest amount of belief in the future.
          </p>
          <p>
            Whether a sticker appreciates or ends up covering a scratch on your
            laptop, both outcomes are approved by the Square Bubbles Council™.
          </p>
          <p>If anything, you are robbing me. I have accepted this.</p>
        </div>
      </div>
    </header>

    <div class="instruments-section-header" data-motion-reveal aria-hidden="true">
      <span>The instruments</span>
      <span class="instruments-section-divider" aria-hidden="true"></span>
      <span>Active listings</span>
    </div>

    <div
      class="instruments-grid"
      data-motion-stagger
      data-motion-children="[data-motion-item]"
    >
      {
        visibleInstruments.map((instrument) => (
          <article
            class="instrument-card ex"
            data-motion-item
            data-instrument-id={instrument.id}
            data-status={instrument.status}
            data-drawer-trigger="sticker-detail"
            tabindex="0"
            role="button"
            aria-label={`View details for ${instrument.title}`}
          >
            {instrument.imageUrl && (
              <div
                class:list={[
                  "ex-art",
                  instrument.id === "DM-0001" && "dm-classified-wrap",
                ]}
                data-reveal-at={instrument.id === "DM-0001" ? "2028-01-01T00:00:00Z" : undefined}
              >
                <Image
                  src={instrument.imageUrl}
                  alt={instrument.imageAlt || instrument.title}
                  loading="lazy"
                  width={900}
                  height={675}
                />
                {instrument.id === "DM-0001" && (
                  <div class="dm-classified-overlay" aria-hidden="true">
                    <div class="dm-classified-scan" />
                    <div class="dm-classified-label">
                      <span class="dm-classified-icon">◈</span>
                      <span class="dm-classified-text">
                        DESIGN
                        <br />
                        CLASSIFIED
                      </span>
                      <span class="dm-classified-sub">REVEAL: 2028</span>
                    </div>
                  </div>
                )}
              </div>
            )}
            <div class="ex-label">
              <h2 class="ex-title">{instrument.title}</h2>
              <p class="ex-tag">{instrument.tagline}</p>
              <div class="ex-meta">
                <span class="ex-ask">{instrument.ask}</span>
                <span>{instrument.ticker} · {editionLabel(instrument)}</span>
                <span>{statusLabel(instrument.status)}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <footer class="return-policy" data-motion-reveal>
      <h3 class="return-title">Return Policy</h3>
      <p class="return-body">
        Overpriced Stickers are sold as collectible art objects. All sales are
        final. No returns, no refunds. By initiating a trade you confirm that
        you understand the speculative nature of the instrument and accept full
        responsibility for your participation. Provenance is verified at point
        of sale; transfer of ownership is documented in the Q888 sales record.
        Existential claims on the object's meaning remain with the buyer.
        Emotional returns are not tracked but are statistically likely.
      </p>
    </footer>
    <div class="footer-back pt-14 pb-24">
      <a href="/#infocigan" class="panel-back hover:text-[var(--text-ink)] no-underline"
        >Retreat to Market</a
      >
    </div>
  </div>
</section>

<div
  id="sticker-detail-drawer"
  class="sticker-drawer fixed inset-0 z-[210] hidden bg-[var(--bg-fog)]/80 backdrop-blur-xl flex items-center justify-center p-4 md:p-8 overflow-y-auto"
  data-sticker-drawer
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Sticker instrument details"
>
  <button
    type="button"
    data-close-drawer
    class="absolute top-6 right-6 z-10 text-3xl font-light text-[var(--text-muted)] hover:text-[var(--text-ink)] transition-colors hidden lg:flex"
    aria-label="Close drawer">×</button
  >
  <div
    class="drawer-scrollable max-w-4xl w-full max-h-[80dvh] overflow-y-auto bg-[var(--bg-fog)] shadow-2xl ring-1 ring-[var(--line-soft)] prose prose-lg prose-headings:text-[var(--text-ink)] prose-p:text-[var(--text-muted)]"
  >
    <div class="drawer-content">
      <div class="rec-bar">
        <div class="rec-nav">
          <button type="button" class="rec-nav-btn" data-rec-prev aria-label="Previous sticker">←</button>
          <button type="button" class="rec-nav-btn" data-rec-next aria-label="Next sticker">→</button>
        </div>
        <span class="rec-count" data-rec-count aria-hidden="true"></span>
      </div>
      <div class="rec-grid">
        <div class="rec-art">
      <div
        class="drawer-image-hero w-full max-w-2xl mx-auto mb-8 rounded-2xl overflow-hidden border-4 border-[var(--line-soft)] shadow-2xl relative"
        data-sticker-image-container
      >
        <img
          data-sticker-image
          class="w-full h-[40dvh] md:h-[50dvh] object-contain object-center bg-[var(--bg-fog)]/50 hidden transition-all duration-700"
          alt=""
        />
        <div
          data-sticker-blur-overlay
          class="absolute inset-0 flex items-center justify-center p-4 bg-black/40 hidden pointer-events-none z-10"
        >
          <div
            class="flex flex-wrap justify-center items-center gap-x-2 gap-y-3 p-5 md:p-8 max-w-[95%] md:max-w-[85%] bg-black/60 backdrop-blur-[1px] border border-white/20 rounded-xl shadow-2xl -rotate-1 select-none"
            style="line-height: 1.2;"
          >
            <!-- IMAGE -->
            <div class="flex items-center gap-0.5">
              <span
                class="inline-block px-1.5 py-0.5 bg-white text-black font-serif text-xl md:text-2xl font-bold border border-black -rotate-3"
                >I</span
              >
              <span
                class="inline-block px-1 py-1 bg-[#ff00ff] text-white font-sans text-lg md:text-xl font-extrabold rotate-2"
                >M</span
              >
              <span
                class="inline-block px-1.5 py-0.5 bg-black text-[#ffe600] font-mono text-xl md:text-2xl rotate-6 border border-[#ffe600]"
                >A</span
              >
              <span
                class="inline-block px-2 py-0 bg-[#ffe600] text-black font-sans text-2xl md:text-3xl font-black -rotate-6"
                style="font-family: 'Black Han Sans', sans-serif;">G</span
              >
              <span
                class="inline-block px-1 py-0.5 bg-white text-[#ff00ff] font-serif text-lg md:text-xl font-black rotate-3 border-2 border-dashed border-[#ff00ff]"
                >E</span
              >
            </div>

            <!-- AVAILABLE -->
            <div class="flex items-center gap-0.5">
              <span
                class="inline-block px-2.5 py-1 bg-black text-white font-sans text-lg md:text-xl font-black -rotate-3"
                style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.15em;"
                >AVAIL</span
              >
              <span
                class="inline-block px-2 py-0.5 bg-[#00ffff] text-black font-mono text-xl md:text-2xl font-bold rotate-4 shadow-[2px_2px_0px_#000]"
                >ABLE</span
              >
            </div>

            <!-- TO -->
            <div class="flex items-center gap-0.5">
              <span
                class="inline-block px-1.5 py-0.5 bg-[#ff2a2a] text-white font-serif text-lg md:text-xl font-bold -rotate-6"
                >T</span
              >
              <span
                class="inline-block px-2 py-1 bg-white text-black font-sans text-xl md:text-2xl font-black rotate-3"
                style="font-family: 'Black Han Sans', sans-serif;">O</span
              >
            </div>

            <!-- THE -->
            <div class="flex items-center">
              <span
                class="inline-block px-2.5 py-1 bg-black text-[#00ff66] font-mono text-lg md:text-xl border-2 border-[#00ff66] -rotate-2"
                style="font-family: 'VT323', monospace;">THE</span
              >
            </div>

            <!-- PUBLIC -->
            <div class="flex items-center gap-0.5">
              <span
                class="inline-block px-1.5 py-0.5 bg-[#ffe600] text-black font-sans text-xl md:text-2xl font-black rotate-4"
                style="font-family: 'Bebas Neue', sans-serif;">P</span
              >
              <span
                class="inline-block px-1 py-1 bg-white text-[#ff00ff] font-serif text-lg md:text-xl font-bold -rotate-3"
                >U</span
              >
              <span
                class="inline-block px-2 py-0.5 bg-black text-white font-mono text-xl md:text-2xl rotate-2 border border-white"
                >B</span
              >
              <span
                class="inline-block px-1.5 py-0 bg-[#ff00ff] text-white font-sans text-lg md:text-xl font-black -rotate-4"
                >L</span
              >
              <span
                class="inline-block px-1 py-1 bg-[#00ffff] text-black font-serif text-xl md:text-2xl rotate-3"
                >I</span
              >
              <span
                class="inline-block px-2 py-0.5 bg-black text-[#ffe600] font-sans text-2xl md:text-3xl font-black -rotate-6"
                style="font-family: 'Black Han Sans', sans-serif;">C</span
              >
            </div>

            <!-- YEAR -->
            <div class="flex items-center">
              <span
                class="inline-block px-2.5 py-1 bg-white text-black font-serif text-xl md:text-2xl font-bold rotate-2 border border-black shadow-[2px_2px_0px_#000]"
                >YEAR</span
              >
            </div>

            <!-- 2028 -->
            <div class="flex items-center">
              <span
                class="inline-block px-3 py-1 bg-[#ff00ff] text-white font-mono text-2xl md:text-3xl font-black rotate-6 shadow-[3px_3px_0px_#ffe600] border-2 border-white"
                style="font-family: 'VT323', monospace; text-shadow: 1px 1px 0px #000;"
                >2028</span
              >
            </div>

            <!-- ± -->
            <div class="flex items-center">
              <span
                class="inline-block px-2 py-0.5 bg-black text-[#00ffff] font-serif text-2xl md:text-3xl font-extrabold -rotate-12 border border-dashed border-[#00ffff]"
                >±</span
              >
            </div>

            <!-- 1 -->
            <div class="flex items-center">
              <span
                class="inline-block px-2.5 py-1 bg-[#ffe600] text-black font-sans text-2xl md:text-3xl font-black rotate-12 shadow-[2px_2px_0px_#ff00ff]"
                style="font-family: 'Black Han Sans', sans-serif;">1</span
              >
            </div>

            <!-- LIGHT -->
            <div class="flex items-center gap-0.5">
              <span
                class="inline-block px-1.5 py-1 bg-white text-[#ff2a2a] font-serif text-lg md:text-xl font-bold rotate-3 border-2 border-[#ff2a2a]"
                >L</span
              >
              <span
                class="inline-block px-2 py-0.5 bg-black text-white font-sans text-xl md:text-2xl font-black -rotate-4"
                style="font-family: 'Bebas Neue', sans-serif;">I</span
              >
              <span
                class="inline-block px-1 py-1 bg-[#00ff66] text-black font-mono text-lg md:text-xl rotate-6"
                >G</span
              >
              <span
                class="inline-block px-1.5 py-0.5 bg-[#ff00ff] text-white font-serif text-xl md:text-2xl font-bold -rotate-3"
                >H</span
              >
              <span
                class="inline-block px-2 py-0 bg-black text-[#ffe600] font-sans text-xl md:text-2xl font-black rotate-2"
                style="font-family: 'Black Han Sans', sans-serif;">T</span
              >
            </div>

            <!-- YEAR. -->
            <div class="flex items-center">
              <span
                class="inline-block px-3 py-1 bg-white text-black font-mono text-xl md:text-2xl font-black -rotate-3 border-2 border-double border-black shadow-[2px_2px_0px_#ff00ff]"
                style="font-family: 'Courier New', monospace;">YEAR.</span
              >
            </div>
          </div>
        </div>
      </div>
      <div
        data-sticker-gallery
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8 hidden"
      >
      </div>
        </div>
        <div class="rec-info">
          <div class="rec-head">
      <p
        class="drawer-ticker font-mono text-sm uppercase tracking-widest mb-2"
        data-sticker-ticker
      >
      </p>
      <h2
        class="drawer-title text-2xl md:text-3xl font-bold text-[var(--text-ink)] mb-4"
        data-sticker-title
      >
      </h2>
      <p
        class="drawer-tagline text-[var(--text-muted)] mb-6"
        data-sticker-tagline
      >
      </p>
          </div>
      <div
        data-sticker-description
        class="prose prose-sm max-w-none leading-relaxed mb-8 text-[var(--text-ink)] hidden"
      >
      </div>
      <div data-sticker-options class="purchase-options-section hidden"></div>
      <div data-sticker-revenue class="revenue-split-section hidden"></div>
      <div data-sticker-subscription class="subscription-section hidden"></div>
      <div data-sticker-theory class="theory-core-section hidden"></div>
      <div data-sticker-playlist class="playlist-section hidden"></div>
      <div data-sticker-matters class="why-matters-section hidden"></div>
      <div data-sticker-mission class="ambassador-mission-section hidden"></div>
      <div data-sticker-download class="download-section hidden"></div>
      <div
        data-sticker-specs
        class="font-mono text-xs md:text-sm uppercase tracking-wider text-[var(--text-ink)] mb-6 pb-6 border-b border-[var(--line-soft)] space-y-2"
      >
      </div>
      <div
        data-sticker-links
        class="drawer-links mt-4 pt-4 border-t border-[var(--line-soft)] text-xs space-y-1 hidden"
      >
      </div>
          <div class="rec-key-wrap">
      <div
        class="drawer-meta flex flex-col gap-y-1 font-mono text-xs uppercase tracking-wider text-[var(--text-muted)] mb-6 pb-6 border-b border-[var(--line-soft)]"
        data-sticker-meta
      >
      </div>
      <div data-sticker-negotiation>
        <button
          type="button"
          class="open-negotiation font-mono text-xs uppercase tracking-widest focus:outline-none focus-visible:ring-1 min-h-[44px]"
          data-sticker-negotiate-btn>Open negotiation channel</button
        >
        <p
          class="mt-2 text-sm text-[var(--text-muted)] hidden"
          data-sticker-email
        >
        </p>
      </div>
      <p class="drawer-protocol text-sm text-[var(--text-muted)] mb-6" data-sticker-protocol>
        Trade protocol: negotiation via email. No automated checkout. Signal
        intent; we respond.
      </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* INFOCIGAN INHERITANCE LOCK */
  .overpriced-stickers-outer,
  .overpriced-inner,
  .instrument-card {
    background: transparent !important;
  }

  /* TICKER FOG GLASS ONLY */
  .q888-ticker {
    background: rgba(245, 245, 245, 0.92) !important;
  }

  /* GRID ON FOG */
  .overpriced-stickers-outer::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(245, 245, 245, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 175, 55, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.03;
    pointer-events: none;
  }

  /* HERO: one composition. Monumental serif title, mono kicker, a hairline of
     champagne gold, copy set small in the right column. Each title word rises
     out of a mask once; a gold sheen follows the pointer across the letters. */
  .hero {
    --ink: var(--text-ink);
    padding-top: 0;
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(0.6rem, 0.9vw, 0.72rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    animation: hero-fade 1.6s ease-out 0.2s both;
  }
  @media (max-width: 520px) {
    .hero-kicker {
      letter-spacing: 0.2em;
    }
    .hero-kicker span:last-child {
      display: none;
    }
  }
  .hero-kicker-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--line-soft), transparent);
  }
  .hero-title {
    margin: 0;
    font-family: "Bricolage Grotesque", "Arial Narrow", Arial, sans-serif;
    font-weight: 800;
    font-size: clamp(3.6rem, 17vw, 22rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .hero-line {
    display: block;
    white-space: nowrap;
  }
  .hero-line-2 {
    padding-left: clamp(1.25rem, 9vw, 12rem);
  }
  /* Letters inflate from hairline to full weight in a wave, like a price
     going up. Plays once on load. */
  .hero-ch {
    display: inline-block;
    font-weight: 800;
    animation: ch-inflate 1.9s cubic-bezier(0.16, 1, 0.3, 1) calc(0.15s + var(--i) * 0.07s) both;
  }
  @keyframes ch-inflate {
    from {
      font-weight: 200;
      opacity: 0;
      filter: blur(6px);
    }
    to {
      font-weight: 800;
      opacity: 1;
      filter: blur(0);
    }
  }
  .hero-lower {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .hero-lower {
      grid-template-columns: 5fr 4fr;
      gap: clamp(3rem, 8vw, 9rem);
    }
  }
  .hero-sub {
    margin: 0;
    font-family: "Bricolage Grotesque", "Arial Narrow", Arial, sans-serif;
    font-weight: 500;
    font-size: clamp(1.7rem, 3.2vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
    max-width: 18ch;
    animation: hero-fade 1.8s ease-out 0.9s both;
  }
  .hero-copy {
    max-width: 36rem;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.55;
    color: var(--text-muted);
    display: grid;
    gap: 1.1rem;
    animation: hero-fade 1.8s ease-out 1.2s both;
  }
  .hero-copy p {
    margin: 0;
  }
  @keyframes hero-rise {
    from {
      transform: translateY(108%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ch,
    .hero-kicker,
