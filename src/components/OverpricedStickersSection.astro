<script>
  (function () {
    const content = document.querySelector("[data-ticker-content]");
    if (!(content instanceof HTMLElement)) return;

    const unit = content.querySelector("[data-ticker-unit]");
    if (!(unit instanceof HTMLElement)) return;

    const pixelsPerSecond = 88;

    const applyTickerMetrics = function () {
      const width = Math.ceil(unit.getBoundingClientRect().width);
      if (width <= 0) return;
      content.style.setProperty("--ticker-distance", `${width}px`);
      content.style.setProperty(
        "--ticker-duration",
        `${width / pixelsPerSecond}s`,
      );
    };

    const initWhenReady = async function () {
      if (document.fonts && document.fonts.ready) {
        try {
          await document.fonts.ready;
        } catch {}
      }
      requestAnimationFrame(function () {
        requestAnimationFrame(applyTickerMetrics);
      });
    };

    initWhenReady();

    const io = new IntersectionObserver(function (entries) {
      if (
        entries.some(function (entry) {
          return entry.isIntersecting;
        })
      ) {
        applyTickerMetrics();
        io.disconnect();
      }
    });
    io.observe(content);

    let resizeTimer = 0;
    const handleResize = function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyTickerMetrics, 150);
    };
    window.addEventListener("resize", handleResize, { passive: true });

    function cleanup() {
      window.removeEventListener("resize", handleResize);
      window.clearTimeout(resizeTimer);
      io.disconnect();
      document.removeEventListener("astro:before-swap", cleanup);
      window.removeEventListener("beforeunload", cleanup);
    }
    document.addEventListener("astro:before-swap", cleanup);
    window.addEventListener("beforeunload", cleanup);
  })();
</script>

<script is:inline define:vars={{ instruments, activeStickerId }}>
  (function () {
    // Each overlay restores only the declarations it owns, including priority.
    function lockScroll() {
      const style = document.body.style;
      const previous = ["overflow-x", "overflow-y", "padding-right"].map((property) => [property, style.getPropertyValue(property), style.getPropertyPriority(property)]);
      const width = window.innerWidth - document.documentElement.clientWidth;
      const padding = parseFloat(getComputedStyle(document.body).paddingRight) || 0;
      if (width > 0) style.setProperty("padding-right", `${padding + width}px`);
      style.setProperty("overflow", "hidden");
      return () => {
        style.removeProperty("overflow");
        previous.forEach(([property, value, priority]) => {
          if (value) style.setProperty(property, value, priority);
          else style.removeProperty(property);
        });
      };
    }
    let releaseTermsScroll = null;
    let releaseDrawerScroll = null;
    window.toggleTermsModal = function () {
      const modal = document.getElementById("termsModal");
      if (!modal) return;
      modal.classList.toggle("hidden");

      if (!modal.classList.contains("hidden")) {
        releaseTermsScroll = lockScroll();
      } else {
        releaseTermsScroll?.();
        releaseTermsScroll = null;
      }
    };

    if (!document.documentElement.dataset.termsModalTouchCloseBound) {
      document.documentElement.dataset.termsModalTouchCloseBound = "1";
      document.addEventListener(
        "touchend",
        (e) => {
          if (e.target?.closest?.(".terms-modal-close")) {
            e.preventDefault();
            window.toggleTermsModal?.();
          }
        },
        { passive: false },
      );
    }

    const drawer = document.getElementById("sticker-detail-drawer");
    const triggers = document.querySelectorAll(
      '[data-drawer-trigger="sticker-detail"]',
    );
    const closeBtn = drawer?.querySelector("[data-close-drawer]");
    const tickerEl = drawer?.querySelector("[data-sticker-ticker]");
    const titleEl = drawer?.querySelector("[data-sticker-title]");
    const taglineEl = drawer?.querySelector("[data-sticker-tagline]");
    const imageEl = drawer?.querySelector("[data-sticker-image]");
    const galleryEl = drawer?.querySelector("[data-sticker-gallery]");
    const descEl = drawer?.querySelector("[data-sticker-description]");
    const optionsEl = drawer?.querySelector("[data-sticker-options]");
    const revenueEl = drawer?.querySelector("[data-sticker-revenue]");
    const subscriptionEl = drawer?.querySelector("[data-sticker-subscription]");
    const theoryEl = drawer?.querySelector("[data-sticker-theory]");
    const playlistEl = drawer?.querySelector("[data-sticker-playlist]");
    const mattersEl = drawer?.querySelector("[data-sticker-matters]");
    const missionEl = drawer?.querySelector("[data-sticker-mission]");
    const downloadEl = drawer?.querySelector("[data-sticker-download]");
    const specsEl = drawer?.querySelector("[data-sticker-specs]");
    const linksEl = drawer?.querySelector("[data-sticker-links]");
    const metaEl = drawer?.querySelector("[data-sticker-meta]");
    const negotiateBtn = drawer?.querySelector("[data-sticker-negotiate-btn]");
    const emailEl = drawer?.querySelector("[data-sticker-email]");

    const data = Array.isArray(instruments) ? instruments : [];
    const escapeHtml = (value) =>
      String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    function openDrawer(id, shouldPushState = true) {
      const inst = data.find(
        (i) =>
          i.id === id ||
          i.slug === id ||
          i.id.toLowerCase() === id.toLowerCase() ||
          (i.slug && i.slug.toLowerCase() === id.toLowerCase()),
      );
      if (!drawer || !inst) return;

      drawer.setAttribute("data-current-instrument-id", inst.id);
      if (tickerEl) tickerEl.textContent = inst.ticker;
      if (titleEl) titleEl.textContent = inst.title;
      if (taglineEl) taglineEl.textContent = inst.tagline;

      const blurOverlay = drawer?.querySelector("[data-sticker-blur-overlay]");
      if (imageEl && inst.imageUrl) {
        imageEl.src = inst.imageUrl;
        imageEl.alt = inst.imageAlt || inst.title;
        imageEl.classList.remove("hidden");

        if (inst.id === "DM-0001") {
          const targetDate = new Date("2028-01-01T00:00:00Z");
          if (new Date() < targetDate) {
            imageEl.style.filter = "blur(24px) brightness(0.6)";
            if (blurOverlay) blurOverlay.classList.remove("hidden");
          } else {
            imageEl.style.filter = "none";
            if (blurOverlay) blurOverlay.classList.add("hidden");
          }
        } else {
          imageEl.style.filter = "none";
          if (blurOverlay) blurOverlay.classList.add("hidden");
        }
      } else if (imageEl) {
        imageEl.classList.add("hidden");
        if (blurOverlay) blurOverlay.classList.add("hidden");
      }

      if (galleryEl && inst.gallery && inst.gallery.length > 0) {
        if (inst.galleryFeature) {
          const feature = inst.galleryFeature;
          galleryEl.innerHTML = `
            <figure class="sticker-gallery-feature">
              <div class="sticker-gallery-feature__image">
                <img src="${escapeHtml(inst.gallery[0])}" alt="${escapeHtml(inst.title)} Full-Swoosh one-of-one custom option" />
              </div>
              <figcaption class="sticker-gallery-feature__copy">
                <span class="sticker-gallery-feature__eyebrow">${escapeHtml(feature.eyebrow)}</span>
                <h3 class="sticker-gallery-feature__title">${escapeHtml(feature.title)}</h3>
                <p class="sticker-gallery-feature__body">${escapeHtml(feature.bodyBeforeLink)}<a href="${escapeHtml(feature.linkUrl)}">${escapeHtml(feature.linkText)}</a>${escapeHtml(feature.bodyAfterLink)}</p>
                <span class="sticker-gallery-feature__footer">${escapeHtml(feature.footer)}</span>
              </figcaption>
            </figure>
          `;
        } else {
          galleryEl.innerHTML = inst.gallery
            .map(
              (url) =>
                `<img src="${escapeHtml(url)}" alt="${escapeHtml(inst.title)} detail" class="w-full aspect-square object-cover border border-[var(--line-soft)] transition-transform duration-200 hover:scale-105" />`,
            )
            .join("");
        }
        galleryEl.classList.remove("hidden");
      } else if (galleryEl) {
        galleryEl.innerHTML = "";
        galleryEl.classList.add("hidden");
      }

      if (descEl && inst.description) {
        const paragraphs = inst.description
          .split("\n\n")
          .filter((p) => p.trim());
        descEl.innerHTML = paragraphs.map((p) => `<p>${p.trim()}</p>`).join("");
        descEl.classList.remove("hidden");
      } else if (descEl) {
        descEl.classList.add("hidden");
      }

      if (optionsEl) {
        if (inst.purchaseOptions?.length) {
          optionsEl.innerHTML = `
            <h3 class="purchase-options-title">Choose Your Atmospheric Risk Level</h3>
            <div class="purchase-options-grid">
              ${inst.purchaseOptions
                .map(
                  (option, index) => `
                    <article class="purchase-option${index > 0 ? " purchase-option--custom" : ""}">
                      <div class="purchase-option-head">
                        <strong class="purchase-option-name">${escapeHtml(option.name)}</strong>
                        <span class="purchase-option-price">${escapeHtml(option.price)}</span>
                      </div>
                      <p class="purchase-option-availability">${escapeHtml(option.availability)}</p>
                      <p class="purchase-option-description">${escapeHtml(option.description)}</p>
                      <ul class="purchase-option-includes">
                        ${option.includes.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}
                      </ul>
                    </article>
                  `,
                )
                .join("")}
            </div>
          `;
          optionsEl.classList.remove("hidden");
        } else {
          optionsEl.classList.add("hidden");
          optionsEl.innerHTML = "";
        }
      }

      if (revenueEl) {
        if (inst.revenueSplit?.allocations?.length) {
          revenueEl.innerHTML = `
            <h3 class="revenue-split-title">Collaborative Revenue Protocol</h3>
            <p class="revenue-split-statement">${escapeHtml(inst.revenueSplit.statement)}</p>
            <div class="revenue-split-grid">
              ${inst.revenueSplit.allocations
                .map(
                  (allocation) => `
                    <div class="revenue-allocation">
                      <span class="revenue-allocation-share">${escapeHtml(allocation.share)}</span>
                      <strong class="revenue-allocation-name">${escapeHtml(allocation.recipient)}</strong>
                      <span class="revenue-allocation-role">${escapeHtml(allocation.role)}</span>
                    </div>
                  `,
                )
                .join("")}
            </div>
          `;
          revenueEl.classList.remove("hidden");
        } else {
          revenueEl.classList.add("hidden");
          revenueEl.innerHTML = "";
        }
      }

      if (subscriptionEl) {
        if (inst.subscriptionModel) {
          const escape = (s) =>
            String(s)
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;");
          const bold = (s) =>
            escape(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
          const formatTerms = (md) => {
            const lines = String(md).split("\n");
            let html = "";
            let inList = false;
            for (const rawLine of lines) {
              const line = rawLine.replace(/\r/g, "");
              const trimmed = line.trim();
              if (!trimmed) {
                if (inList) {
                  html += "</ul>";
                  inList = false;
                }
                html += "<br>";
                continue;
              }
              if (trimmed.startsWith("- ")) {
                if (!inList) {
                  html += "<ul>";
                  inList = true;
                }
                html += `<li>${bold(trimmed.slice(2))}</li>`;
                continue;
              }
              if (inList) {
                html += "</ul>";
                inList = false;
              }
              html += `${bold(trimmed)}<br>`;
            }
            if (inList) html += "</ul>";
            return html;
          };

          const termsHtml = formatTerms(inst.subscriptionModel);

          if (inst.showTermsAsLink) {
            subscriptionEl.innerHTML = `
              <div class="terms-link-section">
                <button
                  class="terms-link-button"
                  onclick="toggleTermsModal()"
                  style="
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                    padding: 0;
                    background: none;
                    border: none;
                    cursor: pointer;
                    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                    font-size: 0.875rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.15em;
                    color: var(--text-ink); text-decoration: underline; text-underline-offset: 0.3em;
                  "
                >
                  Subscription Terms &amp; Conditions 😈
                </button>
              </div>

              <div id="termsModal" class="terms-modal hidden">
                <div class="terms-modal-overlay" onclick="toggleTermsModal()"></div>
                <div class="terms-modal-content">
                  <button class="terms-modal-close" onclick="toggleTermsModal()" aria-label="Close terms">×</button>
                  <h2 class="terms-modal-title">Subscription Model &amp; Protection Terms</h2>
                  <div class="terms-modal-body">${termsHtml}</div>
                </div>
              </div>
            `;
          } else {
            subscriptionEl.innerHTML = `
              <div class="subscription-section">
                <h3 class="subscription-title">Subscription Model & Protection Terms</h3>
                <div class="subscription-content">${termsHtml}</div>
              </div>
            `;
          }
          subscriptionEl.classList.remove("hidden");
        } else {
          subscriptionEl.classList.add("hidden");
          subscriptionEl.innerHTML = "";
        }
      }

      if (theoryEl) {
        if (inst.theoryCore) {
          const escaped = inst.theoryCore
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
          const formatted = escaped
            .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
            .replace(/\n/g, "<br>");
          theoryEl.innerHTML = `
            <h3 class="theory-title">Square Bubble Theory Core Principles</h3>
            <div class="theory-content">${formatted}</div>
            <p class="theory-access">
              <strong>Access Full Theory</strong><br>
              Complete manifesto available as downloadable transmission. The mushroom knows the path between chaos and tyranny—it eats both, transforms both, completes the cycle without ruling.
            </p>
          `;
          theoryEl.classList.remove("hidden");
        } else {
          theoryEl.classList.add("hidden");
          theoryEl.innerHTML = "";
        }
      }

      if (playlistEl) {
        if (inst.playlistUrl) {
          const label = inst.playlistLabel || "Listen on Spotify";
          const note =
            inst.id === "IDJ-SACRED"
              ? "Smart shuffle activates 8.88% enhancement (belief-dependent)"
              : "Smart shuffle mode activates 8.88% creativity enhancement";
          playlistEl.innerHTML = `
            <a href="${inst.playlistUrl}" target="_blank" rel="noopener noreferrer" class="playlist-link">
              <span class="gold-shine" style="
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.2em;
                color: var(--text-ink); text-decoration: underline; text-underline-offset: 0.3em;
              ">
                ${label}
              </span>
            </a>
            <p class="playlist-note">${note}</p>
          `;
          playlistEl.classList.remove("hidden");
        } else if (inst.id === "FWR-88" && inst.downloadUrl) {
          const label = inst.downloadLabel || "Download (PDF)";
          playlistEl.innerHTML = `
            <div class="playlist-section">
              <a href="${inst.downloadUrl}" download class="playlist-link">
                <span class="gold-shine" style="
                  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                  font-size: 0.75rem;
                  text-transform: uppercase;
                  letter-spacing: 0.2em;
                  color: var(--text-ink); text-decoration: underline; text-underline-offset: 0.3em;
                ">
                  ${label}
                </span>
              </a>
            </div>
          `;
          playlistEl.classList.remove("hidden");
        } else {
          playlistEl.classList.add("hidden");
          playlistEl.innerHTML = "";
        }
      }

      if (mattersEl) {
        if (inst.whyThisMatters) {
          const parts = inst.whyThisMatters
            .split("\n\n")
            .filter((p) => p.trim());
          const mattersTitle =
            inst.id === "IDJ-SACRED"
              ? "Why This DJ Is Different"
              : inst.id === "FWR-88"
                ? "Why This Rabbit Is Different"
                : "Why This V1 Matters";
          mattersEl.innerHTML = `
            <h3 class="matters-title">${mattersTitle}</h3>
            <div class="matters-content">${parts.map((p) => `<p>${p.trim()}</p>`).join("")}</div>
          `;
          mattersEl.classList.remove("hidden");
        } else {
          mattersEl.classList.add("hidden");
          mattersEl.innerHTML = "";
        }
      }

      if (missionEl) {
        if (inst.ambassadorMission) {
          const parts = inst.ambassadorMission
            .split("\n\n")
            .filter((p) => p.trim());
          missionEl.innerHTML = `
            <h3 class="mission-title">The Ambassador Mission</h3>
            <div class="mission-content">${parts.map((p) => `<p>${p.trim()}</p>`).join("")}</div>
          `;
          missionEl.classList.remove("hidden");
        } else {
          missionEl.classList.add("hidden");
          missionEl.innerHTML = "";
        }
      }

      if (downloadEl) {
        if (inst.downloadUrl) {
          if (inst.id === "FWR-88") {
            downloadEl.classList.add("hidden");
            downloadEl.innerHTML = "";
          } else {
            const label =
              inst.downloadLabel || "Download KomproMir Manifesto (PDF)";
            downloadEl.innerHTML = `
      <a
        href="${inst.downloadUrl}"
        download
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.5rem;
          text-decoration: none;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.2em;
          line-height: 1.5;
          color: var(--text-ink); text-decoration: underline; text-underline-offset: 0.3em;
        "
      >
        ${label}
      </a>
          `;
            downloadEl.classList.remove("hidden");
          }
        } else {
          downloadEl.classList.add("hidden");
        }
      }

      if (specsEl) {
        const specs = [];
        if (inst.dimensions) specs.push(`DIMENSIONS: ${inst.dimensions}`);
        if (inst.material) specs.push(`MATERIAL: ${inst.material}`);
        if (inst.year) specs.push(`YEAR: ${inst.year}`);
        if (inst.provenance) specs.push(`PROVENANCE: ${inst.provenance}`);
        if (inst.id === "NAR-OOPS") {
          specs.push("EDITION: 10 · NOT FOR SALE", "ISSUED BY: Kotiki-Nar or an authorised third-party courier", "QUALIFICATION: A genuine Nar-Mail delivery incident. Deliberate parcel loss does not qualify.");
        } else if (inst.id === "FWR-88") {
          specs.push(
            "TRANSFER: Physical handover + acknowledgment that some truths shield themselves through obscurity. Hold while contemplating: follow for awakening or follow for devotion? Rabbit reveals your answer.",
          );
          specs.push(
            "RITUAL: Apply at personal Wonderland threshold—mirror edge, journal cover, device protecting secrets. Whisper your deepest mystery while tracing the spiral. Rabbit leaps between dimensions when observer is ready. May unlock quantum matrix; may simply remind you timeless devotion exists outside simulations.",
          );
        } else if (inst.id === "CID-GATE") {
          specs.push(
            "TRANSFER: Non-transferable. Subscription-based rental only. Must be returned at rental term end unless creator grants permanent placement. Each sticker bears overseer's personal guarantee of karmic justice against unlawful interference.",
          );
          specs.push(
            "RITUAL: Display prominently within business premises where inspectors, authorities, and customers can witness. Signifies ethical compliance and interdimensional protection. If unjust fine occurs during subscription period, contact overseer—restitution guaranteed, perpetrators face consequences. If fine is legitimate, accept revocation and fee forfeiture as accountability reminder.",
          );
        } else if (inst.id === "SQB-1") {
          specs.push(
            "TRANSFER: Physical handover + acknowledgment that freedom requires edges, structure requires breath. Hold while contemplating: what collapses when you optimize too hard? What decays when you remove all rules?",
          );
          specs.push(
            "RITUAL: Apply where systems meet—device protecting both your privacy and connectivity, journal balancing spontaneity with habit, workspace allowing autonomy within deadlines. Whisper one constraint you protect, one freedom you enable. Mushroom completes its cycle, stabilizing your paradox.",
          );
        } else if (inst.id === "IDJ-SACRED") {
          specs.push(
            "TRANSFER: High-price negotiation required. Not sold to highest bidder but to most aligned frequency. Hold under shifting light while antennae decode your sonic readiness. Transfer signifies acceptance of chaos curation responsibility.",
          );
          specs.push(
            "RITUAL: Apply to creative chaos zone or meditation threshold. Activate designated Spotify playlist in smart shuffle mode—awareness and relaxation increase by 8.88%, scaled by belief coefficient. Antennae receive frequencies proportional to your conviction. Rotate viewing angle to access full spectrum guidance between order and entropy.",
          );
        } else if (inst.id === "IJ-V1") {
          specs.push(
            "TRANSFER: Physical handover requires acknowledgment of cosmic responsibility. Hold under shifting light until holographic rainbow stabilizes. Recipient becomes keeper of peace technology, not owner.",
          );
          specs.push(
            "RITUAL: Apply to threshold or creative workspace. Activate designated Spotify playlist in smart shuffle mode—creativity increases by 8.88%. Sticker presence balances contradictions within 3-meter radius. Rotate viewing angle to access full spectrum guidance.",
          );
        } else if (inst.id === "SS-888") {
          specs.push(
            "TRANSFER: Physical handover + ceremonial acknowledgment that this object has infinite value because you decided it does. Hold while questioning capitalism, endorsing capitalism, transcending both.",
          );
          specs.push(
            "RITUAL: Apply to cherished item during moment of resistance against planned obsolescence. Whisper 'This is now an heirloom.' Item immediately transforms into collectible piece of art, never to be mindlessly discarded. You are now sticker ambassador—flaunt, inspire, create demand.",
          );
        } else if (inst.id === "POG-2025" || inst.id === "POG-2026") {
          specs.push(
            "TRANSFER: Sticker transfer signifies acceptance of responsibility for humor, unity, and progress. Hold while acknowledging power is project not throne.",
          );
          specs.push(
            "RITUAL: Apply with irony, optimism, and zero respect for outdated galactic hierarchies. Place where control fails but coordination thrives. Bonds where leadership rotates, meaning endures.",
          );
        } else if (inst.id === "KM-V1") {
          specs.push(
            "TRANSFER: Original 12 given freely to those who understood: small local changes seed global harmony. All dispersed into the world.",
          );
          specs.push(
            "RITUAL: Applied where contradictions meet without violence—laptop corners, notebook margins, threshold edges. Whispered commitment to one small daily improvement. Bonded where compromise births peace, not surrender.",
          );
          if (inst.sentimentalValue)
            specs.push(`SENTIMENTAL VALUE: ${inst.sentimentalValue}`);
        } else if (inst.id === "LM-PRICELESS") {
          specs.push(
            "TRANSFER: Not purchasable. Appears to those who stabilize contradictions without force. Recognition is the only currency accepted.",
          );
          specs.push(
            "RITUAL: Apply where geometries conflict (notebook corner bridging round/square doodles, portal thresholds). Whisper gratitude for imbalance. Adheres where love flows between incompatible forms, preventing cosmic overflow.",
          );
        } else if (inst.id === "KN-0002") {
          specs.push(
            "TRANSFER: Physical handover + ceremonial acknowledgment of value being irrational.",
          );
          specs.push(
            "RITUAL: Apply to a surface that divides two completely different realities.",
          );
        } else {
          specs.push(
            "TRANSFER: Physical handover + ceremonial acknowledgment of value being irrational.",
          );
          specs.push("RITUAL: Apply at an edge during indecision.");
        }
        specsEl.innerHTML = specs
          .map((s) => {
            const i = s.indexOf(": ");
            return i < 0
              ? `<div class="spec-row"><span class="spec-v">${s}</span></div>`
              : `<div class="spec-row"><span class="spec-k">${s.slice(0, i)}</span><span class="spec-v">${s.slice(i + 2)}</span></div>`;
          })
          .join("");
      }
      if (specsEl) specsEl.classList.remove("hidden");

      if (linksEl) {
        if (inst.relatedUrl) {
          linksEl.innerHTML = `
            <a href="${escapeHtml(inst.relatedUrl)}" class="drawer-link gold-shine inline-flex items-center transition-all no-underline">
              ↗ ${escapeHtml(inst.relatedLabel || "Open related project")}
            </a>
          `;
          linksEl.classList.remove("hidden");
        } else if (id === "ML-0444") {
          linksEl.innerHTML = `
            <a href="/docs/modern-love.pdf" download class="drawer-link gold-shine inline-flex items-center transition-all no-underline">
              Full story PDF (free download)
            </a>
            <br>
            <a href="https://open.spotify.com/playlist/1XXi7nCuLSmX0B2YNSRT5D?si=691b787012194cc6" target="_blank" rel="noopener noreferrer" class="drawer-link gold-shine inline-flex items-center transition-all no-underline">
              Modern Love Playlist (@Quirky888 + @hanam444)
            </a>
          `;
          linksEl.classList.remove("hidden");
        } else {
          linksEl.classList.add("hidden");
        }
      }

      if (metaEl) {
        const statusMap = {
          LISTED: "Listed",
          BEYOND_TRANSACTION: "Beyond transaction",
          SOLD_OUT: "Sold out",
          SOLD: "Sold",
          NEGOTIABLE: "Negotiable",
          SUBSCRIPTION: "Subscription",
          RESERVED: "Reserved",
        };
        const statusLabel = statusMap[inst.status] || inst.status;
        const edition = ["POG-2026", "NAR-OOPS"].includes(inst.id)
          ? `Edition ${inst.editionTotal}`
          : `Ed. ${inst.availableCount}/${inst.editionTotal}`;
        metaEl.innerHTML = `<div class="rec-price">${inst.ask}</div><div class="rec-sub">${edition} · ${statusLabel}</div>`;
      }
      if (emailEl) {
        emailEl.textContent = "";
        emailEl.classList.add("hidden");
      }
      if (negotiateBtn) {
        negotiateBtn.hidden = inst.id === "NAR-OOPS";
        negotiateBtn.textContent =
          inst.status === "SUBSCRIPTION"
            ? "Contact for subscription"
            : inst.status === "NEGOTIABLE"
              ? "Contact for negotiation"
              : "Open negotiation channel";
      }
      const protocolEl = drawer.querySelector("[data-sticker-protocol]");
      if (protocolEl) protocolEl.textContent = inst.id === "NAR-OOPS"
        ? "Oops Protocol: issued as an apology only. No purchase, reservation or negotiation. Unlimited money will not help."
        : "Trade protocol: negotiation via email. No automated checkout. Signal intent; we respond.";

      const countEl = drawer.querySelector("[data-rec-count]");
      if (countEl) {
        const ids = Array.from(
          document.querySelectorAll(".instrument-card[data-instrument-id]"),
        ).map((el) => el.getAttribute("data-instrument-id"));
        const n = ids.indexOf(inst.id);
        countEl.textContent = n >= 0 ? `${String(n + 1).padStart(2, "0")} / ${String(ids.length).padStart(2, "0")}` : "";
      }
      drawer.setAttribute("aria-hidden", "false");
      if (!releaseDrawerScroll) releaseDrawerScroll = lockScroll();
      drawer.classList.remove("hidden");

      if (shouldPushState) {
        const slug = inst.slug || inst.id.toLowerCase();
        history.pushState({ stickerId: inst.id }, "", `/overpriced/${slug}/`);
      }
    }

    function closeDrawer(shouldPushState = true) {
      if (!drawer) return;
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.add("hidden");
      releaseTermsScroll?.();
      releaseTermsScroll = null;
      document.getElementById("termsModal")?.classList.add("hidden");
      releaseDrawerScroll?.();
      releaseDrawerScroll = null;

      if (shouldPushState) {
        history.pushState({ stickerId: null }, "", "/overpriced/");
      }
    }

    function revealEmail() {
      const id = drawer?.getAttribute("data-current-instrument-id");
      const inst = data.find((i) => i.id === id);
      if (!emailEl || !inst) return;
      if (inst.id === "NAR-OOPS") return;
      emailEl.textContent = inst.contactEmail;
      emailEl.classList.remove("hidden");
      if (negotiateBtn) negotiateBtn.hidden = true;
    }

    function initDrawer() {
      if (!drawer) {
        console.error("Drawer element not found");
        return;
      }
      if (drawer.dataset.drawerInitialized === "true") return;
      drawer.dataset.drawerInitialized = "true";

      const handlePopstate = () => {
        const path = window.location.pathname;
        if (path.startsWith("/overpriced/")) {
          const id = path.substring("/overpriced/".length);
          if (id) {
            openDrawer(id, false);
          } else {
            closeDrawer(false);
          }
        } else if (path === "/overpriced" || path === "/overpriced/") {
          closeDrawer(false);
        }
      };
      window.addEventListener("popstate", handlePopstate);

      const handleBeforeSwap = () => {
        closeDrawer(false);
        window.removeEventListener("popstate", handlePopstate);
        document.removeEventListener("astro:before-swap", handleBeforeSwap);
      };
      document.addEventListener("astro:before-swap", handleBeforeSwap);

      if (activeStickerId) {
        openDrawer(activeStickerId, false);
      }

      triggers.forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = el.getAttribute("data-instrument-id");
          if (id) {
            openDrawer(id);
          }
        });

        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            e.stopPropagation();
            const id = el.getAttribute("data-instrument-id");
            if (id) {
              openDrawer(id);
            }
          }
        });
      });

      const handleClose = (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeDrawer();
      };
      const stepOrder = Array.from(
        document.querySelectorAll(".instrument-card[data-instrument-id]"),
      ).map((el) => el.getAttribute("data-instrument-id"));
      const step = (dir) => {
        const cur = drawer.getAttribute("data-current-instrument-id");
        const i = stepOrder.indexOf(cur);
        if (i < 0 || !stepOrder.length) return;
        openDrawer(stepOrder[(i + dir + stepOrder.length) % stepOrder.length]);
        drawer.querySelector(".drawer-scrollable")?.scrollTo({ top: 0 });
      };
      drawer.querySelector("[data-rec-prev]")?.addEventListener("click", () => step(-1));
      drawer.querySelector("[data-rec-next]")?.addEventListener("click", () => step(1));
      drawer.addEventListener("keydown", (e) => {
        if (drawer.getAttribute("aria-hidden") !== "false") return;
        if (e.key === "ArrowLeft") step(-1);
        if (e.key === "ArrowRight") step(1);
      });
      closeBtn?.addEventListener("click", handleClose);
      closeBtn?.addEventListener("touchend", handleClose, { passive: false });

      negotiateBtn?.addEventListener("click", revealEmail);

      const handleClickOutside = (e) => {
        if (e.target === drawer) {
          closeDrawer();
        }
      };
      drawer.addEventListener("click", handleClickOutside);
      drawer.addEventListener("touchstart", handleClickOutside, {
        passive: true,
      });

      drawer.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          drawer.getAttribute("aria-hidden") === "false"
        ) {
          closeDrawer();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDrawer);
    } else {
      initDrawer();
    }

    document.addEventListener("astro:page-load", initDrawer);
  })();
</script>
