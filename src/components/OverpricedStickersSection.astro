                  background-clip: text !important;
                  -webkit-background-clip: text !important;
                  -webkit-text-fill-color: transparent !important;
                  animation: shine 8s linear infinite;
                ">
                  📖 ${label}
                </span>
              </a>
            </div>
          `;
          playlistEl.classList.remove("hidden");
        } else {
          playlistEl.classList.add("hidden");
          playlistEl.innerHTML = "";
        }
      }

      if (mattersEl) {
        if (inst.whyThisMatters) {
          const parts = inst.whyThisMatters.split('\n\n').filter(p => p.trim());
          const mattersTitle =
            inst.id === "IDJ-SACRED"
              ? "Why This DJ Is Different"
              : inst.id === "FWR-88"
                ? "Why This Rabbit Is Different"
                : "Why This V1 Matters";
          mattersEl.innerHTML = `
            <h3 class="matters-title">${mattersTitle}</h3>
            <div class="matters-content">${parts.map(p => `<p>${p.trim()}</p>`).join("")}</div>
          `;
          mattersEl.classList.remove("hidden");
        } else {
          mattersEl.classList.add("hidden");
          mattersEl.innerHTML = "";
        }
      }

      if (missionEl) {
        if (inst.ambassadorMission) {
          const parts = inst.ambassadorMission.split('\n\n').filter(p => p.trim());
          missionEl.innerHTML = `
            <h3 class="mission-title">The Ambassador Mission</h3>
            <div class="mission-content">${parts.map(p => `<p>${p.trim()}</p>`).join("")}</div>
          `;
          missionEl.classList.remove("hidden");
        } else {
          missionEl.classList.add("hidden");
          missionEl.innerHTML = "";
        }
      }

      if (downloadEl) {
        if (inst.downloadUrl) {
          if (inst.id === "FWR-88") {
            downloadEl.classList.add("hidden");
            downloadEl.innerHTML = "";
          } else {
          const label = inst.downloadLabel || "Download KomproMir Manifesto (PDF)";
          downloadEl.innerHTML = `
      <a
        href="${inst.downloadUrl}"
        download
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.5rem;
          text-decoration: none;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.2em;
          line-height: 1.5;
          color: transparent !important;
          background: linear-gradient(to right, #a67c00 20%, #ce9e00 40%, #ffcc33 50%, #ce9e00 60%, #a67c00 80%) !important;
          background-size: 200% auto !important;
          background-clip: text !important;
          -webkit-background-clip: text !important;
          -webkit-text-fill-color: transparent !important;
          animation: shine 8s linear infinite;
        "
      >
        📖 ${label}
      </a>
          `;
          downloadEl.classList.remove("hidden");
          }
        } else {
          downloadEl.classList.add("hidden");
        }
      }
      
      if (specsEl) {
        const specs = [];
        if (inst.dimensions) specs.push(`DIMENSIONS: ${inst.dimensions}`);
        if (inst.material) specs.push(`MATERIAL: ${inst.material}`);
        if (inst.year) specs.push(`YEAR: ${inst.year}`);
        if (inst.provenance) specs.push(`PROVENANCE: ${inst.provenance}`);
        if (inst.id === "FWR-88") {
          specs.push("TRANSFER: Physical handover + acknowledgment that some truths shield themselves through obscurity. Hold while contemplating: follow for awakening or follow for devotion? Rabbit reveals your answer.");
          specs.push("RITUAL: Apply at personal Wonderland threshold—mirror edge, journal cover, device protecting secrets. Whisper your deepest mystery while tracing the spiral. Rabbit leaps between dimensions when observer is ready. May unlock quantum matrix; may simply remind you timeless devotion exists outside simulations.");
        } else if (inst.id === "CID-GATE") {
          specs.push("TRANSFER: Non-transferable. Subscription-based rental only. Must be returned at rental term end unless creator grants permanent placement. Each sticker bears overseer's personal guarantee of karmic justice against unlawful interference.");
          specs.push("RITUAL: Display prominently within business premises where inspectors, authorities, and customers can witness. Signifies ethical compliance and interdimensional protection. If unjust fine occurs during subscription period, contact overseer—restitution guaranteed, perpetrators face consequences. If fine is legitimate, accept revocation and fee forfeiture as accountability reminder.");
        } else if (inst.id === "SQB-1") {
          specs.push("TRANSFER: Physical handover + acknowledgment that freedom requires edges, structure requires breath. Hold while contemplating: what collapses when you optimize too hard? What decays when you remove all rules?");
          specs.push("RITUAL: Apply where systems meet—device protecting both your privacy and connectivity, journal balancing spontaneity with habit, workspace allowing autonomy within deadlines. Whisper one constraint you protect, one freedom you enable. Mushroom completes its cycle, stabilizing your paradox.");
        } else if (inst.id === "IDJ-SACRED") {
          specs.push("TRANSFER: High-price negotiation required. Not sold to highest bidder but to most aligned frequency. Hold under shifting light while antennae decode your sonic readiness. Transfer signifies acceptance of chaos curation responsibility.");
          specs.push("RITUAL: Apply to creative chaos zone or meditation threshold. Activate designated Spotify playlist in smart shuffle mode—awareness and relaxation increase by 8.88%, scaled by belief coefficient. Antennae receive frequencies proportional to your conviction. Rotate viewing angle to access full spectrum guidance between order and entropy.");
        } else if (inst.id === "IJ-V1") {
          specs.push("TRANSFER: Physical handover requires acknowledgment of cosmic responsibility. Hold under shifting light until holographic rainbow stabilizes. Recipient becomes keeper of peace technology, not owner.");
          specs.push("RITUAL: Apply to threshold or creative workspace. Activate designated Spotify playlist in smart shuffle mode—creativity increases by 8.88%. Sticker presence balances contradictions within 3-meter radius. Rotate viewing angle to access full spectrum guidance.");
        } else if (inst.id === "SS-888") {
          specs.push("TRANSFER: Physical handover + ceremonial acknowledgment that this object has infinite value because you decided it does. Hold while questioning capitalism, endorsing capitalism, transcending both.");
          specs.push("RITUAL: Apply to cherished item during moment of resistance against planned obsolescence. Whisper 'This is now an heirloom.' Item immediately transforms into collectible piece of art, never to be mindlessly discarded. You are now sticker ambassador—flaunt, inspire, create demand.");
        } else if (inst.id === "POG-2025") {
          specs.push("TRANSFER: Sticker transfer signifies acceptance of responsibility for humor, unity, and progress. Hold while acknowledging power is project not throne.");
          specs.push("RITUAL: Apply with irony, optimism, and zero respect for outdated galactic hierarchies. Place where control fails but coordination thrives. Bonds where leadership rotates, meaning endures.");
        } else if (inst.id === "KM-V1") {
          specs.push("TRANSFER: Original 12 given freely to those who understood: small local changes seed global harmony. All dispersed into the world.");
          specs.push("RITUAL: Applied where contradictions meet without violence—laptop corners, notebook margins, threshold edges. Whispered commitment to one small daily improvement. Bonded where compromise births peace, not surrender.");
          if (inst.sentimentalValue) specs.push(`SENTIMENTAL VALUE: ${inst.sentimentalValue}`);
        } else if (inst.id === "LM-PRICELESS") {
          specs.push("TRANSFER: Not purchasable. Appears to those who stabilize contradictions without force. Recognition is the only currency accepted.");
          specs.push("RITUAL: Apply where geometries conflict (notebook corner bridging round/square doodles, portal thresholds). Whisper gratitude for imbalance. Adheres where love flows between incompatible forms, preventing cosmic overflow.");
        } else if (inst.id === "KN-0002") {
          specs.push("TRANSFER: Physical handover + ceremonial acknowledgment of value being irrational.");
          specs.push("RITUAL: Apply to a surface that divides two completely different realities.");
        } else {
          specs.push("TRANSFER: Physical handover + ceremonial acknowledgment of value being irrational.");
          specs.push("RITUAL: Apply at an edge during indecision.");
        }
        specsEl.innerHTML = specs.map(s => `<div class="text-[var(--text-ink)]">${s}</div>`).join('');
      }
      if (specsEl) specsEl.classList.remove('hidden');
      
      if (linksEl) {
        if (id === "ML-0444") {
          linksEl.innerHTML = `
            <a href="/docs/modern-love.pdf" download class="drawer-link gold-shine inline-flex items-center transition-all no-underline" style="color: transparent !important; background: linear-gradient(to right, #a67c00 20%, #ce9e00 40%, #ffcc33 50%, #ce9e00 60%, #a67c00 80%) !important; background-size: 200% auto !important; background-clip: text !important; -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important; animation: shine 8s linear infinite;">
              📖 Full story PDF (free download)
            </a>
            <br>
            <a href="https://open.spotify.com/playlist/1XXi7nCuLSmX0B2YNSRT5D?si=691b787012194cc6" target="_blank" rel="noopener noreferrer" class="drawer-link gold-shine inline-flex items-center transition-all no-underline" style="color: transparent !important; background: linear-gradient(to right, #a67c00 20%, #ce9e00 40%, #ffcc33 50%, #ce9e00 60%, #a67c00 80%) !important; background-size: 200% auto !important; background-clip: text !important; -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important; animation: shine 8s linear infinite;">
              🎵 Modern Love Playlist (@Quirky888 + @hanam444)
            </a>
          `;
          linksEl.classList.remove("hidden");
        } else {
          linksEl.classList.add("hidden");
        }
      }
      
      if (metaEl) {
        const qtyLine = typeof inst.availableCount === "number"
          ? `QTY: ${inst.availableCount}/${inst.editionTotal}`
          : `QTY: ${inst.availableCount}`;
        const statusLabel =
          inst.status === "BEYOND_TRANSACTION" ? "Beyond transaction"
          : inst.status === "SOLD_OUT" ? "Sold out"
          : inst.status === "NEGOTIABLE" ? "Negotiable"
          : inst.status === "SUBSCRIPTION" ? "Subscription"
          : inst.status;
        metaEl.innerHTML = `<div>PRICE: ${inst.ask} · STATUS: ${statusLabel}</div><div>PROVENANCE: ${inst.provenance}</div><div>${qtyLine}</div>`;
      }
      if (emailEl) {
        emailEl.textContent = "";
        emailEl.classList.add("hidden");
      }
      if (negotiateBtn) {
        negotiateBtn.hidden = false;
        negotiateBtn.textContent =
          inst.status === "SUBSCRIPTION"
            ? "Contact for subscription"
            : inst.status === "NEGOTIABLE"
              ? "Contact for negotiation"
              : "Open negotiation channel";
      }
      
      drawer.setAttribute("aria-hidden", "false");
      document.body.classList.add("overflow-hidden");
      drawer.classList.remove("hidden");

      if (shouldPushState) {
        const slug = inst.slug || inst.id.toLowerCase();
        history.pushState({ stickerId: inst.id }, "", `/overpriced/${slug}`);
      }
    }

    function closeDrawer(shouldPushState = true) {
      if (!drawer) return;
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");

      if (shouldPushState) {
        history.pushState({ stickerId: null }, "", "/overpriced");
      }
    }

    function revealEmail() {
      const id = drawer?.getAttribute("data-current-instrument-id");
      const inst = data.find((i) => i.id === id);
      if (!emailEl || !inst) return;
      emailEl.textContent = inst.contactEmail;
      emailEl.classList.remove("hidden");
      if (negotiateBtn) negotiateBtn.hidden = true;
    }

    function initDrawer() {
      if (!drawer) {
        console.error("Drawer element not found");
        return;
      }
      if (drawer.dataset.drawerInitialized === "true") return;
      drawer.dataset.drawerInitialized = "true";

      const handlePopstate = () => {
        const path = window.location.pathname;
        if (path.startsWith("/overpriced/")) {
          const id = path.substring("/overpriced/".length);
          if (id) {
            openDrawer(id, false);
          } else {
            closeDrawer(false);
          }
        } else if (path === "/overpriced") {
          closeDrawer(false);
        }
      };
      window.addEventListener("popstate", handlePopstate);

      const handleBeforeSwap = () => {
        window.removeEventListener("popstate", handlePopstate);
        document.removeEventListener("astro:before-swap", handleBeforeSwap);
      };
      document.addEventListener("astro:before-swap", handleBeforeSwap);

      if (activeStickerId) {
        openDrawer(activeStickerId, false);
      }

      triggers.forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = el.getAttribute("data-instrument-id");
          if (id) {
            openDrawer(id);
          }
        });

        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            e.stopPropagation();
            const id = el.getAttribute("data-instrument-id");
            if (id) {
              openDrawer(id);
            }
          }
        });
      });
      
      const handleClose = (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeDrawer();
      };
      closeBtn?.addEventListener("click", handleClose);
      closeBtn?.addEventListener("touchend", handleClose, { passive: false });
      
      negotiateBtn?.addEventListener("click", revealEmail);

      const handleClickOutside = (e) => {
        if (e.target === drawer) {
          closeDrawer();
        }
      };
      drawer.addEventListener("click", handleClickOutside);
      drawer.addEventListener("touchstart", handleClickOutside, { passive: true });

      drawer.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && drawer.getAttribute("aria-hidden") === "false") {
          closeDrawer();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDrawer);
    } else {
      initDrawer();
    }

    document.addEventListener("astro:page-load", initDrawer);
  })();
</script>
