                🎵 ${label}
              </span>
            </a>
            <p class="playlist-note">${note}</p>
          `;
          playlistEl.classList.remove("hidden");
        } else if (inst.id === "FWR-88" && inst.downloadUrl) {
          const label = inst.downloadLabel || "Download (PDF)";
