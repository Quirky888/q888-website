                    letter-spacing: 0.15em;
                    color: transparent !important;
                    background: linear-gradient(to right, #a67c00 20%, #ce9e00 40%, #ffcc33 50%, #ce9e00 60%, #a67c00 80%) !important;
                    background-size: 200% auto !important;
                    background-clip: text !important;
                    -webkit-background-clip: text !important;
                    -webkit-text-fill-color: transparent !important;
                    animation: shine 8s linear infinite;
                  "
                >
                  Subscription Terms &amp; Conditions 😈
                </button>
              </div>

              <div id="termsModal" class="terms-modal hidden">
                <div class="terms-modal-overlay" onclick="toggleTermsModal()"></div>
                <div class="terms-modal-content">
                  <button class="terms-modal-close" onclick="toggleTermsModal()" aria-label="Close terms">×</button>
                  <h2 class="terms-modal-title">Subscription Model &amp; Protection Terms</h2>
                  <div class="terms-modal-body">${termsHtml}</div>
                </div>
              </div>
            `;
          } else {
            subscriptionEl.innerHTML = `
              <div class="subscription-section">
                <h3 class="subscription-title">Subscription Model & Protection Terms</h3>
                <div class="subscription-content">${termsHtml}</div>
              </div>
            `;
          }
          subscriptionEl.classList.remove("hidden");
        } else {
          subscriptionEl.classList.add("hidden");
          subscriptionEl.innerHTML = "";
        }
      }

      if (theoryEl) {
        if (inst.theoryCore) {
          const escaped = inst.theoryCore
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
          const formatted = escaped
            .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
            .replace(/\n/g, "<br>");
          theoryEl.innerHTML = `
            <h3 class="theory-title">Square Bubble Theory Core Principles</h3>
            <div class="theory-content">${formatted}</div>
            <p class="theory-access">
              <strong>Access Full Theory</strong><br>
              Complete manifesto available as downloadable transmission. The mushroom knows the path between chaos and tyranny—it eats both, transforms both, completes the cycle without ruling.
            </p>
          `;
          theoryEl.classList.remove("hidden");
        } else {
          theoryEl.classList.add("hidden");
          theoryEl.innerHTML = "";
        }
      }

      if (playlistEl) {
        if (inst.playlistUrl) {
          const label = inst.playlistLabel || "Listen on Spotify";
          const note =
            inst.id === "IDJ-SACRED"
              ? "Smart shuffle activates 8.88% enhancement (belief-dependent)"
              : "Smart shuffle mode activates 8.88% creativity enhancement";
