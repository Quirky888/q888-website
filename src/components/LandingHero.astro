---
---

<div class="flex flex-col min-h-screen w-full overflow-x-hidden">
  <div class="relative w-full h-screen overflow-hidden bg-[var(--bg-fog)]">
    <picture>
      <source
        type="image/avif"
        media="(max-width: 768px) and (orientation: portrait)"
        srcset="/images/q888_mobile.avif"
      />
      <source
        type="image/webp"
        media="(max-width: 768px) and (orientation: portrait)"
        srcset="/images/q88_mobile_fallback.webp"
      />
      <img
        src="/images/Q888_hero.webp"
        alt="Q888"
        class="absolute inset-0 z-0 w-full h-full object-contain"
        decoding="async"
        loading="eager"
        fetchpriority="high"
        width="800"
        height="1200"
      />
    </picture>

    <span class="hero-tagline-silver hero-tagline-corner">The hidden d∞oor is slightly open.</span>

    <div class="absolute z-10 left-0 px-6 md:px-24 hero-text-block">
      <h1 class="hero-title-silver">Q888</h1>
    </div>

    <svg width="0" height="0" class="absolute pointer-events-none" aria-hidden="true" focusable="false">
      <defs>
        <filter id="hero-tagline-glitch">
          <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" />
        </filter>
      </defs>
    </svg>
  </div>

  <div class="landing-typography px-6 md:px-24 pt-8 md:pt-10 pb-16 md:pb-24">
    <p class="landing-line-1">
      Identity &amp; Architecture
    </p>

    <p class="landing-line-2">
      Q888 builds <span class="symbolic-box"><span class="gold-gradient-text">symbolic systems</span></span>, narrative architectures, and speculative tools.
    </p>

    <p class="landing-line-3">
      Operating at the intersection of contemporary art, AI, and conceptual infrastructure, this practice treats myth, code, and interface as equal materials.
    </p>

    <p class="landing-intro-follow">
      This work refuses instant clarity; it is structured to unfold. Meaning accumulates here through repetition, context, and return.
    </p>

    <p class="landing-entry-point">
      <span class="black-box-white">This is not a portfolio. It is an entry point into a set of living systems.</span>
    </p>

    <h2 class="landing-projects-heading">The Systems</h2>

    <p class="landing-paragraph-1">
      <span class="gold-gradient-text">Digital Ink</span><br />
      AI-driven drawing tools for iPad where image-making becomes a negotiation between human intention and machine interpretation. A research environment for explainable visual collaboration.
    </p>

    <p class="landing-paragraph-2">
      <span class="gold-gradient-text">Edinburgh Magic Map</span><br />
      An interactive mythology layered onto real geography. A cartographic narrative where place becomes interface and story becomes infrastructure.
    </p>

    <p class="landing-paragraph-3">
      <span class="gold-gradient-text">Project Infocigan</span><br />
      A speculative design studio producing artifacts for uncertain futures. Objects released with internal logic, controlled circulation, and conceptual lineage.
    </p>

    <h2 class="landing-method-heading">The Method</h2>

    <p class="landing-method-paragraph">
      Across these works, Q888 constructs ecosystems, not isolated pieces. Editions, protocols, and verification structures are embedded into the code of each project.
    </p>

    <p class="landing-method-paragraph landing-method-paragraph-2">
      Here, scarcity, provenance, and narrative weight are not marketing devices—they are core artistic materials.
    </p>

    <p class="landing-method-paragraph landing-method-paragraph-3">
      <span class="black-box-white">The practice spans screens, walls, and conceptual territories. Technology is treated as substance, not surface. Absurdism is the method used to question value systems, authorship, and the mechanics of belief.</span>
    </p>

    <p class="landing-method-paragraph landing-method-paragraph-4">
      These works behave like operating systems: mythologies with governance, artifacts with lineage, and tools that generate further tools.
    </p>

    <p class="landing-final-line">
      Collaborations, commissions, research partnerships, and critical dialogue are welcome.
    </p>
  </div>
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let glitchTimeoutId = 0;

  function runPulseGlitch() {
    const tagline = document.querySelector(".hero-tagline-silver");
    if (!tagline || reducedMotion.matches) return;

    const pulseGlitch = () => {
      if (!tagline.isConnected || reducedMotion.matches) return;
      tagline.classList.add("is-glitching");
      window.setTimeout(() => tagline.classList.remove("is-glitching"), 140);
      glitchTimeoutId = window.setTimeout(pulseGlitch, 2000 + Math.random() * 1000);
    };
    pulseGlitch();
  }

  function init() {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runPulseGlitch, { once: true });
    } else {
      runPulseGlitch();
    }
  }

  function cleanup() {
    if (glitchTimeoutId) clearTimeout(glitchTimeoutId);
    glitchTimeoutId = 0;
    document.removeEventListener("astro:before-swap", cleanup);
    window.removeEventListener("beforeunload", cleanup);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:before-swap", cleanup);
  window.addEventListener("beforeunload", cleanup);
</script>

<style>
  .hero-tagline-corner {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    padding: 3.5rem 1.5rem 0 0.75rem;
  }
  @media (max-width: 768px) {
    .hero-tagline-corner {
      padding-top: 5rem;
    }
  }
  @media (min-width: 768px) {
    .hero-tagline-corner {
      padding: 3.75rem 6rem 0 1.5rem;
    }
  }
  .hero-text-block {
    top: 38%;
    transform: translateY(-50%);
  }
  .hero-title-silver {
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    background: linear-gradient(
      to right,
      #b0b0b0 20%,
      #e8e8e8 40%,
      #ffffff 50%,
      #e8e8e8 60%,
      #b0b0b0 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }
  .hero-tagline-silver {
    font-family: ui-monospace, monospace;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    display: inline-block;
    background: linear-gradient(
      to right,
      #a8a8a8 20%,
      #e0e0e0 40%,
      #ffffff 50%,
      #e0e0e0 60%,
      #a8a8a8 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }
  .hero-tagline-silver.is-glitching {
    filter: url("#hero-tagline-glitch");
  }
  @keyframes hero-shine {
    to { background-position: 200% center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title-silver,
    .hero-tagline-silver {
      animation: none;
    }
  }

  .landing-typography {
    position: relative;
    min-height: 78vh;
    color: var(--text-ink);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .landing-line-1 {
    margin: 0;
    margin-left: 6%;
    max-width: 20ch;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    font-weight: 650;
  }

  .landing-line-2 {
    margin: 2rem 0 0 10%;
    max-width: 28ch;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.4;
    font-weight: 450;
    opacity: 0.9;
  }

  .landing-line-3 {
    margin: 2.25rem 0 0 62%;
    max-width: 36ch;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.5;
    font-weight: 400;
    color: var(--text-ink);
    opacity: 0.9;
  }

  .landing-intro-follow {
    margin: 2.1rem 0 0 12%;
    max-width: 60ch;
    font-size: clamp(1.05rem, 1.9vw, 1.3rem);
    line-height: 1.7;
    font-weight: 360;
    opacity: 0.86;
  }

  .landing-entry-point {
    margin: 2.2rem 0 0 54%;
    max-width: 34ch;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.55;
    font-weight: 520;
  }

  .landing-projects-heading {
    margin: 5rem 0 0 14%;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(184, 143, 98);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .landing-paragraph-1 {
    margin: 2rem 0 0 10%;
    max-width: 700px;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.7;
    font-weight: 400;
  }

  .landing-paragraph-2 {
    margin: 3.2rem 0 0 42%;
    max-width: 650px;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
    font-weight: 350;
    opacity: 0.85;
  }

  .landing-paragraph-3 {
    margin: 3rem 0 0 12%;
    max-width: 680px;
    font-size: clamp(1.05rem, 1.9vw, 1.28rem);
    line-height: 1.7;
    font-weight: 350;
    opacity: 0.9;
  }

  .landing-method-heading {
    margin: 4.5rem 0 0 16%;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(184, 143, 98);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .landing-method-paragraph {
    margin: 1.6rem 0 0 16%;
    max-width: 680px;
    font-size: clamp(1.05rem, 1.85vw, 1.25rem);
    line-height: 1.75;
    font-weight: 350;
    opacity: 0.9;
  }

  .landing-method-paragraph-2 {
    margin-top: 1.7rem;
    margin-left: 44%;
  }

  .landing-method-paragraph-3 {
    margin-top: 1.7rem;
    margin-left: 12%;
  }

  .landing-method-paragraph-4 {
    margin-top: 1.7rem;
    margin-left: 48%;
