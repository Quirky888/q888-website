---
import LocalizedArtistName from "./LocalizedArtistName.astro";
---

<div class="flex flex-col min-h-[100dvh] min-h-screen w-full overflow-x-hidden">
  <div
    class="relative w-full h-[100dvh] h-screen overflow-hidden bg-[var(--bg-fog)]"
  >
    <picture>
      <source
        type="image/avif"
        media="(max-width: 768px) and (orientation: portrait)"
        srcset="/images/q888_mobile.avif"
      />
      <source
        type="image/webp"
        media="(max-width: 768px) and (orientation: portrait)"
        srcset="/images/q88_mobile_fallback.webp"
      />
      <img
        src="/images/Q888_hero.webp"
        alt="Q888"
        class="absolute inset-0 z-0 w-full h-full object-contain"
        decoding="async"
        loading="eager"
        fetchpriority="high"
        width="800"
        height="1200"
      />
    </picture>

    <span class="hero-tagline-silver hero-tagline-corner tagline-container">
      <span class="tagline-line">The hidden d∞oor</span>
      <span class="tagline-line">is slightly</span>
      <span class="tagline-line">open.</span>
    </span>

    <div class="absolute z-10 left-0 px-6 md:px-24 hero-text-block">
      <h1 class="hero-title-silver">
        Q888<span class="hero-square-bubble-mark" aria-hidden="true"></span>
      </h1>
    </div>

    <svg
      width="0"
      height="0"
      class="absolute pointer-events-none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <filter id="hero-tagline-glitch">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.02"
            numOctaves="3"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5"
          ></feDisplacementMap>
        </filter>
      </defs>
    </svg>
  </div>

  <!-- CHOICE: Orientation follows the artwork and replaces the old status theatre and essay. -->
  <div
    id="landing-map"
    class="landing-orientation px-6 md:px-24 py-16 md:py-24"
  >
    <p class="landing-kicker">Q888 · Living portfolio · Edinburgh</p>

    <h2>One artist.<br />Several worlds.</h2>

    <div class="landing-orientation-copy">
      <p>
        Q888 is the evolving practice of
        <LocalizedArtistName />: drawings, objects,
        code, research and invented systems collected in one changing place.
      </p>

      <p>
        The projects do not share one house style because they come from
        different moments of the same artistic life. Some images are made by
        hand, some with AI as a collaborator, and some are still changing.
      </p>

      <p class="landing-method">
        Myth, technology and ordinary life are allowed to meet here without
        becoming a brand guideline.
      </p>
    </div>

    <p class="landing-construction">
      Site state: under construction until we all get bored.
    </p>
  </div>
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const isTablet =
    window.matchMedia("(max-width: 1024px)").matches ||
    window.matchMedia("(hover: none)").matches;
  let glitchTimeoutId = 0;

  function runPulseGlitch() {
    const tagline = document.querySelector(".hero-tagline-silver");
    if (!tagline || reducedMotion.matches || isTablet) return;

    const pulseGlitch = () => {
      if (!tagline.isConnected || reducedMotion.matches) return;
      tagline.classList.add("is-glitching");
      window.setTimeout(() => tagline.classList.remove("is-glitching"), 140);
      glitchTimeoutId = window.setTimeout(
        pulseGlitch,
        2000 + Math.random() * 1000,
      );
    };
    pulseGlitch();
  }

  function cleanup() {
    if (glitchTimeoutId) clearTimeout(glitchTimeoutId);
    glitchTimeoutId = 0;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", runPulseGlitch, {
      once: true,
    });
  } else {
    runPulseGlitch();
  }
  document.addEventListener("astro:page-load", runPulseGlitch);
  document.addEventListener("astro:before-swap", cleanup);
  window.addEventListener("beforeunload", cleanup);
</script>

<style>
  .hero-tagline-corner {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    padding: 3.5rem 1.5rem 0 0.75rem;
  }

  @media (max-width: 768px) {
    .hero-tagline-corner {
      padding-top: 5rem;
    }
  }

  @media (min-width: 768px) {
    .hero-tagline-corner {
      padding: 3.75rem 6rem 0 1.5rem;
    }
  }

  .hero-text-block {
    top: 38%;
    transform: translateY(-50%);
  }

  .hero-title-silver {
    position: relative;
    width: fit-content;
    margin: 0;
    font-size: clamp(3.9rem, 12vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    background: linear-gradient(
      to right,
      #b0b0b0 20%,
      #e8e8e8 40%,
      #ffffff 50%,
      #e8e8e8 60%,
      #b0b0b0 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }

  /* DNA: the empty square is Q888's quiet authorship seal, not another logo. */
  .hero-square-bubble-mark {
    position: absolute;
    top: 0.2em;
    right: -0.27em;
    width: 0.16em;
    aspect-ratio: 1;
    padding: max(2px, 0.022em);
    background: linear-gradient(
      to right,
      #a8a8a8 20%,
      #e8e8e8 40%,
      #ffffff 50%,
      #e8e8e8 60%,
      #a8a8a8 80%
    );
    background-size: 200% auto;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: hero-shine 8s linear infinite;
    filter: drop-shadow(0 0 0.035em rgba(255, 255, 255, 0.9));
    transform: rotate(-1.5deg);
    opacity: 0.96;
  }

  .hero-tagline-silver {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    background: linear-gradient(
      to right,
      #a8a8a8 20%,
      #e0e0e0 40%,
      #ffffff 50%,
      #e0e0e0 60%,
      #a8a8a8 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }

  .tagline-line {
    display: inline;
  }

  .hero-tagline-silver.is-glitching {
    filter: url("#hero-tagline-glitch");
  }

  @keyframes hero-shine {
    to {
      background-position: 200% center;
    }
  }

  .landing-orientation {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(18rem, 1fr);
    column-gap: clamp(3rem, 9vw, 9rem);
    row-gap: 1.25rem;
    align-items: start;
    color: var(--text-ink);
    background: var(--bg-fog);
    border-top: 1px solid var(--line-soft);
  }

  .landing-kicker {
    grid-column: 1 / -1;
    margin: 0 0 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .landing-orientation h2 {
    margin: 0;
    max-width: 9ch;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: clamp(2.9rem, 6vw, 5.7rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .landing-orientation-copy {
    max-width: 47rem;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: clamp(1rem, 1.55vw, 1.22rem);
    font-weight: 360;
    line-height: 1.62;
  }

  .landing-orientation-copy p {
    margin: 0;
  }

  .landing-orientation-copy p + p {
    margin-top: 1.1rem;
  }

  .landing-orientation-copy a {
    color: inherit;
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .landing-method {
    color: var(--text-muted);
  }

  .landing-construction {
    grid-column: 1 / -1;
    margin: 2.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 768px) and (orientation: portrait) {
    .tagline-line {
      display: block;
    }

    .hero-text-block {
      top: 33.4%;
    }

    .hero-title-silver {
      font-size: 3rem;
    }

    .landing-orientation {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }

    .landing-kicker,
    .landing-construction {
      grid-column: 1;
    }

    .landing-kicker {
      margin-bottom: 0;
    }

    .landing-orientation h2 {
      font-size: clamp(2.8rem, 14vw, 4rem);
    }

    .landing-construction {
      margin-top: 0.75rem;
    }
  }

  @media (max-width: 768px) {
    .hero-tagline-silver {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title-silver,
    .hero-tagline-silver {
      animation: none;
    }
  }
</style>
