---
import LocalizedArtistName from "./LocalizedArtistName.astro";
---

<!-- DNA: the tagline's hidden door is literal here. Scrolling opens it onto the artwork. -->
<div class="door-hero" data-door-hero>
  <div class="door-stage">
    <canvas class="door-threads" data-door-threads aria-hidden="true"></canvas>

    <div class="door-aperture">
      <picture>
        <source
          type="image/avif"
          media="(max-width: 768px) and (orientation: portrait)"
          srcset="/images/q888_mobile.avif"
        />
        <source
          type="image/webp"
          media="(max-width: 768px) and (orientation: portrait)"
          srcset="/images/q88_mobile_fallback.webp"
        />
        <img
          src="/images/Q888_hero.webp"
          alt="Q888 artwork: black and grey silhouettes of mushrooms, a fir tree and drifting letters"
          decoding="async"
          loading="eager"
          fetchpriority="high"
          width="2560"
          height="1440"
        />
      </picture>
    </div>

    <div class="door-copy qd-wrap">
      <p class="qd-mono">Q888 · Living portfolio · Edinburgh</p>
      <h1 class="door-wordmark" data-door-wordmark aria-label="Q888">
        <span aria-hidden="true">Q</span><span class="door-eight" aria-hidden="true">8</span><span class="door-eight" aria-hidden="true">8</span><span class="door-eight" aria-hidden="true">8</span>
        <!-- DNA: the empty square is Q888's quiet authorship seal, not another logo. -->
        <span class="hero-square-bubble-mark" aria-hidden="true"></span>
      </h1>
      <p class="door-tagline">The hidden d∞oor is slightly open.</p>
    </div>

    <p class="door-hint qd-wrap qd-mono" aria-hidden="true">Scroll to open ↓</p>
  </div>
</div>

<!-- CHOICE: Orientation follows the artwork instead of covering it. -->
<div id="landing-map" class="landing-orientation qd-wrap">
  <h2>One artist. <em>Several worlds.</em></h2>

  <div class="landing-orientation-copy">
    <p>
      Q888 is the evolving practice of
      <LocalizedArtistName />: drawings, objects,
      code, research and invented systems collected in one changing place.
    </p>

    <p class="landing-method">
      The projects do not share one house style because they come from
      different moments of the same artistic life. Some images are made by
      hand, some with AI as a collaborator, and some are still changing.
    </p>

    <p class="landing-method">
      Myth, technology and ordinary life are allowed to meet here without
      becoming a brand guideline.
    </p>

    <p class="landing-construction qd-mono">
      Site state: under construction until we all get bored.
    </p>
  </div>
</div>

<style>
  /* LEARN: --p runs 0 → 1 with scroll (set in hiddenDoor.ts). Every door edge is a calc() of it,
     so the browser does the geometry and the script only writes one number. */
  .door-hero {
    --p: 0;
    --door-left: 66vw;
    --door-right: 22vw;
    --door-top: 17vh;
    --door-bottom: 15vh;
    position: relative;
    height: 230vh;
    height: 230svh;
  }

  .door-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .door-threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .door-aperture {
    position: absolute;
    z-index: 2;
    left: calc((1 - var(--p)) * var(--door-left));
    right: calc((1 - var(--p)) * var(--door-right));
    top: calc((1 - var(--p)) * var(--door-top));
    bottom: calc((1 - var(--p)) * var(--door-bottom));
    overflow: hidden;
    border-radius: calc((1 - var(--p)) * 12vw) calc((1 - var(--p)) * 12vw) 0 0;
    background: var(--bg-fog);
    box-shadow:
      0 0 calc((1 - var(--p)) * 140px) var(--door-glow),
      0 0 0 1px var(--line-soft);
  }

  /* The artwork stays pinned to the viewport while the aperture grows around it. */
  .door-aperture img {
    position: absolute;
    left: calc((1 - var(--p)) * var(--door-left) * -1);
    top: calc((1 - var(--p)) * var(--door-top) * -1);
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100svh;
    object-fit: cover;
    filter: var(--door-art-filter);
  }

  .door-copy {
    position: absolute;
    inset-inline: 0;
    bottom: 13vh;
    bottom: 13svh;
    opacity: calc(1 - var(--p) * 1.9);
    transform: translateY(calc(var(--p) * -40px));
  }

  .door-wordmark {
    position: relative;
    display: flex;
    width: max-content;
    margin: 0.6rem 0 0;
    font-family: var(--font-door-display);
    font-size: clamp(7.5rem, 25vw, 26rem);
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    letter-spacing: -0.045em;
    line-height: 0.82;
    color: var(--text-ink);
  }

  .door-wordmark span {
    display: inline-block;
    transition:
      transform 1s cubic-bezier(0.6, 0, 0.1, 1),
      margin 1s cubic-bezier(0.6, 0, 0.1, 1),
      color 1s ease;
  }

  /* An 8 on its side is ∞: the same sign the tagline hides inside "d∞oor". */
  .door-wordmark.is-infinite .door-eight {
    transform: rotate(90deg);
    margin-inline: 0.15em;
  }

  .door-wordmark.is-infinite .door-eight:nth-of-type(3) {
    transition-delay: 0.12s;
    color: var(--door-gold);
  }

  .door-wordmark.is-infinite .door-eight:nth-of-type(4) {
    transition-delay: 0.24s;
  }

  .door-wordmark .hero-square-bubble-mark {
    position: absolute;
    top: 0.08em;
    right: -0.16em;
    width: 0.075em;
    aspect-ratio: 1;
    border: max(2px, 0.008em) solid currentColor;
    transform: rotate(-1.5deg);
  }

  .door-tagline {
    max-width: 16em;
    margin: 2.1rem 0 0;
    font-family: var(--font-door-serif);
    font-size: clamp(1.4rem, 2.6vw, 2.5rem);
    font-style: italic;
    line-height: 1.15;
    color: var(--text-ink);
  }

  .door-hint {
    position: absolute;
    inset-inline: 0;
    bottom: 5vh;
    bottom: 5svh;
    margin: 0;
    text-align: right;
    opacity: calc(1 - var(--p) * 3);
  }

  .landing-orientation {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    align-items: end;
    padding-block: clamp(5rem, 14vw, 12.5rem);
    color: var(--text-ink);
    background: var(--bg-fog);
  }

  .landing-orientation h2 {
    margin: 0;
    font-family: var(--font-door-display);
    font-size: clamp(3rem, 9vw, 9.4rem);
    font-weight: 700;
    font-variation-settings: "wdth" 78;
    letter-spacing: -0.035em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .landing-orientation h2 em {
    font-family: var(--font-door-serif);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--door-gold);
  }

  .landing-orientation-copy {
    max-width: 34em;
    font-family: var(--font-door-display);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .landing-orientation-copy p {
    margin: 0;
  }

  .landing-orientation-copy p + p {
    margin-top: 1em;
  }

  .landing-method {
    color: var(--text-muted);
  }

  .landing-orientation-copy .landing-construction {
    margin-top: 2.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }

  @media (max-width: 800px) {
    .landing-orientation {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) and (orientation: portrait) {
    .door-hero {
      --door-left: 62vw;
      --door-right: 8vw;
      --door-top: 13vh;
      --door-bottom: 45vh;
    }

    .door-copy {
      bottom: 12vh;
      bottom: 12svh;
    }
  }

  /* Reduced motion: no pinned stage and no scroll-linked opening. The copy comes first,
     then the whole artwork as an ordinary image, with no leftover offsets. */
  @media (prefers-reduced-motion: reduce) {
    .door-hero {
      height: auto;
    }

    .door-stage {
      position: relative;
      display: flex;
      flex-direction: column;
      height: auto;
      padding-top: 7rem;
    }

    .door-copy {
      position: relative;
      bottom: auto;
      order: 1;
      opacity: 1;
      transform: none;
    }

    .door-aperture {
      position: relative;
      inset: auto;
      order: 2;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin-top: 3rem;
      border-radius: 0;
      box-shadow: 0 0 0 1px var(--line-soft);
    }

    .door-aperture img {
      position: static;
      width: 100%;
      height: 100%;
    }

    .door-hint {
      display: none;
    }

    .door-wordmark span {
      transition: none;
    }
  }
</style>
