---
---

<div class="flex flex-col min-h-screen w-full overflow-x-hidden">
  <div class="relative w-full h-screen overflow-hidden bg-[var(--bg-fog)]">
    <img 
      src="/images/Q888_hero.webp" 
      alt="Q888" 
      class="absolute inset-0 z-0 w-full h-full object-contain"
      decoding="async"
      loading="eager"
    />

    <div class="absolute z-10 left-0 px-6 md:px-24 hero-text-block">
      <div class="flex flex-col gap-3">
        <h1 class="hero-title-silver">Q888</h1>
        <span class="hero-tagline-silver">The hidden d∞oor is slightly open.</span>
      </div>
    </div>
  </div>

  <!-- 3) Main hero copy block (constrained container) -->
  <div class="px-6 md:px-24 py-16 md:py-24 max-w-7xl">
    <div class="space-y-8 md:space-y-12">
      <p class="text-2xl md:text-5xl lg:text-6xl font-light leading-tight md:leading-[1.1] text-neutral-800 max-w-[20ch] md:max-w-[25ch]">
        I'm an artist who builds symbolic systems and narrative tools.
      </p>
      <p class="text-xl md:text-3xl lg:text-4xl font-light leading-relaxed text-neutral-500 max-w-[30ch] md:max-w-[40ch]">
        I make things that don't always explain themselves, but tend to reveal meaning over time.
      </p>
      <p class="text-lg md:text-2xl lg:text-3xl font-light text-neutral-400">
        Welcome to one version of me.
      </p>
    </div>
  </div>
</div>

<style>
  .hero-text-block {
    top: 38%;
    transform: translateY(-50%);
  }
  .hero-title-silver {
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    background: linear-gradient(
      to right,
      #b0b0b0 20%,
      #e8e8e8 40%,
      #ffffff 50%,
      #e8e8e8 60%,
      #b0b0b0 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }
  .hero-tagline-silver {
    font-family: ui-monospace, monospace;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    font-style: italic;
    background: linear-gradient(
      to right,
      #a8a8a8 20%,
      #e0e0e0 40%,
      #ffffff 50%,
      #e0e0e0 60%,
      #a8a8a8 80%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 8s linear infinite;
  }
  @keyframes hero-shine {
    to { background-position: 200% center; }
  }
</style>
