  .landing-final-line {
    margin: 3.5rem 0 0 64%;
    max-width: 32ch;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.6;
    font-weight: 500;
    color: rgb(184, 143, 98);
  }

  .gold-gradient-text {
    background: linear-gradient(135deg, rgb(218, 197, 143) 0%, rgb(184, 143, 98) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 600;
  }

  .symbolic-box {
    display: inline-block;
    background: #000;
    padding: 0.24em 0.58em 0.3em 0.48em;
    border-radius: 0.46em 0.22em 0.58em 0.3em;
    line-height: 1;
    transform: rotate(-1.6deg);
  }

  .black-box-white {
    display: inline;
    color: #fff;
    background: #000;
    padding: 0.24em 0.52em 0.3em 0.44em;
    border-radius: 0.5em 0.24em 0.6em 0.28em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    line-height: 1.68;
    -webkit-text-fill-color: #fff;
    background-clip: border-box;
    -webkit-background-clip: border-box;
  }

  .landing-entry-point .black-box-white {
    transform: rotate(-1.2deg);
    display: inline-block;
  }

  .landing-method-paragraph-3 .black-box-white {
    transform: rotate(1.35deg);
    display: inline-block;
    padding: 0.26em 0.6em 0.34em 0.5em;
    border-radius: 0.62em 0.26em 0.42em 0.56em;
  }

  @media (max-width: 980px) {
    .landing-typography {
      min-height: auto;
    }

    .landing-line-1,
    .landing-line-2,
    .landing-line-3,
    .landing-intro-follow,
    .landing-entry-point,
    .landing-projects-heading,
    .landing-paragraph-1,
    .landing-paragraph-2,
    .landing-paragraph-3,
    .landing-method-heading,
    .landing-method-paragraph,
    .landing-final-line {
      margin-left: 0;
      margin-right: 0;
      max-width: none;
    }

    .landing-line-2 {
      margin-top: 1.5rem;
    }

    .landing-line-3 {
      margin-top: 1.5rem;
      margin-left: 8%;
    }

    .landing-intro-follow {
      margin-top: 1.5rem;
      margin-left: 4%;
    }

    .landing-entry-point {
      margin-top: 1.6rem;
      margin-left: 10%;
    }

    .landing-projects-heading {
      margin-top: 3rem;
      margin-left: 4%;
    }

    .landing-paragraph-1 {
      margin-top: 1.2rem;
      margin-left: 2%;
    }

    .landing-paragraph-2 {
      margin-top: 2rem;
      margin-left: 9%;
    }

    .landing-paragraph-3 {
      margin-top: 2rem;
      margin-left: 3%;
    }

    .landing-method-heading {
      margin-top: 2.4rem;
      margin-left: 6%;
