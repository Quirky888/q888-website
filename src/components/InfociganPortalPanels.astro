---
import SlimNav from "./SlimNav.astro";
import OverpricedStickersSection from "./OverpricedStickersSection.astro";
import DynamicCosmicBackground from "./DynamicCosmicBackground.astro";
import NarMailChatbot from "./NarMailChatbot.astro";
import InvestorChatbot from "./InvestorChatbot.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

type ProductData = CollectionEntry<"products">["data"];
type QBagData = Extract<ProductData, { slug: "q-bag" }>;
type NarMailData = Extract<ProductData, { slug: "nar-mail-express" }>;

const zones = (await getCollection("projects"))
  .map(({ data }) => ({
    sortOrder: data.sortOrder,
    slug: data.slug,
    title: data.panelTitle,
    description: data.panelDescription,
    specs: data.panelSpecs,
  }))
  .sort((a, b) => a.sortOrder - b.sortOrder);

const qBagEntry = await getEntry("products", "q-bag");
const narMailEntry = await getEntry("products", "nar-mail-express");
const afterlifeEntry = await getEntry("contracts", "afterlife-contracts");
const presidentEntry = await getEntry("campaigns", "president-of-the-galaxy");

if (
  !qBagEntry ||
  qBagEntry.data.slug !== "q-bag" ||
  !narMailEntry ||
  narMailEntry.data.slug !== "nar-mail-express" ||
  !afterlifeEntry ||
  !presidentEntry
) {
  throw new Error("Required Infocigan content entries are missing.");
}

const qBag: QBagData = qBagEntry.data;
const narMail: NarMailData = narMailEntry.data;
const afterlife = afterlifeEntry.data;
const president = presidentEntry.data;
---

<div class="infocigan-portal-system">
  {zones.map((zone) => (
    <div 
      class="portal-panel" 
      data-portal-panel={zone.slug}
    >
      <div class="panel-overlay"></div>
      <div class="panel-content">
        <!-- Archival Header for Panel -->
        <div class="panel-archive-bar w-full bg-[#343d46] py-3 px-6 md:px-24 flex items-center justify-between border-b border-white/5">
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#a67c00]">ARCHIVE_ID: {zone.slug.toUpperCase()}</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#a67c00]/50">CONFIDENTIAL_MARKET_DATA</span>
        </div>

        <div class="panel-scroll">
          {zone.slug === "q-bag" ? (
            <>
            <SlimNav />
            <div class="qbag-new-layout">
              <section class="qbag-hero">
                <img
                  src={qBag.heroImage}
                  alt={qBag.heroAlt}
                  loading="eager"
                  decoding="async"
                  width="1200"
                  height="800"
                />
                <div class="qbag-hero-overlay">
                  <h1 class="qbag-title gold-shine">{qBag.heroTitle}</h1>
                </div>
              </section>
              <div class="qbag-main-content">
                <section class="qbag-intro-section">
                  <div class="glass-card intro-card">
                    <p class="qbag-tagline gold-shine">{qBag.introTagline}</p>
                    <p class="qbag-lead">
                      {qBag.introLead}
                    </p>
                  </div>
                </section>
              </div>
              <!-- Artwork Gallery Info Card (replaces full artwork section) -->
              <section class="qbag-artwork-card-section">
                <div class="artwork-info-card glass-card" id="artwork-gallery-trigger">
                  <div class="artwork-card-content">
                    <div class="artwork-card-icon">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 16L8.586 11.414C9.367 10.633 10.633 10.633 11.414 11.414L16 16M14 14L15.586 12.414C16.367 11.633 17.633 11.633 18.414 12.414L20 14M14 8H14.01M6 20H18C19.105 20 20 19.105 20 18V6C20 4.895 19.105 4 18 4H6C4.895 4 4 4.895 4 6V18C4 19.105 4.895 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <div class="artwork-card-text">
                          <h3 class="artwork-card-title">{qBag.artworkCardTitle}</h3>
                          <p class="artwork-card-description">{qBag.artworkCardDescription}</p>
                    </div>
                    <button class="artwork-card-button" type="button">
                          <span>{qBag.artworkCardButtonLabel}</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </section>
              <div class="qbag-main-content">
                <section class="qbag-content-grid-section" data-motion-reveal>
                  <div class="qbag-glass-grid" data-motion-stagger data-motion-children="[data-motion-item]">
                    <div class="glass-card" data-motion-item>
                      <h3>{qBag.conceptCards[0].title}</h3>
                      <p>{qBag.conceptCards[0].paragraphs[0]}</p>
                      <p>{qBag.conceptCards[0].paragraphs[1]}</p>
                    </div>
                    <div class="glass-card" data-motion-item>
                      <h3>{qBag.conceptCards[1].title}</h3>
                      <p>{qBag.conceptCards[1].paragraphs[0]}</p>
                      <p>{qBag.conceptCards[1].paragraphs[1]}</p>
                      <p>{qBag.conceptCards[1].paragraphs[2]}</p>
                    </div>
                    <div class="glass-card" data-motion-item>
                      <h3>{qBag.conceptCards[2].title}</h3>
                      <p>{qBag.conceptCards[2].paragraphs[0]}</p>
                      <p>{qBag.conceptCards[2].paragraphs[1]}</p>
                    </div>
                    <div class="glass-card" data-motion-item>
                      <h3>{qBag.conceptCards[3].title}</h3>
                      <p>{qBag.conceptCards[3].paragraphs[0]}</p>
                      <p>{qBag.conceptCards[3].paragraphs[1]}</p>
                    </div>
                  </div>
                </section>
                <section class="qbag-partners-section">
                  <div class="glass-card partners-card">
                    <h2>{qBag.partnersTitle}</h2>
                    <p>{qBag.partnersParagraphs[0]}</p>
                    <p>{qBag.partnersParagraphs[1]}</p>
                  </div>
                </section>
                <section class="qbag-closing-section">
                  <div class="closing-content">
                    <p class="big-statement">
                      {qBag.closingLines[0]}<br />
                      {qBag.closingLines[1]}<br />
                      {qBag.closingLines[2]}
                    </p>
                  </div>
                </section>
                <section class="qbag-contact-section">
                  <div class="glass-card contact-card">
                    <p>{qBag.contactIntro}</p>
                    <p class="contact-info">
                      <a href={`mailto:${qBag.contactEmail}`}>{qBag.contactEmail}</a> or Instagram: <a href={qBag.contactInstagramUrl} target="_blank" rel="noopener">{qBag.contactInstagramHandle}</a>
                    </p>
                  </div>
                </section>
              </div>
              <section class="qbag-cta">
                <button type="button" class="retreat-button" data-portal-back>
                  {qBag.ctaLabel}
                </button>
              </section>

              <div class="artwork-viewer" id="artwork-viewer" aria-hidden="true">
                <div class="viewer-overlay"></div>
                <div class="viewer-container">
                  <div class="viewer-controls">
                    <button class="viewer-btn viewer-close" aria-label="Close viewer" title="Close (ESC)">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="viewer-btn viewer-zoom-in" aria-label="Zoom in" title="Zoom In">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="viewer-btn viewer-zoom-out" aria-label="Zoom out" title="Zoom Out">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="viewer-btn viewer-reset" aria-label="Reset view" title="Reset View">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="viewer-image-wrapper">
                    <div class="viewer-image-container" id="viewer-image-container">
                      <img
                        src={qBag.viewerImage}
                        alt={qBag.viewerAlt}
                        class="viewer-image"
                        id="viewer-image"
                        draggable="false"
                        loading="lazy"
                        decoding="async"
                        width="1200"
                        height="900"
                      />
                    </div>
                  </div>
                  <div class="viewer-zoom-indicator" id="zoom-indicator">100%</div>
                </div>
              </div>
            </div>
            </>
          ) : zone.slug === "overpriced-stickers" ? (
            <>
            <div class="overpriced-nav">
              <SlimNav />
            </div>
            <div class="overpriced-layout-with-nav">
              <OverpricedStickersSection inPortal={true} />
              <InvestorChatbot />
            </div>
            </>
          ) : zone.slug === "afterlife-contracts" ? (
            <>
            <div class="afterlife-eden-wrap">
              <SlimNav />
              <div class="afterlife-narmail-layout">
                <section class="afterlife-hero">
                  <div class="afterlife-hero-image">
                    <img src={afterlife.heroImage} alt={afterlife.heroAlt} loading="eager" decoding="async" width="1200" height="800" />
                  </div>
                  <div class="afterlife-hero-overlay px-6 sm:px-10 lg:px-16 pb-16">
                    <div class="mx-auto">
                      <h1 class="afterlife-headline uppercase font-medium tracking-[-0.045em] leading-[0.88] text-[clamp(4rem,9vw,10.5rem)] text-black">
                        <span class="afterlife-headline-line">{afterlife.heroLines[0]}</span>
                        <span class="afterlife-headline-line">{afterlife.heroLines[1]}</span>
                      </h1>
                      <div class="mt-12 mx-auto text-[clamp(1.6rem,2.8vw,3rem)] leading-[1.15] text-black">
                        <p>{afterlife.heroSubheadline}</p>
                        <p class="mt-4 text-[clamp(1rem,1.2vw,1.3rem)] opacity-70">{afterlife.heroSubheadlineAside}</p>
                      </div>
                      <div class="afterlife-mono afterlife-mono-gold mt-12 text-lg sm:text-xl leading-relaxed uppercase tracking-widest">
                        <div>{afterlife.statusLines[0]}</div>
                        <div>{afterlife.statusLines[1]}</div>
                        <div>{afterlife.statusLines[2]}</div>
                      </div>
                    </div>
                  </div>
                </section>

                <div class="afterlife-main-content px-6 sm:px-10 lg:px-16 pb-16">
                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.aboutHeading}</h2>
                    <p>{afterlife.aboutParagraph}</p>
                  </section>

                  <section class="afterlife-artwork-card-section">
                    <div class="artwork-info-card afterlife-narmail-glass" id="afterlife-gallery-trigger">
                      <div class="artwork-card-content">
                        <div class="artwork-card-icon afterlife-gallery-icon">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 16L8.586 11.414C9.367 10.633 10.633 10.633 11.414 11.414L16 16M14 14L15.586 12.414C16.367 11.633 17.633 11.633 18.414 12.414L20 14M14 8H14.01M6 20H18C19.105 20 20 19.105 20 18V6C20 4.895 19.105 4 18 4H6C4.895 4 4 4.895 4 6V18C4 19.105 4.895 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                        <div class="artwork-card-text">
                          <h3 class="artwork-card-title afterlife-gallery-title">{afterlife.artworkCardTitle}</h3>
                          <p class="artwork-card-description">{afterlife.artworkCardDescription}</p>
                        </div>
                        <button class="artwork-card-button afterlife-gallery-btn" type="button">
                          <span>{afterlife.artworkCardButtonLabel}</span>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.conceptHeading}</h2>
                    <p>{afterlife.conceptParagraphs[0]}</p>
                    <p>{afterlife.conceptParagraphs[1]}</p>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.bureaucracyHeading}</h2>
                    <p>{afterlife.bureaucracyParagraph}</p>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.dualityHeading}</h2>
                    <p>{afterlife.dualityParagraphs[0]}</p>
                    <p>{afterlife.dualityParagraphs[1]}</p>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.visualLanguageHeading}</h2>
                    <p>{afterlife.visualLanguageParagraph}</p>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.interactionHeading}</h2>
                    <p>{afterlife.interactionIntro}</p>
                    <ul class="afterlife-list">
                      <li>{afterlife.interactionItems[0]}</li>
                      <li>{afterlife.interactionItems[1]}</li>
                      <li>{afterlife.interactionItems[2]}</li>
                      <li>{afterlife.interactionItems[3]}</li>
                    </ul>
                    <p>{afterlife.interactionClosing}</p>
                  </section>

                  <section class="afterlife-section afterlife-guarantee">
                    <h2 class="afterlife-h2">{afterlife.closingHeading}</h2>
                    <blockquote class="afterlife-blockquote">
                      {afterlife.closingQuoteLines[0]}<br />
                      {afterlife.closingQuoteLines[1]}
                    </blockquote>
                  </section>

                  <section class="afterlife-section">
                    <h2 class="afterlife-h2">{afterlife.downloadHeading}</h2>
                    <p>{afterlife.downloadIntro}</p>
                    <div class="afterlife-terms">
                      <h3 class="afterlife-h3">{afterlife.termsHeading}</h3>
                      <p>{afterlife.termsIntro}</p>
                      <ul class="afterlife-list">
                        <li>{afterlife.termsItems[0]}</li>
                        <li>{afterlife.termsItems[1]}</li>
                        <li>{afterlife.termsItems[2]}</li>
                        <li>{afterlife.termsItems[3]}</li>
                        <li>{afterlife.termsItems[4]}</li>
                      </ul>
                      <div class="terms-checkbox-wrapper mt-6">
                        <label class="terms-checkbox-label">
                          <input type="checkbox" id="afterlife-terms-checkbox" class="terms-checkbox" />
                          <span class="checkbox-text">{afterlife.termsCheckboxLabel}</span>
                        </label>
                      </div>
                    </div>
                    <div class="download-button-wrapper mt-6">
                      <a
                        href={afterlife.downloadHref}
                        download={afterlife.downloadFilename}
                        class="afterlife-download-btn"
                        id="afterlife-download-btn"
                        aria-disabled="true"
                      >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15M7 10L12 15M12 15L17 10M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{afterlife.downloadButtonLabel}</span>
                      </a>
                      <p class="download-hint" id="download-hint">{afterlife.downloadHint}</p>
                    </div>
                  </section>

                  <section class="afterlife-section afterlife-cta">
                    <button type="button" class="afterlife-retreat-btn" data-portal-back>{afterlife.ctaLabel}</button>
                  </section>
                </div>
              </div>
            </div>
            <div class="artwork-viewer" id="afterlife-artwork-viewer" aria-hidden="true">
              <div class="viewer-overlay"></div>
              <div class="viewer-container">
                <div class="viewer-controls">
                  <button class="viewer-btn viewer-close" aria-label="Close viewer" title="Close (ESC)">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <button class="viewer-btn viewer-zoom-in" aria-label="Zoom in" title="Zoom In">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <button class="viewer-btn viewer-zoom-out" aria-label="Zoom out" title="Zoom Out">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <button class="viewer-btn viewer-reset" aria-label="Reset view" title="Reset View">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 4V9H9M20 20V15H15M19.91 14.94C19.4 16.68 18.35 18.19 16.92 19.27C15.49 20.35 13.75 20.94 12 21C7.03 21 3 16.97 3 12M4.09 9.06C4.6 7.32 5.65 5.81 7.08 4.73C8.51 3.65 10.25 3.06 12 3C16.97 3 21 7.03 21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <div class="viewer-image-wrapper">
                  <div class="viewer-image-container" id="afterlife-viewer-image-container">
                    <img
                      src={afterlife.viewerImage}
                      alt={afterlife.viewerAlt}
                      class="viewer-image"
                      id="afterlife-viewer-image"
                      draggable="false"
                      loading="lazy"
                      decoding="async"
                      width="1200"
                      height="900"
                    />
                  </div>
                </div>
                <div class="viewer-zoom-indicator" id="afterlife-zoom-indicator">100%</div>
              </div>
            </div>
            </>
          ) : zone.slug === "president-of-the-galaxy" ? (
            <>
            <div class="president-bg-wrap">
              <DynamicCosmicBackground />
            </div>
            <div class="president-content president-zone">
              <SlimNav />
              <div class="president-layout president-eden">
                <section class="president-hero">
                  <img
                    src={president.heroImage}
                    alt={president.heroAlt}
                    loading="eager"
                    decoding="async"
                    width="1200"
                    height="800"
                  />
                  <div class="president-hero-overlay">
                    <h1 class="president-title president-eden-headline">{president.heroTitleLines[0]}<br/>{president.heroTitleLines[1]}</h1>
                  </div>
                </section>

                <div class="president-main-content">
                  <section class="president-intro-section">
                    <div class="glass-card president-glass president-intro-card">
                      <p class="president-tagline">{president.tagline}</p>
                      <p class="president-lead president-eden-body">
                        {president.lead}
                      </p>
                      <div class="president-eden-mono">
                        <div>{president.statusLines[0]}</div>
                        <div>{president.statusLines[1]}</div>
                        <div>{president.statusLines[2]}</div>
                        <div>YEAR: <span class="president-censored" data-reveal="??" tabindex="0">██</span>88</div>
                      </div>
                    </div>
                  </section>

                  <section class="president-artwork-card-section">
                    <div class="artwork-info-card glass-card president-glass" id="president-gallery-trigger">
                      <div class="artwork-card-content">
                        <div class="artwork-card-icon">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                        <div class="artwork-card-text">
                          <h3 class="artwork-card-title">{president.artworkCardTitle}</h3>
                          <p class="artwork-card-description">{president.artworkCardDescription}</p>
                        </div>
                        <button class="artwork-card-button president-btn" type="button">
                          <span>{president.artworkCardButtonLabel}</span>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </section>

                  <section class="president-content-grid-section" data-motion-reveal>
                    <div class="president-glass-grid" data-motion-stagger data-motion-children="[data-motion-item]">
                      <div class="glass-card president-glass president-what-is-this-card" data-motion-item>
                        <div class="president-what-text">
                          <h3>{president.whatHeading}</h3>
                          <p>{president.whatParagraphs[0]}</p>
                          <p>{president.whatParagraphs[1]}
                          </p>
                        </div>
                        <a href={president.whatLinkHref} class="president-what-image-link group" aria-label="Go to Overpriced Stickers">
                          <img src={president.whatImage} alt="" loading="lazy" decoding="async" width="400" height="400" />
                        </a>
                      </div>
                      <div class="glass-card president-glass" data-motion-item>
                        <h3>{president.dealHeading}</h3>
                        <p>{president.dealParagraph}</p>
                        <h3>{president.dealIncludesHeading}</h3>
                        <ul class="president-list">
                          <li>{president.dealIncludes[0]}</li>
                          <li>{president.dealIncludes[1]}</li>
                          <li>{president.dealIncludes[2]}</li>
                          <li>{president.dealIncludes[3]}</li>
                        </ul>
                        <p set:html={president.dealReturns}></p>
                        <p class="president-fine-print">{president.dealFinePrint}</p>
                      </div>
                      <div class="glass-card president-glass" data-motion-item>
                        <h3>{president.rulesHeading}</h3>
                        <div class="president-rule">
                          <p set:html={president.rules[0]}></p>
                        </div>
                        <div class="president-rule">
                          <p set:html={president.rules[1]}></p>
                        </div>
                        <div class="president-rule">
                          <p set:html={president.rules[2]}></p>
                        </div>
                        <div class="president-rule">
                          <p set:html={president.rules[3]}></p>
                        </div>
                        <div class="president-rule">
                          <p set:html={president.rules[4]}></p>
