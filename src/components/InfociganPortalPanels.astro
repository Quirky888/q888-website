  [data-portal-panel="nar-mail-express"] #nar-chat-widget .nar-chat-input,
  [data-portal-panel="nar-mail-express"] #nar-chat-widget .nar-chat-close {
    color: #ffffff !important;
  }

  .panel-scroll {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .panel-article {
    max-width: 48rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 8rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .panel-article {
      padding: 8rem 6rem 8rem;
    }
  }

  .panel-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 4rem;
    margin-top: auto;
    padding-bottom: 4rem;
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .panel-back {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.4);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 300ms ease;
  }

  .panel-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .panel-body {
    font-size: 1rem;
    line-height: 1.8;
    max-width: 45ch;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .panel-body {
      font-size: 1.125rem;
    }
  }

  .panel-visual {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 6rem 2rem;
    border: 1px solid rgba(0,0,0,0.1);
    text-align: center;
  }

  [data-portal-panel="q-bag"] .panel-archive-bar,
  [data-portal-panel="overpriced-stickers"] .panel-archive-bar {
    display: none;
  }

  .overpriced-layout-with-nav {
    --overpriced-nav-offset: 2.5rem;
    padding-top: var(--overpriced-nav-offset);
  }

  @media (min-width: 768px) {
    .overpriced-layout-with-nav {
      --overpriced-nav-offset: 2.75rem;
    }
  }

  /* Q-Bag layout - clean & modern */
  .qbag-new-layout {
    width: 100%;
    background: #0a0a0a;
    color: var(--text-primary, #e0e0e0);
    font-family: inherit;
    overflow-y: auto;
  }

  .qbag-hero {
    width: 100%;
    height: 80dvh;
    position: relative;
    overflow: hidden;
  }

  .qbag-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .qbag-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 4vw;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  }

  .qbag-title {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(5rem, 14vw, 14rem);
    font-weight: 900;
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--accent-primary, #ffd700);
    margin: 0;
    letter-spacing: -0.04em;
    text-shadow: 0 4px 20px rgba(255, 215, 0, 0.3);
  }

  .qbag-main-content {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4vw;
  }

  .qbag-intro-section {
    padding: 8rem 0 6rem;
  }

  .intro-card {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 4rem;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .qbag-tagline {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 600;
    color: var(--accent-primary, #ffd700);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    line-height: 1;
    opacity: 0.95;
  }

  .qbag-lead {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    line-height: 1.4;
    font-weight: 300;
    opacity: 0.95;
    margin: 0;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .qbag-artwork-card-section {
    padding: 6rem 0;
  }

  .qbag-artwork-card-section .artwork-info-card {
    background-image: linear-gradient(rgba(10, 10, 10, 0.78), rgba(10, 10, 10, 0.78)), url("/images/qbag_concept.webp");
    background-size: cover;
    background-position: center;
  }

  .artwork-info-card {
    max-width: 1000px;
    margin: 0 auto;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .artwork-info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.1), transparent);
    transition: left 0.5s ease;
  }

  .artwork-info-card:hover::before {
    left: 100%;
  }

  .artwork-info-card:hover {
    border-color: rgba(255, 215, 0, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(255, 215, 0, 0.2);
  }

  .artwork-card-content {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 3rem;
  }

  .artwork-card-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary, #ffd700);
    background: rgba(255, 215, 0, 0.1);
    border-radius: 12px;
  }

  .artwork-card-text {
    flex: 1;
  }

  .artwork-card-title {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--accent-primary, #ffd700);
    margin: 0 0 1rem 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .artwork-card-title::before {
    content: '// GALLERY';
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: rgba(255, 215, 0, 0.5);
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .artwork-card-description {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
    font-weight: 300;
    letter-spacing: -0.005em;
  }

  .artwork-card-button {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: var(--accent-primary, #ffd700);
    color: #000;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .artwork-card-button:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(255, 215, 0, 0.4);
  }

  .artwork-card-button svg {
    transition: transform 0.2s ease;
  }

  .artwork-card-button:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .artwork-card-content {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
      gap: 1.5rem;
    }
    .artwork-card-button {
      width: 100%;
      justify-content: center;
    }
  }

  .artwork-viewer {
    position: fixed;
    inset: 0;
    z-index: 2000000;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .artwork-viewer.is-open {
    display: block;
    opacity: 1;
  }

  .viewer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(10px);
  }

  .viewer-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .viewer-controls {
    position: absolute;
    top: calc(1.5rem + env(safe-area-inset-top, 0px));
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    display: flex;
    gap: 0.5rem;
    z-index: 10002;
  }

  .viewer-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }

  .viewer-btn:hover {
    background: rgba(255, 215, 0, 0.2);
    border-color: var(--accent-primary, #ffd700);
    transform: scale(1.05);
  }

  .viewer-close {
    background: rgba(255, 50, 50, 0.15);
    border-color: rgba(255, 50, 50, 0.3);
  }

  .viewer-close:hover {
    background: rgba(255, 50, 50, 0.3);
    border-color: rgba(255, 50, 50, 0.6);
  }

  .viewer-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    cursor: grab;
  }

  .viewer-image-wrapper.is-grabbing {
    cursor: grabbing;
  }

  .viewer-image-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    transition: transform 0.2s ease;
    will-change: transform;
  }

  .viewer-image {
    max-width: 90vw;
    max-height: 90dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  .viewer-zoom-indicator {
    position: absolute;
    bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: 10002;
  }

  .viewer-zoom-indicator.show {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .viewer-controls {
      top: calc(1rem + env(safe-area-inset-top, 0px));
      right: calc(1rem + env(safe-area-inset-right, 0px));
      gap: 0.375rem;
    }
    .viewer-btn {
      width: 40px;
      height: 40px;
    }
    .viewer-image {
      max-width: 95vw;
      max-height: 95dvh;
    }
  }

  .qbag-content-grid-section {
    padding: 6rem 0;
  }

  .qbag-glass-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 3rem;
  }

  .glass-card {
    background: rgba(10, 10, 10, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 3.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .glass-card:hover {
    background: rgba(15, 15, 15, 0.75);
    border-color: rgba(255, 215, 0, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
  }

  .glass-card h3 {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.8rem, 2.5vw, 2.8rem);
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--accent-primary, #ffd700);
    border-bottom: none;
    padding-bottom: 0;
    display: block;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-shadow: 0 0 40px rgba(255, 215, 0, 0.15);
  }

  .glass-card h3::before {
    content: '//';
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7em;
    color: rgba(255, 215, 0, 0.4);
    margin-right: 0.75rem;
    font-weight: 400;
  }

  .glass-card p {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.75;
    opacity: 0.9;
    margin-bottom: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    animation: fadeInUp 0.6s ease-out backwards;
    animation-delay: calc(var(--delay, 0) * 0.1s);
  }

  .glass-card p:first-of-type {
    font-size: clamp(1.15rem, 1.4vw, 1.4rem);
    line-height: 1.7;
    font-weight: 300;
  }

  .glass-card p:last-child {
    margin-bottom: 0;
  }

  .qbag-partners-section {
    padding: 8rem 0;
  }

  .qbag-partners-section h2 {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 3rem;
    color: var(--accent-primary, #ffd700);
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 0 50px rgba(255, 215, 0, 0.2);
  }

  .partners-card h2::before {
    content: '// FOR PARTNERS';
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 215, 0, 0.5);
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .qbag-partners-section p {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.15rem, 1.6vw, 1.6rem);
    line-height: 1.7;
    margin-bottom: 2rem;
    opacity: 0.9;
    font-weight: 300;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .partners-card {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 4rem;
  }

  .qbag-closing-section {
    padding: 8rem 0;
    text-align: center;
  }

  .closing-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .big-statement {
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .qbag-contact-section {
    padding: 6rem 0 8rem;
  }

  .contact-card {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 3rem;
    text-align: center;
  }

  .contact-card p {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.4rem);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .qbag-new-layout .contact-info {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: clamp(1rem, 1.3vw, 1.3rem) !important;
    font-weight: 500 !important;
    letter-spacing: 0.02em;
    margin-top: 2rem;
  }

  .contact-card a {
    color: #ce9e00;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .contact-card a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .qbag-cta {
    padding: 6rem 0;
    text-align: center;
    background: #0a0a0a;
  }

  .qbag-new-layout .retreat-button {
    background: transparent;
    border: 2px solid #a67c00;
    color: #ce9e00;
    padding: 1.5rem 4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 4px;
  }

  .qbag-new-layout .retreat-button:hover {
    background: #ce9e00;
    color: #000;
    box-shadow: 0 0 30px rgba(166, 124, 0, 0.3);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .qbag-glass-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .qbag-title {
      font-size: clamp(4rem, 12vw, 10rem);
    }
    .qbag-tagline {
      letter-spacing: 0.2em;
    }
    .glass-card h3 {
      font-size: clamp(1.6rem, 2.2vw, 2.4rem);
    }
    .intro-card,
    .partners-card,
    .contact-card {
      padding: 3rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .qbag-hero {
      height: 60dvh;
    }
    .qbag-main-content {
      padding: 0 3vw;
    }
    .qbag-title {
      font-size: clamp(3rem, 10vw, 8rem);
      letter-spacing: -0.03em;
    }
    .qbag-tagline {
      font-size: 0.9rem;
      letter-spacing: 0.15em;
    }
    .qbag-lead {
      font-size: clamp(1.25rem, 2vw, 1.8rem);
    }
    .qbag-intro-section {
      padding: 5rem 0 4rem;
    }
    .intro-card {
      padding: 3rem 2.5rem;
    }
    .qbag-content-grid-section {
      padding: 3rem 0;
    }
    .qbag-glass-grid {
      gap: 2rem;
    }
    .glass-card {
      padding: 2.5rem 2rem;
    }
    .glass-card h3 {
      font-size: clamp(1.5rem, 2vw, 2rem);
      margin-bottom: 1.5rem;
    }
    .glass-card p {
      font-size: 1.05rem;
      line-height: 1.7;
    }
    .big-statement {
      font-size: clamp(2rem, 5vw, 4rem);
    }
    .qbag-partners-section h2 {
      font-size: clamp(2rem, 4vw, 3.5rem);
    }
    .qbag-partners-section,
    .qbag-closing-section {
      padding: 5rem 0;
    }
    .qbag-contact-section {
      padding: 5rem 0 6rem;
    }
    .partners-card,
    .contact-card {
      padding: 3rem 2rem;
    }
    .closing-content {
      padding: 3rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .qbag-hero {
      height: 50dvh;
    }
    .qbag-title {
      font-size: clamp(2.5rem, 12vw, 6rem);
    }
    .qbag-tagline {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }
    .intro-card {
      padding: 2rem 1.5rem;
    }
    .glass-card {
      padding: 1.5rem;
    }
    .artwork-card-title {
      font-size: 1.5rem;
    }
    .qbag-new-layout .retreat-button {
      padding: 1rem 2rem;
      font-size: 1rem;
    }
  }

  /* Gold Shine Effect */
  .gold-shine {
    color: #a67c00;
    background: linear-gradient(
      to right, 
      #a67c00 20%, 
