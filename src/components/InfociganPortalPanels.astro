  /* AFTERLIFE CONTRACT - LUXURY BROWN-GOLD DESIGN SYSTEM */
  .afterlife-content {
    position: relative;
    z-index: 1;
    --espresso: 59, 47, 39;
    --cognac: 92, 64, 43;
    --amber: 138, 94, 56;
    --bronze: 167, 125, 85;
    --antique-gold: 184, 143, 98;
    --champagne: 218, 197, 143;
    --cream: 242, 240, 235;
    --warm-white: 255, 251, 245;
  }

  .afterlife-bg-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .afterlife-layout {
    position: relative;
    z-index: 1;
    width: 100%;
    background: transparent;
    color: rgb(var(--espresso));
    font-family: inherit;
    overflow-y: auto;
  }

  .afterlife-layout ::selection {
    background: rgba(var(--antique-gold), 0.3);
    color: rgb(var(--espresso));
  }

  .afterlife-hero {
    width: 100%;
    height: 80vh;
    position: relative;
    overflow: hidden;
    background: rgb(var(--espresso));
  }

  .afterlife-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(59, 47, 39, 0.35) 0%,
      rgba(92, 64, 43, 0.25) 50%,
      rgba(120, 86, 58, 0.15) 100%
    );
  }

  .afterlife-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .afterlife-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 5vw 5vw 2vw 5vw;
    background: transparent;
  }

  .afterlife-title {
    font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(5rem, 14vw, 14rem);
